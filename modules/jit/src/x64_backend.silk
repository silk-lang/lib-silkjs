import jit_exit_state as state

/// Bytes per SSA value slot and per ValueBits.
pub const SLOT_BYTES: u32 = 16
/// js_compiled.EXIT_*.
/// How many instructions after a method read the callee test that names its target is
/// looked for (knownRead): it follows the read at once unless the read was hoisted.
const EXIT_RETURNED: u32 = 0
const EXIT_DEOPT: u32 = 1
const EXIT_POLL: u32 = 2
const EXIT_THROW: u32 = 3
const EXIT_CALL: u32 = 4
/// js_compiled.CompiledFrame.calls's offset (its seventh pointer).
const FRAME_CALLS: i32 = 48
/// CompiledFrame.code's offset (its eighth pointer).
const FRAME_CODE: i32 = 56
/// CompiledFrame.runtime's offset (its fourth pointer).
const FRAME_RUNTIME: i32 = 24
/// Frame words of one inlined callee: its CompiledFrame.
const INLINE_FRAME_WORDS: u32 = 9
/// More values than this would make the frame larger than is sensible for a first tier.
const MAX_VALUES: u32 = 65536
/// The typed array classes whose Int store typedStore makes before its integer views.
fn isFloatClass(classId: u32) -> bool {
  return classId == classes.JS_CLASS_FLOAT64_ARRAY || classId == classes.JS_CLASS_FLOAT32_ARRAY || classId == classes.JS_CLASS_UINT8C_ARRAY
}

/// Why a function was not lowered.
pub struct Unsupported { pub why: &'static [u8] }
/// Code: construct is the offset of frame mode's construct entry (x64_backend.construct), 0
/// for code of no frame.
pub union Lowering { Code { pub value: Code, pub construct: u32 }, Unsupported { pub reason: Unsupported } }

/// Options of one lowering.
pub struct Settings {
  /// Every guard first counts down the i32 at `data` and fails when it reaches zero,
  /// resetting it to stress (the deopt-stress configuration). 0: off.
  pub stress: u32,
  /// Where the engine keeps a ValueBits' tag and payload.
  pub layout: ValueLayout,
  /// Print where each instruction's code starts ("jit: optimized map", the offsets in the
  /// order the SSA text lists the instructions), for joining samples with instructions.
  pub map: bool
}

/// The baseline frame that frame mode's code runs on.
pub struct FramePlan {
  pub f: BaselineLayout,
  /// baseline.extent: the record and the first cell from rbp, the frame's bytes below rbp.
  pub record: i32, pub cells: i32, pub below: i32,
  pub arguments: u32, pub locals: u32,
  /// Shape.copies, codeWord and codeDelta, for the prologue.
  pub copies: bool, pub codeWord: u32, pub codeDelta: u32
}
impl Copy for FramePlan {}
fn signed(value: u32) -> i32 { return u32.wrappingToI32(value) }
impl FramePlan {
  pub fn of(base: BaselineLayout, shape: &Shape) -> FramePlan {
    let at = stubs.extent(&base, &shape)
    return FramePlan { f: base, record: at.record, cells: at.cells, below: at.below, arguments: shape.arguments, locals: shape.locals,
      copies: shape.copies, codeWord: shape.codeWord, codeDelta: shape.codeDelta }
  }
  /// The plan of code for the compiled-entry ABI: no frame.
  fn none() -> FramePlan {
    return FramePlan { f: frames.layout(), record: 0, cells: 0, below: 0, arguments: 0, locals: 0, copies: false, codeWord: 0, codeDelta: 0 }
  }
  /// A field of the record, and of its StackFrame.
  pub fn rec(self: &Self, offset: u32) -> Mem { return Mem.at(Reg.Rbp, self.record + signed(offset)) }
  pub fn sf(self: &Self, offset: u32) -> Mem { return Mem.at(Reg.Rbp, self.record + signed(self.f.frame + offset)) }
  /// The rbp displacement of the frame's own argument cell, local and operand cell index.
  pub fn argumentAt(self: &Self, index: u32) -> i32 { return self.cells + signed(index * 16) }
  pub fn localAt(self: &Self, index: u32) -> i32 { return self.cells + signed((self.arguments + index) * 16) }
  pub fn operandAt(self: &Self, depth: u32) -> i32 { return self.cells + signed((self.arguments + self.locals + depth) * 16) }
}
/// A poll's slow path in frame mode: the engine's poll with the frame at pc, then back, or
/// to the exit when it threw or turned instruction observation on.
struct PollSlow { slow: Label, back: Label, exit: u32, pc: u32 }
impl Copy for PollSlow {}
/// Code kept out of the way of what usually runs (Emitter.outs), placed after the blocks:
/// it starts at `entry` and jumps `back`. `frame` is the Inst.frame it runs for.
struct Out { kind: u32, entry: Label, back: Label, frame: u32, inst: u32, base: Reg, at: i32, flags: u32 }
impl Copy for Out {}
/// The last count of the ValueBits at `at` from `base`: R9 is its payload, whose count the
/// code already dropped. The release helper takes it from there.
const OUT_RELEASE: u32 = 1
/// The variable read of instruction `inst` through its helper.
const OUT_GET_VAR: u32 = 2
/// A keyed store that displaces the last count of the old value (put.field): `at` is the
/// slot's offset from R11, flags the PUT_* of the store.
const OUT_PUT_LAST: u32 = 3
/// The new value is in RAX and R9; the value's own count goes to the field.
const PUT_HELD: u32 = 1
const PUT_MOVED: u32 = 2

pub struct Emitter {
  pub a: Assembler,
  pub blockLabels: List<Label>,
  /// By block: past the `check.shape` that begins it, where the shape dispatch that proved
  /// the shape goes (armEntry).
  pub armLabels: List<Label>,
  pub exitLabels: List<Label>,
  /// Where each call resumes, in instruction order (resume point k + 1 is call k).
  pub resumeLabels: List<Label>,
  /// What each call saves in its call block (ssa_liveness.savedAcross): call k's values are
  /// savedValues[savedStart[k] .. savedStart[k + 1]].
  pub savedValues: List<u32>,
  pub savedStart: List<u32>,
  /// Bytes of the frame below the return address: values, then the edge scratch area.
  pub frame: i32,
  pub scratch: i32,
  /// The frame slots holding the six ABI inputs, from rsp.
  pub inputs: i32,
  pub settings: Settings,
  /// Where each value lives (x64_regalloc).
  pub places: Allocation,
  /// Where an object keeps its shape and slots (inline field access).
  fields: FieldLayout,
  /// Per value: its reads (operands, edge arguments, exit slots; an over-count only costs
  /// speed), the reads that take it as an immediate, and the instruction defining it or NONE.
  uses: List<u32>,
  immediateUses: List<u32>,
  defs: List<u32>,
  /// Per value: its constant when a `const.i32` defines it.
  pub constants: List<Option<i32>>,
  /// The block being lowered: a jump to the next one falls through.
  current: u32,
  /// The instruction being lowered, and the one a label is bound after (NONE: none): where
  /// a get.elem that loaded its number itself skips its unbox (fusedUnbox).
  cursor: u32,
  skipAt: u32,
  skipLabel: Label,
  /// The instruction that emits nothing: a release whose count a store took (movedInto).
  dropAt: u32,
  /// By value: 1 + the inline target whose one closure the value is known to be, or 0
  /// (presets); and the exit of the callee test that proves it.
  preset: List<u32>,
  presetGuard: List<u32>,
  /// `add.i32`/`sub.i32` done in place (result and first operand in one register): on
  /// overflow each jumps to its label here, where the operation is undone before the exit
  /// reads the operand.
  undoLabels: List<Label>,
  undoInsts: List<Inst>,
  /// mul.i32's tests for -0, out of line: where a zero product goes, where it comes back.
  zeroLabels: List<Label>,
  zeroBacks: List<Label>,
  zeroInsts: List<Inst>,
  /// Slow paths placed after the blocks (coldPieces): where each starts and goes back to,
  /// the instruction, and COLD_READ's unbox exit or COLD_STORE's box (NONE for none).
  coldLabels: List<Label>,
  coldBacks: List<Label>,
  coldInsts: List<Inst>,
  coldAux: List<u32>,
  /// An instruction another one lowered already (a trusted read's unbox), or NONE.
  omitAt: u32,
  /// The last trusted element read (its instruction, the object's storage and the index):
  /// R11 holds that element's address after it, until something touches R11 (reusesElement).
  elementAt: u32,
  elementObject: u32,
  elementIndex: u32,
  /// Where the inlined callees' CompiledFrames start, from rsp: INLINE_FRAME_WORDS words each.
  inlineFrames: i32,
  /// The closure value each inlined callee's `inline.frame` names, by frame number less one.
  inlineClosures: List<u32>,
  /// Inst.frame of the instruction being lowered: whose frame, code and closure it runs for.
  frameOf: u32,
  /// Frame mode, and the frame.
  pub on: bool,
  pub plan: FramePlan,
  /// Frame mode: the pcs of the method calls (OP_call_method), whose receiver is an operand.
  methods: List<u32>,
  /// Frame mode: the constant keys of field sites and what is known of their objects.
  shapes: Shapes,
  polls: List<PollSlow>,
  outs: List<Out>,
  /// Frame mode: where the prologue goes when the native stack has no room.
  overflow: Label,
  /// Frame mode: the construct entry's offset before placing (frameTails), and where it
  /// joins the prologue (enter).
  constructAt: u32,
  entered: Label,
  /// Frame mode: the prologue's out-of-line arguments copy (fewer passed than declared), and
  /// where it rejoins the prologue.
  copying: Label,
  prologued: Label,
  /// Frame mode: a return's out-of-line ends, for a frame that copied its arguments and for
  /// one whose StackFrame was linked (built) while it ran.
  leaveOwn: Label,
  leaveBuilt: Label,
  /// Frame mode: each exit's stub past the instruction that says it is a plain deopt; a call
  /// or a poll jumps here with how it left in ecx (x64_frame_exit.HOW_*).
  pub exitWith: List<Label>,
  /// Each exit's record among the tables (x64_exits binds them).
  pub records: List<Label>,
  /// Frame mode, by instruction: baseline.stepAlone of the bytecode instruction the
  /// interpreter may run for it on the frame (stepOnFrame), or 0.
  steps: List<u32>,
  /// Frame mode: the slot of the function's realm, from rsp (kept for the polls).
  realmAt: i32,
  /// Frame mode: where the area for exits that leave inlined bodies part way through starts,
  /// from rsp, and its bytes (0: the function has no such exit).
  pub leaveAt: i32,
  pub leaveBytes: u32,
  /// Frame mode: where the operand cells of a call inside an inlined body are, from rsp
  /// (the receiver's, the function's, then the arguments'), and where the records of the
  /// bodies around such a call start, outermost first: each the baseline record's bytes,
  /// then its frame pointer word and a word of padding.
  callAt: u32,
  bodyAt: u32,
  /// Frame mode, by value: the value whose slot holds its bits. A copy (`retain`, a read
  /// ssa_shapes found to repeat an earlier one) has no slot of its own: its source's def
  /// dominates it and a slot is written only where its value is defined, so the source's
  /// slot holds the copy's bits wherever the copy is read. What the copy owns stays its own.
  pub stored: List<u32>,
  /// Frame mode: the value whose first word is in RAX and payload in R9 at code offset
  /// freshAt with freshBinds labels bound (setFresh), for the next instruction to read
  /// there instead of the slot (isFresh).
  fresh: u32,
  freshAt: usize,
  freshBinds: usize,
  /// The variable cells read by address (Function.ownedCells): entry n's symbol follows the
  /// inline targets' symbols.
  ownedCells: List<u32>,
  /// The atoms whose string cells frame mode's code links (Function.linkedAtoms).
  atoms: List<u32>,
}

pub fn slotOf(v: u32) -> Mem { return Mem.at(Reg.Rsp, u32.wrappingToI32(v * SLOT_BYTES)) }
/// The second word of a value's slot: a ValueBits' payload.
pub fn payloadOf(v: u32) -> Mem { return Mem.at(Reg.Rsp, u32.wrappingToI32(v * SLOT_BYTES + 8)) }
pub fn word(base: Reg, offset: u32) -> Mem { return Mem.at(base, u32.wrappingToI32(offset)) }

/// Lowers function, which must be compacted and verified.
pub effect fn lower(function: &Function, settings: Settings) -> Lowering ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  return run lowerIn(&function, move settings, false, FramePlan.none(), List<u32>.make(), Shapes.none(), List<u32>.make())
}
/// lower in frame mode: for the baseline frame of plan. code is the function's bytecode. The
/// code's symbols: 0 to STUB_COUNT - 1 the shared stubs, then the `moved` and `finish` tails,
/// the entry of the function's baseline code, its `stepEnded` tail and its construct entry,
/// then the inline targets (FRAME_SYMBOLS on). The code has a construct entry of its own
/// (Lowering.Code.construct).
/// Whether inst reads its second operand, when that is a constant, as an immediate.
fn immediateOperand(function: &Function, inst: Inst) -> bool {
  let op = inst.op
  if op == Op.Add || op == Op.Sub || op == Op.Cmp || op == Op.BitAnd || op == Op.BitOr || op == Op.BitXor
    || op == Op.Shl || op == Op.Sar || op == Op.Shr { return true }
  if op == Op.Mul {
    let def = function.value(inst.b).def
    return def != NONE && function.inst(def).op == Op.ConstI32 && function.inst(def).k > 0
  }
  return false
}
/// Whether lowering inst leaves R11 as it is, and stores to no Array: arithmetic,
/// compares, constants, boxes and unboxes of numbers, and shifts by a constant (a shift by
/// a register keeps rcx in R11).
fn r11Kept(function: &Function, inst: Inst) -> bool {
  let op = inst.op
  if op == Op.ConstI32 || op == Op.Imm || op == Op.Unbox || op == Op.UnboxBool || op == Op.BoxI32 || op == Op.BoxBool
    || op == Op.Add || op == Op.Sub || op == Op.Mul || op == Op.Cmp || op == Op.BitAnd || op == Op.BitOr || op == Op.BitXor
    || op == Op.BitNot || op == Op.Neg || op == Op.NotBool || op == Op.Removed { return true }
  if op == Op.Shl || op == Op.Sar || op == Op.Shr {
    let def = function.value(inst.b).def
    return def != NONE && function.inst(def).op == Op.ConstI32
  }
  return false
}
/// Whether the i32 v is never negative: a constant that is not, an `and` with one, or a
/// logical shift right by a nonzero constant.
fn nonNegative(function: &Function, v: u32) -> bool {
  let def = function.value(v).def
  if def == NONE { return false }
  let inst = function.inst(def)
  if inst.op == Op.ConstI32 { return inst.k >= 0 }
  if inst.op == Op.BitAnd { return nonNegativeConstant(function, inst.a) || nonNegativeConstant(function, inst.b) }
  if inst.op == Op.Shr {
    let shift = function.value(inst.b).def
    return shift != NONE && function.inst(shift).op == Op.ConstI32 && (function.inst(shift).k & 31) != 0
  }
  return false
}
fn nonNegativeConstant(function: &Function, v: u32) -> bool {
  let def = function.value(v).def
  return def != NONE && function.inst(def).op == Op.ConstI32 && function.inst(def).k >= 0
}
/// The constant when it is positive, else 0.
fn positiveConstant(constant: Option<i32>) -> i32 {
  return match constant { Option<i32>.Some { value } => if value > 0 { value } else { 0 } Option<i32>.None => 0 }
}
pub effect fn lowerOnFrame(function: &Function, settings: Settings, plan: FramePlan, code: &[u8], shapes: Shapes) -> Lowering ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut methods = List<u32>.make()
  let mut i: usize = 0
  while i < function.insts.length() {
    let inst = function.insts.get(i)
    if inst.op == Op.Call && inst.frame == 0 && u32.toUsize(inst.pc) < code.length && code[u32.toUsize(inst.pc)] == opcodes.OP_call_method { run methods.append(inst.pc) }
    i = i + 1
  }
  // What the interpreter may run on the frame for the code: an instruction without a
  // template (a generic call) and a site that left compiled code before.
  let mut steps = List<u32>.make()
  run steps.appendRepeated(0, function.insts.length())
  i = 0
  while i < function.insts.length() {
    let inst = function.insts.get(i)
    let mut wanted = false
    if inst.frame == 0 && inst.exit != NONE {
      if inst.op == Op.GetField || inst.op == Op.GetLength { wanted = (inst.k & FIELD_STEPS) != 0 }
      else if inst.op == Op.GetElem || inst.op == Op.GetKey { wanted = inst.k == ELEM_STEPS }
      else if inst.op == Op.PutField || inst.op == Op.PutKey { wanted = true }
      else if inst.op == Op.Call {
        wanted = (inst.k & calls.GENERIC) != 0 || calls.kindOf(inst) != compiled.SITE_CALL
        // A concatenation into a local (add_loc) leaves when it declines.
        if calls.kindOf(inst) == compiled.SITE_ADD && u32.toUsize(inst.pc) < code.length && code[u32.toUsize(inst.pc)] == opcodes.OP_add_loc { wanted = false }
      }
    }
    if wanted { steps.set(i, stepFor(&function, inst, code)) }
    i = i + 1
  }
  return run lowerIn(&function, move settings, true, plan, move methods, move shapes, move steps)
}
/// baseline.stepAlone of the bytecode instruction of inst, when the code can have it stepped
/// on its frame: the depths fit a step's shape, and a generic call's values are where the
/// instruction leaves them. 0 otherwise.
/// In a step entry (Emitter.steps): the engine may make the instruction without the
/// interpreter (js_baseline.SERVICE_QUICK), on its operand cells alone.
const STEP_QUICK: u32 = 0x80000000
fn stepFor(function: &Function, inst: Inst, code: &[u8]) -> u32 {
  let mut step = stubs.stepAlone(code, u32.toUsize(inst.pc))
  if step == 0 { return 0 }
  let opcode = code[u32.toUsize(inst.pc)]
  if inst.op == Op.Call && (inst.k & calls.GENERIC) != 0 && (opcode == opcodes.OP_object || opcode == opcodes.OP_define_field
    || opcode == opcodes.OP_set_proto || opcode == opcodes.OP_array_from || opcode == opcodes.OP_rest) { step = step | STEP_QUICK }
  let before = function.exit(inst.exit).stackDepth
  let after = u32.wrappingToI32(before) + u32.wrappingToI32(u32.shiftRight(step, 16) & 255) - 128
  if before > 255 || after < 0 || after > 255 || inst.pc + (step & 65535) >= 16777216 { return 0 }
  if inst.op == Op.Call && (inst.k & calls.GENERIC) != 0 {
    let count = u32.wrappingToI32(calls.countOf(inst))
    let base = u32.wrappingToI32(before) - count
    let results = calls.resultCount(inst.k)
    if base < 0 || after < base { return 0 }
    if results == 0 { if after - base > 1 { return 0 } }
    else if after - base != results { return 0 }
  }
  return step
}
/// The symbols of frame mode's code after the shared stubs: the baseline code's `moved` tail
/// (MARK_MOVED), its `finish` tail (MARK_FINISH) and its entry; the inline targets follow.
pub const SYMBOL_MOVED: u32 = stubs.STUB_COUNT
pub const SYMBOL_FINISH: u32 = stubs.STUB_COUNT + 1
pub const SYMBOL_BASELINE: u32 = stubs.STUB_COUNT + 2
/// Where its steps' nonzero answers go (MARK_STEP_ENDED).
pub const SYMBOL_STEP_ENDED: u32 = stubs.STUB_COUNT + 3
/// The baseline code's construct entry (MARK_CONSTRUCT).
pub const SYMBOL_BASELINE_CONSTRUCT: u32 = stubs.STUB_COUNT + 4
pub const FRAME_SYMBOLS: u32 = stubs.STUB_COUNT + 5

effect fn lowerIn(function: &Function, settings: Settings, on: bool, plan: FramePlan, methods: List<u32>, shapes: Shapes, steps: List<u32>) -> Lowering ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  match supported(&function, on, settings.stress, &steps) {
    Option<&'static [u8]>.Some { value } => { return Lowering.Unsupported { reason: Unsupported { why: value } } }
    Option<&'static [u8]>.None => ()
  }
  let values = function.valueCount()
  let mut pool = regalloc.entryPool()
  if on { pool = regalloc.framePool() }
  let places = run regalloc.allocateIn(&function, pool)
  let mut pushes: u32 = 0
  let mut r: usize = 0
  while !on && r < gprCount() { if u32.bitAnd(u32.shiftRight(places.savedMask, usize.toU32(r)), 1) != 0 { pushes = pushes + 1 } r = r + 1 }
  // The value slots, the edge moves' scratch slot, then the six ABI inputs; 16-byte aligned
  // at calls below the return address and the saved registers. In frame mode the function's
  // own CompiledFrame, built where a helper needs one (ownFrame), takes the inputs' place,
  // the realm's word follows the inlined callees' frames, and all of it is below the
  // baseline frame, which the shared prologue fills.
  // Two scratch slots: the edge moves' one, and room to keep the four fragile registers
  // over a slow path's call (keepFragile).
  let inputs = (values + 2) * SLOT_BYTES
  let inlined = usize.toU32(function.inlineTargets.length())
  let mut own = INPUT_COUNT * 8
  if on { own = INLINE_FRAME_WORDS * 8 }
  // Frame mode's exits that leave inlined bodies part way through (ssa.Exit.frames) build
  // those bodies' activations after the realm's word: a js_baseline.Inlined each, then
  // their values' cells (x64_frame_exit), 16-byte aligned from rsp.
  let leaveAt = ((inputs + own + inlined * INLINE_FRAME_WORDS * 8 + 8 + 15) / 16) * 16
  let mut leaveBytes: u32 = 0
  let mut leaving: usize = 0
  while on && leaving < function.exits.length() {
    let exit = function.exits.get(leaving)
    if exit.frames != 0 {
      let bytes = exit.frames * state.INLINED_BYTES + exit.inner * SLOT_BYTES
      if bytes > leaveBytes { leaveBytes = bytes }
    }
    leaving = leaving + 1
  }
  let mut raw = inputs + own + inlined * INLINE_FRAME_WORDS * 8 + 8 + pushes * 8
  if leaveBytes != 0 { raw = leaveAt + leaveBytes }
  // Frame mode's calls inside inlined bodies (callInBody): the call's operand cells (the
  // receiver, the function, the arguments), then a record with a frame pointer word for
  // each body around the deepest such call or poll (js_baseline.FRAME_BARE_INLINED).
  let mut bodyCells: u32 = 0
  let mut bodyDepth: u32 = 0
  let mut getters = false
  let mut calling: usize = 0
  while on && calling < function.insts.length() {
    let inst = function.insts.get(calling)
    // A field read that may call a getter (getterCall) takes the receiver and function cells.
    if inst.op == Op.GetField && inst.frame == 0 && (inst.k & FIELD_STEPS) != 0 && calling < steps.length() && steps.get(calling) != 0 {
      getters = true
      if bodyCells < 2 { bodyCells = 2 }
    }
    // A store that may call a setter (setterCall) takes those and the value's.
    if inst.op == Op.Call && calls.kindOf(inst) == compiled.SITE_PUT_FIELD && inst.frame == 0 && calling < steps.length() && steps.get(calling) != 0 {
      getters = true
      if bodyCells < 3 { bodyCells = 3 }
    }
    if (inst.op == Op.Call || inst.op == Op.Poll) && inst.exit != NONE && function.exit(inst.exit).frames != 0 {
      if inst.op == Op.Call && calls.countOf(inst) + 2 > bodyCells { bodyCells = calls.countOf(inst) + 2 }
      if function.exit(inst.exit).frames > bodyDepth { bodyDepth = function.exit(inst.exit).frames }
    }
    calling = calling + 1
  }
  let callAt = ((raw + 15) / 16) * 16
  let recordBytes = i32.wrappingToU32(0 - plan.record)
  if bodyDepth != 0 || getters { raw = callAt + bodyCells * SLOT_BYTES + bodyDepth * (recordBytes + 16) }
  let mut frame = u32.wrappingToI32(((raw + 15) / 16) * 16 - 8 - pushes * 8)
  if on { frame = plan.below + u32.wrappingToI32(((raw + 15) / 16) * 16) }
  let mut assembler = Assembler.make()
  let skipLabel = run assembler.label()
  let overflow = run assembler.label()
  let entered = run assembler.label()
  let copying = run assembler.label()
  let prologued = run assembler.label()
  let leaveOwn = run assembler.label()
  let leaveBuilt = run assembler.label()
  let mut emitter = Emitter { a: move assembler, blockLabels: List<Label>.make(), armLabels: List<Label>.make(), exitLabels: List<Label>.make(),
    resumeLabels: List<Label>.make(), savedValues: List<u32>.make(), savedStart: List<u32>.make(), frame: frame,
    scratch: u32.wrappingToI32(values * SLOT_BYTES), inputs: u32.wrappingToI32(inputs), settings: move settings, places: move places, fresh: NONE, freshAt: 0, freshBinds: 0, ownedCells: run function.ownedCells(), atoms: run function.linkedAtoms(),
    uses: List<u32>.make(), immediateUses: List<u32>.make(), defs: List<u32>.make(), constants: List<Option<i32>>.make(), current: 0, fields: objects.fieldLayout(),
    undoLabels: List<Label>.make(), undoInsts: List<Inst>.make(), zeroLabels: List<Label>.make(), zeroBacks: List<Label>.make(), zeroInsts: List<Inst>.make(), coldLabels: List<Label>.make(), coldBacks: List<Label>.make(), coldInsts: List<Inst>.make(), coldAux: List<u32>.make(), omitAt: NONE, elementAt: NONE, elementObject: NONE, elementIndex: NONE, cursor: 0, skipAt: NONE, skipLabel: skipLabel, dropAt: NONE, preset: List<u32>.make(), presetGuard: List<u32>.make(),
    inlineFrames: u32.wrappingToI32(inputs + own), inlineClosures: List<u32>.make(), frameOf: 0,
    on: on, plan: plan, methods: move methods, polls: List<PollSlow>.make(), outs: List<Out>.make(), overflow: overflow, constructAt: 0, entered: entered, copying: copying, prologued: prologued, leaveOwn: leaveOwn, leaveBuilt: leaveBuilt, exitWith: List<Label>.make(), records: List<Label>.make(), steps: move steps,
    realmAt: u32.wrappingToI32(inputs + own + inlined * INLINE_FRAME_WORDS * 8), shapes: move shapes, stored: List<u32>.make(),
    leaveAt: u32.wrappingToI32(leaveAt), leaveBytes: leaveBytes, callAt: callAt, bodyAt: callAt + bodyCells * SLOT_BYTES }
  run emitter.inlineClosures.appendRepeated(NONE, u32.toUsize(inlined))
  let mut own0: u32 = 0
  while own0 < values { run emitter.stored.append(own0) own0 = own0 + 1 }
  let mut n: usize = 0
  // Blocks are in an order where a definition comes before what it dominates.
  while on && n < function.insts.length() {
    let inst = function.insts.get(n)
    let mut from = NONE
    if inst.op == Op.Retain { from = inst.a }
    else if inst.op == Op.GetField { from = emitter.shapes.sameAs(usize.toU32(n)) }
    if from != NONE && from < values && inst.result != NONE && inst.result < values {
      let source = emitter.stored.get(u32.toUsize(from))
      emitter.stored.set(u32.toUsize(inst.result), source)
    }
    n = n + 1
  }
  n = 0
  while n < function.insts.length() {
    let inst = function.insts.get(n)
    if inst.op == Op.InlineFrame { let closure = emitter.storage(inst.a) emitter.inlineClosures.set(i32.toUsize(inst.k), closure) }
    n = n + 1
  }
  run emitter.countUses(&function)
  run emitter.presets(&function)
  let mut b: u32 = 0
  while b < function.blockCount() { run emitter.blockLabels.append(run emitter.a.label()) run emitter.armLabels.append(run emitter.a.label()) b = b + 1 }
  let mut x: usize = 0
  while x < function.exits.length() {
    run emitter.exitLabels.append(run emitter.a.label())
    run emitter.records.append(run emitter.a.label())
    if on { run emitter.exitWith.append(run emitter.a.label()) }
    x = x + 1
  }
  if on { run emitter.enter(&function) }
  else {
    r = 0
    while r < gprCount() { if emitter.saves(r) { run emitter.a.push(gprAt(r)) } r = r + 1 }
    if frame != 0 { run emitter.a.aluImm(Alu.Sub, Width.W64, Reg.Rsp, frame) }
    let mut k: u32 = 0
    while k < INPUT_COUNT { let at = emitter.input(k) run emitter.a.store(Width.W64, at, inputRegister(k)) k = k + 1 }
  }
  let mut c: usize = 0
  while !on && c < function.insts.length() {
    if function.insts.get(c).op == Op.Call { run emitter.resumeLabels.append(run emitter.a.label()) }
    c = c + 1
  }
  if emitter.resumeLabels.length() != 0 {
    let saved = run liveness.savedAcross(&function)
    let mut k: usize = 0
    while k < saved.length() {
      run emitter.savedStart.append(usize.toU32(emitter.savedValues.length()))
      run emitter.savedValues.appendSlice(saved.asSlice()[k].asSlice())
      k = k + 1
    }
    run emitter.savedStart.append(usize.toU32(emitter.savedValues.length()))
    run emitter.resume()
  }
  let mut offsets = List<u32>.make()
  b = 0
  while b < function.blockCount() {
    let block = function.blocks.get(u32.toUsize(b))
    emitter.current = b
    emitter.a.bind(emitter.blockLabels.get(u32.toUsize(b)))
    let mut i: u32 = 0
    while i < block.instCount {
      emitter.cursor = block.firstInst + i
      if emitter.settings.map { run offsets.append(usize.toU32(emitter.a.offset())) }
      if emitter.omitAt == block.firstInst + i { emitter.omitAt = NONE }
      else { run emitter.instruction(&function, function.inst(block.firstInst + i)) }
      if emitter.skipAt == block.firstInst + i { emitter.a.bind(emitter.skipLabel) emitter.skipAt = NONE }
      i = i + 1
    }
    b = b + 1
  }
  let mut u: usize = 0
  while u < emitter.undoInsts.length() {
    let inst = emitter.undoInsts.get(u)
    emitter.a.bind(emitter.undoLabels.get(u))
    let mut back = Alu.Add
    if inst.op == Op.Add { back = Alu.Sub }
    let place = emitter.at(inst.result)
    run emitter.operate(back, place.gpr, inst.b)
    run emitter.a.jmp(emitter.exitLabels.get(u32.toUsize(inst.exit)))
    u = u + 1
  }
  let mut z: usize = 0
  while z < emitter.zeroInsts.length() {
    let inst = emitter.zeroInsts.get(z)
    emitter.a.bind(emitter.zeroLabels.get(z))
    let place = emitter.at(inst.a) run getI32(&mut emitter.a, Reg.R9, place)
    run emitter.operate(Alu.Or, Reg.R9, inst.b)
    run emitter.a.jcc(Cond.Sign, emitter.exitLabels.get(u32.toUsize(inst.exit)))
    run emitter.a.jmp(emitter.zeroBacks.get(z))
    z = z + 1
  }
  run emitter.coldPieces(&function)
  let mut o: usize = 0
  while o < emitter.outs.length() {
    let out = emitter.outs.get(o)
    run emitter.out(&function, out)
    o = o + 1
  }
  if on { run emitter.frameTails(&function) }
  // Exit stubs: the interpreter state at each exit's bytecode boundary.
  emitter.frameOf = 0
  let map = emitter.settings.map
  if map { run offsets.append(usize.toU32(emitter.a.offset())) }
  run exits.emit(&mut emitter, &function)
  // The construct entry's offset, placed with the map's.
  if on { run offsets.append(emitter.constructAt) }
  let code = run emitter.a.finishPlaced(&mut offsets, 1)
  let mut construct: u32 = 0
  if on { construct = offsets.get(offsets.length() - 1) drop offsets.pop() }
  if map {
    let mut line = List<u8>.make()
    run line.appendSlice(b"jit: optimized map")
    let mut m: usize = 0
    while m < offsets.length() { run line.append(32) run ssa.number(&mut line, offsets.get(m)) m = m + 1 }
    run line.append(10)
    io.stderr(line.asSlice())
  }
  return Lowering.Code { value: move code, construct: construct }
}

/// The ABI inputs, in argument order: arguments, state, counter, data, env, frame.
pub const INPUT_COUNT: u32 = 6
pub const INPUT_ENV: u32 = 4
pub const INPUT_FRAME: u32 = 5
fn inputRegister(k: u32) -> Reg {
  if k == 0 { return Reg.Rdi }
  if k == 1 { return Reg.Rsi }
  if k == 2 { return Reg.Rdx }
  if k == 3 { return Reg.Rcx }
  if k == 4 { return Reg.R8 }
  return Reg.R9
}

/// The first reason function is outside what this backend lowers, or None.
fn supported(function: &Function, on: bool, stress: u32, steps: &List<u32>) -> Option<&'static [u8]> {
  if function.valueCount() > MAX_VALUES { return Option<&'static [u8]>.some(b"too many values") }
  if on && stress != 0 { return Option<&'static [u8]>.some(b"the stress configuration on a baseline frame") }
  let mut i: usize = 0
  while i < function.insts.length() {
    let inst = function.insts.get(i)
    if inst.op == Op.Removed { return Option<&'static [u8]>.some(b"uncompacted function") }
    // On a baseline frame the interpreter steps a generic instruction (stepOnFrame).
    if on && inst.op == Op.Call && calls.kindOf(inst) == compiled.SITE_CALL && (inst.k & calls.GENERIC) != 0 && (inst.frame != 0 || i >= steps.length() || steps.get(i) == 0) {
      return Option<&'static [u8]>.some(b"a generic instruction that is no plain step on a baseline frame")
    }
    if on && inst.op == Op.Call && calls.kindOf(inst) == compiled.SITE_CALL && (inst.k & calls.LAZY_ARGUMENTS) != 0 { return Option<&'static [u8]>.some(b"a lazy arguments call on a baseline frame") }
    if inst.op == Op.PutKey && (!on || inst.frame != 0) { return Option<&'static [u8]>.some(b"a keyed store off the function's own baseline frame") }
    if inst.op == Op.Call && calls.kindOf(inst) == compiled.SITE_ADD && (!on || inst.frame != 0) { return Option<&'static [u8]>.some(b"a concatenation off the function's own baseline frame") }
    i = i + 1
  }
  return Option<&'static [u8]>.none()
}

impl Emitter {
  pub fn saves(self: &Self, index: usize) -> bool { return u32.bitAnd(u32.shiftRight(self.places.savedMask, usize.toU32(index)), 1) != 0 }
  /// Where value v lives.
  fn at(self: &Self, v: u32) -> Place { return self.places.place(v, slotOf(v)) }
  effect fn instruction(self: &mut Self, function: &Function, given: Inst) -> () ! OutOfMemoryError ? &mut Allocator {
    let op = given.op
    self.frameOf = given.frame
    // Operands are read where their bits are (stored). A return asks whose count it hands
    // over, which is the copy's own: resultInto and valueInto find the bits themselves.
    let mut inst = given
    if self.on && op != Op.Return {
      if readsA(op) { inst.a = self.storage(inst.a) }
      if readsB(op) { inst.b = self.storage(inst.b) }
      if readsK(op) { inst.k = u32.wrappingToI32(self.storage(i32.wrappingToU32(inst.k))) }
    }
    if op == Op.CheckCallee {
      // A bytecode closure (tag, class) whose FunctionBytecode cell is the target's.
      run self.stressGuard(inst.exit)
      let layout = self.settings.layout
      let leave = self.exitLabels.get(u32.toUsize(inst.exit))
      run self.unlessTag(inst.a, layout.object(), leave)
      if self.exact(&function, i32.wrappingToU32(inst.k)) {
        // The one closure itself: an object at its address.
        let closure = self.symbol(i32.wrappingToU32(inst.k) * 3 + 2)
        let fresh = self.isFresh(inst.a)
        run self.a.movSymbol(Reg.Rax, closure)
        if fresh { run self.a.alu(Alu.Cmp, Width.W64, Reg.Rax, Reg.R9) } else { run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rax, payloadOf(inst.a)) }
        run self.a.jcc(Cond.NotEqual, leave)
        // A preset value holds no count from here on (presets): the read's goes back. It is
        // never the last: the code keeps the closure.
        if self.isPreset(inst.a) && function.value(inst.a).own == Own.Owned { run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rax, 0), 1) }
        return ()
      }
      run self.payloadInto(Reg.R11, inst.a)
      run self.a.loadZero16(Reg.Rax, Mem.at(Reg.R11, compiled.DIRECT_OBJECT_CLASS))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(compiled.DIRECT_BYTECODE_CLASS))
      run self.a.jcc(Cond.NotEqual, leave)
      let target = self.symbol(i32.wrappingToU32(inst.k) * 3)
      run self.a.movSymbol(Reg.Rax, target)
      run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rax, Mem.at(Reg.R11, compiled.DIRECT_CLOSURE_BYTECODE))
      run self.a.jcc(Cond.NotEqual, leave)
      return ()
    }
    if op == Op.IsCallee {
      // A test whose only reader is the branch right after it is that branch's flags.
      if self.fusedCallee(&function, inst) { return () }
      run self.a.movImm32(Reg.R9, 0)
      run self.calleeFlags(&function, inst)
      run self.a.setcc(Cond.Equal, Reg.R9)
      let place = self.at(inst.result) run putI32(&mut self.a, place, Reg.R9)
      return ()
    }
    // An inlined callee's frame is built where a helper needs it (frameInto): the inline
    // paths read its code and runtime without one.
    // Each block of the body names the closure again, as the value it is there.
    if op == Op.InlineFrame { self.inlineClosures.set(i32.toUsize(inst.k), inst.a) return () }
    if op == Op.Arg {
      // The caller's argument cell, copied (borrowed: no count).
      let at = i32.wrappingToU32(inst.k) * SLOT_BYTES
      let mut cells = Reg.Rdi
      if self.on {
        // The frame's arguments: the caller's cells or its own copy (STUB_PROLOGUE).
        let p = self.plan
        cells = Reg.R8
        run self.a.load(Width.W64, Reg.R8, p.sf(p.f.argumentsData))
      }
      run self.a.load(Width.W64, Reg.Rax, word(cells, at))
      run self.a.load(Width.W64, Reg.R9, word(cells, at + 8))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
      return ()
    }
    if op == Op.ConstI32 {
      if self.onlyImmediate(inst.result) { return () }
      let out = self.at(inst.result)
      if out.kind == GPR { run self.a.movImm32(out.gpr, i32.wrappingToU32(inst.k)) return () }
      run self.a.storeImm(Width.W64, slotOf(inst.result), 0)
      run self.a.storeImm(Width.W32, slotOf(inst.result), inst.k)
      return ()
    }
    if op == Op.Imm {
      let layout = self.settings.layout
      run self.a.movImm64(Reg.Rax, layout.tagWord(immTag(&layout, inst.k)))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.storeImm(Width.W64, payloadOf(inst.result), immPayload(inst.k))
      return ()
    }
    if op == Op.Unbox {
      run self.stressGuard(inst.exit)
      if self.on && function.value(inst.a).def != NONE && function.inst(function.value(inst.a).def).op == Op.Imm {
        // An exit that is always taken (ssa_translate.sideExit: a throw, an instruction
        // outside the subset in on-stack-replacement code): the baseline code runs the
        // instruction. No speculation failed, so it does not count against the code.
        run self.a.movImm32(Reg.Rcx, leaving.HOW_DECLINED)
        run self.a.jmp(self.exitWith.get(u32.toUsize(inst.exit)))
        return ()
      }
      let tag = self.settings.layout.int()
      if inst.k == UNBOX_EXACT {
        // An Int, or a Float64 that is exactly an int32 and not -0 (the interpreter's numbers
        // are one kind): a loop's entry guard (ssa_opt_hoist), for a value made by double
        // arithmetic, which the loop's own unbox of it would have taken as a double add.
        let floatTag = self.settings.layout.float64()
        let float = run self.a.label()
        let done = run self.a.label()
        let exit = self.exitLabels.get(u32.toUsize(inst.exit))
        run self.unlessTag(inst.a, tag, float)
        run self.a.load(Width.W32, Reg.Rax, payloadOf(inst.a))
        run self.a.jmp(done)
        self.a.bind(float)
        run self.unlessTag(inst.a, floatTag, exit)
        run self.a.loadDouble(Xmm.Xmm0, payloadOf(inst.a))
        run self.a.doubleToInt(Width.W32, Reg.Rax, Xmm.Xmm0)
        run self.a.intToDouble(Width.W32, Xmm.Xmm1, Reg.Rax)
        run self.a.packed(PackedOp.Ucomisd, Xmm.Xmm0, Xmm.Xmm1)
        run self.a.jcc(Cond.Parity, exit)
        run self.a.jcc(Cond.NotEqual, exit)
        run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
        run self.a.jcc(Cond.NotEqual, done)
        run self.a.load(Width.W64, Reg.R8, payloadOf(inst.a))
        run self.a.test(Width.W64, Reg.R8, Reg.R8)
        run self.a.jcc(Cond.Sign, exit)
        self.a.bind(done)
        run self.a.mov(Width.W32, Reg.Rax, Reg.Rax)
        let place = self.at(inst.result) run putI32(&mut self.a, place, Reg.Rax)
        return ()
      }
      run self.tagGuard(inst.a, tag, inst.exit)
      // A 32-bit load zero-extends: the place holds the i32.
      let out = self.at(inst.result)
      if out.kind == GPR && self.isFresh(inst.a) { run self.a.mov(Width.W32, out.gpr, Reg.R9) return () }
      if out.kind == GPR { run self.a.load(Width.W32, out.gpr, payloadOf(inst.a)) return () }
      run self.a.load(Width.W32, Reg.Rax, payloadOf(inst.a))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      return ()
    }
    if op == Op.UnboxBool {
      run self.stressGuard(inst.exit)
      let tag = self.settings.layout.boolean()
      run self.tagGuard(inst.a, tag, inst.exit)
      run self.a.loadZero8(Reg.Rax, payloadOf(inst.a))
      run self.a.aluImm(Alu.And, Width.W32, Reg.Rax, 1)
      let place101 = self.at(inst.result) run putI32(&mut self.a, place101, Reg.Rax)
      return ()
    }
    if op == Op.TagIs {
      // A test whose only reader is the branch right after it is that branch's flags.
      if self.fusedTag(&function, inst) { return () }
      let layout = self.settings.layout
      run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(inst.a * SLOT_BYTES + layout.tagOffset)))
      run self.a.movImm32(Reg.R9, 0)
      run self.a.movImm32(Reg.R10, 0)
      if (inst.k & 1) != 0 { run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.undefined())) run self.a.setcc(Cond.Equal, Reg.R9) }
      if (inst.k & 2) != 0 { run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.null())) run self.a.setcc(Cond.Equal, Reg.R10) }
      run self.a.alu(Alu.Or, Width.W32, Reg.R9, Reg.R10)
      if (inst.k & 4) != 0 {
        run self.a.movImm32(Reg.R10, 0)
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.uninitialized())) run self.a.setcc(Cond.Equal, Reg.R10)
        run self.a.alu(Alu.Or, Width.W32, Reg.R9, Reg.R10)
      }
      let place = self.at(inst.result) run putI32(&mut self.a, place, Reg.R9)
      return ()
    }
    if op == Op.TypeofAtom {
      run self.stressGuard(inst.exit)
      // typeof(env, frame, value) -> atom, 0 for a proxy.
      run self.ownFrame(Reg.Rsi)
      run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.a))
      run self.callHelper(helpers.TYPEOF)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
      let place = self.at(inst.result) run putI32(&mut self.a, place, Reg.Rax)
      return ()
    }
    if op == Op.Equals {
      // Lowered at the branch that reads it (fusedEquals).
      if self.fusedEquals(&function, given) { return () }
      run self.stressGuard(inst.exit)
      let answered = run self.a.label()
      let helper = run self.a.label()
      if self.on { run self.equalsInPlace(inst.a, inst.b, inst.k == 1, answered, helper, false, answered) }
      self.a.bind(helper)
      // equals(env, left, right, strict) -> 0 or 1, 2 to decline.
      run self.a.lea(Width.W64, Reg.Rsi, slotOf(inst.a))
      run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.b))
      run self.a.movImm32(Reg.Rcx, i32.wrappingToU32(inst.k))
      run self.callHelper(helpers.EQUALS)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 2)
      run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
      self.a.bind(answered)
      let place = self.at(inst.result) run putI32(&mut self.a, place, Reg.Rax)
      return ()
    }
    if op == Op.InstanceOf {
      run self.stressGuard(inst.exit)
      // instanceof(env, frame, left, right) -> 0 or 1, 2 to decline.
      run self.ownFrame(Reg.Rsi)
      run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.a))
      run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.b))
      run self.callHelper(helpers.INSTANCEOF)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 2)
      run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
      let place = self.at(inst.result) run putI32(&mut self.a, place, Reg.Rax)
      return ()
    }
    if op == Op.BoxI32 || op == Op.BoxBool {
      // The trusted store right after it boxes into the element itself (storedBox).
