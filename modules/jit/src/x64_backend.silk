      let mut work = Reg.Rax
      if out.kind == GPR && self.key(inst.a) != self.key(inst.result) && self.key(inst.b) != self.key(inst.result) { work = out.gpr }
      let place5 = self.at(inst.a) run getI32(&mut self.a, work, place5)
      run self.stressGuard(inst.exit)
      let place6 = self.at(inst.b)
      if place6.kind == GPR { run self.a.imul(Width.W32, work, place6.gpr) } else { run self.a.imulLoad(Width.W32, work, place6.mem) }
