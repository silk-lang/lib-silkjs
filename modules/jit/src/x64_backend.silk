      // is elsewhere: the exit reads the operand, so an overflow undoes the operation first.
      let into = self.at(inst.result)
      let constantB = self.constants.get(u32.toUsize(inst.b)).isSome()
      // An add whose result takes the second operand's register runs there the same way,
      // with its operands the other way round.
      let mut turned = inst
      if op == Op.Add && into.kind == GPR && !constantB && self.key(inst.b) == self.key(inst.result) && self.key(inst.a) != self.key(inst.result)
        && self.constants.get(u32.toUsize(inst.a)).isNone() { turned.a = inst.b turned.b = inst.a }
      let turnedConstant = self.constants.get(u32.toUsize(turned.b)).isSome()
      if into.kind == GPR && self.key(turned.a) == self.key(turned.result) && (turnedConstant || self.key(turned.b) != self.key(turned.result)) {
        run self.operate(alu, into.gpr, turned.b)
        let undo = run self.a.label()
        run self.a.jcc(Cond.Overflow, undo)
        run self.undoLabels.append(undo)
        run self.undoInsts.append(turned)
        return ()
      }
      if into.kind == GPR && (turnedConstant || self.key(turned.b) != self.key(turned.result)) {
        // The result's register holds neither operand: the operation runs there, and an
        // overflow leaves with both operands where they were.
