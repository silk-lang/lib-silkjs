//! A first x86-64 backend for the SSA form (docs/jit/ssa.md) under the compiled-entry ABI
//! (docs/jit/compiled-entry.md, js_compiled.CompiledCode):
//!   extern "C" fn(arguments: *const ValueBits, state: *mut u64, counter: *mut i32, data: ?*mut u8,
//!     env: ?*mut CompiledEnv, frame: *const CompiledFrame) -> u32
//! Integers, bools and doubles live in registers where x64_regalloc finds one, else in their
//! slot; a boxed `value` always lives in its slot. Every instruction reads its operands into
//! scratch registers, computes there, and writes its result last, after any exit. An edge is a
//! parallel move from its arguments' places to the target's parameters'.
//!
//! Values. Every SSA value has a 16-byte slot. An i32 value's slot holds it zero-extended in
//! its first word, a bool 0 or 1. A boxed `value` is a ValueBits in the engine's own layout
//! (value_layout.ValueLayout, probed from the engine): the arguments are the caller's cells,
//! the exit state and the return value are ValueBits the engine takes over as they are.
//! Counts are real: `retain` adds one inline when the value is a heap reference (all
//! HeapCell.retain does), `release` calls the engine's deferred release through the helper
//! table, a `move` exit slot or `return` hands the count over, and a `dup` slot adds one.
//!
//! The six ABI inputs are stored in fixed frame slots by the prologue; a helper call clobbers
//! the caller-saved registers, so after one the code reloads arguments, state, counter and data.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.num.i32
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.core.option { Option }
import asm_x64 { Alu, Assembler, Code, Cond, Label, Mem, Reg, Scale, Shift, Unary, UnboundLabelError, Width, Xmm }
import ssa { Function, Inst, Op, Type, Own, SlotMode, NONE, isNumberOp, numberOpReadsB, readsK }
import ssa
import value_layout { ValueLayout }
import x64_backend_float as float
import x64_regalloc { Allocation, Place, GPR, XMM, getI32, putI32, aluWith, getF64, putF64, getBits, putBits, gprAt, gprCount }
import x64_regalloc as regalloc
import ssa_calls as calls
import jit_helpers as helpers
import silkjs.js_compiled as compiled
import silkjs.js_compiled_objects { FieldLayout }
import silkjs.js_compiled_objects as objects
import silkjs.js_class_data as classes
import ssa_liveness as liveness
import ssa_calls as calls
import x64_exits as exits

/// Bytes per SSA value slot and per ValueBits.
pub const SLOT_BYTES: u32 = 16
/// js_compiled.EXIT_*.
const EXIT_RETURNED: u32 = 0
const EXIT_DEOPT: u32 = 1
const EXIT_POLL: u32 = 2
const EXIT_THROW: u32 = 3
const EXIT_CALL: u32 = 4
/// js_compiled.CompiledFrame.calls's offset (its seventh pointer).
const FRAME_CALLS: i32 = 48
/// CompiledFrame.code's offset (its eighth pointer).
const FRAME_CODE: i32 = 56
/// CompiledFrame.runtime's offset (its fourth pointer).
const FRAME_RUNTIME: i32 = 24
/// Frame words of one inlined callee: its CompiledFrame.
const INLINE_FRAME_WORDS: u32 = 9
/// More values than this would make the frame larger than is sensible for a first tier.
const MAX_VALUES: u32 = 65536

/// Why a function was not lowered.
pub struct Unsupported { pub why: &'static [u8] }
pub union Lowering { Code { pub value: Code }, Unsupported { pub reason: Unsupported } }

/// Options of one lowering.
pub struct Settings {
  /// Every guard first counts down the i32 at `data` and fails when it reaches zero,
  /// resetting it to stress (the deopt-stress configuration). 0: off.
  pub stress: u32,
  /// Where the engine keeps a ValueBits' tag and payload.
  pub layout: ValueLayout
}

pub struct Emitter {
  pub a: Assembler,
  pub blockLabels: List<Label>,
  pub exitLabels: List<Label>,
  /// Where each call resumes, in instruction order (resume point k + 1 is call k).
  pub resumeLabels: List<Label>,
  /// What each call saves in its call block (ssa_liveness.savedAcross): call k's values are
  /// savedValues[savedStart[k] .. savedStart[k + 1]].
  pub savedValues: List<u32>,
  pub savedStart: List<u32>,
  /// Bytes of the frame below the return address: values, then the edge scratch area.
  pub frame: i32,
  pub scratch: i32,
  /// The frame slots holding the six ABI inputs, from rsp.
  pub inputs: i32,
  pub settings: Settings,
  /// Where each value lives (x64_regalloc).
  pub places: Allocation,
  /// Where an object keeps its shape and slots (inline field access).
  fields: FieldLayout,
  /// Per value: its reads (operands, edge arguments, exit slots; an over-count only costs
  /// speed), the reads that take it as an immediate, and the instruction defining it or NONE.
  uses: List<u32>,
  immediateUses: List<u32>,
  defs: List<u32>,
  /// Per value: its constant when a `const.i32` defines it.
  pub constants: List<Option<i32>>,
  /// The block being lowered: a jump to the next one falls through.
  current: u32,
  /// The instruction being lowered, and the one a label is bound after (NONE: none): where
  /// a get.elem that loaded its number itself skips its unbox (fusedUnbox).
  cursor: u32,
  skipAt: u32,
  skipLabel: Label,
  /// `add.i32`/`sub.i32` done in place (result and first operand in one register): on
  /// overflow each jumps to its label here, where the operation is undone before the exit
  /// reads the operand.
  undoLabels: List<Label>,
  undoInsts: List<Inst>,
  /// Where the inlined callees' CompiledFrames start, from rsp: INLINE_FRAME_WORDS words each.
  inlineFrames: i32,
  /// The closure value each inlined callee's `inline.frame` names, by frame number less one.
  inlineClosures: List<u32>,
  /// Inst.frame of the instruction being lowered: whose frame, code and closure it runs for.
  frameOf: u32,
}

pub fn slotOf(v: u32) -> Mem { return Mem.at(Reg.Rsp, u32.wrappingToI32(v * SLOT_BYTES)) }
/// The second word of a value's slot: a ValueBits' payload.
pub fn payloadOf(v: u32) -> Mem { return Mem.at(Reg.Rsp, u32.wrappingToI32(v * SLOT_BYTES + 8)) }
pub fn word(base: Reg, offset: u32) -> Mem { return Mem.at(base, u32.wrappingToI32(offset)) }

/// Lowers function, which must be compacted and verified.
pub effect fn lower(function: &Function, settings: Settings) -> Lowering ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  match supported(&function) {
    Option<&'static [u8]>.Some { value } => { return Lowering.Unsupported { reason: Unsupported { why: value } } }
    Option<&'static [u8]>.None => ()
  }
  let values = function.valueCount()
  let places = run regalloc.allocate(&function)
  let mut pushes: u32 = 0
  let mut r: usize = 0
  while r < gprCount() { if u32.bitAnd(u32.shiftRight(places.savedMask, usize.toU32(r)), 1) != 0 { pushes = pushes + 1 } r = r + 1 }
  // The value slots, the edge moves' scratch slot, then the six ABI inputs; 16-byte aligned
  // at calls below the return address and the saved registers.
  let inputs = (values + 1) * SLOT_BYTES
  let inlined = usize.toU32(function.inlineTargets.length())
  let raw = inputs + INPUT_COUNT * 8 + inlined * INLINE_FRAME_WORDS * 8 + 8 + pushes * 8
  let frame = u32.wrappingToI32(((raw + 15) / 16) * 16 - 8 - pushes * 8)
  let mut assembler = Assembler.make()
  let skipLabel = run assembler.label()
  let mut emitter = Emitter { a: move assembler, blockLabels: List<Label>.make(), exitLabels: List<Label>.make(),
    resumeLabels: List<Label>.make(), savedValues: List<u32>.make(), savedStart: List<u32>.make(), frame: frame,
    scratch: u32.wrappingToI32(values * SLOT_BYTES), inputs: u32.wrappingToI32(inputs), settings: move settings, places: move places,
    uses: List<u32>.make(), immediateUses: List<u32>.make(), defs: List<u32>.make(), constants: List<Option<i32>>.make(), current: 0, fields: objects.fieldLayout(),
    undoLabels: List<Label>.make(), undoInsts: List<Inst>.make(), cursor: 0, skipAt: NONE, skipLabel: skipLabel,
    inlineFrames: u32.wrappingToI32(inputs + INPUT_COUNT * 8), inlineClosures: List<u32>.make(), frameOf: 0 }
  run emitter.inlineClosures.appendRepeated(NONE, u32.toUsize(inlined))
  let mut n: usize = 0
  while n < function.insts.length() {
    let inst = function.insts.get(n)
    if inst.op == Op.InlineFrame { emitter.inlineClosures.set(i32.toUsize(inst.k), inst.a) }
    n = n + 1
  }
  run emitter.countUses(&function)
  let mut b: u32 = 0
  while b < function.blockCount() { run emitter.blockLabels.append(run emitter.a.label()) b = b + 1 }
  let mut x: usize = 0
  while x < function.exits.length() { run emitter.exitLabels.append(run emitter.a.label()) x = x + 1 }
  r = 0
  while r < gprCount() { if emitter.saves(r) { run emitter.a.push(gprAt(r)) } r = r + 1 }
  if frame != 0 { run emitter.a.aluImm(Alu.Sub, Width.W64, Reg.Rsp, frame) }
  let mut k: u32 = 0
  while k < INPUT_COUNT { let at = emitter.input(k) run emitter.a.store(Width.W64, at, inputRegister(k)) k = k + 1 }
  let mut c: usize = 0
  while c < function.insts.length() {
    if function.insts.get(c).op == Op.Call { run emitter.resumeLabels.append(run emitter.a.label()) }
    c = c + 1
  }
  if emitter.resumeLabels.length() != 0 {
    let saved = run liveness.savedAcross(&function)
    let mut k: usize = 0
    while k < saved.length() {
      run emitter.savedStart.append(usize.toU32(emitter.savedValues.length()))
      run emitter.savedValues.appendSlice(saved.asSlice()[k].asSlice())
      k = k + 1
    }
    run emitter.savedStart.append(usize.toU32(emitter.savedValues.length()))
    run emitter.resume()
  }
  b = 0
  while b < function.blockCount() {
    let block = function.blocks.get(u32.toUsize(b))
    emitter.current = b
    emitter.a.bind(emitter.blockLabels.get(u32.toUsize(b)))
    let mut i: u32 = 0
    while i < block.instCount {
      emitter.cursor = block.firstInst + i
      run emitter.instruction(&function, function.inst(block.firstInst + i))
      if emitter.skipAt == block.firstInst + i { emitter.a.bind(emitter.skipLabel) emitter.skipAt = NONE }
      i = i + 1
    }
    b = b + 1
  }
  let mut u: usize = 0
  while u < emitter.undoInsts.length() {
    let inst = emitter.undoInsts.get(u)
    emitter.a.bind(emitter.undoLabels.get(u))
    let mut back = Alu.Add
    if inst.op == Op.Add { back = Alu.Sub }
    let place = emitter.at(inst.result)
    run emitter.operate(back, place.gpr, inst.b)
    run emitter.a.jmp(emitter.exitLabels.get(u32.toUsize(inst.exit)))
    u = u + 1
  }
  // Exit stubs: the interpreter state at each exit's bytecode boundary.
  emitter.frameOf = 0
  run exits.emit(&mut emitter, &function)
  return Lowering.Code { value: run emitter.a.finish() }
}

/// The ABI inputs, in argument order: arguments, state, counter, data, env, frame.
pub const INPUT_COUNT: u32 = 6
pub const INPUT_ENV: u32 = 4
pub const INPUT_FRAME: u32 = 5
fn inputRegister(k: u32) -> Reg {
  if k == 0 { return Reg.Rdi }
  if k == 1 { return Reg.Rsi }
  if k == 2 { return Reg.Rdx }
  if k == 3 { return Reg.Rcx }
  if k == 4 { return Reg.R8 }
  return Reg.R9
}

/// The first reason function is outside what this backend lowers, or None.
fn supported(function: &Function) -> Option<&'static [u8]> {
  if function.valueCount() > MAX_VALUES { return Option<&'static [u8]>.some(b"too many values") }
  let mut i: usize = 0
  while i < function.insts.length() {
    let inst = function.insts.get(i)
    if inst.op == Op.Removed { return Option<&'static [u8]>.some(b"uncompacted function") }
    i = i + 1
  }
  return Option<&'static [u8]>.none()
}

impl Emitter {
  pub fn saves(self: &Self, index: usize) -> bool { return u32.bitAnd(u32.shiftRight(self.places.savedMask, usize.toU32(index)), 1) != 0 }
  /// Where value v lives.
  fn at(self: &Self, v: u32) -> Place { return self.places.place(v, slotOf(v)) }
  effect fn instruction(self: &mut Self, function: &Function, inst: Inst) -> () ! OutOfMemoryError ? &mut Allocator {
    let op = inst.op
    self.frameOf = inst.frame
    if op == Op.CheckCallee {
      // A bytecode closure (tag, class) whose FunctionBytecode cell is the target's.
      run self.stressGuard(inst.exit)
      let layout = self.settings.layout
      let leave = self.exitLabels.get(u32.toUsize(inst.exit))
      run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(inst.a * SLOT_BYTES + layout.tagOffset)))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.object()))
      run self.a.jcc(Cond.NotEqual, leave)
      run self.a.load(Width.W64, Reg.R11, payloadOf(inst.a))
      run self.a.loadZero16(Reg.Rax, Mem.at(Reg.R11, compiled.DIRECT_OBJECT_CLASS))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(compiled.DIRECT_BYTECODE_CLASS))
      run self.a.jcc(Cond.NotEqual, leave)
      run self.a.movSymbol(Reg.Rax, i32.wrappingToU32(inst.k) * 2)
      run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rax, Mem.at(Reg.R11, compiled.DIRECT_CLOSURE_BYTECODE))
      run self.a.jcc(Cond.NotEqual, leave)
      return ()
    }
    // An inlined callee's frame is built where a helper needs it (frameInto): the inline
    // paths read its code and runtime without one.
    if op == Op.InlineFrame { return () }
    if op == Op.Arg {
      // The caller's argument cell, copied (borrowed: no count).
      let at = i32.wrappingToU32(inst.k) * SLOT_BYTES
      run self.a.load(Width.W64, Reg.Rax, word(Reg.Rdi, at))
      run self.a.load(Width.W64, Reg.R9, word(Reg.Rdi, at + 8))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
      return ()
    }
    if op == Op.ConstI32 {
      if self.onlyImmediate(inst.result) { return () }
      let out = self.at(inst.result)
      if out.kind == GPR { run self.a.movImm32(out.gpr, i32.wrappingToU32(inst.k)) return () }
      run self.a.storeImm(Width.W64, slotOf(inst.result), 0)
      run self.a.storeImm(Width.W32, slotOf(inst.result), inst.k)
      return ()
    }
    if op == Op.Imm {
      let layout = self.settings.layout
      run self.a.movImm64(Reg.Rax, layout.tagWord(immTag(&layout, inst.k)))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.storeImm(Width.W64, payloadOf(inst.result), immPayload(inst.k))
      return ()
    }
    if op == Op.Unbox {
      run self.stressGuard(inst.exit)
      let tag = self.settings.layout.int()
      run self.tagGuard(inst.a, tag, inst.exit)
      // A 32-bit load zero-extends: the place holds the i32.
      let out = self.at(inst.result)
      if out.kind == GPR { run self.a.load(Width.W32, out.gpr, payloadOf(inst.a)) return () }
      run self.a.load(Width.W32, Reg.Rax, payloadOf(inst.a))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      return ()
    }
    if op == Op.UnboxBool {
      run self.stressGuard(inst.exit)
      let tag = self.settings.layout.boolean()
      run self.tagGuard(inst.a, tag, inst.exit)
      run self.a.loadZero8(Reg.Rax, payloadOf(inst.a))
      run self.a.aluImm(Alu.And, Width.W32, Reg.Rax, 1)
      let place101 = self.at(inst.result) run putI32(&mut self.a, place101, Reg.Rax)
      return ()
    }
    if op == Op.TagIs {
      let layout = self.settings.layout
      run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(inst.a * SLOT_BYTES + layout.tagOffset)))
      run self.a.movImm32(Reg.R9, 0)
      run self.a.movImm32(Reg.R10, 0)
      if (inst.k & 1) != 0 { run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.undefined())) run self.a.setcc(Cond.Equal, Reg.R9) }
      if (inst.k & 2) != 0 { run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.null())) run self.a.setcc(Cond.Equal, Reg.R10) }
      run self.a.alu(Alu.Or, Width.W32, Reg.R9, Reg.R10)
      let place = self.at(inst.result) run putI32(&mut self.a, place, Reg.R9)
      return ()
    }
    if op == Op.TypeofAtom {
      run self.stressGuard(inst.exit)
      // typeof(env, frame, value) -> atom, 0 for a proxy.
      let frame = self.input(INPUT_FRAME)
      run self.a.load(Width.W64, Reg.Rsi, frame)
      run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.a))
      run self.callHelper(helpers.TYPEOF)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
      let place = self.at(inst.result) run putI32(&mut self.a, place, Reg.Rax)
      return ()
    }
    if op == Op.Equals {
      run self.stressGuard(inst.exit)
      // equals(env, left, right, strict) -> 0 or 1, 2 to decline.
      run self.a.lea(Width.W64, Reg.Rsi, slotOf(inst.a))
      run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.b))
      run self.a.movImm32(Reg.Rcx, i32.wrappingToU32(inst.k))
      run self.callHelper(helpers.EQUALS)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 2)
      run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
      let place = self.at(inst.result) run putI32(&mut self.a, place, Reg.Rax)
      return ()
    }
    if op == Op.InstanceOf {
      run self.stressGuard(inst.exit)
      // instanceof(env, frame, left, right) -> 0 or 1, 2 to decline.
      let frame = self.input(INPUT_FRAME)
      run self.a.load(Width.W64, Reg.Rsi, frame)
      run self.a.lea(Width.W64, Reg.Rdx, slotOf(inst.a))
      run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.b))
      run self.callHelper(helpers.INSTANCEOF)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 2)
      run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
      let place = self.at(inst.result) run putI32(&mut self.a, place, Reg.Rax)
      return ()
    }
    if op == Op.BoxI32 || op == Op.BoxBool {
      let place1 = self.at(inst.a) run getI32(&mut self.a, Reg.Rax, place1)
      run self.boxInto(op == Op.BoxBool, Reg.Rax, Reg.Rsp, inst.result * SLOT_BYTES)
      return ()
    }
    if op == Op.Add || op == Op.Sub {
      run self.stressGuard(inst.exit)
      let mut alu = Alu.Sub
      if op == Op.Add { alu = Alu.Add }
      // In place when the result takes the first operand's register and the second operand
      // is elsewhere: the exit reads the operand, so an overflow undoes the operation first.
      let into = self.at(inst.result)
      if into.kind == GPR && self.key(inst.a) == self.key(inst.result) && (self.constants.get(u32.toUsize(inst.b)).isSome() || self.key(inst.b) != self.key(inst.result)) {
        run self.operate(alu, into.gpr, inst.b)
        let undo = run self.a.label()
        run self.a.jcc(Cond.Overflow, undo)
        run self.undoLabels.append(undo)
        run self.undoInsts.append(inst)
        return ()
      }
      let place2 = self.at(inst.a) run getI32(&mut self.a, Reg.Rax, place2)
      run self.operate(alu, Reg.Rax, inst.b)
      run self.a.jcc(Cond.Overflow, self.exitLabels.get(u32.toUsize(inst.exit)))
      let place102 = self.at(inst.result) run putI32(&mut self.a, place102, Reg.Rax)
      return ()
    }
    if op == Op.Mul {
      let place5 = self.at(inst.a) run getI32(&mut self.a, Reg.Rax, place5)
      let place6 = self.at(inst.b) run getI32(&mut self.a, Reg.R8, place6)
      run self.stressGuard(inst.exit)
      // -0: a zero product with a negative operand, which (a | b) < 0 detects.
      run self.a.mov(Width.W32, Reg.R9, Reg.Rax)
      run self.a.alu(Alu.Or, Width.W32, Reg.R9, Reg.R8)
      run self.a.imul(Width.W32, Reg.Rax, Reg.R8)
      run self.a.jcc(Cond.Overflow, self.exitLabels.get(u32.toUsize(inst.exit)))
      let fine = run self.a.label()
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.NotEqual, fine)
      run self.a.test(Width.W32, Reg.R9, Reg.R9)
      run self.a.jcc(Cond.Sign, self.exitLabels.get(u32.toUsize(inst.exit)))
      self.a.bind(fine)
      run self.a.mov(Width.W32, Reg.Rax, Reg.Rax)
      let place103 = self.at(inst.result) run putI32(&mut self.a, place103, Reg.Rax)
      return ()
    }
    if op == Op.Cmp {
      // A compare whose only reader is the branch right after it is that branch's flags.
      if self.fusedCompare(&function, inst) { return () }
      run self.a.movImm32(Reg.R9, 0)
      run self.compare(inst)
      run self.a.setcc(condition(inst.k), Reg.R9)
      let place104 = self.at(inst.result) run putI32(&mut self.a, place104, Reg.R9)
      return ()
    }
    if op == Op.Retain {
      run self.a.load(Width.W64, Reg.Rax, slotOf(inst.a))
      run self.a.load(Width.W64, Reg.R9, payloadOf(inst.a))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
      // A borrowed copy (ssa_ownership.borrowFields) takes no count.
      if function.value(inst.result).own != Own.Borrowed { run self.retainBits(Reg.Rax, Reg.R9) }
      return ()
    }
    if op == Op.Release { run self.releaseValue(inst.a) return () }
    if op == Op.UnboxF64 {
      // An Int converts exactly (cvtsi2sd of the signed i32), a Float64 is its payload bits.
      run self.stressGuard(inst.exit)
      let layout = self.settings.layout
      let notInt = run self.a.label()
      let done = run self.a.label()
      run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(inst.a * SLOT_BYTES + layout.tagOffset)))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.int()))
      run self.a.jcc(Cond.NotEqual, notInt)
      run self.a.load(Width.W32, Reg.Rax, payloadOf(inst.a))
      run self.a.intToDouble(Width.W32, Xmm.Xmm0, Reg.Rax)
      let place105 = self.at(inst.result) run putF64(&mut self.a, place105, Xmm.Xmm0)
      run self.a.jmp(done)
      self.a.bind(notInt)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.float64()))
      run self.a.jcc(Cond.NotEqual, self.exitLabels.get(u32.toUsize(inst.exit)))
      run self.a.load(Width.W64, Reg.Rax, payloadOf(inst.a))
