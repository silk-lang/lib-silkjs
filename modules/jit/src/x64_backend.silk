//! A first x86-64 backend for the SSA form (docs/jit/ssa.md) under the compiled-entry ABI
//! (docs/jit/compiled-entry.md, js_compiled.CompiledCode):
//!   extern "C" fn(arguments: *const ValueBits, state: *mut u64, counter: *mut i32, data: ?*mut u8,
//!     env: ?*mut CompiledEnv, frame: *const CompiledFrame) -> u32
//! Correctness and the deoptimization path come first, code quality later: every SSA value
//! lives in its own 8-byte stack slot, every instruction loads its operands into scratch
//! registers and stores its result, and an edge copies its arguments through a scratch area
//! into the target's parameters (a parallel move). No register allocation.
//!
//! Values. Every SSA value has a 16-byte slot. An i32 value's slot holds it zero-extended in
//! its first word, a bool 0 or 1. A boxed `value` is a ValueBits in the engine's own layout
//! (value_layout.ValueLayout, probed from the engine): the arguments are the caller's cells,
//! the exit state and the return value are ValueBits the engine takes over as they are.
//! Counts are real: `retain` adds one inline when the value is a heap reference (all
//! HeapCell.retain does), `release` calls the engine's deferred release through the helper
//! table, a `move` exit slot or `return` hands the count over, and a `dup` slot adds one.
//!
//! The six ABI inputs are stored in fixed frame slots by the prologue; a helper call clobbers
//! the caller-saved registers, so after one the code reloads arguments, state, counter and data.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.num.i32
import silk.num.u32
import silk.num.u8
import silk.num.usize
import silk.core.option { Option }
import asm_x64 { Alu, Assembler, Code, Cond, Label, Mem, Reg, Shift, UnboundLabelError, Width }
import ssa { Function, Inst, Op, Type, Own, SlotMode }
import value_layout { ValueLayout }
import jit_helpers as helpers

/// Bytes per SSA value slot and per ValueBits.
pub const SLOT_BYTES: u32 = 16
/// js_compiled.EXIT_*.
const EXIT_RETURNED: u32 = 0
const EXIT_DEOPT: u32 = 1
const EXIT_POLL: u32 = 2
/// More values than this would make the frame larger than is sensible for a first tier.
const MAX_VALUES: u32 = 65536

/// Why a function was not lowered.
pub struct Unsupported { pub why: &'static [u8] }
pub union Lowering { Code { pub value: Code }, Unsupported { pub reason: Unsupported } }

/// Options of one lowering.
pub struct Settings {
  /// Every guard first counts down the i32 at `data` and fails when it reaches zero,
  /// resetting it to stress (the deopt-stress configuration). 0: off.
  pub stress: u32,
  /// Where the engine keeps a ValueBits' tag and payload.
  pub layout: ValueLayout
}

pub struct Emitter {
  pub a: Assembler,
  pub blockLabels: List<Label>,
  pub exitLabels: List<Label>,
  /// Bytes of the frame below the return address: values, then the edge scratch area.
  pub frame: i32,
  pub scratch: i32,
  /// The frame slots holding the six ABI inputs, from rsp.
  pub inputs: i32,
  pub settings: Settings
}

pub fn slotOf(v: u32) -> Mem { return Mem.at(Reg.Rsp, u32.wrappingToI32(v * SLOT_BYTES)) }
/// The second word of a value's slot: a ValueBits' payload.
pub fn payloadOf(v: u32) -> Mem { return Mem.at(Reg.Rsp, u32.wrappingToI32(v * SLOT_BYTES + 8)) }
pub fn word(base: Reg, offset: u32) -> Mem { return Mem.at(base, u32.wrappingToI32(offset)) }

/// Lowers function, which must be compacted and verified.
pub effect fn lower(function: &Function, settings: Settings) -> Lowering ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  match supported(&function) {
    Option<&'static [u8]>.Some { value } => { return Lowering.Unsupported { reason: Unsupported { why: value } } }
    Option<&'static [u8]>.None => ()
  }
  let values = function.valueCount()
  let mut widest: u32 = 0
  let mut e: usize = 0
  while e < function.edges.length() {
    let edge = function.edges.get(e)
    if edge.argCount > widest { widest = edge.argCount }
    e = e + 1
  }
  // 16-byte aligned at calls: entry rsp is 8 below a multiple of 16.
  let inputs = (values + widest) * SLOT_BYTES
  let raw = inputs + INPUT_COUNT * 8 + 8
  let frame = u32.wrappingToI32(((raw + 15) / 16) * 16 - 8)
  let mut emitter = Emitter { a: Assembler.make(), blockLabels: List<Label>.make(), exitLabels: List<Label>.make(),
    frame: frame, scratch: u32.wrappingToI32(values * SLOT_BYTES), inputs: u32.wrappingToI32(inputs), settings: move settings }
  let mut b: u32 = 0
  while b < function.blockCount() { run emitter.blockLabels.append(run emitter.a.label()) b = b + 1 }
  let mut x: usize = 0
  while x < function.exits.length() { run emitter.exitLabels.append(run emitter.a.label()) x = x + 1 }
  if frame != 0 { run emitter.a.aluImm(Alu.Sub, Width.W64, Reg.Rsp, frame) }
  let mut k: u32 = 0
  while k < INPUT_COUNT { let at = emitter.input(k) run emitter.a.store(Width.W64, at, inputRegister(k)) k = k + 1 }
  b = 0
  while b < function.blockCount() {
    let block = function.blocks.get(u32.toUsize(b))
    emitter.a.bind(emitter.blockLabels.get(u32.toUsize(b)))
    let mut i: u32 = 0
    while i < block.instCount {
      run emitter.instruction(&function, function.inst(block.firstInst + i))
      i = i + 1
    }
    b = b + 1
  }
  // Exit stubs: the interpreter state at each exit's bytecode boundary.
  x = 0
  while x < function.exits.length() {
    run emitter.exitStub(&function, usize.toU32(x))
    x = x + 1
  }
  return Lowering.Code { value: run emitter.a.finish() }
}

/// The ABI inputs, in argument order: arguments, state, counter, data, env, frame.
pub const INPUT_COUNT: u32 = 6
pub const INPUT_ENV: u32 = 4
pub const INPUT_FRAME: u32 = 5
fn inputRegister(k: u32) -> Reg {
  if k == 0 { return Reg.Rdi }
  if k == 1 { return Reg.Rsi }
  if k == 2 { return Reg.Rdx }
  if k == 3 { return Reg.Rcx }
  if k == 4 { return Reg.R8 }
  return Reg.R9
}

/// The first reason function is outside what this backend lowers, or None.
fn supported(function: &Function) -> Option<&'static [u8]> {
  if function.valueCount() > MAX_VALUES { return Option<&'static [u8]>.some(b"too many values") }
  let mut i: usize = 0
  while i < function.insts.length() {
    let inst = function.insts.get(i)
    if inst.op == Op.Removed { return Option<&'static [u8]>.some(b"uncompacted function") }
    i = i + 1
  }
  return Option<&'static [u8]>.none()
}

impl Emitter {
  effect fn instruction(self: &mut Self, function: &Function, inst: Inst) -> () ! OutOfMemoryError ? &mut Allocator {
    let op = inst.op
    if op == Op.Arg {
      // The caller's argument cell, copied (borrowed: no count).
      let at = i32.wrappingToU32(inst.k) * SLOT_BYTES
      run self.a.load(Width.W64, Reg.Rax, word(Reg.Rdi, at))
      run self.a.load(Width.W64, Reg.R9, word(Reg.Rdi, at + 8))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
      return ()
    }
    if op == Op.ConstI32 {
      run self.a.storeImm(Width.W64, slotOf(inst.result), 0)
      run self.a.storeImm(Width.W32, slotOf(inst.result), inst.k)
      return ()
    }
    if op == Op.Imm {
      let layout = self.settings.layout
      run self.a.movImm64(Reg.Rax, layout.tagWord(immTag(&layout, inst.k)))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.storeImm(Width.W64, payloadOf(inst.result), immPayload(inst.k))
      return ()
    }
    if op == Op.Unbox {
      run self.stressGuard(inst.exit)
      let tag = self.settings.layout.int()
      run self.tagGuard(inst.a, tag, inst.exit)
      // A 32-bit load zero-extends: the slot holds the i32.
      run self.a.load(Width.W32, Reg.Rax, payloadOf(inst.a))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      return ()
    }
    if op == Op.UnboxBool {
      run self.stressGuard(inst.exit)
      let tag = self.settings.layout.boolean()
      run self.tagGuard(inst.a, tag, inst.exit)
      run self.a.loadZero8(Reg.Rax, payloadOf(inst.a))
      run self.a.aluImm(Alu.And, Width.W32, Reg.Rax, 1)
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      return ()
    }
    if op == Op.BoxI32 || op == Op.BoxBool {
      run self.a.load(Width.W32, Reg.Rax, slotOf(inst.a))
      run self.boxInto(op == Op.BoxBool, Reg.Rax, Reg.Rsp, inst.result * SLOT_BYTES)
      return ()
    }
    if op == Op.Add || op == Op.Sub {
      run self.a.load(Width.W32, Reg.Rax, slotOf(inst.a))
      run self.a.load(Width.W32, Reg.R8, slotOf(inst.b))
      run self.stressGuard(inst.exit)
      if op == Op.Add { run self.a.alu(Alu.Add, Width.W32, Reg.Rax, Reg.R8) } else { run self.a.alu(Alu.Sub, Width.W32, Reg.Rax, Reg.R8) }
      run self.a.jcc(Cond.Overflow, self.exitLabels.get(u32.toUsize(inst.exit)))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      return ()
    }
    if op == Op.Mul {
      run self.a.load(Width.W32, Reg.Rax, slotOf(inst.a))
      run self.a.load(Width.W32, Reg.R8, slotOf(inst.b))
      run self.stressGuard(inst.exit)
      // -0: a zero product with a negative operand, which (a | b) < 0 detects.
      run self.a.mov(Width.W32, Reg.R9, Reg.Rax)
      run self.a.alu(Alu.Or, Width.W32, Reg.R9, Reg.R8)
      run self.a.imul(Width.W32, Reg.Rax, Reg.R8)
      run self.a.jcc(Cond.Overflow, self.exitLabels.get(u32.toUsize(inst.exit)))
      let fine = run self.a.label()
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.NotEqual, fine)
      run self.a.test(Width.W32, Reg.R9, Reg.R9)
      run self.a.jcc(Cond.Sign, self.exitLabels.get(u32.toUsize(inst.exit)))
      self.a.bind(fine)
      run self.a.mov(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      return ()
    }
    if op == Op.Cmp {
      run self.a.load(Width.W32, Reg.Rax, slotOf(inst.a))
      run self.a.load(Width.W32, Reg.R8, slotOf(inst.b))
      run self.a.movImm32(Reg.R9, 0)
      run self.a.alu(Alu.Cmp, Width.W32, Reg.Rax, Reg.R8)
      run self.a.setcc(condition(inst.k), Reg.R9)
      run self.a.store(Width.W64, slotOf(inst.result), Reg.R9)
      return ()
    }
    if op == Op.Retain {
      run self.a.load(Width.W64, Reg.Rax, slotOf(inst.a))
      run self.a.load(Width.W64, Reg.R9, payloadOf(inst.a))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
      run self.retainBits(Reg.Rax, Reg.R9)
      return ()
    }
    if op == Op.Release {
      // Only a heap reference has a count to drop; the engine's deferred release does it.
      let skip = run self.a.label()
      run self.a.load(Width.W64, Reg.Rax, slotOf(inst.a))
      run self.heapTest(Reg.Rax, skip)
      run self.a.lea(Width.W64, Reg.Rsi, slotOf(inst.a))
      run self.callHelper(helpers.RELEASE)
      self.a.bind(skip)
      return ()
    }
    if op == Op.Poll {
      run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rdx, 0), 1)
      run self.a.jcc(Cond.LessOrEqual, self.exitLabels.get(u32.toUsize(inst.exit)))
      return ()
    }
    if op == Op.Jump {
      run self.edge(&function, inst.edge)
      return ()
    }
    if op == Op.Branch {
      let otherwise = run self.a.label()
      run self.a.load(Width.W32, Reg.Rax, slotOf(inst.a))
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, otherwise)
      run self.edge(&function, inst.edge)
      self.a.bind(otherwise)
      run self.edge(&function, inst.edge + 1)
      return ()
    }
    if op == Op.Return {
      // state[0..1]: the owned result; state[2]: the bytecode offset of the return.
      run self.valueInto(&function, inst.a, SlotMode.Move, Reg.Rsi, 0)
      run self.a.movImm32(Reg.Rax, inst.pc)
      run self.a.store(Width.W64, Mem.at(Reg.Rsi, 16), Reg.Rax)
      run self.leave(EXIT_RETURNED)
      return ()
    }
    if op == Op.This {
      // The receiver cell named by CompiledFrame.thisValue (offset 0), copied (borrowed).
      let at = self.input(INPUT_FRAME)
      run self.a.load(Width.W64, Reg.R8, at)
      run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R8, 0))
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R8, 0))
      run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R8, 8))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
      return ()
    }
    if op == Op.CheckTag {
      run self.stressGuard(inst.exit)
      let tag = self.settings.layout.tagOf(inst.k)
      run self.tagGuard(inst.a, tag, inst.exit)
      return ()
    }
    if op == Op.GetField {
      run self.stressGuard(inst.exit)
      // get_field(env, frame, site, object, out) -> 1 when out holds the owned value.
      let frame = self.input(INPUT_FRAME)
      run self.a.load(Width.W64, Reg.Rsi, frame)
      run self.a.movImm32(Reg.Rdx, u32.bitOr(inst.pc, u32.shiftLeft(i32.wrappingToU32(inst.k), 31)))
      run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.a))
      run self.a.lea(Width.W64, Reg.R8, slotOf(inst.result))
      run self.callHelper(helpers.GET_FIELD)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
      return ()
    }
    if op == Op.AtomValue {
      run self.stressGuard(inst.exit)
      // atom_value(env, frame, site, out) -> 1 when out holds the owned string.
      let frame = self.input(INPUT_FRAME)
      run self.a.load(Width.W64, Reg.Rsi, frame)
      run self.a.movImm32(Reg.Rdx, u32.bitOr(inst.pc, u32.shiftLeft(i32.wrappingToU32(inst.k), 31)))
      run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.result))
      run self.callHelper(helpers.ATOM_VALUE)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
      return ()
    }
    if op == Op.PutField {
      run self.stressGuard(inst.exit)
      // put_field(env, frame, pc, object, value) -> 1 when stored (the object retained value).
      let frame = self.input(INPUT_FRAME)
      run self.a.load(Width.W64, Reg.Rsi, frame)
      run self.a.movImm32(Reg.Rdx, inst.pc)
      run self.a.lea(Width.W64, Reg.Rcx, slotOf(inst.a))
      run self.a.lea(Width.W64, Reg.R8, slotOf(inst.b))
      run self.callHelper(helpers.PUT_FIELD)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, self.exitLabels.get(u32.toUsize(inst.exit)))
      return ()
    }
    Intrinsic.trap("x64_backend: unlowered SSA operation")
  }
  /// Moves an edge's arguments into its target's parameters, then jumps there.
  effect fn edge(self: &mut Self, function: &Function, index: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let edge = function.edge(index)
    let target = function.blocks.get(u32.toUsize(edge.target))
    let mut i: u32 = 0
    while i < edge.argCount {
      let from = function.edgeArg(edge, i)
      let to = self.scratch + u32.wrappingToI32(i * SLOT_BYTES)
      run self.a.load(Width.W64, Reg.Rax, slotOf(from))
      run self.a.store(Width.W64, Mem.at(Reg.Rsp, to), Reg.Rax)
      if function.value(from).ty == Type.Value {
        run self.a.load(Width.W64, Reg.Rax, payloadOf(from))
        run self.a.store(Width.W64, Mem.at(Reg.Rsp, to + 8), Reg.Rax)
      }
      i = i + 1
    }
    i = 0
    while i < edge.argCount {
      let into = function.paramAt(target, i)
      let from = self.scratch + u32.wrappingToI32(i * SLOT_BYTES)
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rsp, from))
      run self.a.store(Width.W64, slotOf(into), Reg.Rax)
      if function.value(into).ty == Type.Value {
        run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rsp, from + 8))
        run self.a.store(Width.W64, payloadOf(into), Reg.Rax)
      }
      i = i + 1
    }
    run self.a.jmp(self.blockLabels.get(u32.toUsize(edge.target)))
  }
  /// Exits unless value v's tag field is tag.
  effect fn tagGuard(self: &mut Self, v: u32, tag: u32, exit: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let at = Mem.at(Reg.Rsp, u32.wrappingToI32(v * SLOT_BYTES + self.settings.layout.tagOffset))
    run self.loadTag(Reg.R8, at)
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(tag))
    run self.a.jcc(Cond.NotEqual, self.exitLabels.get(u32.toUsize(exit)))
  }
  /// Loads the tag field at mem, zero-extended, into dst.
  effect fn loadTag(self: &mut Self, dst: Reg, mem: Mem) -> () ! OutOfMemoryError ? &mut Allocator {
    let width = self.settings.layout.tagWidth
    if width == 1 { run self.a.loadZero8(dst, mem) }
    else if width == 2 { run self.a.loadZero16(dst, mem) }
    else { run self.a.load(Width.W32, dst, mem) }
  }
  /// Writes the i32 (or, when boolean, the bool) in the low half of payload as a ValueBits at
  /// base + offset. Clobbers R8.
  effect fn boxInto(self: &mut Self, boolean: bool, payload: Reg, base: Reg, offset: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let mut tag = layout.int()
    if boolean { tag = layout.boolean() }
    run self.a.mov(Width.W32, payload, payload)
    run self.a.movImm64(Reg.R8, layout.tagWord(tag))
    run self.a.store(Width.W64, word(base, offset), Reg.R8)
    run self.a.store(Width.W64, word(base, offset + 8), payload)
  }
  /// Writes value v as a ValueBits at base + offset for the engine to take over, as an exit
  /// slot of mode writes it: an i32 or bool boxed, an `imm` as it is, an owned value or a
  /// borrow (`move`, `dup`) with one count added. Clobbers RAX, R8, R9, R10.
  effect fn valueInto(self: &mut Self, function: &Function, v: u32, mode: SlotMode, base: Reg, offset: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let info = function.value(v)
    if info.ty == Type.I32 || info.ty == Type.Bool {
      run self.a.load(Width.W32, Reg.Rax, slotOf(v))
      run self.boxInto(info.ty == Type.Bool, Reg.Rax, base, offset)
      return ()
    }
    run self.a.load(Width.W64, Reg.Rax, slotOf(v))
    run self.a.load(Width.W64, Reg.R9, payloadOf(v))
    run self.a.store(Width.W64, word(base, offset), Reg.Rax)
    run self.a.store(Width.W64, word(base, offset + 8), Reg.R9)
    // A move hands its count over; a dup (a borrow) adds the slot's own.
    if info.own == Own.Imm || mode == SlotMode.Imm || info.own == Own.Owned { return () }
    run self.retainBits(Reg.Rax, Reg.R9)
  }
  /// Adds one count to the ValueBits whose first word is in tagWord and payload in payload,
  /// when it is a heap reference (HeapCell.retain). Clobbers R10.
  effect fn retainBits(self: &mut Self, tagWord: Reg, payload: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    let skip = run self.a.label()
    run self.heapTest(tagWord, skip)
    run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(payload, 0), 1)
    self.a.bind(skip)
  }
  /// Jumps to notHeap unless the ValueBits whose first word is in tagWord is a heap
  /// reference. Clobbers R10.
  pub effect fn heapTest(self: &mut Self, tagWord: Reg, notHeap: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    run self.a.mov(Width.W64, Reg.R10, tagWord)
    if layout.tagOffset != 0 { run self.a.shiftImm(Shift.Shr, Width.W64, Reg.R10, u32.wrappingToU8(layout.tagOffset * 8)) }
    if layout.tagWidth == 1 { run self.a.aluImm(Alu.And, Width.W32, Reg.R10, 255) }
    else if layout.tagWidth == 2 { run self.a.aluImm(Alu.And, Width.W32, Reg.R10, 65535) }
    run self.a.aluImm(Alu.Sub, Width.W32, Reg.R10, u32.wrappingToI32(layout.heapLowest))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R10, u32.wrappingToI32(layout.heapHighest - layout.heapLowest))
    run self.a.jcc(Cond.Above, notHeap)
  }
  /// The frame slot of ABI input k.
  pub fn input(self: &Self, k: u32) -> Mem { return Mem.at(Reg.Rsp, self.inputs + u32.wrappingToI32(k * 8)) }
  /// Calls helper index with env as its first argument (the caller has set the others from
  /// RSI on), then reloads the inputs the code keeps in registers. The result is in RAX.
  pub effect fn callHelper(self: &mut Self, index: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let atE = self.input(INPUT_ENV) run self.a.load(Width.W64, Reg.Rdi, atE)
    run self.a.callMem(Mem.at(Reg.Rdi, helpers.helperOffset(index)))
    let at0 = self.input(0) run self.a.load(Width.W64, Reg.Rdi, at0)
    let at1 = self.input(1) run self.a.load(Width.W64, Reg.Rsi, at1)
    let at2 = self.input(2) run self.a.load(Width.W64, Reg.Rdx, at2)
    let at3 = self.input(3) run self.a.load(Width.W64, Reg.Rcx, at3)
  }
  /// The stress configuration: every guard also fails on every Nth check.
  effect fn stressGuard(self: &mut Self, exit: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.settings.stress == 0 { return () }
    let pass = run self.a.label()
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rcx, 0), 1)
    run self.a.jcc(Cond.Greater, pass)
    run self.a.storeImm(Width.W32, Mem.at(Reg.Rcx, 0), u32.wrappingToI32(self.settings.stress))
    run self.a.jmp(self.exitLabels.get(u32.toUsize(exit)))
    self.a.bind(pass)
  }
  /// Restores the stack and returns code.
  effect fn leave(self: &mut Self, code: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.frame != 0 { run self.a.aluImm(Alu.Add, Width.W64, Reg.Rsp, self.frame) }
    run self.a.movImm32(Reg.Rax, code)
    run self.a.ret()
  }
  effect fn exitStub(self: &mut Self, function: &Function, index: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let exit = function.exit(index)
    self.a.bind(self.exitLabels.get(u32.toUsize(index)))
    run self.a.movImm32(Reg.Rax, exit.pc)
    run self.a.store(Width.W64, Mem.at(Reg.Rsi, 0), Reg.Rax)
    run self.a.movImm32(Reg.Rax, exit.stackDepth)
    run self.a.store(Width.W64, Mem.at(Reg.Rsi, 8), Reg.Rax)
    // One ValueBits per local and stack slot, each owning what the interpreter's would.
    let count = function.localCount + exit.stackDepth
    let mut i: u32 = 0
    while i < count {
      let slot = function.slot(exit, i)
      run self.valueInto(&function, slot.value, slot.mode, Reg.Rsi, 16 + i * SLOT_BYTES)
      i = i + 1
    }
    // A poll's exit is the loop target after a back edge: interrupt, not deopt.
    let mut code = EXIT_DEOPT
    if isPollExit(&function, index) { code = EXIT_POLL }
    run self.leave(code)
  }
}

fn isPollExit(function: &Function, exit: u32) -> bool {
  let mut i: usize = 0
  while i < function.insts.length() {
    let inst = function.insts.get(i)
    if inst.exit == exit { return inst.op == Op.Poll }
    i = i + 1
  }
  return false
}
/// The tag field and payload of an `Imm` constant.
fn immTag(layout: &ValueLayout, k: i32) -> u32 {
  if k == 0 { return layout.undefined() }
  if k == 1 { return layout.null() }
  if k == 2 || k == 3 { return layout.boolean() }
  return layout.uninitialized()
}
fn immPayload(k: i32) -> i32 { if k == 3 { return 1 } return 0 }
fn condition(k: i32) -> Cond {
  if k == 0 { return Cond.Less }
  if k == 1 { return Cond.LessOrEqual }
  if k == 2 { return Cond.Greater }
  if k == 3 { return Cond.GreaterOrEqual }
  if k == 4 { return Cond.Equal }
  return Cond.NotEqual
}
