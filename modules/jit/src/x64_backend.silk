        run self.callHelper(helpers.PUT_FIELD)
        run self.callBlock(Reg.R11)
        run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
        run self.a.jcc(Cond.Equal, generic)
        let layout = self.settings.layout
        run self.a.movImm64(Reg.Rax, layout.tagWord(layout.undefined()))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.storeImm(Width.W64, payloadOf(inst.result), 0)
        run self.a.jmp(done)
      } else if calls.kindOf(inst) == compiled.SITE_EQUAL {
        // A generic == or != tries the equals helper first (2 where it would coerce).
        run self.a.lea(Width.W64, Reg.Rsi, word(Reg.R11, area))
        run self.a.lea(Width.W64, Reg.Rdx, word(Reg.R11, area + SLOT_BYTES))
        run self.a.movImm32(Reg.Rcx, 0)
        run self.callHelper(helpers.EQUALS)
        run self.callBlock(Reg.R11)
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 2)
        run self.a.jcc(Cond.Equal, generic)
        if calls.notEqualOf(inst) { run self.a.aluImm(Alu.Xor, Width.W32, Reg.Rax, 1) }
        let layout = self.settings.layout
        run self.a.movImm64(Reg.R9, layout.tagWord(layout.boolean()))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.R9)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.Rax)
        run self.a.jmp(done)
      } else if (inst.k & calls.CONSTRUCT) == 0 {
        let helper = run self.a.label()
        let count = i32.wrappingToU32(calls.argumentCount(inst.k))
        if count == 1 || count == 2 {
          // A native callee may be one of Math's own functions on Numbers: computed at once.
          let layout = self.settings.layout
          let fields = self.fields
          let notMath = run self.a.label()
          run self.loadTag(Reg.R8, word(Reg.R11, area + layout.tagOffset))
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.object()))
          run self.a.jcc(Cond.NotEqual, notMath)
          run self.a.load(Width.W64, Reg.R9, word(Reg.R11, area + 8))
          run self.a.loadZero16(Reg.R8, Mem.at(Reg.R9, u32.wrappingToI32(fields.objectClass)))
          run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(classes.JS_CLASS_C_FUNCTION))
          run self.a.jcc(Cond.NotEqual, notMath)
          let mathResult = u32.wrappingMultiply(usize.toU32(compiled.CALL_RESULT), 8)
          run self.a.lea(Width.W64, Reg.Rsi, word(Reg.R11, area))
          run self.a.movImm32(Reg.Rdx, count)
          run self.a.lea(Width.W64, Reg.Rcx, word(Reg.R11, mathResult))
          run self.callHelper(helpers.MATH)
          run self.callBlock(Reg.R11)
          run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
          run self.a.jcc(Cond.Equal, notMath)
          run self.a.load(Width.W64, Reg.Rax, word(Reg.R11, mathResult))
          run self.a.load(Width.W64, Reg.R9, word(Reg.R11, mathResult + 8))
          run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
          run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
          run self.a.jmp(done)
          self.a.bind(notMath)
        }
        run self.directCall(i32.wrappingToU32(calls.argumentCount(inst.k)), helper, generic)
        let directResult = u32.wrappingMultiply(usize.toU32(compiled.CALL_STATE), 8)
        run self.a.load(Width.W64, Reg.Rax, word(Reg.R11, directResult))
        run self.a.load(Width.W64, Reg.R9, word(Reg.R11, directResult + 8))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
        run self.a.jmp(done)
        self.a.bind(helper)
        let atF = self.input(INPUT_FRAME) run self.a.load(Width.W64, Reg.Rsi, atF)
        run self.a.mov(Width.W64, Reg.Rdx, Reg.R11)
        run self.callHelper(helpers.CALL_FAST)
        run self.callBlock(Reg.R11)
        run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
        run self.a.jcc(Cond.NotEqual, generic)
        let fastResult = u32.wrappingMultiply(usize.toU32(compiled.CALL_RESULT), 8)
        run self.a.load(Width.W64, Reg.Rax, word(Reg.R11, fastResult))
        run self.a.load(Width.W64, Reg.R9, word(Reg.R11, fastResult + 8))
        run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
        run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
        run self.a.jmp(done)
      }
      // Otherwise leave with EXIT_CALL: the resume point and the saved values go to the block.
      self.a.bind(generic)
      run self.a.movImm32(Reg.Rax, u32.shiftLeft(point + 1, 2))
      run self.a.store(Width.W64, word(Reg.R11, 0), Reg.Rax)
      run self.keep(point, true)
      run self.leave(EXIT_CALL)
      // Resumed (see resume) with the block's word 0 in RAX and the block in R11.
      self.a.bind(self.resumeLabels.get(u32.toUsize(point)))
      run self.keep(point, false)
      let returned = run self.a.label()
      run self.a.aluImm(Alu.And, Width.W32, Reg.Rax, 3)
      run self.a.jcc(Cond.Equal, returned)
      // Threw (1) or not called (2): the throw exit with that status, the state before the call.
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 1)
      run self.a.storeImm(Width.W64, slotOf(inst.result), u32.wrappingToI32(EXIT_DEOPT))
      run self.a.jcc(Cond.NotEqual, self.exitLabels.get(u32.toUsize(inst.exit)))
      run self.a.storeImm(Width.W64, slotOf(inst.result), u32.wrappingToI32(EXIT_THROW))
      run self.a.jmp(self.exitLabels.get(u32.toUsize(inst.exit)))
      self.a.bind(returned)
      let result = u32.wrappingMultiply(usize.toU32(compiled.CALL_RESULT), 8)
      run self.a.load(Width.W64, Reg.Rax, word(Reg.R11, result))
      run self.a.load(Width.W64, Reg.R9, word(Reg.R11, result + 8))
      run self.a.store(Width.W64, slotOf(inst.result), Reg.Rax)
      run self.a.store(Width.W64, payloadOf(inst.result), Reg.R9)
      self.a.bind(done)
      return ()
    }
    Intrinsic.trap("x64_backend: unlowered SSA operation")
  }
  /// Moves an edge's arguments into its target's parameters, then jumps there.
  effect fn edge(self: &mut Self, function: &Function, index: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.edgeThen(&function, index, true)
  }
  /// edge, where last says whether its code ends the block (so a jump to the next block falls through).
  effect fn edgeThen(self: &mut Self, function: &Function, index: u32, last: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    let edge = function.edge(index)
    let target = function.blocks.get(u32.toUsize(edge.target))
    // A parallel move: emit any move whose destination no pending move still reads; when
    // only cycles are left, park one source in the scratch place and go on.
    let mut from = List<u32>.make()
    let mut to = List<u32>.make()
    let mut i: u32 = 0
    while i < edge.argCount {
      let source = function.edgeArg(edge, i)
      let into = function.paramAt(target, i)
      if self.key(source) != self.key(into) { run from.append(source) run to.append(into) }
      i = i + 1
    }
    let mut parked = NONE
    let mut done = List<bool>.make()
    run done.appendRepeated(false, from.length())
    let mut left = from.length()
    while left > 0 {
      let mut progress = false
      let mut m: usize = 0
      while m < from.length() {
        if !done.get(m) {
          let blocked = self.readByPending(&from, &done, m, self.key(to.get(m)), parked)
          if !blocked {
            run self.moveValue(&function, from.get(m), to.get(m), from.get(m) == parked)
            done.set(m, true) left = left - 1 progress = true
            if from.get(m) == parked { parked = NONE }
          }
        }
        m = m + 1
      }
      if !progress {
        // Every pending move is in a cycle: park the first one's source.
        let mut first: usize = 0
        while done.get(first) { first = first + 1 }
        parked = from.get(first)
        run self.park(&function, parked)
      }
    }
    if !last || edge.target != self.current + 1 { run self.a.jmp(self.blockLabels.get(u32.toUsize(edge.target))) }
  }
  /// Whether following edge index moves any value.
  fn moves(self: &Self, function: &Function, index: u32) -> bool {
    let edge = function.edge(index)
    let target = function.blocks.get(u32.toUsize(edge.target))
    let mut i: u32 = 0
    while i < edge.argCount {
      if self.key(function.edgeArg(edge, i)) != self.key(function.paramAt(target, i)) { return true }
      i = i + 1
    }
    return false
  }
  /// Whether `read` (a get.elem) is followed in its block by the unbox of its result, the
  /// only reader of that result but for the unbox's own exit.
  fn fusedUnbox(self: &Self, function: &Function, read: Inst) -> bool {
    let block = function.blocks.get(u32.toUsize(read.block))
    if self.cursor + 1 >= block.firstInst + block.instCount { return false }
    let unbox = function.inst(self.cursor + 1)
    if unbox.op != Op.Unbox || unbox.a != read.result || unbox.result == NONE || unbox.exit == NONE { return false }
    let exit = function.exit(unbox.exit)
    let mut readers: u32 = 1
    let mut s: u32 = 0
    while s < function.slotCount(exit) { if function.slot(exit, s).value == read.result { readers = readers + 1 } s = s + 1 }
    return self.uses.get(u32.toUsize(read.result)) == readers
  }
  effect fn countUses(self: &mut Self, function: &Function) -> () ! OutOfMemoryError ? &mut Allocator {
    let count = u32.toUsize(function.valueCount())
    run self.uses.appendRepeated(0, count)
    run self.immediateUses.appendRepeated(0, count)
    run self.defs.appendRepeated(NONE, count)
    run self.constants.appendRepeated(Option<i32>.none(), count)
    let mut i: usize = 0
    while i < function.insts.length() {
      let inst = function.insts.get(i)
      if inst.result != NONE && inst.result < function.valueCount() {
        self.defs.set(u32.toUsize(inst.result), usize.toU32(i))
        if inst.op == Op.ConstI32 { self.constants.set(u32.toUsize(inst.result), Option<i32>.some(inst.k)) }
      }
      i = i + 1
    }
    i = 0
    while i < function.insts.length() {
      let inst = function.insts.get(i)
      if inst.a != NONE && inst.a < function.valueCount() { self.read(inst.a) }
      if readsK(inst.op) { self.read(i32.wrappingToU32(inst.k)) }
      if inst.b != NONE && inst.b < function.valueCount() {
        self.read(inst.b)
        if (inst.op == Op.Add || inst.op == Op.Sub || inst.op == Op.Cmp) && self.constant(&function, inst.b) {
          let at = u32.toUsize(inst.b)
          let before = self.immediateUses.get(at)
          self.immediateUses.set(at, before + 1)
        }
      }
      i = i + 1
    }
    i = 0
    while i < function.edgeArgs.length() { self.read(function.edgeArgs.get(i)) i = i + 1 }
    i = 0
    while i < function.slots.length() {
      let v = function.slots.get(i).value
      self.read(v)
      // An exit writes a constant from its immediate (valueInto), so it needs no register.
      if v != NONE && v < function.valueCount() && self.constant(&function, v) {
        let at = u32.toUsize(v)
        let before = self.immediateUses.get(at)
        self.immediateUses.set(at, before + 1)
      }
      i = i + 1
    }
  }
  fn read(self: &mut Self, v: u32) -> () {
    if v == NONE || u32.toUsize(v) >= self.uses.length() { return () }
    let before = self.uses.get(u32.toUsize(v))
    self.uses.set(u32.toUsize(v), before + 1)
  }
  fn constant(self: &Self, function: &Function, v: u32) -> bool {
    return self.constants.get(u32.toUsize(v)).isSome()
  }
  fn onlyImmediate(self: &Self, v: u32) -> bool {
    return self.uses.get(u32.toUsize(v)) == self.immediateUses.get(u32.toUsize(v))
  }
  /// Whether compare's only reader is its block's terminator, a branch, with no code between.
  fn fusedCompare(self: &Self, function: &Function, compare: Inst) -> bool {
    if compare.op != Op.Cmp || self.uses.get(u32.toUsize(compare.result)) != 1 { return false }
    let block = function.blocks.get(u32.toUsize(compare.block))
    let last = block.firstInst + block.instCount - 1
    let branch = function.inst(last)
    if branch.op != Op.Branch || branch.a != compare.result { return false }
    // Find compare, then only code-free instructions until the branch.
    let mut i = block.firstInst
    while i < last && function.inst(i).result != compare.result { i = i + 1 }
    i = i + 1
    while i < last { if function.inst(i).op != Op.Release { return false } i = i + 1 }
    return true
  }
  /// The flags of compare's operands (it stores nothing).
  effect fn compare(self: &mut Self, compare: Inst) -> () ! OutOfMemoryError ? &mut Allocator {
    let left = self.at(compare.a)
    let mut dst = Reg.Rax
    if left.kind == GPR { dst = left.gpr } else { run getI32(&mut self.a, Reg.Rax, left) }
    run self.operate(Alu.Cmp, dst, compare.b)
  }
  /// dst = dst op b, with b an immediate when it is a constant.
  effect fn operate(self: &mut Self, alu: Alu, dst: Reg, b: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    match self.constants.get(u32.toUsize(b)) {
      Option<i32>.Some { value } => { run self.a.aluImm(alu, Width.W32, dst, value) return () }
      Option<i32>.None => ()
    }
    let place = self.at(b) run aluWith(&mut self.a, alu, dst, place)
  }
  /// What v's place is, as a number: equal numbers are the same storage.
  fn key(self: &Self, v: u32) -> u32 {
    let kind = self.places.kind(v)
    if kind == GPR { return 1000000 + u8.toU32(self.places.register(v)) }
    if kind == XMM { return 2000000 + u8.toU32(self.places.register(v)) }
    return v
  }
  fn readByPending(self: &Self, from: &List<u32>, done: &List<bool>, except: usize, key: u32, parked: u32) -> bool {
    let mut n: usize = 0
    while n < from.length() {
      // A parked source is read from the scratch place, not its own.
      if n != except && !done.get(n) && from.get(n) != parked && self.key(from.get(n)) == key { return true }
      n = n + 1
    }
    return false
  }
  /// Copies v's place to the scratch place (rax, xmm0 or the scratch slot).
  effect fn park(self: &mut Self, function: &Function, v: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let ty = function.value(v).ty
    if ty == Type.F64 { let place10 = self.at(v) run getF64(&mut self.a, Xmm.Xmm0, place10) return () }
    if ty == Type.I32 || ty == Type.Bool { let place11 = self.at(v) run getI32(&mut self.a, Reg.R11, place11) return () }
    run self.a.load(Width.W64, Reg.Rax, slotOf(v))
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, self.scratch), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, payloadOf(v))
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, self.scratch + 8), Reg.Rax)
  }
  /// Copies value from's place (or the scratch place, when parked) into value into's.
  effect fn moveValue(self: &mut Self, function: &Function, from: u32, into: u32, parked: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    let ty = function.value(into).ty
    let target = self.at(into)
    if ty == Type.F64 {
      if parked { run putF64(&mut self.a, target, Xmm.Xmm0) return () }
      let source = self.at(from)
      if target.kind == XMM { run getF64(&mut self.a, target.xmm, source) return () }
      if source.kind == XMM { run putF64(&mut self.a, target, source.xmm) return () }
      run self.a.load(Width.W64, Reg.Rax, source.mem)
      run self.a.store(Width.W64, target.mem, Reg.Rax)
      return ()
    }
    if ty == Type.I32 || ty == Type.Bool {
      if parked { run putI32(&mut self.a, target, Reg.R11) return () }
      let source = self.at(from)
      if target.kind == GPR { run getI32(&mut self.a, target.gpr, source) return () }
      if source.kind == GPR { run putI32(&mut self.a, target, source.gpr) return () }
      run self.a.load(Width.W64, Reg.Rax, source.mem)
      run self.a.store(Width.W64, target.mem, Reg.Rax)
      return ()
    }
    let mut tagAt = slotOf(from)
    let mut payloadAt = payloadOf(from)
    if parked { tagAt = Mem.at(Reg.Rsp, self.scratch) payloadAt = Mem.at(Reg.Rsp, self.scratch + 8) }
    run self.a.load(Width.W64, Reg.Rax, tagAt)
    run self.a.store(Width.W64, slotOf(into), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, payloadAt)
    run self.a.store(Width.W64, payloadOf(into), Reg.Rax)
  }
  /// Exits unless value v's tag field is tag.
  effect fn tagGuard(self: &mut Self, v: u32, tag: u32, exit: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let at = Mem.at(Reg.Rsp, u32.wrappingToI32(v * SLOT_BYTES + self.settings.layout.tagOffset))
    run self.loadTag(Reg.R8, at)
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(tag))
    run self.a.jcc(Cond.NotEqual, self.exitLabels.get(u32.toUsize(exit)))
  }
  /// Loads the tag field at mem, zero-extended, into dst.
  effect fn loadTag(self: &mut Self, dst: Reg, mem: Mem) -> () ! OutOfMemoryError ? &mut Allocator {
    let width = self.settings.layout.tagWidth
    if width == 1 { run self.a.loadZero8(dst, mem) }
    else if width == 2 { run self.a.loadZero16(dst, mem) }
    else { run self.a.load(Width.W32, dst, mem) }
  }
  /// Writes the i32 (or, when boolean, the bool) in the low half of payload as a ValueBits at
  /// base + offset. Clobbers R8.
  effect fn boxInto(self: &mut Self, boolean: bool, payload: Reg, base: Reg, offset: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let mut tag = layout.int()
    if boolean { tag = layout.boolean() }
    run self.a.mov(Width.W32, payload, payload)
    run self.a.movImm64(Reg.R8, layout.tagWord(tag))
    run self.a.store(Width.W64, word(base, offset), Reg.R8)
    run self.a.store(Width.W64, word(base, offset + 8), payload)
  }
  /// Writes the double whose bits are in bits as a Float64 ValueBits at base + offset. An
  /// integral double stays a Float64, as the interpreter's own arithmetic leaves it
  /// (docs/jit/doubles.md). Clobbers R8.
  effect fn boxDoubleInto(self: &mut Self, bits: Reg, base: Reg, offset: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    run self.a.movImm64(Reg.R8, layout.tagWord(layout.float64()))
    run self.a.store(Width.W64, word(base, offset), Reg.R8)
    run self.a.store(Width.W64, word(base, offset + 8), bits)
  }
  /// Writes value v as a ValueBits at base + offset for the engine to take over, as an exit
  /// slot of mode writes it: an i32 or bool boxed, an `imm` as it is, an owned value or a
  /// borrow (`move`, `dup`) with one count added. Clobbers RAX, R8, R9, R10.
  effect fn valueInto(self: &mut Self, function: &Function, v: u32, mode: SlotMode, base: Reg, offset: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let info = function.value(v)
    if info.ty == Type.I32 || info.ty == Type.Bool {
      match self.constants.get(u32.toUsize(v)) {
        Option<i32>.Some { value } => { run self.a.movImm32(Reg.Rax, i32.wrappingToU32(value)) }
        Option<i32>.None => { let place12 = self.at(v) run getI32(&mut self.a, Reg.Rax, place12) }
      }
      run self.boxInto(info.ty == Type.Bool, Reg.Rax, base, offset)
      return ()
    }
    if info.ty == Type.F64 {
      let place13 = self.at(v) run getBits(&mut self.a, Reg.Rax, place13)
      run self.boxDoubleInto(Reg.Rax, base, offset)
      return ()
    }
    run self.a.load(Width.W64, Reg.Rax, slotOf(v))
    run self.a.load(Width.W64, Reg.R9, payloadOf(v))
    run self.a.store(Width.W64, word(base, offset), Reg.Rax)
    run self.a.store(Width.W64, word(base, offset + 8), Reg.R9)
    // A move hands its count over; a dup (a borrow) adds the slot's own.
    if info.own == Own.Imm || mode == SlotMode.Imm || info.own == Own.Owned { return () }
    run self.retainBits(Reg.Rax, Reg.R9)
  }
  /// Drops the count the owned value v holds. Only a heap reference has one. A count above
  /// one drops here; the last goes to the engine's deferred release.
  effect fn releaseValue(self: &mut Self, v: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let skip = run self.a.label()
    let last = run self.a.label()
    run self.a.load(Width.W64, Reg.Rax, slotOf(v))
    run self.heapTest(Reg.Rax, skip)
    run self.a.load(Width.W64, Reg.R9, payloadOf(v))
    run self.a.aluStoreImm(Alu.Cmp, Width.W32, Mem.at(Reg.R9, 0), 1)
    run self.a.jcc(Cond.LessOrEqual, last)
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.R9, 0), 1)
    run self.a.jmp(skip)
    self.a.bind(last)
    run self.a.lea(Width.W64, Reg.Rsi, slotOf(v))
    run self.callHelper(helpers.RELEASE)
    self.a.bind(skip)
  }
  /// Adds one count to the ValueBits whose first word is in tagWord and payload in payload,
  /// when it is a heap reference (HeapCell.retain). Clobbers R10.
  effect fn retainBits(self: &mut Self, tagWord: Reg, payload: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    let skip = run self.a.label()
    run self.heapTest(tagWord, skip)
    run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(payload, 0), 1)
    self.a.bind(skip)
  }
  /// R11 = the address of the slot that the inline key of the field site at pc names in
  /// the object in value's slot, or a jump to miss: value is not an object, or the key's
  /// shape version (key >> 16, slot index in the low 16 bits, at code + pc + 5 as
  /// js_vm_property_ops.fieldKeyAt reads it) is not its shape's. Clobbers RAX, R8 to R11.
  effect fn fieldSlot(self: &mut Self, value: u32, pc: u32, miss: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let fields = self.fields
    run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(value * SLOT_BYTES + layout.tagOffset)))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.object()))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R11, payloadOf(value))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectShape)))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, u32.wrappingToI32(fields.shapeVersion)))
    run self.codeInto(Reg.R10)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R10, u32.wrappingToI32(pc + 5)))
    run self.a.mov(Width.W64, Reg.R8, Reg.R9)
    run self.a.shiftImm(Shift.Shr, Width.W64, Reg.R8, 16)
    run self.a.alu(Alu.Cmp, Width.W64, Reg.R8, Reg.Rax)
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.aluImm(Alu.And, Width.W32, Reg.R9, 65535)
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R9, 4)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectSlots)))
    run self.a.alu(Alu.Add, Width.W64, Reg.R11, Reg.R9)
  }
  /// R11 = the address of element `index` (an i32 value) of the fast Array in value's slot,
  /// or a jump to miss: not a fast Array, or the index is negative or past its elements.
  /// Clobbers R8 and R11.
  effect fn elementSlot(self: &mut Self, value: u32, index: u32, miss: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let fields = self.fields
    run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(value * SLOT_BYTES + layout.tagOffset)))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.object()))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R11, payloadOf(value))
    if fields.objectClass == fields.objectFlags + 2 && fields.arrayClass < 65536 && fields.fastArray < 256 {
      // The flags byte and the 16-bit class share one 32-bit word: one test for both.
      run self.a.load(Width.W32, Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectFlags)))
      run self.a.aluImm(Alu.And, Width.W32, Reg.R8, u32.wrappingToI32(u32.bitOr(0xffff0000, fields.fastArray)))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(u32.bitOr(u32.shiftLeft(fields.arrayClass, 16), fields.fastArray)))
      run self.a.jcc(Cond.NotEqual, miss)
    } else {
      run self.a.loadZero16(Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectClass)))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(fields.arrayClass))
      run self.a.jcc(Cond.NotEqual, miss)
      run self.a.loadZero8(Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectFlags)))
      run self.a.testImm(Width.W32, Reg.R8, u32.wrappingToI32(fields.fastArray))
      run self.a.jcc(Cond.Equal, miss)
    }
    let place = self.at(index)
    run getI32(&mut self.a, Reg.R8, place)
    run self.a.aluLoad(Alu.Cmp, Width.W32, Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(fields.elementCount)))
    run self.a.jcc(Cond.AboveOrEqual, miss)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, u32.wrappingToI32(fields.elements)))
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R8, 4)
    run self.a.alu(Alu.Add, Width.W64, Reg.R11, Reg.R8)
  }
  /// The typed array arm of get.elem and put.elem, guarding what the interpreter's fast arms
  /// guard (js_typed_array_read.quickRead: "if index >= array.count || array.shared { return
  /// none }", then a jump on the class; js_typed_array_write.quickWriteInt and quickWrite):
  /// an object of a class Uint8C..Float64 whose payload is a TypedArray, not shared, the
  /// index below the element count (detaching or shrinking the buffer sets count to 0). Reads
  /// box what quickRead returns (Uint32 above the int32 range as a Float64). Stores take an
  /// Int or a Float64; a double goes to an integer array through cvttsd2si when it is in the
  /// int32 range (ToInt32 is then a truncation). Float16 and BigInt views, a double into
  /// Uint8C (round half to even), and a double out of range, NaN or an infinity go to `slow`.
  /// The count and the data pointer are invariant in a loop with no call and no generic
  /// instruction. Clobbers RAX, R8 to R11, XMM0.
  effect fn typedElement(self: &mut Self, put: bool, object: u32, index: u32, value: u32, result: u32, done: Label, slow: Label)
    -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let fields = self.fields
    if fields.typedTagAt == u32.MAX { run self.a.jmp(slow) return () }
    run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(object * SLOT_BYTES + layout.tagOffset)))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.object()))
    run self.a.jcc(Cond.NotEqual, slow)
    run self.a.load(Width.W64, Reg.R11, payloadOf(object))
    run self.a.loadZero16(Reg.R8, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectClass)))
    run self.a.mov(Width.W32, Reg.R10, Reg.R8)
    run self.a.aluImm(Alu.Sub, Width.W32, Reg.R10, u32.wrappingToI32(fields.typedFirst))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R10, u32.wrappingToI32(fields.typedLast - fields.typedFirst))
    run self.a.jcc(Cond.Above, slow)
    run self.a.loadZero8(Reg.R10, Mem.at(Reg.R11, u32.wrappingToI32(fields.typedTagAt)))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R10, u32.wrappingToI32(fields.typedTag))
    run self.a.jcc(Cond.NotEqual, slow)
    run self.a.loadZero8(Reg.R10, Mem.at(Reg.R11, u32.wrappingToI32(fields.typedShared)))
    run self.a.test(Width.W32, Reg.R10, Reg.R10)
    run self.a.jcc(Cond.NotEqual, slow)
    let place = self.at(index)
    run getI32(&mut self.a, Reg.R9, place)
    // Sign-extended, a negative index is above any count.
    run self.a.signExtend32(Reg.R9, Reg.R9)
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R9, Mem.at(Reg.R11, u32.wrappingToI32(fields.typedCount)))
    run self.a.jcc(Cond.AboveOrEqual, slow)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, u32.wrappingToI32(fields.typedData)))
    if put { run self.typedStore(value, done, slow) } else { run self.typedLoad(result, done, slow) }
  }
  /// Jumps to `next` unless the class in R8 is `classId`.
  effect fn unlessClass(self: &mut Self, classId: u32, next: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(classId))
    run self.a.jcc(Cond.NotEqual, next)
  }
  /// typedElement's read: element R9 of the data at R11, class in R8, boxed into `result`.
  effect fn typedLoad(self: &mut Self, result: u32, done: Label, slow: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let at = result * SLOT_BYTES
    let mut next = run self.a.label()
    run self.unlessClass(classes.JS_CLASS_FLOAT64_ARRAY, next)
    run self.a.load(Width.W64, Reg.Rax, Mem.indexed(Reg.R11, Reg.R9, Scale.Eight, 0))
    run self.boxDoubleInto(Reg.Rax, Reg.Rsp, at) run self.a.jmp(done)
    self.a.bind(next) next = run self.a.label()
    run self.unlessClass(classes.JS_CLASS_FLOAT32_ARRAY, next)
    run self.a.loadFloat(Xmm.Xmm0, Mem.indexed(Reg.R11, Reg.R9, Scale.Four, 0))
    run self.a.doubleToBits(Reg.Rax, Xmm.Xmm0)
    run self.boxDoubleInto(Reg.Rax, Reg.Rsp, at) run self.a.jmp(done)
    self.a.bind(next) next = run self.a.label()
    run self.unlessClass(classes.JS_CLASS_INT32_ARRAY, next)
    run self.a.load(Width.W32, Reg.Rax, Mem.indexed(Reg.R11, Reg.R9, Scale.Four, 0))
    run self.boxInto(false, Reg.Rax, Reg.Rsp, at) run self.a.jmp(done)
    self.a.bind(next) next = run self.a.label()
    run self.unlessClass(classes.JS_CLASS_UINT8_ARRAY, next)
    run self.a.loadZero8(Reg.Rax, Mem.indexed(Reg.R11, Reg.R9, Scale.One, 0))
    run self.boxInto(false, Reg.Rax, Reg.Rsp, at) run self.a.jmp(done)
    self.a.bind(next) next = run self.a.label()
    run self.unlessClass(classes.JS_CLASS_UINT8C_ARRAY, next)
    run self.a.loadZero8(Reg.Rax, Mem.indexed(Reg.R11, Reg.R9, Scale.One, 0))
    run self.boxInto(false, Reg.Rax, Reg.Rsp, at) run self.a.jmp(done)
    self.a.bind(next) next = run self.a.label()
    run self.unlessClass(classes.JS_CLASS_INT8_ARRAY, next)
    run self.a.loadSigned8(Reg.Rax, Mem.indexed(Reg.R11, Reg.R9, Scale.One, 0))
    run self.boxInto(false, Reg.Rax, Reg.Rsp, at) run self.a.jmp(done)
    self.a.bind(next) next = run self.a.label()
    run self.unlessClass(classes.JS_CLASS_INT16_ARRAY, next)
    run self.a.loadSigned16(Reg.Rax, Mem.indexed(Reg.R11, Reg.R9, Scale.Two, 0))
    run self.boxInto(false, Reg.Rax, Reg.Rsp, at) run self.a.jmp(done)
    self.a.bind(next) next = run self.a.label()
    run self.unlessClass(classes.JS_CLASS_UINT16_ARRAY, next)
    run self.a.loadZero16(Reg.Rax, Mem.indexed(Reg.R11, Reg.R9, Scale.Two, 0))
    run self.boxInto(false, Reg.Rax, Reg.Rsp, at) run self.a.jmp(done)
    self.a.bind(next)
    // Uint32: an Int when it fits (ValueBits.number), else a Float64.
    run self.unlessClass(classes.JS_CLASS_UINT32_ARRAY, slow)
    let wide = run self.a.label()
    run self.a.load(Width.W32, Reg.Rax, Mem.indexed(Reg.R11, Reg.R9, Scale.Four, 0))
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.Sign, wide)
    run self.boxInto(false, Reg.Rax, Reg.Rsp, at) run self.a.jmp(done)
    self.a.bind(wide)
    run self.a.intToDouble(Width.W64, Xmm.Xmm0, Reg.Rax)
    run self.a.doubleToBits(Reg.Rax, Xmm.Xmm0)
    run self.boxDoubleInto(Reg.Rax, Reg.Rsp, at) run self.a.jmp(done)
  }
  /// typedElement's store of `value` (borrowed: numbers carry no count) at element R9 of the
  /// data at R11, class in R8.
  effect fn typedStore(self: &mut Self, value: u32, done: Label, slow: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let double = run self.a.label()
    let integer = run self.a.label()
    run self.loadTag(Reg.R10, Mem.at(Reg.Rsp, u32.wrappingToI32(value * SLOT_BYTES + layout.tagOffset)))
    run self.a.load(Width.W64, Reg.Rax, payloadOf(value))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R10, u32.wrappingToI32(layout.float64()))
    run self.a.jcc(Cond.Equal, double)
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R10, u32.wrappingToI32(layout.int()))
    run self.a.jcc(Cond.NotEqual, slow)
    // An Int in EAX.
    let mut next = run self.a.label()
    run self.unlessClass(classes.JS_CLASS_FLOAT64_ARRAY, next)
    run self.a.intToDouble(Width.W32, Xmm.Xmm0, Reg.Rax)
    run self.a.storeDouble(Mem.indexed(Reg.R11, Reg.R9, Scale.Eight, 0), Xmm.Xmm0) run self.a.jmp(done)
    self.a.bind(next) next = run self.a.label()
    run self.unlessClass(classes.JS_CLASS_FLOAT32_ARRAY, next)
    run self.a.intToDouble(Width.W32, Xmm.Xmm0, Reg.Rax)
    run self.a.doubleToFloat(Xmm.Xmm0, Xmm.Xmm0)
    run self.a.storeFloat(Mem.indexed(Reg.R11, Reg.R9, Scale.Four, 0), Xmm.Xmm0) run self.a.jmp(done)
    self.a.bind(next) next = run self.a.label()
    run self.unlessClass(classes.JS_CLASS_UINT8C_ARRAY, next)
    let clamped = run self.a.label()
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, 255)
    run self.a.jcc(Cond.BelowOrEqual, clamped)
    // Out of 0..255: 0 below (sign set), 255 above.
    run self.a.mov(Width.W32, Reg.R10, Reg.Rax)
    run self.a.shiftImm(Shift.Sar, Width.W32, Reg.R10, 31)
    run self.a.movImm32(Reg.Rax, 255)
    run self.a.unary(Unary.Not, Width.W32, Reg.R10)
    run self.a.alu(Alu.And, Width.W32, Reg.Rax, Reg.R10)
    self.a.bind(clamped)
    run self.a.store8(Mem.indexed(Reg.R11, Reg.R9, Scale.One, 0), Reg.Rax) run self.a.jmp(done)
    self.a.bind(next)
    run self.a.jmp(integer)
    // A Float64: bits in RAX.
    self.a.bind(double)
    next = run self.a.label()
    run self.unlessClass(classes.JS_CLASS_FLOAT64_ARRAY, next)
    run self.a.store(Width.W64, Mem.indexed(Reg.R11, Reg.R9, Scale.Eight, 0), Reg.Rax) run self.a.jmp(done)
    self.a.bind(next) next = run self.a.label()
    run self.a.bitsToDouble(Xmm.Xmm0, Reg.Rax)
    run self.unlessClass(classes.JS_CLASS_FLOAT32_ARRAY, next)
    run self.a.doubleToFloat(Xmm.Xmm0, Xmm.Xmm0)
    run self.a.storeFloat(Mem.indexed(Reg.R11, Reg.R9, Scale.Four, 0), Xmm.Xmm0) run self.a.jmp(done)
    self.a.bind(next)
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(classes.JS_CLASS_UINT8C_ARRAY))
    run self.a.jcc(Cond.Equal, slow)
    // ToInt32 of a double in the int32 range is its truncation; cvttsd2si gives 0x80000000 for
    // everything else (and for -2^31 itself, which the helper stores just as well).
    run self.a.doubleToInt(Width.W32, Reg.Rax, Xmm.Xmm0)
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, -0x80000000)
    run self.a.jcc(Cond.Equal, slow)
    // Integer views, with the Int or the truncated double in EAX.
    self.a.bind(integer)
    next = run self.a.label()
    run self.unlessClass(classes.JS_CLASS_INT32_ARRAY, next)
    run self.a.store(Width.W32, Mem.indexed(Reg.R11, Reg.R9, Scale.Four, 0), Reg.Rax) run self.a.jmp(done)
    self.a.bind(next) next = run self.a.label()
    run self.unlessClass(classes.JS_CLASS_UINT32_ARRAY, next)
    run self.a.store(Width.W32, Mem.indexed(Reg.R11, Reg.R9, Scale.Four, 0), Reg.Rax) run self.a.jmp(done)
    self.a.bind(next) next = run self.a.label()
    run self.unlessClass(classes.JS_CLASS_UINT8_ARRAY, next)
    run self.a.store8(Mem.indexed(Reg.R11, Reg.R9, Scale.One, 0), Reg.Rax) run self.a.jmp(done)
    self.a.bind(next) next = run self.a.label()
    run self.unlessClass(classes.JS_CLASS_INT8_ARRAY, next)
    run self.a.store8(Mem.indexed(Reg.R11, Reg.R9, Scale.One, 0), Reg.Rax) run self.a.jmp(done)
    self.a.bind(next) next = run self.a.label()
    run self.unlessClass(classes.JS_CLASS_INT16_ARRAY, next)
    run self.a.store16(Mem.indexed(Reg.R11, Reg.R9, Scale.Two, 0), Reg.Rax) run self.a.jmp(done)
    self.a.bind(next)
    run self.unlessClass(classes.JS_CLASS_UINT16_ARRAY, slow)
    run self.a.store16(Mem.indexed(Reg.R11, Reg.R9, Scale.Two, 0), Reg.Rax) run self.a.jmp(done)
  }
  /// fieldSlot by the site cache entry (js_vm_property_ops.readFieldCachedAt): an own entry of
  /// the object's shape version, or a prototype entry for it while RuntimeState.shapeEpoch is
  /// the entry's (then the slot is in the entry's holder). An exotic object misses.
  effect fn cachedFieldSlot(self: &mut Self, value: u32, pc: u32, miss: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    let fields = self.fields
    let entries = u32.wrappingToI32(fields.fieldCache)
    let proto = run self.a.label()
    let found = run self.a.label()
    run self.loadTag(Reg.R8, Mem.at(Reg.Rsp, u32.wrappingToI32(value * SLOT_BYTES + layout.tagOffset)))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, u32.wrappingToI32(layout.object()))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R11, payloadOf(value))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectShape)))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, u32.wrappingToI32(fields.shapeVersion)))
    // R9 = the site (the operand's address), R8 = its entry less the cache's offset.
    run self.codeInto(Reg.R9)
    run self.a.lea(Width.W64, Reg.R9, Mem.at(Reg.R9, u32.wrappingToI32(pc + 1)))
    run self.runtimeInto(Reg.R10)
    run self.a.mov(Width.W64, Reg.R8, Reg.R9)
    run self.a.aluImm(Alu.And, Width.W32, Reg.R8, 4095)
    run self.a.imulImm(Width.W64, Reg.R8, Reg.R8, u32.wrappingToI32(fields.entryStride))
    run self.a.alu(Alu.Add, Width.W64, Reg.R8, Reg.R10)
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R9, Mem.at(Reg.R8, entries + u32.wrappingToI32(fields.entrySite)))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R8, entries + u32.wrappingToI32(fields.entryKey)))
    run self.a.mov(Width.W64, Reg.R10, Reg.R9)
    run self.a.shiftImm(Shift.Shr, Width.W64, Reg.R9, 16)
    run self.a.alu(Alu.Cmp, Width.W64, Reg.R9, Reg.Rax)
    run self.a.jcc(Cond.NotEqual, proto)
    run self.a.aluImm(Alu.And, Width.W32, Reg.R10, 65535)
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R10, 4)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectSlots)))
    run self.a.alu(Alu.Add, Width.W64, Reg.R11, Reg.R10)
    run self.a.jmp(found)
    self.a.bind(proto)
    run self.a.loadZero8(Reg.R10, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectFlags)))
    run self.a.testImm(Width.W32, Reg.R10, u32.wrappingToI32(fields.exotic))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.movImm64(Reg.R10, fields.protoKey)
    run self.a.alu(Alu.Or, Width.W64, Reg.Rax, Reg.R10)
    run self.a.alu(Alu.Cmp, Width.W64, Reg.R9, Reg.Rax)
    run self.a.jcc(Cond.NotEqual, miss)
    run self.runtimeInto(Reg.R10)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R8, entries + u32.wrappingToI32(fields.entryEpoch)))
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R9, Mem.at(Reg.R10, u32.wrappingToI32(fields.shapeEpoch)))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R8, entries + u32.wrappingToI32(fields.entryHolder)))
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R8, entries + u32.wrappingToI32(fields.entryHolderIndex)))
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R9, 4)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, u32.wrappingToI32(fields.objectSlots)))
    run self.a.alu(Alu.Add, Width.W64, Reg.R11, Reg.R9)
    self.a.bind(found)
  }
  /// Jumps to notHeap unless the ValueBits whose first word is in tagWord is a heap
  /// reference. Clobbers R10.
  pub effect fn heapTest(self: &mut Self, tagWord: Reg, notHeap: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let layout = self.settings.layout
    run self.a.mov(Width.W64, Reg.R10, tagWord)
    if layout.tagOffset != 0 { run self.a.shiftImm(Shift.Shr, Width.W64, Reg.R10, u32.wrappingToU8(layout.tagOffset * 8)) }
    if layout.tagWidth == 1 { run self.a.aluImm(Alu.And, Width.W32, Reg.R10, 255) }
    else if layout.tagWidth == 2 { run self.a.aluImm(Alu.And, Width.W32, Reg.R10, 65535) }
    run self.a.aluImm(Alu.Sub, Width.W32, Reg.R10, u32.wrappingToI32(layout.heapLowest))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R10, u32.wrappingToI32(layout.heapHighest - layout.heapLowest))
    run self.a.jcc(Cond.Above, notHeap)
  }
  /// The frame slot of ABI input k.
  pub fn input(self: &Self, k: u32) -> Mem { return Mem.at(Reg.Rsp, self.inputs + u32.wrappingToI32(k * 8)) }
  /// dst = the CompiledFrame the instruction being lowered runs for, to pass to a helper: the
  /// function's own, or an inlined callee's (Inst.frame), which is built here, on the slow
  /// path, as a direct call builds one (directCall): the closure's bytecode, captured cells and
  /// scope, the function's realm and runtime (the target's realm was checked when it was
  /// chosen), the target's code. The receiver cell is never read: an inlined body takes
  /// `this` as a value. Clobbers RAX and R8 to R10.
  effect fn frameInto(self: &mut Self, dst: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    let own = self.input(INPUT_FRAME)
    if self.frameOf == 0 { run self.a.load(Width.W64, dst, own) return () }
    let k = self.frameOf - 1
    let closure = self.inlineClosures.get(u32.toUsize(k))
    let f = self.inlineFrames + u32.wrappingToI32(k * INLINE_FRAME_WORDS * 8)
    run self.a.load(Width.W64, Reg.R10, payloadOf(closure))
    run self.a.lea(Width.W64, Reg.Rax, slotOf(closure))
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, f), Reg.Rax)
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_BYTECODE))
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 8), Reg.R8)
    run self.a.load(Width.W64, Reg.R9, own)
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R9, 16))
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 16), Reg.R8)
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R9, FRAME_RUNTIME))
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 24), Reg.R8)
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_REFERENCES))
    run self.a.lea(Width.W64, Reg.Rax, Mem.at(Reg.R8, compiled.DIRECT_BOX_DATA))
    run self.a.test(Width.W64, Reg.R8, Reg.R8)
    run self.a.cmov(Cond.Equal, Width.W64, Reg.Rax, Reg.Rsp)
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 32), Reg.Rax)
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_SCOPE))
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 40), Reg.R8)
    run self.a.storeImm(Width.W64, Mem.at(Reg.Rsp, f + 48), 0)
    run self.a.movSymbol(Reg.Rax, k * 2 + 1)
    run self.a.store(Width.W64, Mem.at(Reg.Rsp, f + 56), Reg.Rax)
    run self.a.storeImm(Width.W64, Mem.at(Reg.Rsp, f + 64), 0)
    run self.a.lea(Width.W64, dst, Mem.at(Reg.Rsp, f))
  }
  /// dst = the first byte of the code the instruction being lowered belongs to
  /// (CompiledFrame.code): an inlined callee's is a link-time constant.
  effect fn codeInto(self: &mut Self, dst: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.frameOf != 0 { run self.a.movSymbol(dst, (self.frameOf - 1) * 2 + 1) return () }
    let own = self.input(INPUT_FRAME)
    run self.a.load(Width.W64, dst, own)
    run self.a.load(Width.W64, dst, Mem.at(dst, FRAME_CODE))
  }
  /// dst = the runtime (CompiledFrame.runtime), which every frame of the function shares.
  effect fn runtimeInto(self: &mut Self, dst: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    let own = self.input(INPUT_FRAME)
    run self.a.load(Width.W64, dst, own)
    run self.a.load(Width.W64, dst, Mem.at(dst, FRAME_RUNTIME))
  }
  /// dst = the call block (CompiledFrame.calls).
  effect fn callBlock(self: &mut Self, dst: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    let frame = self.input(INPUT_FRAME)
    run self.a.load(Width.W64, dst, frame)
    run self.a.load(Width.W64, dst, Mem.at(dst, FRAME_CALLS))
  }
  /// Which resume point call is (its index among the function's calls).
  fn resumeIndex(self: &Self, function: &Function, call: Inst) -> u32 {
    let mut point: u32 = 0
    let mut i: usize = 0
    while i < function.insts.length() {
      let inst = function.insts.get(i)
      if inst.op == Op.Call {
        if inst.pc == call.pc && inst.result == call.result { return point }
        point = point + 1
      }
      i = i + 1
    }
    return Intrinsic.trap("x64_backend: a call without a resume point")
  }
  /// Saves (out) or restores the values call point keeps, between the frame and the call block
  /// in R11, at block word CALL_SAVED + 2 * value. Clobbers R9.
  effect fn keep(self: &mut Self, point: u32, out: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    let base = u32.wrappingMultiply(usize.toU32(compiled.CALL_SAVED), 8)
    let mut i = u32.toUsize(self.savedStart.get(u32.toUsize(point)))
    let end = u32.toUsize(self.savedStart.get(u32.toUsize(point) + 1))
    while i < end {
      let v = self.savedValues.get(i)
      let mut w: u32 = 0
      while w < 2 {
        let frame = Mem.at(Reg.Rsp, u32.wrappingToI32(v * SLOT_BYTES + w * 8))
        let block = word(Reg.R11, base + v * SLOT_BYTES + w * 8)
        if out { run self.a.load(Width.W64, Reg.R9, frame) run self.a.store(Width.W64, block, Reg.R9) }
        else { run self.a.load(Width.W64, Reg.R9, block) run self.a.store(Width.W64, frame, Reg.R9) }
        w = w + 1
      }
      i = i + 1
    }
  }
  /// The entry of code that makes calls: a run after EXIT_CALL (the call block's word 0 is
  /// nonzero) jumps to its resume point with word 0 in RAX and the block in R11.
  effect fn resume(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let fresh = run self.a.label()
    run self.callBlock(Reg.R11)
    run self.a.test(Width.W64, Reg.R11, Reg.R11)
    run self.a.jcc(Cond.Equal, fresh)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, 0))
    run self.a.test(Width.W64, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.Equal, fresh)
    run self.a.mov(Width.W64, Reg.R8, Reg.Rax)
    run self.a.shiftImm(Shift.Shr, Width.W64, Reg.R8, 2)
    let mut point: u32 = 0
    while point < usize.toU32(self.resumeLabels.length()) {
      run self.a.aluImm(Alu.Cmp, Width.W64, Reg.R8, u32.wrappingToI32(point + 1))
      run self.a.jcc(Cond.Equal, self.resumeLabels.get(u32.toUsize(point)))
      point = point + 1
    }
    run self.a.ud2()
    self.a.bind(fresh)
  }
  /// Calls helper index with env as its first argument (the caller has set the others from
  /// RSI on), then reloads the inputs the code keeps in registers. The result is in RAX.
  pub effect fn callHelper(self: &mut Self, index: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let atE = self.input(INPUT_ENV) run self.a.load(Width.W64, Reg.Rdi, atE)
    run self.a.callMem(Mem.at(Reg.Rdi, helpers.helperOffset(index)))
    run self.reloadInputs()
  }
  /// Reloads the ABI inputs the code keeps in registers (RDI to RCX) after a C call.
  effect fn reloadInputs(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let at0 = self.input(0) run self.a.load(Width.W64, Reg.Rdi, at0)
    let at1 = self.input(1) run self.a.load(Width.W64, Reg.Rsi, at1)
    let at2 = self.input(2) run self.a.load(Width.W64, Reg.Rdx, at2)
    let at3 = self.input(3) run self.a.load(Width.W64, Reg.Rcx, at3)
  }
  /// The stress configuration: every guard also fails on every Nth check.
  effect fn stressGuard(self: &mut Self, exit: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.settings.stress == 0 { return () }
    let pass = run self.a.label()
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rcx, 0), 1)
    run self.a.jcc(Cond.Greater, pass)
    run self.a.storeImm(Width.W32, Mem.at(Reg.Rcx, 0), u32.wrappingToI32(self.settings.stress))
    run self.a.jmp(self.exitLabels.get(u32.toUsize(exit)))
    self.a.bind(pass)
  }
  /// A direct call from machine code (docs/jit/compiled-entry.md 7.7), with the call area
  /// and site written and the block in R11: a bytecode closure linked to code that makes no
  /// calls and that a direct call through CALL_FAST has prepared (CompiledEntry.directArity
  /// at most count) runs at once, through the runtime's entry table, on a frame built at
  /// CALL_FRAME. Falls through with the block in R11 when it returned (its result at
  /// CALL_STATE); goes to left, with CALL_CALLEE_EXIT set, when it left at a deopt or poll;
  /// goes to helper for anything else, nothing written.
  effect fn directCall(self: &mut Self, count: u32, helper: Label, left: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let area = u32.wrappingMultiply(usize.toU32(compiled.CALL_AREA), 8)
    let f = u32.wrappingMultiply(usize.toU32(compiled.CALL_FRAME), 8)
    run self.a.loadZero8(Reg.Rax, word(Reg.R11, area))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(compiled.DIRECT_OBJECT_TAG))
    run self.a.jcc(Cond.NotEqual, helper)
    run self.a.load(Width.W64, Reg.R10, word(Reg.R11, area + 8))
    run self.a.loadZero16(Reg.Rax, Mem.at(Reg.R10, compiled.DIRECT_OBJECT_CLASS))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(compiled.DIRECT_BYTECODE_CLASS))
    run self.a.jcc(Cond.NotEqual, helper)
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_BYTECODE))
    run self.a.load(Width.W32, Reg.Rax, Mem.at(Reg.R8, compiled.DIRECT_BYTECODE_INDEX))
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.Equal, helper)
    let atF = self.input(INPUT_FRAME) run self.a.load(Width.W64, Reg.Rsi, atF)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.Rsi, FRAME_RUNTIME))
    run self.a.aluLoad(Alu.Cmp, Width.W32, Reg.Rax, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_COUNT))
    run self.a.jcc(Cond.Above, helper)
    run self.a.loadZero8(Reg.Rcx, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_OBSERVE))
    run self.a.testImm(Width.W32, Reg.Rcx, 1)
    run self.a.jcc(Cond.NotEqual, helper)
    run self.a.store(Width.W64, word(Reg.R11, u32.wrappingMultiply(usize.toU32(compiled.CALL_INDEX), 8)), Reg.Rax)
    // The entry: entries + (index - 1) * its size.
    run self.a.aluImm(Alu.Sub, Width.W32, Reg.Rax, 1)
    run self.a.imulImm(Width.W64, Reg.Rax, Reg.Rax, u32.wrappingToI32(compiled.DIRECT_ENTRY_BYTES))
    run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_ENTRIES))
    run self.a.alu(Alu.Add, Width.W64, Reg.Rdx, Reg.Rax)
    run self.a.load(Width.W32, Reg.Rcx, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_ARITY))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rcx, u32.wrappingToI32(count))
    run self.a.jcc(Cond.Above, helper)
    let nested = run self.a.label()
    let counted = run self.a.label()
    run self.a.load(Width.W32, Reg.Rcx, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_CALL_WORDS))
    run self.a.test(Width.W32, Reg.Rcx, Reg.Rcx)
    run self.a.jcc(Cond.NotEqual, nested)
    // The callee's frame (js_compiled.CompiledFrame): receiver cell, bytecode, realm, runtime,
    // captured cells (a non-null filler when none), scope, no call block, code, no activation.
    run self.a.lea(Width.W64, Reg.Rcx, word(Reg.R11, area + SLOT_BYTES))
    run self.a.store(Width.W64, word(Reg.R11, f), Reg.Rcx)
    run self.a.store(Width.W64, word(Reg.R11, f + 8), Reg.R8)
    run self.a.load(Width.W64, Reg.Rcx, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_REALM))
    run self.a.store(Width.W64, word(Reg.R11, f + 16), Reg.Rcx)
    run self.a.store(Width.W64, word(Reg.R11, f + 24), Reg.R9)
    run self.a.load(Width.W64, Reg.Rcx, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_REFERENCES))
    run self.a.lea(Width.W64, Reg.Rax, Mem.at(Reg.Rcx, compiled.DIRECT_BOX_DATA))
    run self.a.test(Width.W64, Reg.Rcx, Reg.Rcx)
    run self.a.cmov(Cond.Equal, Width.W64, Reg.Rax, Reg.R11)
    run self.a.store(Width.W64, word(Reg.R11, f + 32), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rcx, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_SCOPE))
    run self.a.store(Width.W64, word(Reg.R11, f + 40), Reg.Rcx)
    run self.a.storeImm(Width.W64, word(Reg.R11, f + 48), 0)
    run self.a.load(Width.W64, Reg.Rcx, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_SOURCE))
    run self.a.store(Width.W64, word(Reg.R11, f + 56), Reg.Rcx)
    run self.a.storeImm(Width.W64, word(Reg.R11, f + 64), 0)
    run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_RUNS), 1)
    // The compiled-entry ABI: cells, state, counter, data, env, frame.
    run self.a.mov(Width.W64, Reg.R10, Reg.Rdx)
    run self.a.lea(Width.W64, Reg.Rdi, word(Reg.R11, area + 2 * SLOT_BYTES))
    run self.a.lea(Width.W64, Reg.Rsi, word(Reg.R11, u32.wrappingMultiply(usize.toU32(compiled.CALL_STATE), 8)))
    run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.R10, compiled.DIRECT_ENTRY_COUNTER))
    run self.a.load(Width.W64, Reg.Rcx, Mem.at(Reg.R10, compiled.DIRECT_ENTRY_DATA))
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, compiled.DIRECT_ENTRY_ENV))
    run self.a.lea(Width.W64, Reg.R9, word(Reg.R11, f))
    run self.a.callMem(Mem.at(Reg.R10, compiled.DIRECT_ENTRY_CODE))
    run self.reloadInputs()
    run self.callBlock(Reg.R11)
    let returned = run self.a.label()
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.Equal, returned)
    // Left: the exit code and the callee's index, for compiledCall to finish it interpreted.
    run self.a.mov(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.load(Width.W64, Reg.Rcx, word(Reg.R11, u32.wrappingMultiply(usize.toU32(compiled.CALL_INDEX), 8)))
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.Rcx, 32)
    run self.a.alu(Alu.Or, Width.W64, Reg.Rax, Reg.Rcx)
    run self.a.store(Width.W64, word(Reg.R11, u32.wrappingMultiply(usize.toU32(compiled.CALL_CALLEE_EXIT), 8)), Reg.Rax)
    run self.a.jmp(left)
    self.a.bind(returned)
    run self.a.jmp(counted)
    self.a.bind(nested)
    run self.nestedCall(count, helper, left, counted)
    self.a.bind(counted)
    let atE = self.input(INPUT_ENV) run self.a.load(Width.W64, Reg.R10, atE)
    run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.R10, helpers.DIRECT_CALLS_OFFSET), 1)
  }
  /// directCall for a callee whose code makes calls, with R10 its closure, R8 its bytecode,
  /// R9 the runtime, RDX its entry and RSI the caller's frame: pushes its activation
  /// (js_vm.Activation, DIRECT_ACT_*) as js_vm.fastCall would and runs it nested. Goes to
  /// returned with the result at CALL_STATE and the activation popped; to left with the block
  /// CALLEE_PUSHED (the runner continues it); to helper, nothing changed, when it is too deep
  /// or the stack has no room.
  effect fn nestedCall(self: &mut Self, count: u32, helper: Label, left: Label, returned: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let area = u32.wrappingMultiply(usize.toU32(compiled.CALL_AREA), 8)
    let f = u32.wrappingMultiply(usize.toU32(compiled.CALL_FRAME), 8)
    let header = compiled.DIRECT_ACTIVATION_HEADER * 8
    run self.a.load(Width.W32, Reg.Rax, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_DEPTH))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, u32.wrappingToI32(compiled.DIRECT_NESTING))
    run self.a.jcc(Cond.AboveOrEqual, helper)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_CAPACITY))
    run self.a.aluLoad(Alu.Sub, Width.W64, Reg.Rax, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_TOP))
    run self.a.load(Width.W32, Reg.Rcx, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_WORDS))
    run self.a.alu(Alu.Cmp, Width.W64, Reg.Rcx, Reg.Rax)
    run self.a.jcc(Cond.Above, helper)
    // Push: the record at activations + top words, the new top past its words.
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_TOP))
    run self.a.alu(Alu.Add, Width.W64, Reg.Rcx, Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_TOP), Reg.Rcx)
    run self.a.mov(Width.W64, Reg.Rcx, Reg.Rax)
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.Rcx, 3)
    run self.a.aluLoad(Alu.Add, Width.W64, Reg.Rcx, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_ACTIVATIONS))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_MARK), Reg.Rax)
    run self.a.store(Width.W64, word(Reg.R11, f), Reg.Rcx)
    run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_DEPTH), 1)
    run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_RUNS), 1)
    // Its CompiledFrame: receiver cell, bytecode, realm, runtime, captured cells (the record
    // as a non-null filler when none), scope, its call block, code, itself.
    run self.a.lea(Width.W64, Reg.Rax, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_RECEIVER))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 0), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 8), Reg.R8)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_REALM))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 16), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 24), Reg.R9)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_REFERENCES))
    run self.a.lea(Width.W64, Reg.Rdi, Mem.at(Reg.Rax, compiled.DIRECT_BOX_DATA))
    run self.a.test(Width.W64, Reg.Rax, Reg.Rax)
    run self.a.cmov(Cond.Equal, Width.W64, Reg.Rdi, Reg.Rcx)
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 32), Reg.Rdi)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R10, compiled.DIRECT_CLOSURE_SCOPE))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 40), Reg.Rax)
    run self.a.lea(Width.W64, Reg.Rdi, Mem.at(Reg.Rcx, header))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 48), Reg.Rdi)
    run self.a.storeImm(Width.W64, Mem.at(Reg.Rdi, 0), 0)
    run self.a.storeImm(Width.W64, Mem.at(Reg.Rdi, u32.wrappingToI32(u32.wrappingMultiply(usize.toU32(compiled.CALL_CALLEE_EXIT), 8))), 0)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_SOURCE))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, 56), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.FRAME_ACTIVATION), Reg.Rcx)
    // Its exit state after the block, then Prepared, cells, stack frame and the rest.
    run self.a.load(Width.W32, Reg.Rax, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_CALL_WORDS))
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.Rax, 3)
    run self.a.alu(Alu.Add, Width.W64, Reg.Rax, Reg.Rdi)
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_STATE), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_CODE))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_PREPARED), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_DATA))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_PREPARED + 8), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_ENV))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_PREPARED + 16), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rdx, compiled.DIRECT_ENTRY_COUNTER))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_PREPARED + 24), Reg.Rax)
    run self.a.lea(Width.W64, Reg.Rax, word(Reg.R11, area + 2 * SLOT_BYTES))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_CELLS), Reg.Rax)
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_ARGV), Reg.Rax)
    run self.a.storeImm(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_ARGV + 8), u32.wrappingToI32(count))
    run self.a.lea(Width.W64, Reg.Rax, Mem.at(Reg.Rcx, compiled.DIRECT_ACTIVATION_WORDS * 8))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_STACK_FRAME), Reg.Rax)
    // No pc yet (NO_PC), not published, the bytecode's mode.
    run self.a.storeImm(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_PC), -1)
    run self.a.loadZero8(Reg.Rax, Mem.at(Reg.R8, compiled.DIRECT_BYTECODE_MODE))
    run self.a.shiftImm(Shift.Shl, Width.W32, Reg.Rax, 8)
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_PUBLISHED), Reg.Rax)
    // The function and receiver, borrowed from the area.
    run self.a.load(Width.W64, Reg.Rax, word(Reg.R11, area))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_FUNCTION), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, word(Reg.R11, area + 8))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_FUNCTION + 8), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, word(Reg.R11, area + SLOT_BYTES))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_RECEIVER), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, word(Reg.R11, area + SLOT_BYTES + 8))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_RECEIVER + 8), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rsi, compiled.FRAME_ACTIVATION))
    run self.a.store(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_PARENT), Reg.Rax)
    run self.a.load(Width.W32, Reg.Rax, word(Reg.R11, u32.wrappingMultiply(usize.toU32(compiled.CALL_INDEX), 8)))
    run self.a.store(Width.W32, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_INDEX), Reg.Rax)
    run self.a.storeImm(Width.W32, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_INDEX + 4), u32.wrappingToI32(compiled.DIRECT_COPY_ARGUMENTS))
    // Fresh (EXIT_FRESH), not known.
    run self.a.storeImm(Width.W64, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_EXIT), u32.wrappingToI32(compiled.EXIT_FRESH))
    // The compiled-entry ABI: cells, state, counter, data, env, its frame (the record).
    run self.a.mov(Width.W64, Reg.R10, Reg.Rdx)
    run self.a.mov(Width.W64, Reg.R9, Reg.Rcx)
    run self.a.lea(Width.W64, Reg.Rdi, word(Reg.R11, area + 2 * SLOT_BYTES))
    run self.a.load(Width.W64, Reg.Rsi, Mem.at(Reg.Rcx, compiled.DIRECT_ACT_STATE))
    run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.R10, compiled.DIRECT_ENTRY_COUNTER))
    run self.a.load(Width.W64, Reg.Rcx, Mem.at(Reg.R10, compiled.DIRECT_ENTRY_DATA))
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, compiled.DIRECT_ENTRY_ENV))
    run self.a.callMem(Mem.at(Reg.R10, compiled.DIRECT_ENTRY_CODE))
    run self.reloadInputs()
    run self.callBlock(Reg.R11)
    // Back: one level shallower. Only RAX and R8-R10 are free (the inputs are reloaded).
    run self.a.load(Width.W64, Reg.R10, word(Reg.R11, f))
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R10, 24))
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_DEPTH), 1)
    let exited = run self.a.label()
    let published = run self.a.label()
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.NotEqual, exited)
    // Returned: the owned result to CALL_STATE, then pop.
    run self.a.load(Width.W64, Reg.R8, Mem.at(Reg.R10, compiled.DIRECT_ACT_STATE))
    let into = u32.wrappingMultiply(usize.toU32(compiled.CALL_STATE), 8)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R8, 0))
    run self.a.store(Width.W64, word(Reg.R11, into), Reg.Rax)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R8, 8))
    run self.a.store(Width.W64, word(Reg.R11, into + 8), Reg.Rax)
    run self.a.loadZero8(Reg.Rax, Mem.at(Reg.R10, compiled.DIRECT_ACT_PUBLISHED))
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.NotEqual, published)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R10, compiled.DIRECT_ACT_MARK))
    run self.a.store(Width.W64, Mem.at(Reg.R9, compiled.DIRECT_RUNTIME_TOP), Reg.Rax)
    run self.a.jmp(returned)
    self.a.bind(published)
    run self.a.mov(Width.W64, Reg.Rsi, Reg.R10)
    run self.callHelper(helpers.CALL_POP)
    run self.callBlock(Reg.R11)
    run self.a.jmp(returned)
    // Left: the runner continues it from its recorded exit (CALLEE_PUSHED, the record at
    // CALL_STATE), as for CALL_FAST.
    self.a.bind(exited)
    run self.a.store(Width.W32, Mem.at(Reg.R10, compiled.DIRECT_ACT_EXIT), Reg.Rax)
    run self.a.store(Width.W64, word(Reg.R11, into), Reg.R10)
    run self.a.storeImm(Width.W64, word(Reg.R11, u32.wrappingMultiply(usize.toU32(compiled.CALL_CALLEE_EXIT), 8)), -1)
    run self.a.jmp(left)
  }
  /// Restores the stack and returns code.
  effect fn leave(self: &mut Self, code: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.unwind()
    run self.a.movImm32(Reg.Rax, code)
    run self.a.ret()
  }
  /// Frees the frame and pops the saved registers (the prologue in reverse). Keeps RAX.
  pub effect fn unwind(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.frame != 0 { run self.a.aluImm(Alu.Add, Width.W64, Reg.Rsp, self.frame) }
    let mut r = gprCount()
    while r > 0 { r = r - 1 if self.saves(r) { run self.a.pop(gprAt(r)) } }
  }
  effect fn exitStub(self: &mut Self, function: &Function, index: u32, owner: Inst) -> () ! OutOfMemoryError ? &mut Allocator {
    let exit = function.exit(index)
    self.a.bind(self.exitLabels.get(u32.toUsize(index)))
    run self.a.movImm32(Reg.Rax, exit.pc)
    run self.a.store(Width.W64, Mem.at(Reg.Rsi, 0), Reg.Rax)
    run self.a.movImm32(Reg.Rax, exit.stackDepth)
    run self.a.store(Width.W64, Mem.at(Reg.Rsi, 8), Reg.Rax)
    // One ValueBits per local and stack slot, each owning what the interpreter's would.
    let count = function.localCount + exit.stackDepth
    let mut i: u32 = 0
    while i < count {
      let slot = function.slot(exit, i)
      run self.valueInto(&function, slot.value, slot.mode, Reg.Rsi, 16 + i * SLOT_BYTES)
      i = i + 1
    }
    // A poll's exit is the loop target after a back edge: interrupt, not deopt. A call's
    // returns the status its result slot holds.
    if owner.op == Op.Call {
      run self.a.load(Width.W32, Reg.Rax, slotOf(owner.result))
      run self.unwind()
      run self.a.ret()
      return ()
    }
    let mut code = EXIT_DEOPT
    if owner.op == Op.Poll { code = EXIT_POLL }
    run self.leave(code)
  }
}

/// The tag field and payload of an `Imm` constant.
fn immTag(layout: &ValueLayout, k: i32) -> u32 {
  if k >= ssa.IMM_CATCH { return layout.catchOffset() }
  if k == 0 { return layout.undefined() }
  if k == 1 { return layout.null() }
  if k == 2 || k == 3 { return layout.boolean() }
  return layout.uninitialized()
}
fn immPayload(k: i32) -> i32 { if k >= ssa.IMM_CATCH { return k - ssa.IMM_CATCH } if k == 3 { return 1 } return 0 }
/// The comparison k's negation, for i32 operands (there is no NaN).
fn opposite(k: i32) -> i32 {
  if k == 0 { return 3 }
  if k == 1 { return 2 }
  if k == 2 { return 1 }
  if k == 3 { return 0 }
  if k == 4 { return 5 }
  return 4
}
fn condition(k: i32) -> Cond {
  if k == 0 { return Cond.Less }
  if k == 1 { return Cond.LessOrEqual }
  if k == 2 { return Cond.Greater }
  if k == 3 { return Cond.GreaterOrEqual }
  if k == 4 { return Cond.Equal }
  return Cond.NotEqual
}
