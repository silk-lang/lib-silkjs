    }
    if op == Op.Mul && inst.b != NONE && positiveConstant(self.constants.get(u32.toUsize(inst.b))) > 0 {
      // By a positive constant: no -0, for a zero product has a zero first operand.
      let factor = positiveConstant(self.constants.get(u32.toUsize(inst.b)))
      let place = self.at(inst.a) run getI32(&mut self.a, Reg.Rax, place)
      run self.stressGuard(inst.exit)
      run self.a.imulImm(Width.W32, Reg.Rax, Reg.Rax, factor)
      run self.a.jcc(Cond.Overflow, self.exitLabels.get(u32.toUsize(inst.exit)))
      run self.a.mov(Width.W32, Reg.Rax, Reg.Rax)
