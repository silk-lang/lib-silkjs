//! x86-64 lowering of the number operations of the SSA form (docs/jit/doubles.md): unboxed
//! doubles with SSE2 and the int32 operators beyond add, sub and mul. x64_backend calls
//! `lowerNumber` for every operation `ssa.isNumberOp` names, with the memory operands of the
//! operation's values and the label of its exit. An f64 value's slot holds its 64 bits; an i32
//! slot holds the value zero-extended, a bool 0 or 1, as everywhere in x64_backend.
//!
//! Registers: rax, r8, r9, r10, r11 and xmm0, xmm1 are scratch. rcx and rdx hold the stress
//! word and the interrupt counter (the entry ABI's arguments): a shift by a variable count and
//! a division need them, so those save them in r10 and r11 and restore them before anything
//! can leave.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u8
import silk.num.u64
import asm_x64 { Alu, Assembler, Cond, Label, Mem, PackedOp, Reg, ScalarOp, Shift, Unary, Width, Xmm }
import ssa { Function, Inst, Op, Cmp }

const SIGN: u64 = 0x8000000000000000
const MAGNITUDE: u64 = 0x7fffffffffffffff

/// Lowers `inst`, a number operation. `left`, `right` and `out` are the slots of its operands
/// and result (`right` and `out` unused when the operation has none); `exit` is its exit's
/// label when it has one.
pub effect fn lowerNumber(a: &mut Assembler, f: &Function, inst: Inst, left: Mem, right: Mem, out: Mem, exit: Label) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  let op = inst.op
  if op == Op.ConstF64 {
    run a.movImm64(Reg.Rax, f.numbers.get(i32.toUsize(inst.k)))
    run a.store(Width.W64, out, Reg.Rax)
    return ()
  }
  if op == Op.ToF64 {
    run a.load(Width.W32, Reg.Rax, left)
    run a.intToDouble(Width.W32, Xmm.Xmm0, Reg.Rax)
    run a.storeDouble(out, Xmm.Xmm0)
    return ()
  }
  if op == Op.AddF64 || op == Op.SubF64 || op == Op.MulF64 || op == Op.DivF64 {
    let mut scalar = ScalarOp.Add
    if op == Op.SubF64 { scalar = ScalarOp.Sub } else if op == Op.MulF64 { scalar = ScalarOp.Mul } else if op == Op.DivF64 { scalar = ScalarOp.Div }
    run a.loadDouble(Xmm.Xmm0, left)
    run a.scalarLoad(scalar, Xmm.Xmm0, right)
    run a.storeDouble(out, Xmm.Xmm0)
    return ()
  }
  if op == Op.SqrtF64 {
    run a.scalarLoad(ScalarOp.Sqrt, Xmm.Xmm0, left)
    run a.storeDouble(out, Xmm.Xmm0)
    return ()
  }
  if op == Op.NegF64 || op == Op.AbsF64 {
    // Sign bit flipped or cleared on the bits; no NaN or -0 special case is needed.
    run a.load(Width.W64, Reg.Rax, left)
    if op == Op.NegF64 { run a.movImm64(Reg.R8, SIGN) run a.alu(Alu.Xor, Width.W64, Reg.Rax, Reg.R8) }
    else { run a.movImm64(Reg.R8, MAGNITUDE) run a.alu(Alu.And, Width.W64, Reg.Rax, Reg.R8) }
    run a.store(Width.W64, out, Reg.Rax)
    return ()
  }
  if op == Op.CmpF64 {
    run a.loadDouble(Xmm.Xmm0, left)
    run a.loadDouble(Xmm.Xmm1, right)
    run a.movImm32(Reg.R9, 0)
    run compareDoubles(&mut a, inst.k)
    run a.store(Width.W64, out, Reg.R9)
    return ()
  }
  if op == Op.ToInt32 {
    // A truncation that fits int64 has ToInt32 as its low half; NaN, the infinities and
    // everything else out of range give the int64 minimum, which leaves.
    run a.loadDouble(Xmm.Xmm0, left)
    run a.doubleToInt(Width.W64, Reg.Rax, Xmm.Xmm0)
    run a.movImm64(Reg.R8, SIGN)
    run a.alu(Alu.Cmp, Width.W64, Reg.Rax, Reg.R8)
    run a.jcc(Cond.Equal, exit)
    run a.mov(Width.W32, Reg.Rax, Reg.Rax)
    run a.store(Width.W64, out, Reg.Rax)
    return ()
  }
  if op == Op.ExactI32 {
    // Exactly an int32 and not -0: truncate, convert back, compare; a zero result needs a
    // clear sign bit.
    run a.loadDouble(Xmm.Xmm0, left)
    run a.doubleToInt(Width.W32, Reg.Rax, Xmm.Xmm0)
    run a.intToDouble(Width.W32, Xmm.Xmm1, Reg.Rax)
    run a.packed(PackedOp.Ucomisd, Xmm.Xmm0, Xmm.Xmm1)
    run a.jcc(Cond.Parity, exit)
    run a.jcc(Cond.NotEqual, exit)
    let fine = run a.label()
    run a.test(Width.W32, Reg.Rax, Reg.Rax)
    run a.jcc(Cond.NotEqual, fine)
    run a.load(Width.W64, Reg.R8, left)
    run a.test(Width.W64, Reg.R8, Reg.R8)
    run a.jcc(Cond.Sign, exit)
    a.bind(fine)
    run a.mov(Width.W32, Reg.Rax, Reg.Rax)
    run a.store(Width.W64, out, Reg.Rax)
    return ()
  }
  if op == Op.NotBool {
    run a.load(Width.W32, Reg.Rax, left)
    run a.aluImm(Alu.Xor, Width.W32, Reg.Rax, 1)
    run a.store(Width.W64, out, Reg.Rax)
    return ()
  }
  if op == Op.BitNot || op == Op.Neg {
    run a.load(Width.W32, Reg.Rax, left)
    if op == Op.BitNot { run a.unary(Unary.Not, Width.W32, Reg.Rax) }
    else {
      // -0 and the overflow of the minimum make doubles in the interpreter.
      run a.test(Width.W32, Reg.Rax, Reg.Rax)
      run a.jcc(Cond.Equal, exit)
      run a.unary(Unary.Neg, Width.W32, Reg.Rax)
      run a.jcc(Cond.Overflow, exit)
    }
    run a.store(Width.W64, out, Reg.Rax)
    return ()
  }
  if op == Op.BitAnd || op == Op.BitOr || op == Op.BitXor {
    let mut alu = Alu.And
    if op == Op.BitOr { alu = Alu.Or } else if op == Op.BitXor { alu = Alu.Xor }
    run a.load(Width.W32, Reg.Rax, left)
    run a.aluLoad(alu, Width.W32, Reg.Rax, right)
    run a.store(Width.W64, out, Reg.Rax)
    return ()
  }
  if op == Op.Shl || op == Op.Sar || op == Op.Shr {
    let mut shift = Shift.Shl
    if op == Op.Sar { shift = Shift.Sar } else if op == Op.Shr { shift = Shift.Shr }
    run a.mov(Width.W64, Reg.R10, Reg.Rcx)
    run a.load(Width.W32, Reg.Rax, left)
    run a.load(Width.W32, Reg.Rcx, right)
    // The 32-bit shift takes its count modulo 32, as JavaScript does.
    run a.shiftCl(shift, Width.W32, Reg.Rax)
    run a.mov(Width.W64, Reg.Rcx, Reg.R10)
    if op == Op.Shr {
      // An unsigned result past the int32 maximum is a double in the interpreter.
      run a.test(Width.W32, Reg.Rax, Reg.Rax)
      run a.jcc(Cond.Sign, exit)
    }
    run a.store(Width.W64, out, Reg.Rax)
    return ()
  }
  if op == Op.Mod {
    // Only a positive divisor (no zero, no -1 fault), and never a -0 result.
    run a.load(Width.W32, Reg.R8, right)
    run a.test(Width.W32, Reg.R8, Reg.R8)
    run a.jcc(Cond.LessOrEqual, exit)
    run a.mov(Width.W64, Reg.R11, Reg.Rdx)
    run a.load(Width.W32, Reg.Rax, left)
    run a.mov(Width.W32, Reg.R9, Reg.Rax)
    run a.signExtendAccumulator(Width.W32)
    run a.unary(Unary.Idiv, Width.W32, Reg.R8)
    run a.mov(Width.W32, Reg.Rax, Reg.Rdx)
    run a.mov(Width.W64, Reg.Rdx, Reg.R11)
    let fine = run a.label()
    run a.test(Width.W32, Reg.Rax, Reg.Rax)
    run a.jcc(Cond.NotEqual, fine)
    run a.test(Width.W32, Reg.R9, Reg.R9)
    run a.jcc(Cond.Sign, exit)
    a.bind(fine)
    run a.store(Width.W64, out, Reg.Rax)
    return ()
  }
  Intrinsic.trap("x64_backend_float: unlowered number operation")
}

/// Sets r9 (cleared by the caller) to the comparison `k` of xmm0 with xmm1, false when either
/// is NaN except for `ne`.
effect fn compareDoubles(a: &mut Assembler, k: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  if k == u8.toI32(Cmp.value(Cmp.Lt)) { run a.packed(PackedOp.Ucomisd, Xmm.Xmm1, Xmm.Xmm0) run a.setcc(Cond.Above, Reg.R9) return () }
  if k == u8.toI32(Cmp.value(Cmp.Le)) { run a.packed(PackedOp.Ucomisd, Xmm.Xmm1, Xmm.Xmm0) run a.setcc(Cond.AboveOrEqual, Reg.R9) return () }
  if k == u8.toI32(Cmp.value(Cmp.Gt)) { run a.packed(PackedOp.Ucomisd, Xmm.Xmm0, Xmm.Xmm1) run a.setcc(Cond.Above, Reg.R9) return () }
  if k == u8.toI32(Cmp.value(Cmp.Ge)) { run a.packed(PackedOp.Ucomisd, Xmm.Xmm0, Xmm.Xmm1) run a.setcc(Cond.AboveOrEqual, Reg.R9) return () }
  run a.movImm32(Reg.R10, 0)
  run a.packed(PackedOp.Ucomisd, Xmm.Xmm0, Xmm.Xmm1)
  if k == u8.toI32(Cmp.value(Cmp.Eq)) {
    run a.setcc(Cond.Equal, Reg.R9) run a.setcc(Cond.NoParity, Reg.R10) run a.alu(Alu.And, Width.W32, Reg.R9, Reg.R10)
  } else {
    run a.setcc(Cond.NotEqual, Reg.R9) run a.setcc(Cond.Parity, Reg.R10) run a.alu(Alu.Or, Width.W32, Reg.R9, Reg.R10)
  }
}

/// Whether x64_backend can lower `op` today. Boxing a double, unboxing one from a boxed value
/// and writing one to an exit need the 16-byte value layout (J's ABI) and wait for it.
pub fn lowersNumber(op: Op) -> bool { return op != Op.UnboxF64 && op != Op.BoxF64 }
