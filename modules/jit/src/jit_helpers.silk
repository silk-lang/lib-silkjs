//! The environment compiled code receives as its fifth argument (CompiledEntry.env), and the
//! numbering of the runtime helpers it calls.
//!
//! Compiled code names a helper by its index into `CompiledEnv.helpers`, never by address, so
//! the code bytes hold no process-local pointer (ahead-of-time compilation). The JIT fills the
//! table once per runtime. Indices are partitioned by workstream so they can be added without
//! colliding: J (objects) 0-31, H (calls) 32-63, I (loops) 64-95, K (numbers) 96-127.
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.num.u32
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_gc as gc

pub const HELPER_COUNT: usize = 128

// ---- J: 0-31 ----
/// release(env, value: *const ValueBits): drops the count the value owns (gc.releaseDeferred).
pub const RELEASE: u32 = 0

/// The layout compiled code reads: offsets below are part of the code ABI.
pub struct CompiledEnv {
  /// The runtime the code runs in (offset 0).
  pub runtime: ?*mut HeapHeader,
  /// Helper entry points, at offset 8 + 8 * index; null where none is installed.
  pub helpers: [?*const u8; 128]
}
impl Copy for CompiledEnv {}

/// The byte offset of helper `index` in a CompiledEnv.
pub fn helperOffset(index: u32) -> i32 { return u32.wrappingToI32(8 + index * 8) }

impl CompiledEnv {
  /// An environment with every helper this module defines installed.
  pub fn make() -> CompiledEnv {
    let mut env = CompiledEnv { runtime: Pointer.null<HeapHeader>(), helpers: [Pointer.null<u8>(); 128] }
    let release: extern "C" fn(*mut CompiledEnv, *const ValueBits) -> () = jitRelease
    env.helpers[u32.toUsize(RELEASE)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut CompiledEnv, *const ValueBits) -> (), *const ?*const u8>(Pointer.fromRef(&release)))
    return env
  }
}

export "C" fn jitRelease(env: *mut CompiledEnv, value: *const ValueBits) -> () {
  unsafe gc.releaseDeferred(unsafe Pointer.read<ValueBits>(value))
}
