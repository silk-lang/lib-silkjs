e2: pc 26 locals [dup v0 (arg 0), int v7, int v6] stack []
e3: pc 16 locals [dup v0 (arg 0), int v7, int v9] stack []
"""

test effect fn goldenSumLoop() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run expectSsa(b"function sum(n){var s=0;for(var i=0;i<n;i++)s+=i;return s} sum(3); sum", SUM,
    "sum of 0..n: i32 loop parameters, no reference counting, guards resume with the argument dup'd")
}

test effect fn goldenArithmetic() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run expectSsa(b"function f(a,b,c){return a+b*c} f(1,2,3); f", ARITH, "a + b * c: guards and overflow exits only")
}

test effect fn goldenObjectPassThrough() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run expectSsa(b"function id(o){return o} id({}); id", PASS, "returning an argument retains it exactly once")
}

test effect fn goldenBorrowedField() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run expectSsa(b"function ch(p){return p.q.x} ch({q:{x:1}}); ch", BORROWED_FIELD, "p.q is read borrowed: no count, no release")
}

const TOTAL_SOURCE: &[u8] = b"function total(a){var s=0;for(var i=0;i<a.length;i++)s=s+a[i];return s} total([1,2]); total"
const GLOBAL_SOURCE: &[u8] = b"var g=[1,2];function sum(n){var s=0;for(var i=0;i<n;i++){s=s+g[i]}return s} sum(2); sum"

test effect fn goldenBorrowedElements() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run expectPasses(TOTAL_SOURCE, ssa_opt.PASS_BORROW, TOTAL_BORROWED, "a[i] and a.length are read borrowed from the argument: no count, no release")
}

test effect fn goldenHoistedLength() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run expectPasses(TOTAL_SOURCE, u32.bitOr(ssa_opt.PASS_BORROW, ssa_opt.PASS_HOIST), TOTAL_HOISTED,
    "a.length and its unbox move to a block in front of the loop, with the state at the loop's header as their exit")
  run expectPasses(GLOBAL_SOURCE, u32.bitOr(ssa_opt.PASS_BORROW, ssa_opt.PASS_HOIST), GLOBAL_HOISTED, "a global read once in front of a loop that stores to no binding")
}

test effect fn goldenUnboxedExits() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run expectPasses(TOTAL_SOURCE, ssa_opt.PASS_ALL, TOTAL_UNBOXED, "the exits after an element's unbox name its number, not the element")
}

test effect fn goldenHoistedInLoopEntry() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run expectAt(TOTAL_SOURCE, u32.bitOr(ssa_opt.PASS_BORROW, ssa_opt.PASS_HOIST), 10, TOTAL_OSR_HOISTED,
    "in code entered at the loop, a.length moves in front of the loop and exits with the state the entry brought")
}

test effect fn goldenMax() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run expectSsa(b"function max(a,b){if(a>b)return a;return b} max(1,2); max", MAX, "max of two: one retain on each return path")
}

test effect fn goldenLoopWithConditional() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run expectSsa(b"function g(n){var t=0;for(var i=0;i<n;i++){if(i<5)t+=i;else t-=1}return t} g(3); g", LOOP_IF,
    "a loop with a conditional joins i32 values in a block parameter")
}

test effect fn goldenObjectKeptThroughLoop() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run expectSsa(b"function sel(o,n){var x=o;var s=0;for(var i=0;i<n;i++){s+=i;x=o}if(s<0)return x;return s} sel({},3); sel", KEEP,
    "an object held in a local across a loop stays borrowed and is retained only where it is returned")
}

test effect fn goldenCall() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run expectSsa(b"function c(g,x){return g(x,2)} c(function(){return 1},0); c", CALL,
    "a call passes borrowed operands, keeps them on the stack for its throw exit and owns its result")
}

test effect fn translatorRefusals() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  run expectSsa(b"function m(a){return a%1.5} m(1); m", b"refused: % of doubles (fmod)", "a remainder of doubles is refused")
  run expectSsa(b"function s(){return /a/} s(); s", b"refused: opcode outside the subset", "regular expression literals are outside the subset")
  run expectSsa(b"function k(){var x=1;return function(){return x}} k(); k", b"refused: opcode outside the subset", "a function whose locals are captured gets past the scope, to fclosure")
  run expectSsa(b"function inner(){var x=1;return function(){return x}} inner()", b"refused: opcode outside the subset", "a closure reading a captured variable is refused (the engine reads it through its scope)")
  run expectSsa(b"function a(){return arguments.length} a(); a", b"refused: opcode outside the subset", "arguments is outside the subset")
  run expectSsa(b"function* gen(){yield 1} gen().next(); gen", b"refused: generator or async function", "generators are refused")
  run expectSsa(b"function d(o){delete o.x;return 0} d({}); d", b"refused: opcode outside the subset", "delete is outside the subset")
}

test effect fn independentOfTheRuntimeInstance() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  // Ahead-of-time compilation needs inputs and IR that name nothing of one process or runtime:
  // two runtime instances, one of them with other code compiled first, must agree byte for byte.
  let sources: [&[u8]; 4] = [
    b"function obj(o,a,n){var s=0;for(var i=0;i<n;i++){s+=o.x+a[i]+a.length;o.y=s}return s} obj({x:1,y:0},[1,2,3],3); obj",
    b"function sum(n){var s=0;for(var i=0;i<n;i++)s+=i;return s} sum(3); sum",
    b"function sel(o,n){var x=o;var s=0;for(var i=0;i<n;i++){s+=i;x=o}if(s<0)return x;return s} sel({},3); sel",
    b"function max(a,b){if(a>b)return a;return b} max(1,2); max"]
  let mut system = Allocator.systemAllocatorProvider()
  let mut i: usize = 0
  while i < 4 {
    // The property names' atoms and site-cache indices are the runtime's, so their bytecode
    // differs (a loader keys on it with atoms remapped); the IR must not.
    let withInput = i != 0
    let first = run ssaOf(sources[i], withInput, 0, NONE)
    let mut later = List<u8>.make()
    run later.appendSlice(b"var unrelated = {p: 1, q: 'x'}; function other(a){return a.p + unrelated.q} other(unrelated); ")
      |> Effect.provideMut<Allocator>(&mut system)
    run later.appendSlice(sources[i]) |> Effect.provideMut<Allocator>(&mut system)
    let second = run ssaOf(later.asSlice(), withInput, 0, NONE)
    if !same(first.asSlice(), second.asSlice()) {
      StderrWriter.print("first:\n{}\nsecond:\n{}\n", &.(unsafe String.fromUtf8Unchecked(first.asSlice()), unsafe String.fromUtf8Unchecked(second.asSlice())))
    }
    run Testing.expect(same(first.asSlice(), second.asSlice()), "the same function gives the same input and IR in another runtime instance")
    i = i + 1
  }
}

// ---- verifier rejections of hand-built functions ----

/// Compacts and verifies `f`; the failure reason, or "ok".
effect fn verdict(f: &mut Function) -> &'static [u8] ! OutOfMemoryError ? &mut Allocator {
  run f.compact()
  match move run Effect.result(verify(&f.*)) {
    Result.Success { .. } => { return b"ok" }
    Result.Failure { error } => {
      match move error {
        VerifyError { reason, .. } => { return reason }
        OutOfMemoryError { .. } => { fail OutOfMemoryError {} }
      }
    }
  }
}

effect fn expectVerdict(f: &mut Function, expected: &[u8], message: string<'static>) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let got = run verdict(&mut f)
  if !same(got, expected) { StderrWriter.print("verifier said: {}\n", &.(unsafe String.fromUtf8Unchecked(got))) }
  run Testing.expect(same(got, expected), message)
}

/// Block 0 of a one-argument function: `arg 0`, then `retain` of it. Returns the retained value.
effect fn retained(f: &mut Function) -> u32 ! OutOfMemoryError ? &mut Allocator {
  let entry = run f.block()
  let a = run f.emit(entry, Op.Arg, true, Type.Value, Own.Borrowed, NONE, NONE, 0, 0)
  f.setOwnership(a, Own.Borrowed, RootKind.Argument, 0)
  return run f.emit(entry, Op.Retain, true, Type.Value, Own.Owned, a, NONE, 0, 0)
}

effect fn returnUndefined(f: &mut Function, block: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let u = run f.emit(block, Op.Imm, true, Type.Value, Own.Imm, NONE, NONE, u8.toI32(Imm.value(Imm.Undefined)), 0)
  run f.terminate(block, Op.Return, u, NONE, 0)
}

test effect fn verifierAcceptsPassThrough() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  let mut f = Function.make(1, 0)
  let r = run retained(&mut f) |> Effect.provideMut<Allocator>(&mut system)
  run f.terminate(0, Op.Return, r, NONE, 0) |> Effect.provideMut<Allocator>(&mut system)
  run expectVerdict(&mut f, b"ok", "retain then return is balanced") |> Effect.provideMut<Allocator>(&mut system)
}

test effect fn verifierRejectsDoubleRelease() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  let mut f = Function.make(1, 0)
  let r = run retained(&mut f) |> Effect.provideMut<Allocator>(&mut system)
  drop run f.emit(0, Op.Release, false, Type.Value, Own.Owned, r, NONE, 0, 0) |> Effect.provideMut<Allocator>(&mut system)
  drop run f.emit(0, Op.Release, false, Type.Value, Own.Owned, r, NONE, 0, 0) |> Effect.provideMut<Allocator>(&mut system)
  run returnUndefined(&mut f, 0) |> Effect.provideMut<Allocator>(&mut system)
  run expectVerdict(&mut f, b"an owned value used after it was consumed", "a second release is a use after consumption") |> Effect.provideMut<Allocator>(&mut system)
}

test effect fn verifierRejectsLeak() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  let mut f = Function.make(1, 0)
  drop run retained(&mut f) |> Effect.provideMut<Allocator>(&mut system)
  run returnUndefined(&mut f, 0) |> Effect.provideMut<Allocator>(&mut system)
  run expectVerdict(&mut f, b"an owned value outstanding at return (a leak)", "a retain never released leaks") |> Effect.provideMut<Allocator>(&mut system)
}

test effect fn verifierRejectsUseAfterRelease() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  let mut f = Function.make(1, 0)
  let r = run retained(&mut f) |> Effect.provideMut<Allocator>(&mut system)
  drop run f.emit(0, Op.Release, false, Type.Value, Own.Owned, r, NONE, 0, 0) |> Effect.provideMut<Allocator>(&mut system)
  drop run f.emit(0, Op.Unbox, true, Type.I32, Own.Unboxed, r, NONE, 0, 0) |> Effect.provideMut<Allocator>(&mut system)
  let last = f.lastInst()
  drop run f.exitFor(last, 0, 0) |> Effect.provideMut<Allocator>(&mut system)
  run returnUndefined(&mut f, 0) |> Effect.provideMut<Allocator>(&mut system)
  run expectVerdict(&mut f, b"an owned value used after it was consumed", "unboxing a released value is a use after consumption") |> Effect.provideMut<Allocator>(&mut system)
}

/// A guard on `a` (the argument) while `r` is outstanding, with an exit of `moves` move slots of `r`.
effect fn guardWhileOwned(f: &mut Function, moves: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let r = run retained(&mut f)
  drop run f.emit(0, Op.Unbox, true, Type.I32, Own.Unboxed, 0, NONE, 0, 0)
  let last = f.lastInst()
  drop run f.exitFor(last, 0, moves + 1)
  run f.slotAt(0, SlotMode.Dup, 0)
  let mut i: u32 = 0
  while i < moves { run f.slotAt(r, SlotMode.Move, NONE) i = i + 1 }
  drop run f.emit(0, Op.Release, false, Type.Value, Own.Owned, r, NONE, 0, 0)
  run returnUndefined(&mut f, 0)
}

test effect fn verifierChecksExitMoves() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  let mut one = Function.make(1, 0)
  run guardWhileOwned(&mut one, 1) |> Effect.provideMut<Allocator>(&mut system)
  run expectVerdict(&mut one, b"ok", "an exit that moves the outstanding value once is fine") |> Effect.provideMut<Allocator>(&mut system)
  let mut none = Function.make(1, 0)
  run guardWhileOwned(&mut none, 0) |> Effect.provideMut<Allocator>(&mut system)
  run expectVerdict(&mut none, b"an exit does not move an outstanding owned value exactly once", "an exit must hand over every outstanding value")
    |> Effect.provideMut<Allocator>(&mut system)
  let mut twice = Function.make(1, 0)
  run guardWhileOwned(&mut twice, 2) |> Effect.provideMut<Allocator>(&mut system)
  run expectVerdict(&mut twice, b"an exit does not move an outstanding owned value exactly once", "an exit must not hand over a value twice")
    |> Effect.provideMut<Allocator>(&mut system)
}

test effect fn verifierRejectsGuardWithoutExit() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  let mut f = Function.make(1, 0)
  let entry = run f.block() |> Effect.provideMut<Allocator>(&mut system)
  let a = run f.emit(entry, Op.Arg, true, Type.Value, Own.Borrowed, NONE, NONE, 0, 0) |> Effect.provideMut<Allocator>(&mut system)
  f.setOwnership(a, Own.Borrowed, RootKind.Argument, 0)
  drop run f.emit(entry, Op.Unbox, true, Type.I32, Own.Unboxed, a, NONE, 0, 0) |> Effect.provideMut<Allocator>(&mut system)
  run returnUndefined(&mut f, entry) |> Effect.provideMut<Allocator>(&mut system)
  run expectVerdict(&mut f, b"an exit on an instruction that cannot leave, or a guard without one", "a guard needs an exit") |> Effect.provideMut<Allocator>(&mut system)
}

/// Adds blocks 1 to 3 and ends block 0 with a branch to blocks 1 and 2 on a constant comparison.
effect fn diamondHead(f: &mut Function) -> () ! OutOfMemoryError ? &mut Allocator {
  let c = run f.emit(0, Op.ConstI32, true, Type.I32, Own.Unboxed, NONE, NONE, 1, 0)
  let k = run f.emit(0, Op.Cmp, true, Type.Bool, Own.Unboxed, c, c, u8.toI32(Cmp.value(Cmp.Lt)), 0)
  drop run f.block() drop run f.block() drop run f.block()
  let left = run f.newEdge(1)
  drop run f.newEdge(2)
  run f.terminate(0, Op.Branch, k, left, 0)
}

test effect fn verifierRejectsDisagreeingPredecessors() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  let mut f = Function.make(1, 0)
  let r = run retained(&mut f) |> Effect.provideMut<Allocator>(&mut system)
  run diamondHead(&mut f) |> Effect.provideMut<Allocator>(&mut system)
  drop run f.emit(1, Op.Release, false, Type.Value, Own.Owned, r, NONE, 0, 0) |> Effect.provideMut<Allocator>(&mut system)
  let e1 = run f.newEdge(3) |> Effect.provideMut<Allocator>(&mut system)
  run f.terminate(1, Op.Jump, NONE, e1, 0) |> Effect.provideMut<Allocator>(&mut system)
  let e2 = run f.newEdge(3) |> Effect.provideMut<Allocator>(&mut system)
  run f.terminate(2, Op.Jump, NONE, e2, 0) |> Effect.provideMut<Allocator>(&mut system)
  run returnUndefined(&mut f, 3) |> Effect.provideMut<Allocator>(&mut system)
  run expectVerdict(&mut f, b"predecessors disagree on the outstanding owned values of a block", "releasing on one path only")
    |> Effect.provideMut<Allocator>(&mut system)
}

test effect fn verifierRejectsUndominatedUse() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  let mut f = Function.make(0, 0)
  drop run f.block() |> Effect.provideMut<Allocator>(&mut system)
  run diamondHead(&mut f) |> Effect.provideMut<Allocator>(&mut system)
  let only = run f.emit(1, Op.ConstI32, true, Type.I32, Own.Unboxed, NONE, NONE, 7, 0) |> Effect.provideMut<Allocator>(&mut system)
  let e1 = run f.newEdge(3) |> Effect.provideMut<Allocator>(&mut system)
  run f.terminate(1, Op.Jump, NONE, e1, 0) |> Effect.provideMut<Allocator>(&mut system)
  let e2 = run f.newEdge(3) |> Effect.provideMut<Allocator>(&mut system)
  run f.terminate(2, Op.Jump, NONE, e2, 0) |> Effect.provideMut<Allocator>(&mut system)
  let boxed = run f.emit(3, Op.BoxI32, true, Type.Value, Own.Imm, only, NONE, 0, 0) |> Effect.provideMut<Allocator>(&mut system)
  run f.terminate(3, Op.Return, boxed, NONE, 0) |> Effect.provideMut<Allocator>(&mut system)
  run expectVerdict(&mut f, b"an operand used where its definition does not dominate", "a value defined on one side of a diamond")
    |> Effect.provideMut<Allocator>(&mut system)
}

test effect fn verifierChecksEdges() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  // An argument for a block without parameters.
  let mut count = Function.make(0, 0)
  let entry = run count.block() |> Effect.provideMut<Allocator>(&mut system)
  let c = run count.emit(entry, Op.ConstI32, true, Type.I32, Own.Unboxed, NONE, NONE, 1, 0) |> Effect.provideMut<Allocator>(&mut system)
  let target = run count.block() |> Effect.provideMut<Allocator>(&mut system)
  let e = run count.newEdge(target) |> Effect.provideMut<Allocator>(&mut system)
  run count.edgeArgument(c) |> Effect.provideMut<Allocator>(&mut system)
  run count.terminate(entry, Op.Jump, NONE, e, 0) |> Effect.provideMut<Allocator>(&mut system)
  run returnUndefined(&mut count, target) |> Effect.provideMut<Allocator>(&mut system)
  run expectVerdict(&mut count, b"edge arguments do not match the target's parameters", "an edge passes one argument per parameter")
    |> Effect.provideMut<Allocator>(&mut system)
  // An i32 for a value parameter.
  let mut typed = Function.make(0, 0)
  let entry2 = run typed.block() |> Effect.provideMut<Allocator>(&mut system)
  let c2 = run typed.emit(entry2, Op.ConstI32, true, Type.I32, Own.Unboxed, NONE, NONE, 1, 0) |> Effect.provideMut<Allocator>(&mut system)
  let target2 = run typed.block() |> Effect.provideMut<Allocator>(&mut system)
  let p2 = run typed.addParam(target2, Type.Value, Own.Imm) |> Effect.provideMut<Allocator>(&mut system)
  let e2 = run typed.newEdge(target2) |> Effect.provideMut<Allocator>(&mut system)
  run typed.edgeArgument(c2) |> Effect.provideMut<Allocator>(&mut system)
  run typed.terminate(entry2, Op.Jump, NONE, e2, 0) |> Effect.provideMut<Allocator>(&mut system)
  run typed.terminate(target2, Op.Return, p2, NONE, 0) |> Effect.provideMut<Allocator>(&mut system)
  run expectVerdict(&mut typed, b"an edge argument of the wrong type", "an edge argument has its parameter's type") |> Effect.provideMut<Allocator>(&mut system)
  // A borrowed argument for an owned parameter: the target would release what it does not own.
  let mut owned = Function.make(1, 0)
  let entry3 = run owned.block() |> Effect.provideMut<Allocator>(&mut system)
  let a3 = run owned.emit(entry3, Op.Arg, true, Type.Value, Own.Borrowed, NONE, NONE, 0, 0) |> Effect.provideMut<Allocator>(&mut system)
  owned.setOwnership(a3, Own.Borrowed, RootKind.Argument, 0)
  let target3 = run owned.block() |> Effect.provideMut<Allocator>(&mut system)
  let p3 = run owned.addParam(target3, Type.Value, Own.Owned) |> Effect.provideMut<Allocator>(&mut system)
  let e3 = run owned.newEdge(target3) |> Effect.provideMut<Allocator>(&mut system)
  run owned.edgeArgument(a3) |> Effect.provideMut<Allocator>(&mut system)
  run owned.terminate(entry3, Op.Jump, NONE, e3, 0) |> Effect.provideMut<Allocator>(&mut system)
  run owned.terminate(target3, Op.Return, p3, NONE, 0) |> Effect.provideMut<Allocator>(&mut system)
  run expectVerdict(&mut owned, b"an edge argument whose ownership the parameter cannot take", "a borrow cannot become an owned parameter")
    |> Effect.provideMut<Allocator>(&mut system)
}

test effect fn verifierChecksOperandTypes() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  let mut f = Function.make(1, 0)
  let entry = run f.block() |> Effect.provideMut<Allocator>(&mut system)
  let a = run f.emit(entry, Op.Arg, true, Type.Value, Own.Borrowed, NONE, NONE, 0, 0) |> Effect.provideMut<Allocator>(&mut system)
  f.setOwnership(a, Own.Borrowed, RootKind.Argument, 0)
  let c = run f.emit(entry, Op.ConstI32, true, Type.I32, Own.Unboxed, NONE, NONE, 1, 0) |> Effect.provideMut<Allocator>(&mut system)
  drop run f.emit(entry, Op.Cmp, true, Type.Bool, Own.Unboxed, a, c, u8.toI32(Cmp.value(Cmp.Lt)), 0) |> Effect.provideMut<Allocator>(&mut system)
  run returnUndefined(&mut f, entry) |> Effect.provideMut<Allocator>(&mut system)
  run expectVerdict(&mut f, b"operand or result types do not fit the instruction", "comparing a boxed value needs an unbox first")
    |> Effect.provideMut<Allocator>(&mut system)
}

/// js_vm_values.step's shuffles, restated over positions: what each leaves on a stack whose
/// window holds 0..n-1 (bottom first). Independent of ssa_translate.shuffleOf's table.
effect fn interpreterShuffle(opcode: u8, n: usize) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut s = List<u8>.make()
  let mut i: usize = 0
  while i < n { run s.append(usize.toU8(i)) i = i + 1 }
  // top(d) is s[len - d]
  let len = s.length()
  if opcode == op.OP_nip1 { let mut out = List<u8>.make() run out.append(s.get(1)) run out.append(s.get(2)) return move out }
  if opcode == op.OP_dup1 { let top = s.get(len - 1) let below = s.get(len - 2) s.set(len - 1, below) run s.append(top) return move s }
  if opcode == op.OP_dup2 || opcode == op.OP_dup3 {
    let mut count: usize = 2 if opcode == op.OP_dup3 { count = 3 }
    let mut k: usize = 0
    while k < count { let v = s.get(s.length() - count) run s.append(v) k = k + 1 }
    return move s
  }
  if opcode >= op.OP_insert2 && opcode <= op.OP_insert4 {
    let count = u8.toUsize(opcode - op.OP_insert2) + 2
    let value = s.get(len - 1)
    run s.append(value)
    let mut depth: usize = 2
    while depth <= count { let l = s.length() copyAt(&mut s, l - depth, l - depth - 1) depth = depth + 1 }
    let l = s.length() s.set(l - count - 1, value)
    return move s
  }
  if opcode >= op.OP_perm3 && opcode <= op.OP_perm5 {
    let count = u8.toUsize(opcode - op.OP_perm3) + 3
    let value = s.get(len - 2)
    let mut depth: usize = 2
    while depth < count { copyAt(&mut s, len - depth, len - depth - 1) depth = depth + 1 }
    s.set(len - count, value)
    return move s
  }
  if opcode == op.OP_swap2 {
    let a = s.get(len - 4) let b = s.get(len - 3)
    copyAt(&mut s, len - 4, len - 2) copyAt(&mut s, len - 3, len - 1) s.set(len - 2, a) s.set(len - 1, b)
    return move s
  }
  if opcode == op.OP_rot3r {
    let value = s.get(len - 1)
    copyAt(&mut s, len - 1, len - 2) copyAt(&mut s, len - 2, len - 3) s.set(len - 3, value)
    return move s
  }
  let mut depth: usize = 3
  if opcode == op.OP_rot4l { depth = 4 } else if opcode == op.OP_rot5l { depth = 5 }
  let value = s.get(len - depth)
  while depth > 1 { copyAt(&mut s, len - depth, len - depth + 1) depth = depth - 1 }
  s.set(len - 1, value)
  return move s
}

fn copyAt(s: &mut List<u8>, to: usize, from: usize) -> () { let v = s.get(from) s.set(to, v) }

test effect fn shuffleTableMatchesTheInterpreter() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  let codes: [u8; 10] = [op.OP_nip1, op.OP_dup1, op.OP_dup2, op.OP_insert2, op.OP_insert3, op.OP_insert4,
    op.OP_perm3, op.OP_perm4, op.OP_rot3l, op.OP_rot3r]
  let mut i: usize = 0
  while i < 10 {
    let code = codes[i]
    let table = shuffleOf(code)
    let n = u8.toUsize(table[0] - 48)
    let info = op.opcodeInfo(code, true)
    run Testing.expect(u8.toUsize(info.pops) == n && u8.toUsize(info.pushes) == table.length - 1, "a shuffle's window and result match the opcode table")
    let expected = run interpreterShuffle(code, n) |> Effect.provideMut<Allocator>(&mut system)
    let mut same = expected.length() == table.length - 1
    let mut k: usize = 0
    while same && k < expected.length() { same = expected.get(k) == table[k + 1] - 48 k = k + 1 }
    run Testing.expect(same, "a shuffle's table matches js_vm_values.step")
    i = i + 1
  }
}

/// The rewriting work (ssa.Function.work) and bytecode bytes of the function `source`
/// evaluates to, after translation and the ownership pass; zeros when there is none.
unsafe effect fn measure<'m>(engine: &mut Engine<'m, NoHostServices>, context: *mut HeapHeader, source: &[u8], out: &mut List<u64>) -> ()
  ! JsException | OutOfMemoryError ? &mut Allocator {
  let memory = engine.memory
  let result = run eval.evaluate(&mut engine, memory, unsafe lendRealm(&context, context), source, b"work.js", 0)
  match ObjectRef.of(result.borrow()).functionCode() {
    Option.Some { value: cell } => {
      let anchor = ()
      let input = run inputOf(cell.get(&anchor))
      match move run Effect.result(translate(&input)) {
        Result.Success { value: translated } => {
          let mut f = move translated
          run ssa_ownership.optimize(&mut f)
          run out.append(f.work)
          run out.append(usize.toU64(input.code.length()))
        }
        Result.Failure { error } => {
          match move error {
            Refusal { .. } => ()
            OutOfMemoryError { .. } => { fail OutOfMemoryError {} }
          }
        }
      }
    }
    Option.None => ()
  }
  unsafe gc.release(&mut engine, unsafe runtime.contextRuntime(context), Value.intoBits(move result))
}
effect fn workOf(source: &[u8]) -> List<u64> ! OutOfMemoryError | SynchronizationError | JsException {
  let mut allocator = run RuntimeAllocator.make(Allocator.systemAllocatorProvider())
  let memory = run allocator.observe()
  let mut system = Allocator.systemAllocatorProvider()
  let domain = run WaiterDomain.make() |> Effect.provideMut<Allocator>(&mut system)
  let rt = run runtime.allocateRuntimeStorage(stack.currentFrameAddress()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut engine = Engine { memory: &memory, domain: domain.handle(), services: NoHostServices {} }
  let context = run unsafe intrinsics.create(&mut engine, &memory, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut out = List<u64>.make()
  let checked = run Effect.result(unsafe measure(&mut engine, context, source, &mut out)) |> Effect.provideMut<Allocator>(&mut allocator)
  unsafe gc.releaseHeader(&mut engine, rt, context)
  run unsafe gc.destroyRuntime(&mut engine, rt) |> Effect.provideMut<Allocator>(&mut allocator)
  match move checked {
    Result<(), JsException | OutOfMemoryError>.Success { value: _ } => ()
    Result<(), JsException | OutOfMemoryError>.Failure { error } => { fail move error }
  }
  return move out
}
/// A function of eight locals and `statements` statements that each read and write them
/// through guards: straight-line code whose exits all name every local.
effect fn longFunction(statements: usize) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut source = List<u8>.make()
  run source.appendSlice(b"function w(a,b){var c=1,d=2,e=3,f=4,g=5,h=6;")
  let mut i: usize = 0
  while i < statements {
    run source.appendSlice(b"c=c+a;d=d+c;if(e<d){e=e+b}f=f+e;g=g+f;h=h+g;c=c+h;d=d+1;")
    i = i + 1
  }
  run source.appendSlice(b"return a+b+c+d+e+f+g+h} w(1,2); w")
  return move source
}

/// Compile cost per bytecode byte must not grow with the function: the ownership pass was
/// once quadratic (a sweep of the function per replaced value, a compaction per pass), which
/// cost seconds on Octane's zlib. Four times the code may cost at most six times the work,
/// and the work per bytecode byte stays under a bound twice what it measured when written.
test effect fn compileWorkStaysLinear() -> () ! OutOfMemoryError | SynchronizationError | JsException | AssertionError<'static> {
  let mut system = Allocator.systemAllocatorProvider()
  let small = run longFunction(10) |> Effect.provideMut<Allocator>(&mut system)
  let large = run longFunction(40) |> Effect.provideMut<Allocator>(&mut system)
  let one = run workOf(small.asSlice())
  let four = run workOf(large.asSlice())
  run Testing.expect(one.length() == 2 && four.length() == 2, "both functions translate")
  if one.length() == 2 && four.length() == 2 {
    StderrWriter.print("compile work: {} for {} bytes, {} for {} bytes\n", &.(one.get(0), one.get(1), four.get(0), four.get(1)))
    run Testing.expect(four.get(0) <= one.get(0) * 6, "four times the code costs at most six times the rewriting work")
    run Testing.expect(four.get(0) <= four.get(1) * WORK_PER_BYTE, "rewriting work per bytecode byte stays under its bound")
  }
}
/// Instructions and exit slots walked per bytecode byte, at most (compileWorkStaysLinear).
const WORK_PER_BYTE: u64 = 160
