//! The ownership-aware SSA form (docs/jit/ssa.md): data structures, builder, compaction and
//! the textual printer.
//!
//! A `Function` is built by appending: `block` makes a block, `param` gives it parameters,
//! `emit` and the terminator methods append instructions to the block named in their call, in
//! any order across blocks. `compact` then puts the blocks in reverse postorder from the entry,
//! drops unreachable blocks and `Removed` instructions, and renumbers blocks, values and exits
//! densely, so the form the backend and the printer see is canonical. Passes rewrite in place
//! and compact again.
//!
//! Everything is an index: nothing here holds a pointer, so a function can be stored and read
//! back unchanged.
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u32
import silk.num.usize

/// The index that names nothing.
pub const NONE: u32 = 4294967295
/// GetElem's `k`: ELEM_STEP (a for-of step) exits where the element is not a fast Array's,
/// instead of reading it through the engine.
pub const ELEM_STEP: i32 = 1

/// The type of a value.
pub enum Type { I32, Bool, Value, F64 }

/// The ownership of a value. `Unboxed` is the only one an `i32`, `bool` or `f64` has; a `value` is
/// `Owned` (one count, consumed exactly once on every path), `Borrowed` (no count, valid while
/// its root is) or `Imm` (no heap reference, needs no count).
pub enum Own { Unboxed, Owned, Borrowed, Imm }

/// What a borrowed value borrows from: an argument cell (`root` is its index) or an owned value
/// (`root` is its value index).
pub enum RootKind { None, Argument, Value }

/// The operation of an instruction. See docs/jit/ssa.md for each one's meaning.
pub enum Op {
  /// `arg k`: the bits of argument cell `k`, borrowed from it.
  Arg,
  /// `const.i32 k`.
  ConstI32,
  /// An immediate boxed constant; `k` is an `Imm` tag.
  Imm,
  /// `unbox.i32 a`: guard, exits unless `a` is an Int.
  Unbox,
  /// `unbox.bool a`: guard, exits unless `a` is a Bool.
  UnboxBool,
  /// `box.i32 a`.
  BoxI32,
  /// `box.bool a`.
  BoxBool,
  /// `add.i32 a, b`: guard, exits on overflow.
  Add,
  /// `sub.i32 a, b`: guard, exits on overflow.
  Sub,
  /// `mul.i32 a, b`: guard, exits on overflow and on a -0 result.
  Mul,
  /// `cmp.i32 a, b` with the `Cmp` in `k`: a bool.
  Cmp,
  /// `retain a`: a new owner of `a`'s bits.
  Retain,
  /// `release a`: consumes the owned `a`.
  Release,
  /// An interrupt safepoint on a loop back edge, with an exit at the loop target.
  Poll,
  /// Terminator: `jump` along `edge`.
  Jump,
  /// Terminator: `branch a`, along `edge` when true and `edge + 1` when false.
  Branch,
  /// Terminator: `return a`, transferring `a` to the caller.
  Return,
  // ---- objects (workstream J). None consumes an operand: a helper retains what it keeps.
  /// `this`: the frame's receiver cell, borrowed (root: argument `argumentCount`).
  This,
  /// `check.tag a, k`: guard, exits unless `a`'s engine tag (ValueBits.tag) is `k`.
  CheckTag,
  /// `get.field a`: guard, the named property the instruction at `pc` reads from object `a`
  /// (an owned value), through the interpreter's own site cache; exits on any miss.
  GetField,
  /// `put.field a, b`: guard, the named property store of the instruction at `pc` of value `b`
  /// into object `a`, an existing own writable data property of the shape the site's key names;
  /// exits on anything else. The object takes its own count of `b`.
  PutField,
  /// `atom.value k`: the string push_atom_value (k 0) or push_empty_string (k 1) at `pc`
  /// pushes, owned; exits for an integer atom.
  AtomValue,
  /// `get.var k`: the value of closure variable `k` (get_var, get_var_undef: globals), owned;
  /// exits when it is uninitialized.
  GetVar,
  /// `put.var a, k`: stores `a` into closure variable `k` (put_var), which takes its own count;
  /// exits for a const or uninitialized binding.
  PutVar,
  /// `get.scope k`: slot `k & 0xffff` of the function's own scope (get_scope0; bit 16:
  /// get_scope0_check, exits when uninitialized), owned. Bit 17: captured operand `k & 0xffff`
  /// instead (get_var_ref, get_var_ref_check), exits when uninitialized.
  GetScope,
  /// `put.scope a, k`: stores `a` into scope slot `k & 0xffff` (put_scope0, set_scope0; bit 16:
  /// put_scope0_check, exits when uninitialized), which takes its own count. Bit 17: captured
  /// operand `k & 0xffff` (put_var_ref, set_var_ref, put_var_ref_check), exits when uninitialized.
  PutScope,
  /// `get.elem a, b`: guard, element `b` (an i32) of `a` (get_array_el and its fused forms):
  /// a fast Array's below its length, a typed array's, a fast arguments object's; owned;
  /// exits on anything else.
  GetElem,
  /// `put.elem a, b, k`: guard, stores `b` over existing element `k` (a value: an i32) of the
  /// fast Array `a`, which takes its own count; exits on anything else.
  PutElem,
  /// `get.length a`: guard, a string's or an Array's length (get_length), owned; exits on
  /// anything else.
  GetLength,
  /// `truthy a`: ToBoolean of boxed `a` (a condition on a site that deoptimized at unbox.bool),
  /// through a helper call; no exit.
  Truthy,
  /// `tag.is a, k`: whether boxed `a` is undefined (k bit 0) or null (k bit 1); no exit.
  TagIs,
  /// `typeof a`: the atom typeof answers for boxed `a` (a helper call), as an i32; exits for a
  /// proxy.
  TypeofAtom,
  /// `instanceof a, b`: whether boxed `a` is an instance of boxed `b` through the ordinary
  /// @@hasInstance and a plain prototype chain (a helper call), as a bool; exits when the
  /// operator could run JavaScript or meet a proxy.
  InstanceOf,
  /// `equals a, b, k`: `a === b` (k 1) or `a == b` (k 0) of boxed operands through a helper,
  /// as a bool; exits when the operator would coerce (and could run JavaScript).
  Equals,
  // ---- calls (workstream H)
  /// `call.arg a, k`: operand `a` is argument `k` of the `call` that follows (CallArgs come
  /// right before their call, in order). Borrows `a` for the call; consumes nothing.
  CallArg,
  /// `call a, b, k`: calls function `a` with receiver `b` and the `k` preceding `call.arg`s;
  /// an owned result. Its exit is the throw exit: the frame before the call (operands still on
  /// the stack), taken when the callee threw (the exception is pending).
  Call,
  // ---- numbers beyond int32 and the remaining int32 operators (docs/jit/doubles.md) ----
  /// `const.f64 k`: the double `Function.numbers[k]`.
  ConstF64,
  /// `unbox.f64 a`: guard, exits unless `a` is a number (an Int converts exactly).
  UnboxF64,
  /// `box.f64 a`: a Float64.
  BoxF64,
  /// `f64 a`: the i32 `a` as a double (exact).
  ToF64,
  /// `add.f64`, `sub.f64`, `mul.f64`, `div.f64 a, b`: IEEE, no guard.
  AddF64,
  SubF64,
  MulF64,
  DivF64,
  /// `cmp.f64 a, b` with the `Cmp` in `k`: a bool; every comparison with NaN is false but `ne`.
  CmpF64,
  /// `neg.f64 a`, `sqrt.f64 a`, `abs.f64 a`.
  NegF64,
  SqrtF64,
  AbsF64,
  /// `floor.f64 a`: Math.floor, no guard (NaN, infinities and -0 stay themselves).
  FloorF64,
  /// `toint32 a`: ToInt32 of the double `a`; guard, exits when the truncation leaves the
  /// int64 range (NaN, infinities, huge values), which the interpreter answers instead.
  ToInt32,
  /// `int.f64 a`: the double `a` as an i32 when it is one exactly (not -0); guard otherwise.
  ExactI32,
  /// int32 bitwise operators, never failing: `and`, `or`, `xor`, `shl`, `sar` (count & 31).
  BitAnd,
  BitOr,
  BitXor,
  Shl,
  Sar,
  /// `shr a, b` (>>>): guard, exits when the unsigned result is not an int32.
  Shr,
  /// `mod.i32 a, b`: guard, exits unless b > 0 and the result is not -0.
  Mod,
  /// `neg.i32 a`: guard, exits on 0 (-0) and the minimum (overflow).
  Neg,
  /// `not.i32 a` (~a).
  BitNot,
  /// `not.bool a` (!a).
  NotBool,
  /// `imul.i32 a, b`: Math.imul, the low 32 bits of the product; never fails.
  Imul,
  // ---- inlining (docs/jit/inlining.md)
  /// `check.callee a, k`: guard, exits unless `a` is a bytecode closure of inline target `k`
  /// (`Function.inlineTargets[k]`; the code names it by relocation symbol `2k`).
  CheckCallee,
  /// `inline.frame a, k`: builds the CompiledFrame of inlined callee `k + 1` (closure `a`, the
  /// one `check.callee a, k` passed) that instructions with `frame == k + 1` run for.
  InlineFrame,
  /// Deleted by a pass; `compact` drops it.
  Removed,
}

/// Comparisons, signed; stored in `Inst.k`.
pub enum Cmp { Lt, Le, Gt, Ge, Eq, Ne }

/// Immediate boxed constants; stored in `Inst.k`.
pub enum Imm { Undefined, Null, False, True, Uninitialized }
/// An `Op.Imm` whose `k` is at least this is the engine's `CatchOffset { offset: k - IMM_CATCH }`
/// (the marker `catch` pushes; it holds no count).
pub const IMM_CATCH: i32 = 8

/// How a deoptimization exit writes a slot. See docs/jit/ssa.md.
pub enum SlotMode { Int, Bool, Imm, Move, Dup, F64 }

pub struct ValueInfo {
  pub ty: Type,
  pub own: Own,
  pub rootKind: RootKind,
  pub root: u32,
  /// The block that defines it.
  pub block: u32,
  /// The defining instruction, or NONE for a block parameter.
  pub def: u32,
}
impl Copy for ValueInfo {}

pub struct Inst {
  pub op: Op,
  /// The value it defines, or NONE.
  pub result: u32,
  pub a: u32,
  pub b: u32,
  /// Constant, argument index, `Cmp` or `Imm` tag.
  pub k: i32,
  /// A terminator's first edge, or NONE.
  pub edge: u32,
  /// The deoptimization exit of a guard or `poll`, or NONE.
  pub exit: u32,
  /// The bytecode offset of the instruction this came from.
  pub pc: u32,
  pub block: u32,
  /// Position within the block; only `compact` reads it.
  pub order: u32,
  /// Whose CompiledFrame a frame-reading instruction (field sites, variables, scopes, atoms)
  /// runs for: 0 the function's own, n the one `inline.frame` built for inlined callee n.
  pub frame: u32,
}
impl Copy for Inst {}

pub struct Block {
  pub firstParam: u32,
  pub paramCount: u32,
  pub firstInst: u32,
  pub instCount: u32,
}
impl Copy for Block {}

pub struct Edge { pub target: u32, pub firstArg: u32, pub argCount: u32 }
impl Copy for Edge {}

/// A deoptimization exit: resume the interpreter at `pc` with `localCount` local slots and
/// `stackDepth` operand stack slots, in `Function.slots` from `firstSlot` (locals first, then
/// the stack bottom first). After them come `drops` more slots the interpreter frame does not
/// receive: values an inlined body holds when it leaves for the caller's state before the
/// call. The exit releases those whose mode is `Move` and ignores the others.
pub struct Exit { pub pc: u32, pub stackDepth: u32, pub firstSlot: u32, pub drops: u32 }
impl Copy for Exit {}

/// One slot of an exit. `root` is the argument index a `Dup` slot's value borrows from, or NONE.
pub struct Slot { pub value: u32, pub mode: SlotMode, pub root: u32 }
impl Copy for Slot {}

/// A call at `pc` that stayed a call: `why`, and the callee's opcode that stopped the attempt (or 0).
pub struct InlineMiss { pub pc: u32, pub opcode: u8, pub why: &'static [u8] }
impl Copy for InlineMiss {}

pub struct Function {
  pub argumentCount: u32,
  pub localCount: u32,
  pub blocks: List<Block>,
  /// Block parameters, grouped by block once compacted.
  pub params: List<u32>,
  pub insts: List<Inst>,
  pub values: List<ValueInfo>,
  pub edges: List<Edge>,
  pub edgeArgs: List<u32>,
  pub exits: List<Exit>,
  pub slots: List<Slot>,
  /// The bits of the doubles `const.f64` names, by index.
  pub numbers: List<u64>,
  /// The inline targets `check.callee` and `inline.frame` name, by index: each an identifier
  /// the embedder gave (`ssa_translate.CallTarget.id`). Relocation symbol `2k` is target k's
  /// FunctionBytecode cell, `2k + 1` the first byte of its code.
  pub inlineTargets: List<u32>,
  /// Calls translated as calls, with why they were not inlined (for --jit-dump only).
  pub inlineMisses: List<InlineMiss>,
  /// `Inst.frame` of the instructions `emit` appends (0 outside an inlined body).
  pub frame: u32,
  nextOrder: u32,
  /// Instructions and exit slots the rewriting passes have walked so far (compact, and the
  /// ownership pass's sweeps): compile cost in units that do not depend on the machine, for
  /// the test that keeps it linear (ssa_tests.compileWorkStaysLinear).
  pub work: u64,
}

/// Copies each exit's slots from the old table (`from`, at oldFirst[exit]) to their place in
/// the new one, renumbering their values (Function.compact).
fn copySlots(from: &[Slot], to: &mut [Slot], numbers: &[u32], exits: &List<Exit>, oldFirst: &List<u32>, localCount: u32) -> () {
  let mut x: usize = 0
  while x < exits.length() {
    let exit = exits.get(x)
    let source = u32.toUsize(oldFirst.get(x))
    let target = u32.toUsize(exit.firstSlot)
    let count = u32.toUsize(localCount + exit.stackDepth + exit.drops)
    let mut s: usize = 0
    while s < count {
      let mut slot = from[source + s]
      slot.value = numbers[u32.toUsize(slot.value)]
      to[target + s] = slot
      s = s + 1
    }
    x = x + 1
  }
}

/// A point in a function being built that `Function.rollback` returns to.
pub struct Mark { insts: usize, values: usize, exits: usize, slots: usize, targets: usize, order: u32,
  blocks: usize, params: usize, edges: usize, edgeArgs: usize }
impl Copy for Mark {}

pub fn ownOf(ty: Type) -> Own { if ty == Type.Value { return Own.Owned } return Own.Unboxed }

/// Whether an instruction may run JavaScript or reenter the engine. A borrow of an argument
/// cell survives one (nothing writes the cells, compiled-entry.md 7.3); any other borrow ends.
pub fn mayReenter(op: Op) -> bool { return op == Op.Call }

pub fn isTerminator(op: Op) -> bool { return op == Op.Jump || op == Op.Branch || op == Op.Return }

/// The number of successor edges a terminator has.
pub fn edgeCount(op: Op) -> u32 {
  if op == Op.Jump { return 1 }
  if op == Op.Branch { return 2 }
  return 0
}

impl Function {
  pub fn make(argumentCount: u32, localCount: u32) -> Function {
    return Function { argumentCount: argumentCount, localCount: localCount, blocks: List<Block>.make(),
      params: List<u32>.make(), insts: List<Inst>.make(), values: List<ValueInfo>.make(),
      edges: List<Edge>.make(), edgeArgs: List<u32>.make(), exits: List<Exit>.make(),
      slots: List<Slot>.make(), numbers: List<u64>.make(), inlineTargets: List<u32>.make(), inlineMisses: List<InlineMiss>.make(), frame: 0, nextOrder: 0, work: 0 }
  }

  pub fn valueCount(self: &Self) -> u32 { return usize.toU32(self.values.length()) }
  pub fn blockCount(self: &Self) -> u32 { return usize.toU32(self.blocks.length()) }
  pub fn value(self: &Self, v: u32) -> ValueInfo { return self.values.get(u32.toUsize(v)) }
  pub fn inst(self: &Self, index: u32) -> Inst { return self.insts.get(u32.toUsize(index)) }
  pub fn edge(self: &Self, index: u32) -> Edge { return self.edges.get(u32.toUsize(index)) }
  pub fn edgeArg(self: &Self, edge: Edge, index: u32) -> u32 { return self.edgeArgs.get(u32.toUsize(edge.firstArg + index)) }
  pub fn exit(self: &Self, index: u32) -> Exit { return self.exits.get(u32.toUsize(index)) }
  pub fn slot(self: &Self, exit: Exit, index: u32) -> Slot { return self.slots.get(u32.toUsize(exit.firstSlot + index)) }
  /// A compacted block's `index`th parameter.
  pub fn paramAt(self: &Self, block: Block, index: u32) -> u32 { return self.params.get(u32.toUsize(block.firstParam + index)) }
  /// A compacted block's terminator.
  pub fn terminator(self: &Self, block: Block) -> Inst { return self.insts.get(u32.toUsize(block.firstInst + block.instCount - 1)) }

  pub fn setOwnership(self: &mut Self, v: u32, own: Own, rootKind: RootKind, root: u32) -> () {
    let mut info = self.values.get(u32.toUsize(v))
    info.own = own info.rootKind = rootKind info.root = root
    self.values.set(u32.toUsize(v), info)
  }
  pub fn setType(self: &mut Self, v: u32, ty: Type) -> () {
    let mut info = self.values.get(u32.toUsize(v))
    info.ty = ty
    self.values.set(u32.toUsize(v), info)
  }
  pub fn setInst(self: &mut Self, index: u32, inst: Inst) -> () { self.insts.set(u32.toUsize(index), inst) }
  pub fn setSlot(self: &mut Self, index: u32, slot: Slot) -> () { self.slots.set(u32.toUsize(index), slot) }
  pub fn setEdgeArg(self: &mut Self, index: u32, v: u32) -> () { self.edgeArgs.set(u32.toUsize(index), v) }

  // ---- building ----

  /// A new block with no parameters and no instructions.
  pub effect fn block(self: &mut Self) -> u32 ! OutOfMemoryError ? &mut Allocator {
    run self.blocks.append(Block { firstParam: 0, paramCount: 0, firstInst: 0, instCount: 0 })
    return usize.toU32(self.blocks.length() - 1)
  }

  effect fn newValue(self: &mut Self, ty: Type, own: Own, block: u32, def: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    run self.values.append(ValueInfo { ty: ty, own: own, rootKind: RootKind.None, root: NONE, block: block, def: def })
    return usize.toU32(self.values.length() - 1)
  }

  /// Adds a parameter to `block`, after the ones it has.
  pub effect fn addParam(self: &mut Self, block: u32, ty: Type, own: Own) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let v = run self.newValue(ty, own, block, NONE)
    // Before compact, a block's range is kept while its parameters arrive together (the
    // translator adds each block's at once); paramsOf reads it.
    let mut info = self.blocks.get(u32.toUsize(block))
    if info.paramCount == 0 { info.firstParam = usize.toU32(self.params.length()) }
    if info.firstParam != NONE && info.firstParam + info.paramCount == usize.toU32(self.params.length()) { info.paramCount = info.paramCount + 1 }
    else { info.firstParam = NONE info.paramCount = info.paramCount + 1 }
    self.blocks.set(u32.toUsize(block), info)
    run self.params.append(v)
    return v
  }

  /// The parameters of `block` in order, for a function that is not compacted yet.
  pub effect fn paramsOf(self: &Self, block: u32) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
    let mut out = List<u32>.make()
    let info = self.blocks.get(u32.toUsize(block))
    if info.firstParam != NONE {
      let mut g: u32 = 0
      while g < info.paramCount { run out.append(self.params.get(u32.toUsize(info.firstParam + g))) g = g + 1 }
      return move out
    }
    let mut i: usize = 0
    while i < self.params.length() {
      let v = self.params.get(i)
      if self.values.get(u32.toUsize(v)).block == block { run out.append(v) }
      i = i + 1
    }
    return move out
  }

  /// Appends an instruction to `block`. When `ty` is not NONE-like (the `hasResult` flag), the
  /// instruction defines a new value of that type and ownership, returned; else NONE.
  pub effect fn emit(self: &mut Self, block: u32, op: Op, hasResult: bool, ty: Type, own: Own, a: u32, b: u32, k: i32, pc: u32) -> u32
    ! OutOfMemoryError ? &mut Allocator {
    let index = usize.toU32(self.insts.length())
    let mut result = NONE
    if hasResult { result = run self.newValue(ty, own, block, index) }
    run self.insts.append(Inst { op: op, result: result, a: a, b: b, k: k, edge: NONE, exit: NONE, pc: pc, block: block, order: self.nextOrder, frame: self.frame })
    self.nextOrder = self.nextOrder + 2
    return result
  }

  /// Inserts an instruction just before instruction `before` (in the same block).
  pub effect fn insertBefore(self: &mut Self, before: u32, op: Op, hasResult: bool, ty: Type, own: Own, a: u32, b: u32, k: i32) -> u32
    ! OutOfMemoryError ? &mut Allocator {
    let at = self.inst(before)
    let index = usize.toU32(self.insts.length())
    let mut result = NONE
    if hasResult { result = run self.newValue(ty, own, at.block, index) }
    run self.insts.append(Inst { op: op, result: result, a: a, b: b, k: k, edge: NONE, exit: NONE, pc: at.pc, block: at.block, order: at.order - 1, frame: at.frame })
    return result
  }

  /// Gives the last instruction appended an exit. Returns the exit's index; its slots are added
  /// with `slotAt`.
  pub effect fn exitFor(self: &mut Self, inst: u32, pc: u32, stackDepth: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let index = usize.toU32(self.exits.length())
    run self.exits.append(Exit { pc: pc, stackDepth: stackDepth, firstSlot: usize.toU32(self.slots.length()), drops: 0 })
    let mut at = self.inst(inst)
    at.exit = index
    self.setInst(inst, at)
    return index
  }
  /// Appends a slot to the exit made last.
  pub effect fn slotAt(self: &mut Self, value: u32, mode: SlotMode, root: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.slots.append(Slot { value: value, mode: mode, root: root })
  }
  /// Appends a drop slot to the exit made last, after all its frame slots.
  pub effect fn dropAt(self: &mut Self, value: u32, mode: SlotMode) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.slots.append(Slot { value: value, mode: mode, root: NONE })
    let last = self.exits.length() - 1
    let mut exit = self.exits.get(last)
    exit.drops = exit.drops + 1
    self.exits.set(last, exit)
  }
  /// The slots of `exit`: the frame's, then its drops.
  pub fn slotCount(self: &Self, exit: Exit) -> u32 { return self.localCount + exit.stackDepth + exit.drops }
  /// The index of the instruction appended last.
  pub fn lastInst(self: &Self) -> u32 { return usize.toU32(self.insts.length() - 1) }

  /// Appends an edge to `target` with no arguments yet; arguments follow with `edgeArgument`.
  pub effect fn newEdge(self: &mut Self, target: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    run self.edges.append(Edge { target: target, firstArg: usize.toU32(self.edgeArgs.length()), argCount: 0 })
    return usize.toU32(self.edges.length() - 1)
  }
  /// Adds an argument to the edge made last.
  pub effect fn edgeArgument(self: &mut Self, v: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.edgeArgs.append(v)
    let last = self.edges.length() - 1
    let mut e = self.edges.get(last)
    e.argCount = e.argCount + 1
    self.edges.set(last, e)
  }

  /// Ends `block` with a terminator whose edges are `edge` and, for a branch, `edge + 1`.
  pub effect fn terminate(self: &mut Self, block: u32, op: Op, a: u32, edge: u32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    drop run self.emit(block, op, false, Type.I32, Own.Unboxed, a, NONE, 0, pc)
    let last = self.lastInst()
    let mut inst = self.inst(last)
    inst.edge = edge
    self.setInst(last, inst)
  }

  /// Where the function stands, for `rollback`.
  pub fn mark(self: &Self) -> Mark {
    return Mark { insts: self.insts.length(), values: self.values.length(), exits: self.exits.length(), slots: self.slots.length(),
      targets: self.inlineTargets.length(), order: self.nextOrder, blocks: self.blocks.length(), params: self.params.length(),
      edges: self.edges.length(), edgeArgs: self.edgeArgs.length() }
  }
  /// Forgets every instruction, value, exit, inline target, block, parameter and edge added
  /// since `mark` (the blocks made before it got no parameter since).
  pub fn rollback(self: &mut Self, mark: Mark) -> () {
    self.insts.truncate(mark.insts) self.values.truncate(mark.values) self.exits.truncate(mark.exits)
    self.slots.truncate(mark.slots) self.inlineTargets.truncate(mark.targets) self.nextOrder = mark.order
    self.blocks.truncate(mark.blocks) self.params.truncate(mark.params) self.edges.truncate(mark.edges) self.edgeArgs.truncate(mark.edgeArgs)
  }

  // ---- compaction ----

  /// Puts the blocks in reverse postorder from block 0, drops unreachable blocks and removed
  /// instructions, and renumbers blocks, values and exits densely in that order.
  pub effect fn compact(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    self.work = self.work + usize.toU64(self.insts.length() + self.slots.length())
    let blockCount = self.blocks.length()
    // The terminator of each block, to walk its successors.
    let mut term = List<u32>.make()
    run term.appendRepeated(NONE, blockCount)
    let mut i: usize = 0
    while i < self.insts.length() {
      let inst = self.insts.get(i)
      if isTerminator(inst.op) { term.set(u32.toUsize(inst.block), usize.toU32(i)) }
      i = i + 1
    }
    // Iterative depth-first search for the postorder.
    let mut state = List<u8>.make()
    run state.appendRepeated(0, blockCount)
    let mut post = List<u32>.make()
    let mut stack = List<u32>.make()
    let mut next = List<u32>.make()
    if blockCount > 0 { run stack.append(0) run next.append(0) state.set(0, 1) }
    while stack.length() > 0 {
      let top = stack.length() - 1
      let b = stack.get(top)
      let n = next.get(top)
      let t = term.get(u32.toUsize(b))
      let mut count: u32 = 0
      if t != NONE { count = edgeCount(self.insts.get(u32.toUsize(t)).op) }
      if n < count {
        next.set(top, n + 1)
        let target = self.edges.get(u32.toUsize(self.insts.get(u32.toUsize(t)).edge + n)).target
        if state.get(u32.toUsize(target)) == 0 {
          state.set(u32.toUsize(target), 1)
          run stack.append(target) run next.append(0)
        }
      } else {
        run post.append(b)
        drop stack.pop() drop next.pop()
      }
    }
    // rank[old block] = new index, or NONE when unreachable.
    let mut rank = List<u32>.make()
    run rank.appendRepeated(NONE, blockCount)
    let mut order = List<u32>.make()
    let mut p = post.length()
    while p > 0 { p = p - 1 rank.set(u32.toUsize(post.get(p)), usize.toU32(order.length())) run order.append(post.get(p)) }

    // Instructions grouped by new block, then by order within it.
    let mut buckets = List<List<u32>>.make()
    let mut bi: usize = 0
    while bi < order.length() { run buckets.append(List<u32>.make()) bi = bi + 1 }
    i = 0
    while i < self.insts.length() {
      let inst = self.insts.get(i)
      let r = rank.get(u32.toUsize(inst.block))
      if r != NONE && inst.op != Op.Removed { run buckets.asMutSlice()[u32.toUsize(r)].append(usize.toU32(i)) }
      i = i + 1
    }
    bi = 0
    while bi < buckets.length() {
      let list = &mut buckets.asMutSlice()[bi]
      // Insertion sort by order: blocks are short and nearly sorted.
      let mut x: usize = 1
      while x < list.length() {
        let item = list.get(x)
        let key = self.insts.get(u32.toUsize(item)).order
        let mut y = x
        while y > 0 && self.insts.get(u32.toUsize(list.get(y - 1))).order > key { let prev = list.get(y - 1) list.set(y, prev) y = y - 1 }
        list.set(y, item)
        x = x + 1
      }
      bi = bi + 1
    }

    // New value numbers: each block's parameters (in creation order), then its results.
    let mut renumber = List<u32>.make()
    run renumber.appendRepeated(NONE, self.values.length())
    let mut newValues = List<ValueInfo>.make()
    let mut newParams = List<u32>.make()
    let mut newBlocks = List<Block>.make()
    let mut newInsts = List<Inst>.make()
    // Parameters grouped by new block, in creation order: paramStart[r] .. paramStart[r + 1]
    // of grouped. One pass, where scanning them per block was quadratic.
    let mut paramStart = List<u32>.make()
    run paramStart.appendRepeated(0, order.length() + 1)
    let mut q: usize = 0
    while q < self.params.length() {
      let r = rank.get(u32.toUsize(self.values.get(u32.toUsize(self.params.get(q))).block))
      if r != NONE { let at = u32.toUsize(r) + 1 let c = paramStart.get(at) + 1 paramStart.set(at, c) }
      q = q + 1
    }
    bi = 0
    while bi < order.length() { let c = paramStart.get(bi + 1) + paramStart.get(bi) paramStart.set(bi + 1, c) bi = bi + 1 }
    let mut fill = List<u32>.make()
    run fill.appendSlice(paramStart.asSlice())
    let mut grouped = List<u32>.make()
    run grouped.appendRepeated(NONE, u32.toUsize(paramStart.get(order.length())))
    q = 0
    while q < self.params.length() {
      let v = self.params.get(q)
      let r = rank.get(u32.toUsize(self.values.get(u32.toUsize(v)).block))
      if r != NONE { let at = u32.toUsize(r) let slot = fill.get(at) grouped.set(u32.toUsize(slot), v) fill.set(at, slot + 1) }
      q = q + 1
    }
    bi = 0
    while bi < order.length() {
      let firstParam = usize.toU32(newParams.length())
      let mut g = paramStart.get(bi)
      while g < paramStart.get(bi + 1) {
        let v = grouped.get(u32.toUsize(g))
        let info = self.values.get(u32.toUsize(v))
        renumber.set(u32.toUsize(v), usize.toU32(newValues.length()))
        run newParams.append(usize.toU32(newValues.length()))
        let mut moved = info moved.block = usize.toU32(bi)
        run newValues.append(moved)
        g = g + 1
      }
      let firstInst = usize.toU32(newInsts.length())
      let list = &buckets.asSlice()[bi]
      let mut x: usize = 0
      while x < list.length() {
        let mut inst = self.insts.get(u32.toUsize(list.get(x)))
        inst.block = usize.toU32(bi)
        // From 2, so insertBefore can still place an instruction before the first.
        inst.order = usize.toU32(x) * 2 + 2
        if inst.result != NONE {
          let mut info = self.values.get(u32.toUsize(inst.result))
          info.block = usize.toU32(bi) info.def = usize.toU32(newInsts.length())
          renumber.set(u32.toUsize(inst.result), usize.toU32(newValues.length()))
          inst.result = usize.toU32(newValues.length())
          run newValues.append(info)
        }
        run newInsts.append(inst)
        x = x + 1
      }
      run newBlocks.append(Block { firstParam: firstParam, paramCount: usize.toU32(newParams.length()) - firstParam,
        firstInst: firstInst, instCount: usize.toU32(newInsts.length()) - firstInst })
      bi = bi + 1
    }

    // Edges and exits in the order the new instructions use them; operands renumbered.
    let mut newEdges = List<Edge>.make()
    let mut newArgs = List<u32>.make()
    let mut newExits = List<Exit>.make()
    let mut newSlots = List<Slot>.make()
    // Each new exit's first slot in the old table, and the slots counted so far.
    let mut oldFirst = List<u32>.make()
    let mut slotTotal: u32 = 0
    i = 0
    while i < newInsts.length() {
      let mut inst = newInsts.get(i)
      if inst.a != NONE && inst.op != Op.Arg && inst.op != Op.ConstI32 && inst.op != Op.Imm && inst.op != Op.ConstF64 && inst.op != Op.This { inst.a = renumber.get(u32.toUsize(inst.a)) }
      if inst.b != NONE { inst.b = renumber.get(u32.toUsize(inst.b)) }
      if readsK(inst.op) { inst.k = u32.wrappingToI32(renumber.get(u32.toUsize(i32.wrappingToU32(inst.k)))) }
      if inst.edge != NONE {
        let first = usize.toU32(newEdges.length())
        let mut e: u32 = 0
        while e < edgeCount(inst.op) {
          let edge = self.edges.get(u32.toUsize(inst.edge + e))
          let firstArg = usize.toU32(newArgs.length())
          let mut g: u32 = 0
          while g < edge.argCount { run newArgs.append(renumber.get(u32.toUsize(self.edgeArgs.get(u32.toUsize(edge.firstArg + g))))) g = g + 1 }
          run newEdges.append(Edge { target: rank.get(u32.toUsize(edge.target)), firstArg: firstArg, argCount: edge.argCount })
          e = e + 1
        }
        inst.edge = first
      }
      if inst.exit != NONE {
        let exit = self.exits.get(u32.toUsize(inst.exit))
        inst.exit = usize.toU32(newExits.length())
        run oldFirst.append(exit.firstSlot)
        run newExits.append(Exit { pc: exit.pc, stackDepth: exit.stackDepth, firstSlot: slotTotal, drops: exit.drops })
        slotTotal = slotTotal + self.slotCount(exit)
      }
      newInsts.set(i, inst)
      i = i + 1
    }
    // The exit slots, by far the largest table (every exit names every local): sized once
    // and copied through slices.
    run newSlots.appendRepeated(Slot { value: NONE, mode: SlotMode.Imm, root: NONE }, u32.toUsize(slotTotal))
    copySlots(self.slots.asSlice(), newSlots.asMutSlice(), renumber.asSlice(), &newExits, &oldFirst, self.localCount)
    // Value roots name values too.
    let mut v: usize = 0
    while v < newValues.length() {
      let mut info = newValues.get(v)
      if info.rootKind == RootKind.Value { info.root = renumber.get(u32.toUsize(info.root)) newValues.set(v, info) }
      v = v + 1
    }
    self.blocks = move newBlocks
    self.params = move newParams
    self.insts = move newInsts
    self.values = move newValues
    self.edges = move newEdges
    self.edgeArgs = move newArgs
    self.exits = move newExits
    self.slots = move newSlots
    self.nextOrder = usize.toU32(self.insts.length()) * 2 + 4
  }

  // ---- printing ----

  /// The textual form: one line per block header, instruction and exit.
  pub effect fn print(self: &Self, out: &mut List<u8>) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut b: u32 = 0
    while b < self.blockCount() {
      let block = self.blocks.get(u32.toUsize(b))
      run text(&mut out, b"b") run number(&mut out, b)
      if block.paramCount > 0 {
        run text(&mut out, b"(")
        let mut p: u32 = 0
        while p < block.paramCount {
          if p > 0 { run text(&mut out, b", ") }
          let v = self.paramAt(block, p)
          run self.typed(&mut out, v)
          p = p + 1
        }
        run text(&mut out, b")")
      }
      run text(&mut out, b":\n")
      let mut i: u32 = 0
      while i < block.instCount {
        run self.printInst(&mut out, self.inst(block.firstInst + i))
        i = i + 1
      }
      b = b + 1
    }
    let mut e: u32 = 0
    while e < usize.toU32(self.exits.length()) {
      let exit = self.exit(e)
      run text(&mut out, b"e") run number(&mut out, e) run text(&mut out, b": pc ") run number(&mut out, exit.pc)
      run text(&mut out, b" locals [")
      let mut s: u32 = 0
      while s < self.localCount { if s > 0 { run text(&mut out, b", ") } run self.printSlot(&mut out, self.slot(exit, s)) s = s + 1 }
      run text(&mut out, b"] stack [")
      s = 0
      while s < exit.stackDepth { if s > 0 { run text(&mut out, b", ") } run self.printSlot(&mut out, self.slot(exit, self.localCount + s)) s = s + 1 }
      run text(&mut out, b"]")
      if exit.drops > 0 {
        run text(&mut out, b" drops [")
        s = 0
        while s < exit.drops { if s > 0 { run text(&mut out, b", ") } run self.printSlot(&mut out, self.slot(exit, self.localCount + exit.stackDepth + s)) s = s + 1 }
        run text(&mut out, b"]")
      }
      run text(&mut out, b"\n")
      e = e + 1
    }
  }

  effect fn typed(self: &Self, out: &mut List<u8>, v: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    run text(&mut out, b"v") run number(&mut out, v) run text(&mut out, b": ")
    let info = self.value(v)
    if info.ty == Type.I32 { run text(&mut out, b"i32") return () }
    if info.ty == Type.Bool { run text(&mut out, b"bool") return () }
    if info.ty == Type.F64 { run text(&mut out, b"f64") return () }
    run text(&mut out, b"value ")
    if info.own == Own.Owned { run text(&mut out, b"owned") }
    else if info.own == Own.Imm { run text(&mut out, b"imm") }
    else if info.own == Own.Borrowed {
      run text(&mut out, b"borrowed(")
      if info.rootKind == RootKind.Argument { run text(&mut out, b"arg ") run number(&mut out, info.root) }
      else if info.rootKind == RootKind.Value { run text(&mut out, b"v") run number(&mut out, info.root) }
      else { run text(&mut out, b"?") }
      run text(&mut out, b")")
    } else { run text(&mut out, b"unboxed?") }
  }

  effect fn printEdge(self: &Self, out: &mut List<u8>, index: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let edge = self.edge(index)
    run text(&mut out, b"b") run number(&mut out, edge.target) run text(&mut out, b"(")
    let mut g: u32 = 0
    while g < edge.argCount { if g > 0 { run text(&mut out, b", ") } run text(&mut out, b"v") run number(&mut out, self.edgeArg(edge, g)) g = g + 1 }
    run text(&mut out, b")")
  }

  effect fn printInst(self: &Self, out: &mut List<u8>, inst: Inst) -> () ! OutOfMemoryError ? &mut Allocator {
    run text(&mut out, b"  ")
    if inst.result != NONE { run self.typed(&mut out, inst.result) run text(&mut out, b" = ") }
    let op = inst.op
    if op == Op.Arg { run text(&mut out, b"arg ") run number(&mut out, i32.wrappingToU32(inst.k)) }
    else if op == Op.ConstI32 { run text(&mut out, b"const.i32 ") run signed(&mut out, inst.k) }
    else if op == Op.Imm { run text(&mut out, b"imm ") run text(&mut out, immName(inst.k)) }
    else if op == Op.Unbox { run text(&mut out, b"unbox.i32 ") run operand(&mut out, inst.a) }
    else if op == Op.UnboxBool { run text(&mut out, b"unbox.bool ") run operand(&mut out, inst.a) }
    else if op == Op.BoxI32 { run text(&mut out, b"box.i32 ") run operand(&mut out, inst.a) }
    else if op == Op.BoxBool { run text(&mut out, b"box.bool ") run operand(&mut out, inst.a) }
    else if op == Op.Add || op == Op.Sub || op == Op.Mul || op == Op.Cmp {
      if op == Op.Add { run text(&mut out, b"add.i32 ") }
      else if op == Op.Sub { run text(&mut out, b"sub.i32 ") }
      else if op == Op.Mul { run text(&mut out, b"mul.i32 ") }
      else { run text(&mut out, cmpName(inst.k)) run text(&mut out, b".i32 ") }
      run operand(&mut out, inst.a) run text(&mut out, b", ") run operand(&mut out, inst.b)
    }
    else if op == Op.ConstF64 { run text(&mut out, b"const.f64 #") run number(&mut out, i32.wrappingToU32(inst.k)) }
    else if isNumberOp(op) {
      run text(&mut out, numberOpName(op))
      if op == Op.CmpF64 { run text(&mut out, cmpName(inst.k)) run text(&mut out, b".f64") }
      run text(&mut out, b" ") run operand(&mut out, inst.a)
      if numberOpReadsB(op) { run text(&mut out, b", ") run operand(&mut out, inst.b) }
    }
    else if op == Op.Retain { run text(&mut out, b"retain ") run operand(&mut out, inst.a) }
    else if op == Op.Release { run text(&mut out, b"release ") run operand(&mut out, inst.a) }
    else if op == Op.Poll { run text(&mut out, b"poll") }
    else if op == Op.Jump { run text(&mut out, b"jump ") run self.printEdge(&mut out, inst.edge) }
    else if op == Op.Branch {
      run text(&mut out, b"branch ") run operand(&mut out, inst.a) run text(&mut out, b", ")
      run self.printEdge(&mut out, inst.edge) run text(&mut out, b", ") run self.printEdge(&mut out, inst.edge + 1)
    }
    else if op == Op.Return { run text(&mut out, b"return ") run operand(&mut out, inst.a) }
    else if op == Op.This { run text(&mut out, b"this") }
    else if op == Op.CheckTag { run text(&mut out, b"check.tag ") run operand(&mut out, inst.a) run text(&mut out, b", ") run signed(&mut out, inst.k) }
    else if op == Op.GetField { run text(&mut out, b"get.field ") run operand(&mut out, inst.a) }
    else if op == Op.GetElem { run text(&mut out, b"get.elem ") run operand(&mut out, inst.a) run text(&mut out, b", ") run operand(&mut out, inst.b) }
    else if op == Op.PutElem { run text(&mut out, b"put.elem ") run operand(&mut out, inst.a) run text(&mut out, b", ") run operand(&mut out, inst.b) run text(&mut out, b", ") run operand(&mut out, i32.wrappingToU32(inst.k)) }
    else if op == Op.GetLength { run text(&mut out, b"get.length ") run operand(&mut out, inst.a) }
    else if op == Op.Truthy { run text(&mut out, b"truthy ") run operand(&mut out, inst.a) }
    else if op == Op.TagIs { run text(&mut out, b"tag.is ") run operand(&mut out, inst.a) run text(&mut out, b", ") run signed(&mut out, inst.k) }
    else if op == Op.Equals { run text(&mut out, b"equals ") run operand(&mut out, inst.a) run text(&mut out, b", ") run operand(&mut out, inst.b) run text(&mut out, b", ") run signed(&mut out, inst.k) }
    else if op == Op.InstanceOf { run text(&mut out, b"instanceof ") run operand(&mut out, inst.a) run text(&mut out, b", ") run operand(&mut out, inst.b) }
    else if op == Op.TypeofAtom { run text(&mut out, b"typeof ") run operand(&mut out, inst.a) }
    else if op == Op.GetScope { run text(&mut out, b"get.scope ") run signed(&mut out, inst.k) }
    else if op == Op.PutScope { run text(&mut out, b"put.scope ") run operand(&mut out, inst.a) run text(&mut out, b", ") run signed(&mut out, inst.k) }
    else if op == Op.GetVar { run text(&mut out, b"get.var ") run signed(&mut out, inst.k) }
    else if op == Op.PutVar { run text(&mut out, b"put.var ") run operand(&mut out, inst.a) run text(&mut out, b", ") run signed(&mut out, inst.k) }
    else if op == Op.AtomValue { run text(&mut out, b"atom.value ") run signed(&mut out, inst.k) }
    else if op == Op.PutField { run text(&mut out, b"put.field ") run operand(&mut out, inst.a) run text(&mut out, b", ") run operand(&mut out, inst.b) }
    else if op == Op.CallArg { run text(&mut out, b"call.arg ") run operand(&mut out, inst.a) run text(&mut out, b", ") run signed(&mut out, inst.k) }
    else if op == Op.Call {
      run text(&mut out, b"call ") run operand(&mut out, inst.a) run text(&mut out, b", ") run operand(&mut out, inst.b)
      run text(&mut out, b", ") run signed(&mut out, inst.k)
    }
    else if op == Op.CheckCallee { run text(&mut out, b"check.callee ") run operand(&mut out, inst.a) run text(&mut out, b", ") run signed(&mut out, inst.k) }
    else if op == Op.InlineFrame { run text(&mut out, b"inline.frame ") run operand(&mut out, inst.a) run text(&mut out, b", ") run signed(&mut out, inst.k) }
    else { run text(&mut out, b"removed") }
    if inst.frame != 0 { run text(&mut out, b" frame ") run number(&mut out, inst.frame) }
    if inst.exit != NONE { run text(&mut out, b" exit e") run number(&mut out, inst.exit) }
    run text(&mut out, b"   @") run number(&mut out, inst.pc)
    run text(&mut out, b"\n")
  }

  effect fn printSlot(self: &Self, out: &mut List<u8>, slot: Slot) -> () ! OutOfMemoryError ? &mut Allocator {
    run text(&mut out, slotModeName(slot.mode)) run text(&mut out, b" ") run operand(&mut out, slot.value)
    if slot.root != NONE { run text(&mut out, b" (arg ") run number(&mut out, slot.root) run text(&mut out, b")") }
  }
}

pub fn immName(k: i32) -> &'static [u8] {
  if k == 0 { return b"undefined" }
  if k == 1 { return b"null" }
  if k == 2 { return b"false" }
  if k == 3 { return b"true" }
  if k >= IMM_CATCH { return b"catch" }
  return b"uninitialized"
}
pub fn cmpName(k: i32) -> &'static [u8] {
  if k == 0 { return b"lt" }
  if k == 1 { return b"le" }
  if k == 2 { return b"gt" }
  if k == 3 { return b"ge" }
  if k == 4 { return b"eq" }
  return b"ne"
}
pub fn slotModeName(mode: SlotMode) -> &'static [u8] {
  if mode == SlotMode.Int { return b"int" }
  if mode == SlotMode.Bool { return b"bool" }
  if mode == SlotMode.Imm { return b"imm" }
  if mode == SlotMode.Move { return b"move" }
  if mode == SlotMode.F64 { return b"f64" }
  return b"dup"
}

pub effect fn text(out: &mut List<u8>, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator { run out.appendSlice(bytes) }
effect fn operand(out: &mut List<u8>, v: u32) -> () ! OutOfMemoryError ? &mut Allocator { run text(&mut out, b"v") run number(&mut out, v) }
/// Appends `value` in decimal.
pub effect fn number(out: &mut List<u8>, value: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut digits: [u8; 10] = [0; 10]
  let mut count: usize = 0
  let mut rest = value
  while count == 0 || rest > 0 { digits[count] = u32.wrappingToU8(rest % 10) + 48 rest = rest / 10 count = count + 1 }
  while count > 0 { count = count - 1 run out.append(digits[count]) }
}
/// Appends `value` in decimal with a sign when negative.
pub effect fn signed(out: &mut List<u8>, value: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  if value < 0 {
    run out.append(45)
    // -2^31 has no positive i32; its magnitude still fits a u32.
    run number(&mut out, u32.wrappingSubtract(0, i32.wrappingToU32(value)))
    return ()
  }
  run number(&mut out, i32.wrappingToU32(value))
}

/// Whether `op` reads a third value, whose number its `k` holds (put.elem's index).
pub fn readsK(op: Op) -> bool { return op == Op.PutElem }
/// The printed name of a K operation (docs/jit/doubles.md), or empty. `cmp.f64` prints its
/// comparison after this prefix.
pub fn numberOpName(op: Op) -> &'static [u8] {
  if op == Op.UnboxF64 { return b"unbox.f64" }
  if op == Op.BoxF64 { return b"box.f64" }
  if op == Op.ToF64 { return b"f64" }
  if op == Op.AddF64 { return b"add.f64" }
  if op == Op.SubF64 { return b"sub.f64" }
  if op == Op.MulF64 { return b"mul.f64" }
  if op == Op.DivF64 { return b"div.f64" }
  if op == Op.CmpF64 { return b"" }
  if op == Op.NegF64 { return b"neg.f64" }
  if op == Op.SqrtF64 { return b"sqrt.f64" }
  if op == Op.AbsF64 { return b"abs.f64" }
  if op == Op.FloorF64 { return b"floor.f64" }
  if op == Op.ToInt32 { return b"toint32" }
  if op == Op.ExactI32 { return b"int.f64" }
  if op == Op.BitAnd { return b"and.i32" }
  if op == Op.BitOr { return b"or.i32" }
  if op == Op.BitXor { return b"xor.i32" }
  if op == Op.Shl { return b"shl.i32" }
  if op == Op.Sar { return b"sar.i32" }
  if op == Op.Shr { return b"shr.i32" }
  if op == Op.Mod { return b"mod.i32" }
  if op == Op.Neg { return b"neg.i32" }
  if op == Op.BitNot { return b"not.i32" }
  if op == Op.NotBool { return b"not.bool" }
  if op == Op.Imul { return b"imul.i32" }
  return b""
}
/// Whether a K operation is one (numberOpName nonempty or `cmp.f64`).
pub fn isNumberOp(op: Op) -> bool { return op == Op.CmpF64 || numberOpName(op).length > 0 }
/// Whether a K operation reads operand `b`.
pub fn numberOpReadsB(op: Op) -> bool {
  return op == Op.AddF64 || op == Op.SubF64 || op == Op.MulF64 || op == Op.DivF64 || op == Op.CmpF64 || op == Op.BitAnd
    || op == Op.BitOr || op == Op.BitXor || op == Op.Shl || op == Op.Sar || op == Op.Shr || op == Op.Mod || op == Op.Imul
}
/// Whether a K operation is a guard (carries an exit).
pub fn numberOpHasExit(op: Op) -> bool {
  return op == Op.UnboxF64 || op == Op.ToInt32 || op == Op.ExactI32 || op == Op.Shr || op == Op.Mod || op == Op.Neg
}
