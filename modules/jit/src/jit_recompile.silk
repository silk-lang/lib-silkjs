//! What the JIT remembers between compilations of a function (docs/jit/doubles.md,
//! "Recompilation"). A function the engine unlinked for deoptimizing too often is reported hot
//! again (js_compiled.rearmHotness); its next compilation widens the sites that deoptimized
//! (CompiledEntry.deoptPcs) to numbers, at most MAX_RECOMPILES times, and refuses it for good
//! when that runs out or when it deoptimized only where it was already widened.
//!
//! Functions are recognised by their code: a hash of the bytecode bytes with the argument and
//! local counts. The cell address only tells a re-report of the same function from another
//! function with the same code (which starts from what the first one learned). Both are hints:
//! every guard stays in the compiled code, so a wrong match costs speed, never correctness.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silkjs.js_core_types { FunctionBytecode, CompiledEntry }

/// Compilations after the first a function may have.
pub const MAX_RECOMPILES: u32 = 2
const NONE: u32 = 4294967295

struct Record {
  address: usize,
  hash: u64,
  /// Compilations so far, refusals included.
  compiles: u32,
  /// The table entry of the code compiled last, or NONE.
  entry: u32,
  sites: List<u32>,
  /// Bytecode bytes translated for it so far, normal and OSR lowerings and refusals alike:
  /// what the compile budget counts (jit_runtime Options.compileBudget).
  lowered: u64,
  /// Whether its coming recompilation already waited for the function to prove hot again.
  waited: bool
}

pub struct History { records: List<Record> }

/// What to do with a reported function: refuse it (with why), or compile it with `sites` as
/// double sites. `record` names the History record to update afterwards; `recompile` says
/// whether this is a function's second or later compilation.
/// kinds: for each of sites the operand kinds the entry recorded there (CompiledEntry.deoptKinds),
/// 0 for a site of an earlier compilation.
pub struct Plan { pub refuse: bool, pub why: &'static [u8], pub sites: List<u32>, pub kinds: List<u8>, pub recompile: bool, record: usize }

/// FNV-1a over the code and the counts the translator reads.
unsafe fn hashOf(function: &FunctionBytecode) -> u64 {
  let mut hash: u64 = 14695981039346656037
  let bytes = unsafe function.code.asSlice()
  let mut index: usize = 0
  while index < bytes.length { hash = u64.wrappingMultiply(u64.bitXor(hash, u8.toU64(bytes[index])), 1099511628211) index = index + 1 }
  hash = u64.wrappingMultiply(u64.bitXor(hash, u16.toU64(function.argumentCount)), 1099511628211)
  hash = u64.wrappingMultiply(u64.bitXor(hash, u16.toU64(function.variableCount)), 1099511628211)
  return u64.wrappingMultiply(u64.bitXor(hash, usize.toU64(bytes.length)), 1099511628211)
}

effect fn copy(from: &List<u32>) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u32>.make()
  run out.appendSlice(from.asSlice())
  return move out
}
fn has(list: &List<u32>, value: u32) -> bool {
  let mut i: usize = 0
  while i < list.length() { if list.get(i) == value { return true } i = i + 1 }
  return false
}

impl History {
  pub fn make() -> History { return History { records: List<Record>.make() } }

  /// The plan for `function`, reported hot, at `address`; `entries` is the compiled code table.
  pub unsafe effect fn plan(self: &mut Self, function: &FunctionBytecode, address: usize, entries: &List<CompiledEntry>) -> Plan
    ! OutOfMemoryError ? &mut Allocator {
    let hash = unsafe hashOf(&function)
    let mut same = self.records.length()
    let mut alike = self.records.length()
    let mut i: usize = 0
    while i < self.records.length() {
      let record = &self.records.asSlice()[i]
      if record.hash == hash {
        if record.address == address { same = i } else if alike == self.records.length() { alike = i }
      }
      i = i + 1
    }
    if same < self.records.length() {
      // Reported again: its code was unlinked (or it was refused and the engine re-armed it).
      let record = &mut self.records.asMutSlice()[same]
      if record.compiles > MAX_RECOMPILES {
        return Plan { refuse: true, why: b"recompiled too often", sites: List<u32>.make(), kinds: List<u8>.make(), recompile: true, record: same }
      }
      let mut sites = run copy(&record.sites)
      let mut widened = false
      if record.entry != NONE {
        let entry = &entries.asSlice()[u32.toUsize(record.entry)]
        let mut k: usize = 0
        while k < u8.toUsize(entry.deoptPcCount) {
          let pc = entry.deoptPcs[k]
          if !has(&sites, pc) { run sites.append(pc) widened = true }
          k = k + 1
        }
      }
      let mut kinds = List<u8>.make()
      let mut s: usize = 0
      while s < sites.length() {
        let mut kind: u8 = 0
        if record.entry != NONE {
          let entry = &entries.asSlice()[u32.toUsize(record.entry)]
          let mut k: usize = 0
          while k < u8.toUsize(entry.deoptPcCount) { if entry.deoptPcs[k] == sites.get(s) { kind = entry.deoptKinds[k] } k = k + 1 }
        }
        run kinds.append(kind)
        s = s + 1
      }
      if !widened {
        record.compiles = MAX_RECOMPILES + 1
        return Plan { refuse: true, why: b"deoptimized again where it was already widened", sites: move sites, kinds: move kinds, recompile: true, record: same }
      }
      return Plan { refuse: false, why: b"", sites: move sites, kinds: move kinds, recompile: true, record: same }
    }
    let mut sites = List<u32>.make()
    if alike < self.records.length() { sites = run copy(&self.records.asSlice()[alike].sites) }
    run self.records.append(Record { address: address, hash: hash, compiles: 0, entry: NONE, sites: List<u32>.make(), lowered: 0, waited: false })
    return Plan { refuse: false, why: b"", sites: move sites, kinds: List<u8>.make(), recompile: false, record: self.records.length() - 1 }
  }

  /// Records the outcome of `plan`: compiled into table entry `entry`, or NONE when refused.
  pub effect fn remember(self: &mut Self, plan: &Plan, entry: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let record = &mut self.records.asMutSlice()[plan.record]
    record.compiles = record.compiles + 1
    record.entry = entry
    record.waited = false
    record.sites.clear()
    run record.sites.appendSlice(plan.sites.asSlice())
  }
}

impl History {
  /// Whether lowering `bytes` more bytecode bytes for plan's function stays within `budget`
  /// (0: no budget); if so they are counted.
  pub fn charge(self: &mut Self, plan: &Plan, bytes: usize, budget: u64) -> bool {
    let record = &mut self.records.asMutSlice()[plan.record]
    let total = record.lowered + usize.toU64(bytes)
    if budget != 0 && total > budget { return false }
    record.lowered = total
    return true
  }
}

/// Entries a recompilation waits for, as a multiple of the hot budget, per compilation so far.
const BACKOFF: u32 = 8

impl History {
  /// How many hot budgets of entries plan's function must run before it is compiled again, or
  /// 0 to compile now. Code that deoptimized until it was unlinked was wasted work, so each
  /// recompilation asks for BACKOFF times more proof than the one before; asked once per
  /// recompilation (the function is reported again when the entries are used up).
  pub fn backoff(self: &mut Self, plan: &Plan) -> u32 {
    if !plan.recompile || plan.refuse { return 0 }
    let record = &mut self.records.asMutSlice()[plan.record]
    if record.waited { return 0 }
    record.waited = true
    let mut wait: u32 = BACKOFF
    let mut n: u32 = 1
    while n < record.compiles && n < MAX_RECOMPILES { wait = wait * BACKOFF n = n + 1 }
    return wait
  }
}

/// The NONE entry for `remember`.
pub fn noEntry() -> u32 { return NONE }
