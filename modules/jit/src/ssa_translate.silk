//! Engine bytecode to the SSA form, for the first subset (docs/jit/ssa.md, "The translator").
//!
//! The output models the interpreter's counts literally: a pushed local or argument is a
//! `retain`, a dropped operand a `release`, a local written over releases its old value, a
//! return releases every local and leftover operand. `ssa_ownership` removes what it can prove
//! redundant. Anything outside the subset fails with `Refusal`; nothing is guessed.
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.i8
import silk.num.i16
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silkjs.js_opcode_data as op
import silkjs.js_atom_data as atoms
import ssa { Function, Type, Own, RootKind, Op, Cmp, Imm, SlotMode, NONE }
import ssa_calls as calls
import ssa

/// What the translator reads about a function: plain numbers and the code bytes, nothing that
/// points into a runtime, so it can be serialized (ahead-of-time compilation).
pub struct FunctionInput {
  /// The final bytecode (`FunctionBytecode.code`).
  pub code: List<u8>,
  /// Argument cells the frame has (`argumentCount`).
  pub argumentCount: u32,
  /// Locals (`variableCount`).
  pub localCount: u32,
  /// Closure variables (`varRefCount`) and own scope slots (`scopeSlots`): refused when nonzero.
  pub closureVars: u32,
  pub scopeSlots: u32,
  /// A plain function (not a generator or async).
  pub normal: bool,
  /// The function's constants as numbers, by constant index (docs/jit/doubles.md).
  pub numberConstants: List<NumberConstant>,
  /// Bytecode offsets of arithmetic and comparison sites to compile as numbers (f64) rather
  /// than int32: sites that deoptimized in an earlier compilation of the same code.
  pub doubleSites: List<u32>,
  /// Some local is captured by a closure (VarDef.isCaptured): a callee could read or write
  /// its frame cell, so on-stack-replacement code that holds it must not make calls.
  pub capturedLocals: bool,
  /// Call sites that may be inlined (docs/jit/inlining.md): what the embedder saw each one
  /// call when it compiled. A hint: the code guards the callee's identity where it is used.
  pub targets: List<CallTarget>,
}

/// The function the call that follows the `get_field2` at `pc` called last: `input` describes
/// it and `id` names it to the embedder (`Function.inlineTargets`).
pub struct CallTarget { pub pc: u32, pub id: u32, pub input: FunctionInput }

/// Inlined bodies nest at most this deep, and are at most this many bytes of code each.
const MAX_INLINE_DEPTH: u32 = 3
const MAX_INLINE_BYTES: usize = 96
/// Inlined call sites one function may have (each takes a frame record on the native stack).
const MAX_INLINE_SITES: usize = 16

/// What an inlined body may be made of: the subset without control flow (a return ends it).
fn inlinable(opcode: u8) -> bool { return supported(opcode) && !isBranch(opcode) && !isGoto(opcode) }

/// Whether `operation` changes nothing a later exit to the state before the call would have
/// to undo (counts aside: the exit drops what the body owns). Anything not listed is an
/// effect, so an operation added later is one until it is put here.
fn withoutEffect(operation: Op) -> bool {
  return operation == Op.Arg || operation == Op.ConstI32 || operation == Op.Imm || operation == Op.Unbox || operation == Op.UnboxBool
    || operation == Op.BoxI32 || operation == Op.BoxBool || operation == Op.Add || operation == Op.Sub || operation == Op.Mul
    || operation == Op.Cmp || operation == Op.Retain || operation == Op.Release || operation == Op.CheckTag
    || operation == Op.GetField || operation == Op.AtomValue || operation == Op.GetVar || operation == Op.GetScope
    || operation == Op.GetElem || operation == Op.GetLength || operation == Op.Truthy || operation == Op.TagIs || operation == Op.TypeofAtom
    || operation == Op.CheckCallee || operation == Op.InlineFrame
    || operation == Op.ConstF64 || ssa.isNumberOp(operation)
}

/// Constant kinds of `NumberConstant`.
pub const CONSTANT_OTHER: u8 = 0
pub const CONSTANT_INT: u8 = 1
pub const CONSTANT_DOUBLE: u8 = 2
/// A constant of the function: an Int (`bits` its i32 bits), a Float64 (`bits` its f64 bits)
/// or something else.
pub struct NumberConstant { pub kind: u8, pub bits: u64 }
impl Copy for NumberConstant {}

/// Why a function was not translated. `pc` and `opcode` name the instruction, when one is to
/// blame (else `pc` is NONE).
pub struct Refusal { pub pc: u32, pub opcode: u8, pub reason: &'static [u8] }

fn refuse(pc: u32, opcode: u8, reason: &'static [u8]) -> Refusal { return Refusal { pc: pc, opcode: opcode, reason: reason } }

/// The opcodes the first subset translates.
pub fn supported(opcode: u8) -> bool {
  return opcode == op.OP_push_i32 || opcode == op.OP_push_i8 || opcode == op.OP_push_i16
    || opcode == op.OP_push_0 || opcode == op.OP_push_1 || opcode == op.OP_undefined || opcode == op.OP_null
    || opcode == op.OP_push_true || opcode == op.OP_push_false
    || opcode == op.OP_drop || opcode == op.OP_dup || opcode == op.OP_nip || opcode == op.OP_swap || shuffleOf(opcode).length != 0
    || opcode == op.OP_get_loc || opcode == op.OP_put_loc || opcode == op.OP_set_loc
    || opcode == op.OP_get_loc8 || opcode == op.OP_put_loc8 || opcode == op.OP_set_loc8
    || (opcode >= op.OP_get_loc0 && opcode <= op.OP_put_loc3)
    || opcode == op.OP_get_arg || (opcode >= op.OP_get_arg0 && opcode <= op.OP_get_arg3)
    || opcode == op.OP_set_loc_uninitialized || opcode == op.OP_get_loc_check
    || opcode == op.OP_put_loc_check || opcode == op.OP_put_loc_check_init
    || opcode == op.OP_add || opcode == op.OP_sub || opcode == op.OP_mul || opcode == op.OP_add_imm
    || opcode == op.OP_inc || opcode == op.OP_dec || opcode == op.OP_inc_loc || opcode == op.OP_dec_loc
    || opcode == op.OP_add_loc || opcode == op.OP_step_loc8
    || (opcode >= op.OP_add_loc_loc8 && opcode <= op.OP_mul_top_loc8)
    || (opcode >= op.OP_add_top_arg8 && opcode <= op.OP_mul_top_arg8)
    || opcode == op.OP_lt || opcode == op.OP_lte || opcode == op.OP_gt || opcode == op.OP_gte
    || opcode == op.OP_eq || opcode == op.OP_neq || opcode == op.OP_strict_eq || opcode == op.OP_strict_neq
    || opcode == op.OP_if_false || opcode == op.OP_if_true || opcode == op.OP_if_false8 || opcode == op.OP_if_true8
    || opcode == op.OP_goto || opcode == op.OP_goto8 || opcode == op.OP_goto16
    || opcode == op.OP_return || opcode == op.OP_return_undef || opcode == op.OP_fuse_prefix
    || objectOpcode(opcode) || callOpcode(opcode) || numberOpcode(opcode) || keepBranch(opcode) || testOpcode(opcode)
    || opcode == op.OP_instanceof
}

/// Where on-stack-replacement code leaves for the interpreter: outside the subset, or a call
/// (OSR code runs on a live, possibly inline frame with no call block; docs/jit/osr.md).
fn osrExit(opcode: u8, calls: bool) -> bool { return !supported(opcode) || (!calls && callOpcode(opcode)) }
/// Whether OSR code for input may make calls: asked for, no captured local, and no
/// arguments object or direct eval that could alias the frame's cells.
fn osrMayCall(input: &FunctionInput, allowCalls: bool) -> bool {
  if !allowCalls || input.capturedLocals { return false }
  let mut pc: usize = 0
  while pc < input.code.length() {
    let opcode = byteAt(input, pc)
    if opcode == op.OP_special_object || opcode == op.OP_eval || opcode == op.OP_apply_eval { return false }
    let size = sizeAt(input, pc)
    if size == 0 { return false }
    pc = pc + size
  }
  return true
}

/// Workstream H's calls: `call0`..`call3`, `call`, `call_method` and `call_constructor`.
pub fn callOpcode(opcode: u8) -> bool {
  return (opcode >= op.OP_call0 && opcode <= op.OP_call3) || opcode == op.OP_call || opcode == op.OP_call_method || opcode == op.OP_call_constructor
}

/// Workstream J's opcodes (`this`, properties, globals, scopes, elements) translated below.
pub fn objectOpcode(opcode: u8) -> bool {
  return opcode == op.OP_push_this || opcode == op.OP_get_field || opcode == op.OP_get_field2
    || opcode == op.OP_get_loc_field8 || opcode == op.OP_get_arg_field8
    || opcode == op.OP_put_field || opcode == op.OP_put_loc_field_loc8 || opcode == op.OP_put_loc_field_arg8
    || opcode == op.OP_push_atom_value || opcode == op.OP_push_empty_string
    || opcode == op.OP_get_var || opcode == op.OP_get_var_undef || opcode == op.OP_put_var
    || opcode == op.OP_get_scope0 || opcode == op.OP_get_scope0_check || opcode == op.OP_put_scope0
    || opcode == op.OP_put_scope0_check || opcode == op.OP_set_scope0
    || opcode == op.OP_get_var_ref || opcode == op.OP_get_var_ref_check || opcode == op.OP_put_var_ref
    || opcode == op.OP_put_var_ref_check || opcode == op.OP_set_var_ref
    || opcode == op.OP_get_array_el || opcode == op.OP_get_array_el2 || opcode == op.OP_get_array_el3
    || opcode == op.OP_put_array_el || opcode == op.OP_get_length
    || opcode == op.OP_get_loc_length8 || opcode == op.OP_get_arg_length8 || opcode == op.OP_get_loc_el8
    || opcode == op.OP_get_arg_el8 || opcode == op.OP_get_loc_el_arg8 || opcode == op.OP_get_arg_el_arg8
}
/// GetField's `k`: which engine read serves the site.
pub const FIELD_KEYED: i32 = 0
pub const FIELD_CACHED: i32 = 1

/// The opcodes the number and operator part translates (docs/jit/doubles.md).
pub fn numberOpcode(opcode: u8) -> bool {
  return opcode == op.OP_div || opcode == op.OP_mod || opcode == op.OP_shl || opcode == op.OP_sar || opcode == op.OP_shr
    || opcode == op.OP_and || opcode == op.OP_xor || opcode == op.OP_or || opcode == op.OP_shl_imm || opcode == op.OP_sar_imm
    || opcode == op.OP_and_imm || opcode == op.OP_or_imm || opcode == op.OP_neg || opcode == op.OP_plus || opcode == op.OP_not
    || opcode == op.OP_lnot || opcode == op.OP_post_inc || opcode == op.OP_post_dec || opcode == op.OP_push_const
    || opcode == op.OP_push_const8 || opcode == op.OP_strict_eq_imm8 || opcode == op.OP_strict_neq_imm8
}
/// `if_true_keep8`/`if_false_keep8`: a branch whose taken edge keeps the tested value.
fn keepBranch(opcode: u8) -> bool { return opcode == op.OP_if_true_keep8 || opcode == op.OP_if_false_keep8 || opcode == op.OP_if_not_nullish_keep8 }
/// The undefined/null tests and typeof tests (no exit but typeof's proxy), and the branches
/// on them.
fn testOpcode(opcode: u8) -> bool {
  return opcode == op.OP_is_undefined || opcode == op.OP_is_null || opcode == op.OP_is_undefined_or_null
    || opcode == op.OP_typeof_is_undefined || opcode == op.OP_typeof_is_function || opcode == op.OP_typeof_is
    || nullMask(opcode) != 0
}
/// The stack shuffles (js_vm_values.step): the window's size in operands, then for each
/// result operand, bottom to top, the window position (bottom 0) it copies, all as ASCII
/// digits. A position used twice is retained once more; one never used is released. Empty
/// for any other opcode. dup3, perm5, swap2, rot4l and rot5l are absent: final code writes
/// them behind OP_extended (js_opcode_data.movedToExtended), and their bytes mean other opcodes.
pub fn shuffleOf(opcode: u8) -> &'static [u8] {
  if opcode == op.OP_nip1 { return b"312" }
  if opcode == op.OP_dup1 { return b"2001" }
  if opcode == op.OP_dup2 { return b"20101" }
  if opcode == op.OP_insert2 { return b"2101" }
  if opcode == op.OP_insert3 { return b"32012" }
  if opcode == op.OP_insert4 { return b"430123" }
  if opcode == op.OP_perm3 { return b"3102" }
  if opcode == op.OP_perm4 { return b"42013" }
  if opcode == op.OP_rot3l { return b"3120" }
  if opcode == op.OP_rot3r { return b"3201" }
  return b""
}
/// tag.is's mask (1 undefined, 2 null) for a test or a branch on one; 0 for anything else.
fn nullMask(opcode: u8) -> i32 {
  if opcode == op.OP_is_undefined { return 1 }
  if opcode == op.OP_is_null || opcode == op.OP_if_null8 || opcode == op.OP_if_not_null8 { return 2 }
  if opcode == op.OP_is_undefined_or_null || opcode == op.OP_if_nullish8 || opcode == op.OP_if_not_nullish8
    || opcode == op.OP_if_not_nullish_keep8 { return 3 }
  return 0
}
/// typeof_is's operand as the type name's atom (js_bytecode.typeofIsAtom).
fn typeofIsAtom(index: u8) -> u32 {
  if index == 0 { return atoms.JS_ATOM_string }
  if index == 1 { return atoms.JS_ATOM_number }
  if index == 2 { return atoms.JS_ATOM_object }
  if index == 3 { return atoms.JS_ATOM_boolean }
  if index == 4 { return atoms.JS_ATOM_symbol }
  if index == 5 { return atoms.JS_ATOM_bigint }
  if index == 6 { return atoms.JS_ATOM_undefined }
  if index == 7 { return atoms.JS_ATOM_function }
  return atoms.JS_ATOM_unknown
}
/// The branches on a nullish or null test: a padding byte, then the displacement.
fn nullBranch(opcode: u8) -> bool {
  return opcode == op.OP_if_nullish8 || opcode == op.OP_if_not_nullish8 || opcode == op.OP_if_null8 || opcode == op.OP_if_not_null8
}

fn isBranch(opcode: u8) -> bool {
  return opcode == op.OP_if_false || opcode == op.OP_if_true || opcode == op.OP_if_false8 || opcode == op.OP_if_true8
    || keepBranch(opcode) || nullBranch(opcode)
}
/// The double operation of an int32 one (`add`, `sub`, `mul`).
fn doubleOf(operation: Op) -> Op {
  if operation == Op.Sub { return Op.SubF64 }
  if operation == Op.Mul { return Op.MulF64 }
  return Op.AddF64
}
fn isGoto(opcode: u8) -> bool { return opcode == op.OP_goto || opcode == op.OP_goto8 || opcode == op.OP_goto16 }
fn isReturn(opcode: u8) -> bool { return opcode == op.OP_return || opcode == op.OP_return_undef }

fn byteAt(input: &FunctionInput, at: usize) -> u8 { return input.code.get(at) }
fn u16At(input: &FunctionInput, at: usize) -> u16 { return u8.toU16(byteAt(input, at)) | u16.shiftLeft(u8.toU16(byteAt(input, at + 1)), 8) }
fn i32At(input: &FunctionInput, at: usize) -> i32 {
  let bits = u8.toU32(byteAt(input, at)) | u32.shiftLeft(u8.toU32(byteAt(input, at + 1)), 8)
    | u32.shiftLeft(u8.toU32(byteAt(input, at + 2)), 16) | u32.shiftLeft(u8.toU32(byteAt(input, at + 3)), 24)
  return u32.wrappingToI32(bits)
}
fn i8At(input: &FunctionInput, at: usize) -> i32 { return i8.toI32(u8.wrappingToI8(byteAt(input, at))) }
fn i16At(input: &FunctionInput, at: usize) -> i32 { return i16.toI32(u16.wrappingToI16(u16At(input, at))) }

/// The size of the instruction at `pc`, from the engine's table.
fn sizeAt(input: &FunctionInput, pc: usize) -> usize { return u8.toUsize(op.opcodeInfo(byteAt(input, pc), true).size) }

/// The target of the branch or goto at `pc`: displacements count from the first operand byte
/// (`Machine.jump`).
fn targetOf(input: &FunctionInput, pc: usize) -> i64 {
  let opcode = byteAt(input, pc)
  let mut displacement: i32 = 0
  if opcode == op.OP_if_false || opcode == op.OP_if_true || opcode == op.OP_goto { displacement = i32At(input, pc + 1) }
  else if opcode == op.OP_goto16 { displacement = i16At(input, pc + 1) }
  else if opcode == op.OP_if_not_nullish_keep8 {
    // dup, if_not_nullish8, drop: its displacement is the fourth byte and counts from itself.
    return usize.toI64(pc + 3) + i32.toI64(i8At(input, pc + 3))
  }
  else if keepBranch(opcode) || nullBranch(opcode) {
    // dup, if_*8, drop in one: the displacement counts from its own byte, the second.
    return usize.toI64(pc + 2) + i32.toI64(i8At(input, pc + 2))
  }
  else { displacement = i8At(input, pc + 1) }
  return usize.toI64(pc + 1) + i32.toI64(displacement)
}

/// Pass A: every reachable instruction start, every block leader and the operand stack depth
/// at each leader, from the engine's pops and pushes. Fails on code outside the subset.
struct Shape { leader: List<bool>, depth: List<i32>, start: List<bool> }

effect fn shape(input: &FunctionInput) -> Shape ! Refusal | OutOfMemoryError ? &mut Allocator { return run shapeAt(input, 0, false, true, 0, u32.MAX) }

/// shape walking from the instruction at `begin` (stack empty there). With `sideExits`, an
/// opcode outside the subset, or an instruction outside [low, high], ends its block (the
/// translator exits there) instead of refusing.
effect fn shapeAt(input: &FunctionInput, begin: usize, sideExits: bool, calls: bool, low: u32, high: u32) -> Shape ! Refusal | OutOfMemoryError ? &mut Allocator {
  let length = input.code.length()
  let mut leader = List<bool>.make() run leader.appendRepeated(false, length + 1)
  let mut start = List<bool>.make() run start.appendRepeated(false, length + 1)
  let mut depth = List<i32>.make() run depth.appendRepeated(-1, length + 1)
  let mut work = List<usize>.make()
  let mut workDepth = List<i32>.make()
  if begin >= length { fail refuse(usize.toU32(begin), 0, b"control falls off the end of the code") }
  leader.set(begin, true) depth.set(begin, 0)
  run work.append(begin) run workDepth.append(0)
  while work.length() > 0 {
    let mut pc = work.pop().unwrapOr(0)
    let mut d = workDepth.pop().unwrapOr(0)
    let mut going = true
    while going {
      if pc >= length { fail refuse(usize.toU32(pc), 0, b"control falls off the end of the code") }
      if start.get(pc) { going = false }
      else {
        start.set(pc, true)
        let opcode = byteAt(input, pc)
        if !supported(opcode) && !sideExits { fail refuse(usize.toU32(pc), opcode, b"opcode outside the subset") }
        // A side exit: the state before it is the block's, nothing after it is reached.
        if sideExits && (osrExit(opcode, calls) || outside(pc, low, high)) { going = false continue }
        let info = op.opcodeInfo(opcode, true)
        let size = u8.toUsize(info.size)
        if size == 0 || pc + size > length { fail refuse(usize.toU32(pc), opcode, b"truncated instruction") }
        d = d - u8.toI32(info.pops) + u8.toI32(info.pushes)
        // A call's table entry counts only its fixed operands; the argument count is in the code.
        if opcode == op.OP_call || opcode == op.OP_call_method || opcode == op.OP_call_constructor { d = d - u16.toI32(u16At(input, pc + 1)) }
        if opcode >= op.OP_call0 && opcode <= op.OP_call3 { d = d - u8.toI32(opcode - op.OP_call0) }
        if d < 0 { fail refuse(usize.toU32(pc), opcode, b"operand stack underflow") }
        if isReturn(opcode) { going = false }
        else if isBranch(opcode) || isGoto(opcode) {
          let target = targetOf(input, pc)
          if target < 0 || target >= usize.toI64(length) { fail refuse(usize.toU32(pc), opcode, b"jump outside the code") }
          let t = i64.toUsize(target)
          // The taken edge of a keep branch still has the tested value.
          let mut taken = d
          if keepBranch(opcode) { taken = d + 1 }
          run mark(&mut leader, &mut depth, &mut work, &mut workDepth, t, taken, pc, opcode)
          if isBranch(opcode) { run mark(&mut leader, &mut depth, &mut work, &mut workDepth, pc + size, d, pc, opcode) }
          going = false
        } else {
          pc = pc + size
          if leader.get(pc) {
            run mark(&mut leader, &mut depth, &mut work, &mut workDepth, pc, d, pc, opcode)
            going = false
          }
        }
      }
    }
  }
  return Shape { leader: move leader, depth: move depth, start: move start }
}

effect fn mark(leader: &mut List<bool>, depth: &mut List<i32>, work: &mut List<usize>, workDepth: &mut List<i32>,
  pc: usize, d: i32, from: usize, opcode: u8) -> () ! Refusal | OutOfMemoryError ? &mut Allocator {
  leader.set(pc, true)
  let known = depth.get(pc)
  if known >= 0 {
    if known != d { fail refuse(usize.toU32(from), opcode, b"operand stack depths disagree at a join") }
    return ()
  }
  depth.set(pc, d)
  run work.append(pc) run workDepth.append(d)
}

/// The interpreter state the translator tracks: one SSA value per local and operand.
struct State { locals: List<u32>, stack: List<u32> }

effect fn copyList(from: &List<u32>) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u32>.make()
  run out.appendSlice(from.asSlice())
  return move out
}

struct Translator {
  f: Function,
  /// SSA block of each leader pc, or NONE.
  blockAt: List<u32>,
  /// The block being filled.
  current: u32,
  locals: List<u32>,
  stack: List<u32>,
  /// FunctionInput.doubleSites, copied.
  doubleSites: List<u32>,
  // ---- inlining (docs/jit/inlining.md): the state of the inlined body being translated.
  /// How many inlined bodies deep the translator is; 0 in the function's own code.
  depth: u32,
  /// The outermost inlined call: its pc, the function's locals and operands before it (the
  /// state every exit inside leaves to) and the first instruction of the attempt.
  rootPc: u32,
  rootLocals: List<u32>,
  rootStack: List<u32>,
  rootInst: usize,
  /// The locals and operands of the inlined bodies around the current one.
  held: List<u32>,
  /// The current body's arguments (the caller's operands), receiver and parameter count.
  args: List<u32>,
  receiver: u32,
  formals: u32,
  /// A guard came after an effect: the attempt fails.
  broken: bool,
  /// On-stack replacement: argument n's number, guarded once at entry, or NONE (or empty).
  argNumbers: List<u32>,
}

impl Translator {
  fn isOwned(self: &Self, v: u32) -> bool { let info = self.f.value(v) return info.ty == Type.Value && info.own == Own.Owned }

  effect fn release(self: &mut Self, v: u32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.isOwned(v) { drop run self.f.emit(self.current, Op.Release, false, Type.I32, Own.Unboxed, v, NONE, 0, pc) }
  }
  /// A second owner of `v` for a new slot: a retain when `v` holds a count.
  effect fn share(self: &mut Self, v: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    if self.isOwned(v) { return run self.f.emit(self.current, Op.Retain, true, Type.Value, Own.Owned, v, NONE, 0, pc) }
    return v
  }
  effect fn push(self: &mut Self, v: u32) -> () ! OutOfMemoryError ? &mut Allocator { run self.stack.append(v) }
  fn pop(self: &mut Self) -> u32 { return self.stack.pop().unwrapOr(NONE) }
  fn top(self: &Self, depth: usize) -> u32 { return self.stack.get(self.stack.length() - depth) }

  /// The parameters of the code being translated: the function's, or an inlined body's.
  fn argumentLimit(self: &Self) -> usize { if self.depth != 0 { return u32.toUsize(self.formals) } return u32.toUsize(self.f.argumentCount) }

  /// The exit of a guard inside an inlined body: the function's state before the outermost
  /// inlined call, where the interpreter makes that call itself. Sound only while the bodies
  /// have had no effect; what they own is dropped (Exit.drops).
  effect fn inlineExit(self: &mut Self, inst: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut before = self.rootInst
    while before < u32.toUsize(inst) { if !withoutEffect(self.f.insts.get(before).op) { self.broken = true } before = before + 1 }
    drop run self.f.exitFor(inst, self.rootPc, usize.toU32(self.rootStack.length()))
    let mut i: usize = 0
    while i < self.rootLocals.length() { let v = self.rootLocals.get(i) run self.slot(v) i = i + 1 }
    i = 0
    while i < self.rootStack.length() { let v = self.rootStack.get(i) run self.slot(v) i = i + 1 }
    i = 0
    while i < self.held.length() { let v = self.held.get(i) if self.isOwned(v) { run self.f.dropAt(v, SlotMode.Move) } i = i + 1 }
    i = 0
    while i < self.locals.length() { let v = self.locals.get(i) if self.isOwned(v) { run self.f.dropAt(v, SlotMode.Move) } i = i + 1 }
    i = 0
    while i < self.stack.length() { let v = self.stack.get(i) if self.isOwned(v) { run self.f.dropAt(v, SlotMode.Move) } i = i + 1 }
  }

  /// Gives instruction `inst` an exit at `pc` with the current state.
  effect fn exitHere(self: &mut Self, inst: u32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.depth != 0 { run self.inlineExit(inst) return () }
    drop run self.f.exitFor(inst, pc, usize.toU32(self.stack.length()))
    let mut i: usize = 0
    while i < self.locals.length() { let v = self.locals.get(i) run self.slot(v) i = i + 1 }
    i = 0
    while i < self.stack.length() { let v = self.stack.get(i) run self.slot(v) i = i + 1 }
  }
  effect fn slot(self: &mut Self, v: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let info = self.f.value(v)
    if info.ty == Type.I32 { run self.f.slotAt(v, SlotMode.Int, NONE) }
    else if info.ty == Type.Bool { run self.f.slotAt(v, SlotMode.Bool, NONE) }
    else if info.ty == Type.F64 { run self.f.slotAt(v, SlotMode.F64, NONE) }
    else if info.own == Own.Owned { run self.f.slotAt(v, SlotMode.Move, NONE) }
    else if info.own == Own.Imm { run self.f.slotAt(v, SlotMode.Imm, NONE) }
    else {
      let mut root = NONE
      if info.rootKind == RootKind.Argument { root = info.root }
      run self.f.slotAt(v, SlotMode.Dup, root)
    }
  }

  /// `v` as an i32: itself, or unboxed with a guard that exits at `pc`.
  effect fn int(self: &mut Self, v: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let ty = self.f.value(v).ty
    if ty == Type.I32 { return v }
    if ty == Type.Bool { return NONE }
    if ty == Type.F64 {
      let exact = run self.f.emit(self.current, Op.ExactI32, true, Type.I32, Own.Unboxed, v, NONE, 0, pc)
      let at = self.f.lastInst() run self.exitHere(at, pc)
      return exact
    }
    let r = run self.f.emit(self.current, Op.Unbox, true, Type.I32, Own.Unboxed, v, NONE, 0, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
    return r
  }
  /// A guarded `add`, `sub` or `mul` of two i32 values.
  effect fn arith(self: &mut Self, operation: Op, x: u32, y: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let r = run self.f.emit(self.current, operation, true, Type.I32, Own.Unboxed, x, y, 0, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
    return r
  }
  effect fn constant(self: &mut Self, k: i32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    return run self.f.emit(self.current, Op.ConstI32, true, Type.I32, Own.Unboxed, NONE, NONE, k, pc)
  }
  effect fn imm(self: &mut Self, k: Imm, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    return run self.f.emit(self.current, Op.Imm, true, Type.Value, Own.Imm, NONE, NONE, u8.toI32(Imm.value(k)), pc)
  }
  /// Argument `n`'s bits, borrowed from its cell.
  effect fn argument(self: &mut Self, n: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    // In an inlined body: the caller's operand as it is (possibly unboxed), or undefined.
    if self.depth != 0 {
      if u32.toUsize(n) < self.args.length() { return self.args.get(u32.toUsize(n)) }
      return run self.imm(Imm.Undefined, pc)
    }
    if u32.toUsize(n) < self.argNumbers.length() && self.argNumbers.get(u32.toUsize(n)) != NONE { return self.argNumbers.get(u32.toUsize(n)) }
    let v = run self.f.emit(self.current, Op.Arg, true, Type.Value, Own.Borrowed, NONE, NONE, u32.wrappingToI32(n), pc)
    self.f.setOwnership(v, Own.Borrowed, RootKind.Argument, n)
    return v
  }
  /// `v` boxed, for a block parameter or a return.
  effect fn boxed(self: &mut Self, v: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let ty = self.f.value(v).ty
    if ty == Type.I32 { return run self.f.emit(self.current, Op.BoxI32, true, Type.Value, Own.Imm, v, NONE, 0, pc) }
    if ty == Type.Bool { return run self.f.emit(self.current, Op.BoxBool, true, Type.Value, Own.Imm, v, NONE, 0, pc) }
    if ty == Type.F64 { return run self.f.emit(self.current, Op.BoxF64, true, Type.Value, Own.Imm, v, NONE, 0, pc) }
    return v
  }

  /// An edge from the current block to `target` carrying the whole state.
  effect fn edgeTo(self: &mut Self, target: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    // Boxes first: they are instructions of the current block.
    let mut args = List<u32>.make()
    let mut i: usize = 0
    while i < self.locals.length() { let v = self.locals.get(i) let b = run self.boxed(v, pc) run args.append(b) i = i + 1 }
    i = 0
    while i < self.stack.length() { let v = self.stack.get(i) let b = run self.boxed(v, pc) run args.append(b) i = i + 1 }
    let edge = run self.f.newEdge(target)
    i = 0
    while i < args.length() { run self.f.edgeArgument(args.get(i)) i = i + 1 }
    return edge
  }

  /// The block a jump from the instruction at `pc` to `targetPc` goes to: the target's block,
  /// or for a back edge a new latch block that polls and then jumps there.
  effect fn destination(self: &mut Self, targetPc: usize, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let target = self.blockAt.get(targetPc)
    if usize.toU32(targetPc) > pc { return target }
    let latch = run self.f.block()
    let saved = self.current
    let savedLocals = run copyList(&self.locals)
    let savedStack = run copyList(&self.stack)
    // The latch's parameters mirror the state; its poll exits at the loop target.
    self.current = latch
    let mut i: usize = 0
    while i < self.locals.length() { let p = run self.f.addParam(latch, Type.Value, Own.Owned) self.locals.set(i, p) i = i + 1 }
    i = 0
    while i < self.stack.length() { let p = run self.f.addParam(latch, Type.Value, Own.Owned) self.stack.set(i, p) i = i + 1 }
    drop run self.f.emit(latch, Op.Poll, false, Type.I32, Own.Unboxed, NONE, NONE, 0, pc)
    let last = self.f.lastInst() run self.exitHere(last, usize.toU32(targetPc))
    let edge = run self.edgeTo(target, pc)
    run self.f.terminate(latch, Op.Jump, NONE, edge, pc)
    self.current = saved
    self.locals = move savedLocals
    self.stack = move savedStack
    return latch
  }

  /// Ends the current block with a jump to the block of `targetPc`.
  effect fn jumpTo(self: &mut Self, targetPc: usize, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let dest = run self.destination(targetPc, pc)
    let edge = run self.edgeTo(dest, pc)
    run self.f.terminate(self.current, Op.Jump, NONE, edge, pc)
  }

  /// Starts filling the block of leader `pc`: its parameters are the state.
  effect fn enter(self: &mut Self, pc: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    let block = self.blockAt.get(pc)
    self.current = block
    let params = run self.f.paramsOf(block)
    let local = u32.toUsize(self.f.localCount)
    self.locals.clear() self.stack.clear()
    let mut i: usize = 0
    while i < params.length() {
      if i < local { run self.locals.append(params.get(i)) } else { run self.stack.append(params.get(i)) }
      i = i + 1
    }
  }

  /// Releases every local and operand, for a return.
  effect fn releaseAll(self: &mut Self, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut i: usize = 0
    while i < self.locals.length() { let v = self.locals.get(i) run self.release(v, pc) i = i + 1 }
    i = 0
    while i < self.stack.length() { let v = self.stack.get(i) run self.release(v, pc) i = i + 1 }
  }

  /// Writes `v` to local `index`, releasing what it held.
  effect fn store(self: &mut Self, index: usize, v: u32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let old = self.locals.get(index)
    self.locals.set(index, v)
    run self.release(old, pc)
  }

  /// `add`/`sub`/`mul` or a comparison of the two top operands.
  effect fn binary(self: &mut Self, opcode: u8, pc: u32) -> () ! Refusal | OutOfMemoryError ? &mut Allocator {
    let a = self.top(2) let b = self.top(1)
    if self.numberSite(pc, a, b) { run self.numberBinary(opcode, pc) return () }
    let x = run self.int(a, pc) let y = run self.int(b, pc)
    if x == NONE || y == NONE { fail refuse(pc, opcode, b"a boolean operand of arithmetic") }
    let mut r = NONE
    if opcode == op.OP_add { r = run self.arith(Op.Add, x, y, pc) }
    else if opcode == op.OP_sub { r = run self.arith(Op.Sub, x, y, pc) }
    else if opcode == op.OP_mul { r = run self.arith(Op.Mul, x, y, pc) }
    else {
      let mut kind = Cmp.Lt
      if opcode == op.OP_lte { kind = Cmp.Le }
      else if opcode == op.OP_gt { kind = Cmp.Gt }
      else if opcode == op.OP_gte { kind = Cmp.Ge }
      else if opcode == op.OP_eq || opcode == op.OP_strict_eq { kind = Cmp.Eq }
      else if opcode == op.OP_neq || opcode == op.OP_strict_neq { kind = Cmp.Ne }
      r = run self.f.emit(self.current, Op.Cmp, true, Type.Bool, Own.Unboxed, x, y, u8.toI32(Cmp.value(kind)), pc)
    }
    drop self.pop() drop self.pop()
    run self.release(a, pc) run self.release(b, pc)
    run self.push(r)
  }

  /// The truth of `v` for a branch: a bool as it is, an i32 compared with 0, a boxed value
  /// guarded to be a Bool.
  effect fn condition(self: &mut Self, v: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let ty = self.f.value(v).ty
    if ty == Type.Bool { return v }
    if ty == Type.I32 {
      let zero = run self.constant(0, pc)
      return run self.f.emit(self.current, Op.Cmp, true, Type.Bool, Own.Unboxed, v, zero, u8.toI32(Cmp.value(Cmp.Ne)), pc)
    }
    if ty == Type.F64 {
      // A double is false at 0, -0 and NaN: |x| > 0 (x != 0 would be true at NaN).
      let zero = run self.doubleConstant(0.0, pc)
      let magnitude = run self.f.emit(self.current, Op.AbsF64, true, Type.F64, Own.Unboxed, v, NONE, 0, pc)
      return run self.f.emit(self.current, Op.CmpF64, true, Type.Bool, Own.Unboxed, magnitude, zero, u8.toI32(Cmp.value(Cmp.Gt)), pc)
    }
    // A site that deoptimized here before saw something other than a boolean: ToBoolean.
    if self.widened(pc) { return run self.f.emit(self.current, Op.Truthy, true, Type.Bool, Own.Unboxed, v, NONE, 0, pc) }
    let c = run self.f.emit(self.current, Op.UnboxBool, true, Type.Bool, Own.Unboxed, v, NONE, 0, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
    return c
  }
  /// The condition a branch tests: undefined/null for the nullish branches, else ToBoolean.
  effect fn branchTest(self: &mut Self, opcode: u8, v: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let mask = nullMask(opcode)
    if mask != 0 { return run self.nullTest(v, mask, pc) }
    return run self.condition(v, pc)
  }
  /// Whether v is undefined (mask bit 0) or null (bit 1): false for an unboxed number or bool.
  effect fn nullTest(self: &mut Self, v: u32, mask: i32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    if self.f.value(v).ty != Type.Value { return run self.constBool(false, pc) }
    return run self.f.emit(self.current, Op.TagIs, true, Type.Bool, Own.Unboxed, v, NONE, mask, pc)
  }
  effect fn constBool(self: &mut Self, value: bool, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let zero = run self.constant(0, pc)
    let mut k: i32 = 0
    if value { k = 1 }
    let x = run self.constant(k, pc)
    return run self.f.emit(self.current, Op.Cmp, true, Type.Bool, Own.Unboxed, x, zero, u8.toI32(Cmp.value(Cmp.Ne)), pc)
  }
  /// Whether the instruction at pc deoptimized in an earlier compilation.
  fn widened(self: &Self, pc: u32) -> bool {
    let mut i: usize = 0
    while i < self.doubleSites.length() { if self.doubleSites.get(i) == pc { return true } i = i + 1 }
    return false
  }

  // ---- numbers and the remaining operators (docs/jit/doubles.md) ----

  /// Whether the arithmetic or comparison at `pc` on `a` and `b` runs on doubles: an operand is
  /// one already, or the site deoptimized as int32 in an earlier compilation.
  fn numberSite(self: &Self, pc: u32, a: u32, b: u32) -> bool {
    if self.f.value(a).ty == Type.F64 || self.f.value(b).ty == Type.F64 { return true }
    let mut i: usize = 0
    while i < self.doubleSites.length() { if self.doubleSites.get(i) == pc { return true } i = i + 1 }
    return false
  }
  /// `v` as a double: itself, converted from an i32, or unboxed with a number guard at `pc`.
  /// NONE for a bool (refused by the caller).
  effect fn number(self: &mut Self, v: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let ty = self.f.value(v).ty
    if ty == Type.F64 { return v }
    if ty == Type.I32 { return run self.f.emit(self.current, Op.ToF64, true, Type.F64, Own.Unboxed, v, NONE, 0, pc) }
    if ty == Type.Bool { return NONE }
    let r = run self.f.emit(self.current, Op.UnboxF64, true, Type.F64, Own.Unboxed, v, NONE, 0, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
    return r
  }
  /// `v` as ToInt32 would make it, for a bitwise operator: an i32 as it is, a double truncated
  /// (guarded), a boxed value guarded as an Int (as a number on a double site). NONE for a bool.
  effect fn int32(self: &mut Self, v: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let ty = self.f.value(v).ty
    if ty == Type.I32 { return v }
    if ty == Type.Bool { return NONE }
    let mut x = v
    if ty == Type.Value {
      if !self.numberSite(pc, v, v) { return run self.int(v, pc) }
      x = run self.number(v, pc)
    }
    let r = run self.f.emit(self.current, Op.ToInt32, true, Type.I32, Own.Unboxed, x, NONE, 0, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
    return r
  }
  effect fn doubleConstant(self: &mut Self, value: f64, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let bits = f64.toBits(value)
    let mut index: usize = 0
    while index < self.f.numbers.length() && self.f.numbers.get(index) != bits { index = index + 1 }
    if index == self.f.numbers.length() { run self.f.numbers.append(bits) }
    return run self.f.emit(self.current, Op.ConstF64, true, Type.F64, Own.Unboxed, NONE, NONE, usize.toI32(index), pc)
  }
  /// `add`/`sub`/`mul`/`div` or a comparison of the two top operands, on doubles.
  effect fn numberBinary(self: &mut Self, opcode: u8, pc: u32) -> () ! Refusal | OutOfMemoryError ? &mut Allocator {
    let a = self.top(2) let b = self.top(1)
    let x = run self.number(a, pc) let y = run self.number(b, pc)
    if x == NONE || y == NONE { fail refuse(pc, opcode, b"a boolean operand of arithmetic") }
    let mut r = NONE
    if opcode == op.OP_add { r = run self.f.emit(self.current, Op.AddF64, true, Type.F64, Own.Unboxed, x, y, 0, pc) }
    else if opcode == op.OP_sub { r = run self.f.emit(self.current, Op.SubF64, true, Type.F64, Own.Unboxed, x, y, 0, pc) }
    else if opcode == op.OP_mul { r = run self.f.emit(self.current, Op.MulF64, true, Type.F64, Own.Unboxed, x, y, 0, pc) }
    else if opcode == op.OP_div { r = run self.f.emit(self.current, Op.DivF64, true, Type.F64, Own.Unboxed, x, y, 0, pc) }
    else {
      let mut kind = Cmp.Lt
      if opcode == op.OP_lte { kind = Cmp.Le }
      else if opcode == op.OP_gt { kind = Cmp.Gt }
      else if opcode == op.OP_gte { kind = Cmp.Ge }
      else if opcode == op.OP_eq || opcode == op.OP_strict_eq { kind = Cmp.Eq }
      else if opcode == op.OP_neq || opcode == op.OP_strict_neq { kind = Cmp.Ne }
      r = run self.f.emit(self.current, Op.CmpF64, true, Type.Bool, Own.Unboxed, x, y, u8.toI32(Cmp.value(kind)), pc)
    }
    drop self.pop() drop self.pop()
    run self.release(a, pc) run self.release(b, pc)
    run self.push(r)
  }
  /// A guarded or plain int32 operation of `x` and `y` (both i32).
  effect fn intOperation(self: &mut Self, operation: Op, x: u32, y: u32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let r = run self.f.emit(self.current, operation, true, Type.I32, Own.Unboxed, x, y, 0, pc)
    if ssa.numberOpHasExit(operation) { let last = self.f.lastInst() run self.exitHere(last, pc) }
    return r
  }
  /// The opcodes of `numberOpcode`.
  effect fn numberInstruction(self: &mut Self, input: &FunctionInput, pc: usize) -> bool ! Refusal | OutOfMemoryError ? &mut Allocator {
    let opcode = byteAt(input, pc)
    let at = usize.toU32(pc)
    if opcode == op.OP_push_const || opcode == op.OP_push_const8 {
      let mut index: usize = 0
      if opcode == op.OP_push_const8 { index = u8.toUsize(byteAt(input, pc + 1)) } else { index = u32.toUsize(i32.wrappingToU32(i32At(input, pc + 1))) }
      if index >= input.numberConstants.length() { fail refuse(at, opcode, b"a constant index out of range") }
      let constant = input.numberConstants.get(index)
      if constant.kind == CONSTANT_INT { let c = run self.constant(u32.wrappingToI32(u64.wrappingToU32(constant.bits)), at) run self.push(c) return true }
      if constant.kind == CONSTANT_DOUBLE { let c = run self.doubleConstant(f64.fromBits(constant.bits), at) run self.push(c) return true }
      fail refuse(at, opcode, b"a constant that is not a number")
    }
    if opcode == op.OP_div { run self.numberBinary(opcode, at) return true }
    if opcode == op.OP_strict_eq_imm8 || opcode == op.OP_strict_neq_imm8 {
      let a = self.top(1)
      let k = i8At(input, pc + 1)
      let mut kind = Cmp.Eq
      if opcode == op.OP_strict_neq_imm8 { kind = Cmp.Ne }
      let mut r = NONE
      if self.numberSite(at, a, a) {
        let x = run self.number(a, at)
        if x == NONE { fail refuse(at, opcode, b"a boolean compared with a number") }
        let c = run self.doubleConstant(i32.toF64(k), at)
        r = run self.f.emit(self.current, Op.CmpF64, true, Type.Bool, Own.Unboxed, x, c, u8.toI32(Cmp.value(kind)), at)
      } else {
        // A bool is never strictly equal to a number; anything else is speculated an Int.
        if self.f.value(a).ty == Type.Bool { fail refuse(at, opcode, b"a boolean compared with a number") }
        let x = run self.int(a, at)
        let c = run self.constant(k, at)
        r = run self.f.emit(self.current, Op.Cmp, true, Type.Bool, Own.Unboxed, x, c, u8.toI32(Cmp.value(kind)), at)
      }
      drop self.pop() run self.release(a, at) run self.push(r)
      return true
    }
    if opcode == op.OP_lnot {
      let a = self.top(1)
      let c = run self.condition(a, at)
      let r = run self.f.emit(self.current, Op.NotBool, true, Type.Bool, Own.Unboxed, c, NONE, 0, at)
      drop self.pop() run self.release(a, at) run self.push(r)
      return true
    }
    if opcode == op.OP_neg || opcode == op.OP_plus || opcode == op.OP_post_inc || opcode == op.OP_post_dec {
      let a = self.top(1)
      if self.numberSite(at, a, a) {
        let x = run self.number(a, at)
        if x == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
        drop self.pop() run self.release(a, at)
        if opcode == op.OP_neg { let r = run self.f.emit(self.current, Op.NegF64, true, Type.F64, Own.Unboxed, x, NONE, 0, at) run self.push(r) }
        else if opcode == op.OP_plus { run self.push(x) }
        else {
          let mut k: f64 = 1.0
          if opcode == op.OP_post_dec { k = -1.0 }
          let c = run self.doubleConstant(k, at)
          let r = run self.f.emit(self.current, Op.AddF64, true, Type.F64, Own.Unboxed, x, c, 0, at)
          run self.push(x) run self.push(r)
        }
        return true
      }
      let x = run self.int(a, at)
      if x == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
      if opcode == op.OP_neg {
        let r = run self.f.emit(self.current, Op.Neg, true, Type.I32, Own.Unboxed, x, NONE, 0, at)
        let last = self.f.lastInst() run self.exitHere(last, at)
        drop self.pop() run self.release(a, at) run self.push(r)
      } else if opcode == op.OP_plus {
        drop self.pop() run self.release(a, at) run self.push(x)
      } else {
        let one = run self.constant(1, at)
        let mut operation = Op.Add
        if opcode == op.OP_post_dec { operation = Op.Sub }
        let r = run self.arith(operation, x, one, at)
        drop self.pop() run self.release(a, at) run self.push(x) run self.push(r)
      }
      return true
    }
    if opcode == op.OP_not {
      let a = self.top(1)
      let x = run self.int32(a, at)
      if x == NONE { fail refuse(at, opcode, b"a boolean operand of a bitwise operator") }
      let r = run self.f.emit(self.current, Op.BitNot, true, Type.I32, Own.Unboxed, x, NONE, 0, at)
      drop self.pop() run self.release(a, at) run self.push(r)
      return true
    }
    if opcode == op.OP_shl_imm || opcode == op.OP_sar_imm || opcode == op.OP_and_imm || opcode == op.OP_or_imm {
      let a = self.top(1)
      let x = run self.int32(a, at)
      if x == NONE { fail refuse(at, opcode, b"a boolean operand of a bitwise operator") }
      let k = run self.constant(i16At(input, pc + 1), at)
      let mut operation = Op.Shl
      if opcode == op.OP_sar_imm { operation = Op.Sar }
      else if opcode == op.OP_and_imm { operation = Op.BitAnd }
      else if opcode == op.OP_or_imm { operation = Op.BitOr }
      let r = run self.intOperation(operation, x, k, at)
      drop self.pop() run self.release(a, at) run self.push(r)
      return true
    }
    // The two-operand bitwise operators and %.
    let a = self.top(2) let b = self.top(1)
    if opcode == op.OP_mod {
      if self.numberSite(at, a, b) { fail refuse(at, opcode, b"% of doubles (fmod)") }
      let x = run self.int(a, at) let y = run self.int(b, at)
      if x == NONE || y == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
      let r = run self.intOperation(Op.Mod, x, y, at)
      drop self.pop() drop self.pop() run self.release(a, at) run self.release(b, at) run self.push(r)
      return true
    }
    let x = run self.int32(a, at) let y = run self.int32(b, at)
    if x == NONE || y == NONE { fail refuse(at, opcode, b"a boolean operand of a bitwise operator") }
    let mut operation = Op.BitAnd
    if opcode == op.OP_or { operation = Op.BitOr }
    else if opcode == op.OP_xor { operation = Op.BitXor }
    else if opcode == op.OP_shl { operation = Op.Shl }
    else if opcode == op.OP_sar { operation = Op.Sar }
    else if opcode == op.OP_shr { operation = Op.Shr }
    let r = run self.intOperation(operation, x, y, at)
    drop self.pop() drop self.pop() run self.release(a, at) run self.release(b, at) run self.push(r)
    return true
  }

  /// Translates the instruction at `pc` (not a terminator of control flow unless it is one).
  /// Returns false when it ended the block.
  effect fn instruction(self: &mut Self, input: &FunctionInput, pc: usize) -> bool ! Refusal | OutOfMemoryError ? &mut Allocator {
    let opcode = byteAt(input, pc)
    let at = usize.toU32(pc)
    let size = sizeAt(input, pc)
    if opcode == op.OP_fuse_prefix { return true }
    if opcode == op.OP_push_i32 { let c = run self.constant(i32At(input, pc + 1), at) run self.push(c) return true }
    if opcode == op.OP_push_i8 { let c = run self.constant(i8At(input, pc + 1), at) run self.push(c) return true }
    if opcode == op.OP_push_i16 { let c = run self.constant(i16At(input, pc + 1), at) run self.push(c) return true }
    if opcode == op.OP_push_0 { let c = run self.constant(0, at) run self.push(c) return true }
    if opcode == op.OP_push_1 { let c = run self.constant(1, at) run self.push(c) return true }
    if opcode == op.OP_undefined { let c = run self.imm(Imm.Undefined, at) run self.push(c) return true }
    if opcode == op.OP_null { let c = run self.imm(Imm.Null, at) run self.push(c) return true }
    if opcode == op.OP_push_true { let c = run self.imm(Imm.True, at) run self.push(c) return true }
    if opcode == op.OP_push_false { let c = run self.imm(Imm.False, at) run self.push(c) return true }
    if opcode == op.OP_drop { let v = self.pop() run self.release(v, at) return true }
    if opcode == op.OP_dup { let t = self.top(1) let v = run self.share(t, at) run self.push(v) return true }
    if opcode == op.OP_nip { let b = self.pop() let a = self.pop() run self.push(b) run self.release(a, at) return true }
    if opcode == op.OP_swap { let b = self.pop() let a = self.pop() run self.push(b) run self.push(a) return true }
    let shuffle = shuffleOf(opcode)
    if shuffle.length != 0 {
      let n = u8.toUsize(shuffle[0] - 48)
      let mut window = List<u32>.make()
      let mut used = List<bool>.make()
      let mut i: usize = 0
      while i < n { run window.append(self.top(n - i)) run used.append(false) i = i + 1 }
      i = 0
      while i < n { drop self.pop() i = i + 1 }
      i = 1
      while i < shuffle.length {
        let from = u8.toUsize(shuffle[i] - 48)
        let v = window.get(from)
        if used.get(from) { let copy = run self.share(v, at) run self.push(copy) } else { used.set(from, true) run self.push(v) }
        i = i + 1
      }
      i = 0
      while i < n { if !used.get(i) { run self.release(window.get(i), at) } i = i + 1 }
      return true
    }

    // Locals and arguments.
    let mut index: usize = usize.MAX
    if opcode == op.OP_get_loc || opcode == op.OP_put_loc || opcode == op.OP_set_loc || opcode == op.OP_get_arg
      || opcode == op.OP_get_loc_check || opcode == op.OP_put_loc_check || opcode == op.OP_put_loc_check_init
      || opcode == op.OP_set_loc_uninitialized { index = u16.toUsize(u16At(input, pc + 1)) }
    else if opcode == op.OP_get_loc8 || opcode == op.OP_put_loc8 || opcode == op.OP_set_loc8 || opcode == op.OP_inc_loc
      || opcode == op.OP_dec_loc || opcode == op.OP_add_loc || opcode == op.OP_step_loc8 { index = u8.toUsize(byteAt(input, pc + 1)) }
    else if opcode >= op.OP_get_loc0 && opcode <= op.OP_get_loc3 { index = u8.toUsize(opcode - op.OP_get_loc0) }
    else if opcode >= op.OP_put_loc0 && opcode <= op.OP_put_loc3 { index = u8.toUsize(opcode - op.OP_put_loc0) }
    else if opcode >= op.OP_get_arg0 && opcode <= op.OP_get_arg3 { index = u8.toUsize(opcode - op.OP_get_arg0) }
    let isArgument = opcode == op.OP_get_arg || (opcode >= op.OP_get_arg0 && opcode <= op.OP_get_arg3)
    if index != usize.MAX {
      if isArgument { if index >= self.argumentLimit() { fail refuse(at, opcode, b"argument index out of range") } }
      else if index >= self.locals.length() { fail refuse(at, opcode, b"local index out of range") }
    }
    if isArgument {
      let a = run self.argument(usize.toU32(index), at)
      if self.depth != 0 { let shared = run self.share(a, at) run self.push(shared) return true }
      let r = run self.f.emit(self.current, Op.Retain, true, Type.Value, Own.Owned, a, NONE, 0, at)
      run self.push(r) return true
    }
    if opcode == op.OP_get_loc || opcode == op.OP_get_loc8 || (opcode >= op.OP_get_loc0 && opcode <= op.OP_get_loc3) {
      let l = self.locals.get(index) let v = run self.share(l, at) run self.push(v) return true
    }
    if opcode == op.OP_put_loc || opcode == op.OP_put_loc8 || (opcode >= op.OP_put_loc0 && opcode <= op.OP_put_loc3) {
      let v = self.pop() run self.store(index, v, at) return true
    }
    if opcode == op.OP_set_loc || opcode == op.OP_set_loc8 {
      let t = self.top(1) let v = run self.share(t, at) run self.store(index, v, at) return true
    }
    if opcode == op.OP_set_loc_uninitialized { let u = run self.imm(Imm.Uninitialized, at) run self.store(index, u, at) return true }
    if opcode == op.OP_get_loc_check || opcode == op.OP_put_loc_check || opcode == op.OP_put_loc_check_init {
      // Only when the slot's state is known here: an Uninitialized constant, or a value that
      // is not one (an i32 or bool, or an instruction other than that constant).
      let current = self.locals.get(index)
      let info = self.f.value(current)
      let mut uninitialized = false
      let mut known = info.ty != Type.Value
      if !known && info.def != NONE {
        let def = self.f.inst(info.def)
        known = true
        uninitialized = def.op == Op.Imm && def.k == u8.toI32(Imm.value(Imm.Uninitialized))
      }
      if !known { fail refuse(at, opcode, b"cannot prove whether a lexical slot is initialized") }
      if opcode == op.OP_put_loc_check_init {
        if !uninitialized { fail refuse(at, opcode, b"initializing a slot that may be initialized") }
        let v = self.pop() run self.store(index, v, at) return true
      }
      if uninitialized { fail refuse(at, opcode, b"reads or writes a lexical slot before its initialization (throws)") }
      if opcode == op.OP_get_loc_check { let v = run self.share(current, at) run self.push(v) return true }
      let v = self.pop() run self.store(index, v, at) return true
    }

    // Arithmetic and comparisons.
    if opcode == op.OP_add || opcode == op.OP_sub || opcode == op.OP_mul || opcode == op.OP_lt || opcode == op.OP_lte
      || opcode == op.OP_gt || opcode == op.OP_gte || opcode == op.OP_eq || opcode == op.OP_neq
      || opcode == op.OP_strict_eq || opcode == op.OP_strict_neq {
      run self.binary(opcode, at) return true
    }
    if opcode == op.OP_add_imm || opcode == op.OP_inc || opcode == op.OP_dec {
      let a = self.top(1)
      if self.numberSite(at, a, a) {
        let mut k: i32 = 1
        if opcode == op.OP_add_imm { k = i16At(input, pc + 1) }
        if opcode == op.OP_dec { k = -1 }
        let x = run self.number(a, at)
        if x == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
        let c = run self.doubleConstant(i32.toF64(k), at)
        let r = run self.f.emit(self.current, Op.AddF64, true, Type.F64, Own.Unboxed, x, c, 0, at)
        drop self.pop() run self.release(a, at) run self.push(r)
        return true
      }
      let x = run self.int(a, at)
      if x == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
      let mut k: i32 = 1
      if opcode == op.OP_add_imm { k = i16At(input, pc + 1) }
      let c = run self.constant(k, at)
      let mut operation = Op.Add
      if opcode == op.OP_dec { operation = Op.Sub }
      let r = run self.arith(operation, x, c, at)
      drop self.pop() run self.release(a, at) run self.push(r)
      return true
    }
    if opcode == op.OP_inc_loc || opcode == op.OP_dec_loc || opcode == op.OP_step_loc8 {
      let v = self.locals.get(index)
      if self.numberSite(at, v, v) {
        let mut k: f64 = 1.0
        let mut mode: u8 = 1
        if opcode == op.OP_step_loc8 { mode = byteAt(input, pc + 2) if (mode & 2) != 0 { k = -1.0 } }
        else if opcode == op.OP_dec_loc { k = -1.0 }
        let x = run self.number(v, at)
        if x == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
        let c = run self.doubleConstant(k, at)
        let r = run self.f.emit(self.current, Op.AddF64, true, Type.F64, Own.Unboxed, x, c, 0, at)
        run self.store(index, r, at)
        if opcode == op.OP_step_loc8 { if (mode & 1) != 0 { run self.push(r) } else { run self.push(x) } }
        return true
      }
      let x = run self.int(v, at)
      if x == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
      let one = run self.constant(1, at)
      let mut operation = Op.Add
      let mut mode: u8 = 0
      if opcode == op.OP_step_loc8 { mode = byteAt(input, pc + 2) if (mode & 2) != 0 { operation = Op.Sub } }
      else if opcode == op.OP_dec_loc { operation = Op.Sub }
      let r = run self.arith(operation, x, one, at)
      run self.store(index, r, at)
      // step_loc8 pushes the old value (mode bit 0 clear) or the new one.
      if opcode == op.OP_step_loc8 { if (mode & 1) != 0 { run self.push(r) } else { run self.push(x) } }
      return true
    }
    if opcode == op.OP_add_loc {
      let b = self.top(1) let v = self.locals.get(index)
      if self.numberSite(at, v, b) {
        let x = run self.number(v, at) let y = run self.number(b, at)
        if x == NONE || y == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
        let r = run self.f.emit(self.current, Op.AddF64, true, Type.F64, Own.Unboxed, x, y, 0, at)
        drop self.pop() run self.release(b, at)
        run self.store(index, r, at)
        return true
      }
      let x = run self.int(v, at) let y = run self.int(b, at)
      if x == NONE || y == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
      let r = run self.arith(Op.Add, x, y, at)
      drop self.pop() run self.release(b, at)
      run self.store(index, r, at)
      return true
    }
    if (opcode >= op.OP_add_loc_loc8 && opcode <= op.OP_mul_top_loc8) || (opcode >= op.OP_add_top_arg8 && opcode <= op.OP_mul_top_arg8) {
      let mut operation = Op.Add
      if opcode == op.OP_sub_loc_loc8 || opcode == op.OP_sub_top_loc8 || opcode == op.OP_sub_top_arg8 { operation = Op.Sub }
      if opcode == op.OP_mul_loc_loc8 || opcode == op.OP_mul_top_loc8 || opcode == op.OP_mul_top_arg8 { operation = Op.Mul }
      let twoLocals = opcode <= op.OP_mul_loc_loc8
      let mut left = NONE
      let first = u8.toUsize(byteAt(input, pc + 1))
      let mut rightIndex = first
      if twoLocals {
        rightIndex = u8.toUsize(byteAt(input, pc + 2))
        if first >= self.locals.length() { fail refuse(at, opcode, b"local index out of range") }
        left = self.locals.get(first)
      } else { left = self.top(1) }
      let mut right = NONE
      if opcode >= op.OP_add_top_arg8 {
        if rightIndex >= self.argumentLimit() { fail refuse(at, opcode, b"argument index out of range") }
        right = run self.argument(usize.toU32(rightIndex), at)
      } else {
        if rightIndex >= self.locals.length() { fail refuse(at, opcode, b"local index out of range") }
        right = self.locals.get(rightIndex)
      }
      if self.numberSite(at, left, right) {
        let x = run self.number(left, at) let y = run self.number(right, at)
        if x == NONE || y == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
        let r = run self.f.emit(self.current, doubleOf(operation), true, Type.F64, Own.Unboxed, x, y, 0, at)
        if !twoLocals { drop self.pop() run self.release(left, at) }
        run self.push(r)
        return true
      }
      let x = run self.int(left, at) let y = run self.int(right, at)
      if x == NONE || y == NONE { fail refuse(at, opcode, b"a boolean operand of arithmetic") }
      let r = run self.arith(operation, x, y, at)
      if !twoLocals { drop self.pop() run self.release(left, at) }
      run self.push(r)
      return true
    }

    // Control.
    if keepBranch(opcode) {
      // Taken keeps the tested value on the stack; the fall-through drops it, in a block of
      // its own that receives the whole state and releases the value.
      let v = self.top(1)
      let c = run self.branchTest(opcode, v, at)
      let taken = run self.destination(i64.toUsize(targetOf(input, pc)), at)
      let dropBlock = run self.f.block()
      let mut i: usize = 0
      while i < self.locals.length() + self.stack.length() { drop run self.f.addParam(dropBlock, Type.Value, Own.Owned) i = i + 1 }
      let mut first = NONE
      if opcode == op.OP_if_true_keep8 { first = run self.edgeTo(taken, at) drop run self.edgeTo(dropBlock, at) }
      else { first = run self.edgeTo(dropBlock, at) drop run self.edgeTo(taken, at) }
      run self.f.terminate(self.current, Op.Branch, c, first, at)
      self.current = dropBlock
      let params = run self.f.paramsOf(dropBlock)
      let local = self.locals.length()
      self.locals.clear() self.stack.clear()
      i = 0
      while i < params.length() {
        if i < local { run self.locals.append(params.get(i)) } else { run self.stack.append(params.get(i)) }
        i = i + 1
      }
      let dropped = self.pop() run self.release(dropped, at)
      run self.jumpTo(pc + size, at)
      return false
    }
    if isBranch(opcode) {
      let v = self.top(1)
      let c = run self.branchTest(opcode, v, at)
      drop self.pop() run self.release(v, at)
      let target = i64.toUsize(targetOf(input, pc))
      let fall = pc + size
      let taken = run self.destination(target, at)
      let next = run self.destination(fall, at)
      let mut whenTrue = taken let mut whenFalse = next
      if opcode == op.OP_if_false || opcode == op.OP_if_false8 || opcode == op.OP_if_not_nullish8 || opcode == op.OP_if_not_null8 { whenTrue = next whenFalse = taken }
      let edge = run self.edgeTo(whenTrue, at)
      drop run self.edgeTo(whenFalse, at)
      run self.f.terminate(self.current, Op.Branch, c, edge, at)
      return false
    }
    if isGoto(opcode) { run self.jumpTo(i64.toUsize(targetOf(input, pc)), at) return false }
    if opcode == op.OP_return {
      let v = self.pop()
      run self.releaseAll(at)
      let r = run self.boxed(v, at)
      run self.f.terminate(self.current, Op.Return, r, NONE, at)
      return false
    }
    if opcode == op.OP_return_undef {
      run self.releaseAll(at)
      let u = run self.imm(Imm.Undefined, at)
      run self.f.terminate(self.current, Op.Return, u, NONE, at)
      return false
    }
    if testOpcode(opcode) {
      let v = self.top(1)
      let mut r = NONE
      if nullMask(opcode) != 0 { r = run self.nullTest(v, nullMask(opcode), at) }
      else {
        let mut wanted = atoms.JS_ATOM_function
        if opcode == op.OP_typeof_is_undefined { wanted = atoms.JS_ATOM_undefined }
        else if opcode == op.OP_typeof_is { wanted = typeofIsAtom(byteAt(input, pc + 1)) }
        let ty = self.f.value(v).ty
        if ty == Type.I32 || ty == Type.F64 { r = run self.constBool(wanted == atoms.JS_ATOM_number, at) }
        else if ty == Type.Bool { r = run self.constBool(wanted == atoms.JS_ATOM_boolean, at) }
        else {
          let t = run self.f.emit(self.current, Op.TypeofAtom, true, Type.I32, Own.Unboxed, v, NONE, 0, at)
          let last = self.f.lastInst() run self.exitHere(last, at)
          let k = run self.constant(u32.wrappingToI32(wanted), at)
          r = run self.f.emit(self.current, Op.Cmp, true, Type.Bool, Own.Unboxed, t, k, u8.toI32(Cmp.value(Cmp.Eq)), at)
        }
      }
      drop self.pop() run self.release(v, at)
      run self.push(r)
      return true
    }
    if opcode == op.OP_instanceof {
      // The interpreter's arm: quickInstanceOf, both operands released; otherwise the full
      // operator (js_vm OP_instanceof), which this exit hands the instruction to.
      let a = self.top(2) let b = self.top(1)
      let left = run self.boxed(a, at)
      let right = run self.boxed(b, at)
      let r = run self.f.emit(self.current, Op.InstanceOf, true, Type.Bool, Own.Unboxed, left, right, 0, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      drop self.pop() drop self.pop()
      run self.release(b, at) run self.release(a, at)
      run self.push(r)
      return true
    }
    if objectOpcode(opcode) { return run self.object(input, pc) }
    if callOpcode(opcode) { return run self.call(input, pc) }
    if numberOpcode(opcode) { return run self.numberInstruction(input, pc) }
    fail refuse(at, opcode, b"opcode outside the subset")
  }

  // ---- calls (workstream H) ----

  /// A call through the engine's call entry: the callee, its receiver (undefined unless a
  /// method call) and arguments stay on the stack for the throw exit, then become the result.
  effect fn call(self: &mut Self, input: &FunctionInput, pc: usize) -> bool ! Refusal | OutOfMemoryError ? &mut Allocator {
    let opcode = byteAt(input, pc)
    let at = usize.toU32(pc)
    let mut count: usize = 0
    if opcode >= op.OP_call0 && opcode <= op.OP_call3 { count = u8.toUsize(opcode - op.OP_call0) }
    else { count = u16.toUsize(u16At(input, pc + 1)) }
    if count > u32.toUsize(calls.MAX_ARGUMENTS) { fail refuse(at, opcode, b"too many call arguments") }
    let method = opcode == op.OP_call_method
    // `new`: the function, then new.target in the receiver's place, then the arguments.
    let construct = opcode == op.OP_call_constructor
    let mut depth = count + 1
    if method || construct { depth = depth + 1 }
    if self.stack.length() < depth { fail refuse(at, opcode, b"call operands missing") }
    let mut function = self.top(count + 1)
    if construct { function = self.top(count + 2) }
    if self.f.value(function).ty != Type.Value { fail refuse(at, opcode, b"calling an unboxed number") }
    // Boxes come before the call.arg run, which must stay contiguous.
    let mut receiver = NONE
    if method { let given = self.top(count + 2) receiver = run self.boxed(given, at) }
    else if construct { let given = self.top(count + 1) receiver = run self.boxed(given, at) }
    else { receiver = run self.imm(Imm.Undefined, at) }
    if method && run self.inlined(input, function, receiver, count, at) { return true }
    if self.depth != 0 { fail refuse(at, opcode, b"a call inside an inlined body") }
    let mut i: usize = 0
    while i < count {
      let argument = self.top(count - i)
      drop run self.f.emit(self.current, Op.CallArg, false, Type.I32, Own.Unboxed, argument, NONE, usize.toI32(i), at)
      i = i + 1
    }
    let mut k = usize.toI32(count)
    if construct { k = k | calls.CONSTRUCT }
    let r = run self.f.emit(self.current, Op.Call, true, Type.Value, Own.Owned, function, receiver, k, at)
    let last = self.f.lastInst() run self.exitHere(last, at)
    i = 0
    while i < depth { let v = self.pop() run self.release(v, at) i = i + 1 }
    run self.push(r)
    return true
  }

  // ---- inlining (docs/jit/inlining.md) ----

  /// The index in `input.targets` of what the method call of `function` (the value a cached
  /// field read of this code made) may inline, or usize.MAX.
  fn inlineTarget(self: &Self, input: &FunctionInput, function: u32, pc: u32) -> usize {
    if self.depth >= MAX_INLINE_DEPTH || self.f.inlineTargets.length() >= MAX_INLINE_SITES { return usize.MAX }
    // A call that left compiled code before (a deopt recorded at its pc) is not inlined again.
    if self.depth == 0 {
      let mut s: usize = 0
      while s < self.doubleSites.length() { if self.doubleSites.get(s) == pc { return usize.MAX } s = s + 1 }
    }
    let info = self.f.value(function)
    if info.def == NONE { return usize.MAX }
    let read = self.f.inst(info.def)
    if read.op != Op.GetField || read.k != FIELD_CACHED || read.frame != self.f.frame { return usize.MAX }
    let mut t: usize = 0
    while t < input.targets.length() {
      let target = &input.targets.asSlice()[t]
      if target.pc == read.pc {
        let callee = &target.input
        if !callee.normal || callee.closureVars != 0 || callee.scopeSlots != 0 { return usize.MAX }
        if callee.code.length() == 0 || callee.code.length() > MAX_INLINE_BYTES { return usize.MAX }
        return t
      }
      t = t + 1
    }
    return usize.MAX
  }

  /// Translates the method call at `pc` of `function` with `count` arguments as the body of
  /// the function its site last called, guarded by that function's identity, when it can:
  /// true, with the operands replaced by the result. False with nothing changed otherwise.
  effect fn inlined(self: &mut Self, input: &FunctionInput, function: u32, receiver: u32, count: usize, pc: u32) -> bool ! OutOfMemoryError ? &mut Allocator {
    let t = self.inlineTarget(input, function, pc)
    if t == usize.MAX { return false }
    let target = &input.targets.asSlice()[t]
    let mark = self.f.mark()
    let outer = self.depth
    let savedLocals = run copyList(&self.locals)
    let savedStack = run copyList(&self.stack)
    if outer == 0 {
      self.rootPc = pc
      self.rootLocals = run copyList(&self.locals)
      self.rootStack = run copyList(&self.stack)
      self.rootInst = self.f.insts.length()
      self.broken = false
    }
    // The guard and the frame run for the caller: its exit is the caller's.
    let k = usize.toI32(self.f.inlineTargets.length())
    run self.f.inlineTargets.append(target.id)
    drop run self.f.emit(self.current, Op.CheckCallee, false, Type.I32, Own.Unboxed, function, NONE, k, pc)
    let guard = self.f.lastInst() run self.exitHere(guard, pc)
    drop run self.f.emit(self.current, Op.InlineFrame, false, Type.I32, Own.Unboxed, function, NONE, k, pc)
    // Into the body: the caller's state is held, the operands become the arguments.
    let heldBefore = self.held.length()
    if outer != 0 { run self.held.appendSlice(savedLocals.asSlice()) run self.held.appendSlice(savedStack.asSlice()) }
    let mut args = List<u32>.make()
    let mut i: usize = 0
    while i < count { run args.append(self.top(count - i)) i = i + 1 }
    let outerArgs = Intrinsic.replace(self.args, move args)
    let outerReceiver = self.receiver
    let outerFormals = self.formals
    let outerFrame = self.f.frame
    let outerSites = Intrinsic.replace(self.doubleSites, List<u32>.make())
    self.receiver = receiver
    self.formals = target.input.argumentCount
    self.f.frame = i32.wrappingToU32(k) + 1
    self.depth = outer + 1
    self.locals.clear() self.stack.clear()
    let outcome = run Effect.result(self.inlineBody(&target.input, pc))
    self.depth = outer
    self.f.frame = outerFrame
    self.args = move outerArgs
    self.receiver = outerReceiver
    self.formals = outerFormals
    self.doubleSites = move outerSites
    self.held.truncate(heldBefore)
    self.locals = move savedLocals
    self.stack = move savedStack
    let result = match move outcome {
      Result<u32, Refusal | OutOfMemoryError>.Success { value } => value
      Result<u32, Refusal | OutOfMemoryError>.Failure { error } => {
        match move error {
          Refusal { .. } => NONE
          OutOfMemoryError { .. } => { fail OutOfMemoryError {} }
        }
      }
    }
    if result == NONE || self.broken {
      // Nothing of the attempt stays; an attempt around this one fails with it.
      self.f.rollback(mark)
      return false
    }
    // The call's operands (function, receiver, arguments) go, the result takes their place.
    i = 0
    while i < count + 2 { let v = self.pop() run self.release(v, pc) i = i + 1 }
    run self.push(result)
    return true
  }

  /// The body of an inlined function: its instructions in order up to its return, whose
  /// value this returns (owned by the caller from here, or unboxed).
  effect fn inlineBody(self: &mut Self, callee: &FunctionInput, callPc: u32) -> u32 ! Refusal | OutOfMemoryError ? &mut Allocator {
    // Validates the code as the function's own is: sizes, operand stack depths.
    drop run shape(callee)
    let undefined = run self.imm(Imm.Undefined, callPc)
    let mut l: u32 = 0
    while l < callee.localCount { run self.locals.append(undefined) l = l + 1 }
    let length = callee.code.length()
    let mut pc: usize = 0
    while pc < length {
      let opcode = byteAt(callee, pc)
      let at = usize.toU32(pc)
      if !inlinable(opcode) { fail refuse(at, opcode, b"control flow in an inlined body") }
      if opcode == op.OP_return {
        let v = self.pop()
        run self.releaseAll(at)
        return v
      }
      if opcode == op.OP_return_undef {
        run self.releaseAll(at)
        return run self.imm(Imm.Undefined, at)
      }
      drop run self.instruction(callee, pc)
      if self.broken { fail refuse(at, opcode, b"a guard after an effect in an inlined body") }
      pc = pc + sizeAt(callee, pc)
    }
    fail refuse(usize.toU32(length), 0, b"control falls off the end of the code")
  }

  // ---- objects (workstream J) ----

  /// A guard that `v` has engine tag `tag`, exiting at `pc` with the current state.
  effect fn checkTag(self: &mut Self, v: u32, tag: i32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    drop run self.f.emit(self.current, Op.CheckTag, false, Type.I32, Own.Unboxed, v, NONE, tag, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
  }
  /// The named property the instruction at `pc` reads from `object`, owned.
  effect fn getField(self: &mut Self, object: u32, how: i32, pc: u32) -> u32 ! OutOfMemoryError ? &mut Allocator {
    let r = run self.f.emit(self.current, Op.GetField, true, Type.Value, Own.Owned, object, NONE, how, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
    return r
  }
  /// The named property store of the instruction at `pc` of `value` into `object`.
  effect fn putField(self: &mut Self, object: u32, value: u32, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let bits = run self.boxed(value, pc)
    drop run self.f.emit(self.current, Op.PutField, false, Type.I32, Own.Unboxed, object, bits, 0, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
  }
  /// Element `index` of `object` for the instruction at `pc`, owned; refuses a boolean index.
  effect fn getElem(self: &mut Self, object: u32, index: u32, pc: u32, opcode: u8) -> u32 ! Refusal | OutOfMemoryError ? &mut Allocator {
    if self.f.value(object).ty != Type.Value { fail refuse(pc, opcode, b"an element of an unboxed number") }
    let x = run self.int(index, pc)
    if x == NONE { fail refuse(pc, opcode, b"a boolean index") }
    let r = run self.f.emit(self.current, Op.GetElem, true, Type.Value, Own.Owned, object, x, 0, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
    return r
  }
  effect fn getLength(self: &mut Self, object: u32, pc: u32, opcode: u8) -> u32 ! Refusal | OutOfMemoryError ? &mut Allocator {
    if self.f.value(object).ty != Type.Value { fail refuse(pc, opcode, b"the length of an unboxed number") }
    let r = run self.f.emit(self.current, Op.GetLength, true, Type.Value, Own.Owned, object, NONE, 0, pc)
    let last = self.f.lastInst() run self.exitHere(last, pc)
    return r
  }
  /// Local `index` or argument `index` (the fused element forms' operands).
  effect fn slotValue(self: &mut Self, argument: bool, index: usize, pc: u32, opcode: u8) -> u32 ! Refusal | OutOfMemoryError ? &mut Allocator {
    if argument {
      if index >= self.argumentLimit() { fail refuse(pc, opcode, b"argument index out of range") }
      return run self.argument(usize.toU32(index), pc)
    }
    if index >= self.locals.length() { fail refuse(pc, opcode, b"local index out of range") }
    return self.locals.get(index)
  }
  effect fn object(self: &mut Self, input: &FunctionInput, pc: usize) -> bool ! Refusal | OutOfMemoryError ? &mut Allocator {
    let opcode = byteAt(input, pc)
    let at = usize.toU32(pc)
    if opcode == op.OP_push_this && self.depth != 0 {
      // The call's receiver operand, an object as below.
      let receiver = self.receiver
      run self.checkTag(receiver, -1, at)
      let r = run self.share(receiver, at)
      run self.push(r) return true
    }
    if opcode == op.OP_push_this {
      // Only an object receiver: anything else needs the interpreter's mode checks.
      let t = run self.f.emit(self.current, Op.This, true, Type.Value, Own.Borrowed, NONE, NONE, 0, at)
      let receiver = self.f.argumentCount
      self.f.setOwnership(t, Own.Borrowed, RootKind.Argument, receiver)
      run self.checkTag(t, -1, at)
      let r = run self.f.emit(self.current, Op.Retain, true, Type.Value, Own.Owned, t, NONE, 0, at)
      run self.push(r) return true
    }
    if opcode == op.OP_get_field {
      let o = self.top(1)
      if self.f.value(o).ty != Type.Value { fail refuse(at, opcode, b"a property of an unboxed number") }
      let r = run self.getField(o, FIELD_KEYED, at)
      drop self.pop() run self.release(o, at) run self.push(r)
      return true
    }
    if opcode == op.OP_get_field2 {
      let o = self.top(1)
      if self.f.value(o).ty != Type.Value { fail refuse(at, opcode, b"a property of an unboxed number") }
      let r = run self.getField(o, FIELD_CACHED, at)
      run self.push(r)
      return true
    }
    if opcode == op.OP_get_loc_field8 || opcode == op.OP_get_arg_field8 {
      let index = u8.toUsize(byteAt(input, pc + 13))
      let mut o = NONE
      if opcode == op.OP_get_loc_field8 {
        if index >= self.locals.length() { fail refuse(at, opcode, b"local index out of range") }
        o = self.locals.get(index)
      } else {
        if index >= self.argumentLimit() { fail refuse(at, opcode, b"argument index out of range") }
        o = run self.argument(usize.toU32(index), at)
      }
      if self.f.value(o).ty != Type.Value { fail refuse(at, opcode, b"a property of an unboxed number") }
      let r = run self.getField(o, FIELD_KEYED, at)
      run self.push(r)
      return true
    }
    if opcode == op.OP_get_array_el {
      let i = self.top(1)
      let o = self.top(2)
      let r = run self.getElem(o, i, at, opcode)
      drop self.pop() drop self.pop()
      run self.release(i, at) run self.release(o, at)
      run self.push(r)
      return true
    }
    // get_array_el2 keeps the object below the element (a[i] op= ...), get_array_el3 the
    // object and the key (a[i]++).
    if opcode == op.OP_get_array_el2 || opcode == op.OP_get_array_el3 {
      let i = self.top(1)
      let o = self.top(2)
      let r = run self.getElem(o, i, at, opcode)
      if opcode == op.OP_get_array_el2 { drop self.pop() run self.release(i, at) }
      run self.push(r)
      return true
    }
    if opcode == op.OP_get_loc_el8 || opcode == op.OP_get_arg_el8 || opcode == op.OP_get_loc_el_arg8 || opcode == op.OP_get_arg_el_arg8 {
      let o = run self.slotValue(opcode == op.OP_get_arg_el8 || opcode == op.OP_get_arg_el_arg8, u8.toUsize(byteAt(input, pc + 1)), at, opcode)
      let i = run self.slotValue(opcode == op.OP_get_loc_el_arg8 || opcode == op.OP_get_arg_el_arg8, u8.toUsize(byteAt(input, pc + 2)), at, opcode)
      let r = run self.getElem(o, i, at, opcode)
      run self.push(r)
      return true
    }
    if opcode == op.OP_get_length {
      let o = self.top(1)
      let r = run self.getLength(o, at, opcode)
      drop self.pop() run self.release(o, at)
      run self.push(r)
      return true
    }
    if opcode == op.OP_get_loc_length8 || opcode == op.OP_get_arg_length8 {
      let o = run self.slotValue(opcode == op.OP_get_arg_length8, u8.toUsize(byteAt(input, pc + 1)), at, opcode)
      let r = run self.getLength(o, at, opcode)
      run self.push(r)
      return true
    }
    if opcode == op.OP_put_array_el {
      let v = self.top(1)
      let i = self.top(2)
      let o = self.top(3)
      if self.f.value(o).ty != Type.Value { fail refuse(at, opcode, b"an element of an unboxed number") }
      let x = run self.int(i, at)
      if x == NONE { fail refuse(at, opcode, b"a boolean index") }
      let bits = run self.boxed(v, at)
      drop run self.f.emit(self.current, Op.PutElem, false, Type.I32, Own.Unboxed, o, bits, u32.wrappingToI32(x), at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      drop self.pop() drop self.pop() drop self.pop()
      run self.release(v, at) run self.release(i, at) run self.release(o, at)
      return true
    }
    if opcode == op.OP_get_scope0 || opcode == op.OP_get_scope0_check {
      let mut k = u16.toI32(u8.toU16(byteAt(input, pc + 1)) | u16.shiftLeft(u8.toU16(byteAt(input, pc + 2)), 8))
      if opcode == op.OP_get_scope0_check { k = k | 0x10000 }
      let r = run self.f.emit(self.current, Op.GetScope, true, Type.Value, Own.Owned, NONE, NONE, k, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      run self.push(r)
      return true
    }
    if opcode == op.OP_put_scope0 || opcode == op.OP_put_scope0_check || opcode == op.OP_set_scope0 {
      let mut k = u16.toI32(u8.toU16(byteAt(input, pc + 1)) | u16.shiftLeft(u8.toU16(byteAt(input, pc + 2)), 8))
      if opcode == op.OP_put_scope0_check { k = k | 0x10000 }
      let v = self.top(1)
      let bits = run self.boxed(v, at)
      drop run self.f.emit(self.current, Op.PutScope, false, Type.I32, Own.Unboxed, bits, NONE, k, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      // set_scope0 leaves the value on the stack.
      if opcode != op.OP_set_scope0 { drop self.pop() run self.release(v, at) }
      return true
    }
    if opcode == op.OP_get_var_ref || opcode == op.OP_get_var_ref_check {
      let k = u16.toI32(u8.toU16(byteAt(input, pc + 1)) | u16.shiftLeft(u8.toU16(byteAt(input, pc + 2)), 8)) | 0x20000
      let r = run self.f.emit(self.current, Op.GetScope, true, Type.Value, Own.Owned, NONE, NONE, k, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      run self.push(r)
      return true
    }
    if opcode == op.OP_put_var_ref || opcode == op.OP_put_var_ref_check || opcode == op.OP_set_var_ref {
      let k = u16.toI32(u8.toU16(byteAt(input, pc + 1)) | u16.shiftLeft(u8.toU16(byteAt(input, pc + 2)), 8)) | 0x20000
      let v = self.top(1)
      let bits = run self.boxed(v, at)
      drop run self.f.emit(self.current, Op.PutScope, false, Type.I32, Own.Unboxed, bits, NONE, k, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      // set_var_ref leaves the value on the stack.
      if opcode != op.OP_set_var_ref { drop self.pop() run self.release(v, at) }
      return true
    }
    if opcode == op.OP_get_var || opcode == op.OP_get_var_undef {
      let index = u16.toI32(u8.toU16(byteAt(input, pc + 1)) | u16.shiftLeft(u8.toU16(byteAt(input, pc + 2)), 8))
      let r = run self.f.emit(self.current, Op.GetVar, true, Type.Value, Own.Owned, NONE, NONE, index, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      run self.push(r)
      return true
    }
    if opcode == op.OP_put_var {
      let index = u16.toI32(u8.toU16(byteAt(input, pc + 1)) | u16.shiftLeft(u8.toU16(byteAt(input, pc + 2)), 8))
      let v = self.top(1)
      let bits = run self.boxed(v, at)
      drop run self.f.emit(self.current, Op.PutVar, false, Type.I32, Own.Unboxed, bits, NONE, index, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      drop self.pop() run self.release(v, at)
      return true
    }
    if opcode == op.OP_push_atom_value || opcode == op.OP_push_empty_string {
      let mut empty = 0
      if opcode == op.OP_push_empty_string { empty = 1 }
      let r = run self.f.emit(self.current, Op.AtomValue, true, Type.Value, Own.Owned, NONE, NONE, empty, at)
      let last = self.f.lastInst() run self.exitHere(last, at)
      run self.push(r)
      return true
    }
    if opcode == op.OP_put_field {
      let v = self.top(1)
      let o = self.top(2)
      if self.f.value(o).ty != Type.Value { fail refuse(at, opcode, b"a property of an unboxed number") }
      run self.putField(o, v, at)
      drop self.pop() drop self.pop()
      run self.release(v, at) run self.release(o, at)
      return true
    }
    if opcode == op.OP_put_loc_field_loc8 || opcode == op.OP_put_loc_field_arg8 {
      let target = u8.toUsize(byteAt(input, pc + 13))
      let source = u8.toUsize(byteAt(input, pc + 14))
      if target >= self.locals.length() { fail refuse(at, opcode, b"local index out of range") }
      let o = self.locals.get(target)
      let mut v = NONE
      if opcode == op.OP_put_loc_field_loc8 {
        if source >= self.locals.length() { fail refuse(at, opcode, b"local index out of range") }
        v = self.locals.get(source)
      } else {
        if source >= self.argumentLimit() { fail refuse(at, opcode, b"argument index out of range") }
        v = run self.argument(usize.toU32(source), at)
      }
      if self.f.value(o).ty != Type.Value { fail refuse(at, opcode, b"a property of an unboxed number") }
      run self.putField(o, v, at)
      return true
    }
    fail refuse(at, opcode, b"opcode outside the subset")
  }
}

/// Translates `input`, or refuses. The result is compacted but not yet simplified or
/// ownership-optimized (see `ssa_ownership.optimize`).
pub effect fn translate(input: &FunctionInput) -> Function ! Refusal | OutOfMemoryError ? &mut Allocator {
  if !input.normal { fail refuse(NONE, 0, b"generator or async function") }
  if input.closureVars != 0 { fail refuse(NONE, 0, b"closure variables") }
  if input.code.length() == 0 { fail refuse(NONE, 0, b"no code") }
  if op.opcodeInfo(op.OP_fuse_prefix, true).size != 5 { fail refuse(NONE, op.OP_fuse_prefix, b"fusion prefix size changed") }
  let shapeOf = run shape(input)
  let length = input.code.length()
  let mut t = Translator { f: Function.make(input.argumentCount, input.localCount), blockAt: List<u32>.make(), current: 0,
    locals: List<u32>.make(), stack: List<u32>.make(), doubleSites: run copyList(&input.doubleSites), argNumbers: List<u32>.make(),
    depth: 0, rootPc: 0, rootLocals: List<u32>.make(), rootStack: List<u32>.make(), rootInst: 0, held: List<u32>.make(),
    args: List<u32>.make(), receiver: NONE, formals: 0, broken: false }
  run t.blockAt.appendRepeated(NONE, length + 1)
  let entry = run t.f.block()
  // A block per leader, with one parameter per local and per operand at that point.
  let mut pc: usize = 0
  while pc < length {
    if shapeOf.leader.get(pc) && shapeOf.start.get(pc) {
      let b = run t.f.block()
      t.blockAt.set(pc, b)
      let count = input.localCount + i32.wrappingToU32(shapeOf.depth.get(pc))
      let mut i: u32 = 0
      while i < count { drop run t.f.addParam(b, Type.Value, Own.Owned) i = i + 1 }
    }
    pc = pc + 1
  }
  // The entry: locals start undefined, then the code's first block.
  t.current = entry
  let undefined = run t.imm(Imm.Undefined, 0)
  let mut i: u32 = 0
  while i < input.localCount { run t.locals.append(undefined) i = i + 1 }
  // Not a back edge, though its target is offset 0.
  let first = t.blockAt.get(0)
  let edge = run t.edgeTo(first, 0)
  run t.f.terminate(entry, Op.Jump, NONE, edge, 0)
  // Each block in code order.
  pc = 0
  while pc < length {
    if shapeOf.leader.get(pc) && shapeOf.start.get(pc) {
      run t.enter(pc)
      let mut at = pc
      let mut previous = pc
      let mut open = true
      while open {
        if at != pc && shapeOf.leader.get(at) {
          // Falling through into the next block, from the instruction before it.
          run t.jumpTo(at, usize.toU32(previous))
          open = false
        } else {
          open = run t.instruction(input, at)
          previous = at
          at = at + sizeAt(input, at)
        }
      }
    }
    pc = pc + 1
  }
  run t.f.compact()
  return move t.f
}

/// An exit at `pc` that is always taken (a guard on a constant that never holds), ending the
/// block: how on-stack-replacement code leaves at an instruction outside the subset.
effect fn sideExit(t: &mut Translator, pc: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let u = run t.imm(Imm.Undefined, pc)
  drop run t.f.emit(t.current, Op.Unbox, true, Type.I32, Own.Unboxed, u, NONE, 0, pc)
  let last = t.f.lastInst() run t.exitHere(last, pc)
  // Never reached; it ends the block with every owned value consumed.
  run t.releaseAll(pc)
  let r = run t.imm(Imm.Undefined, pc)
  run t.f.terminate(t.current, Op.Return, r, NONE, pc)
}

/// On-stack replacement (docs/jit/osr.md): translates `input` for an entry at the loop header
/// `header`, reached with an empty operand stack. The function takes `argumentCount +
/// localCount` arguments: the frame's arguments, then its locals (local `i` is argument
/// `argumentCount + i`). Only code reachable from the header is translated, and an
/// instruction outside the subset becomes an exit to the interpreter instead of a refusal.
pub effect fn translateOsr(input: &FunctionInput, header: u32, allowCalls: bool) -> Function ! Refusal | OutOfMemoryError ? &mut Allocator {
  let calls = osrMayCall(input, allowCalls)
  let none = List<u8>.make()
  let plain = run translateOsrWith(input, header, calls, &none, &none)
  // Locals the loop only ever makes numbers of enter as numbers: guarded once at entry, so
  // the loop's own unboxing (ssa_ownership) keeps them in registers.
  let speculation = run osrSpeculation(&plain, input.localCount, header, &input.doubleSites)
  // Arguments the loop only unboxes are guarded once at entry too (loop-invariant guards).
  let arguments = run osrArgumentSpeculation(&plain, input.argumentCount)
  let mut any = false
  let mut i: usize = 0
  while i < speculation.length() { if speculation.get(i) != SPECULATE_NONE { any = true } i = i + 1 }
  i = 0
  while i < arguments.length() { if arguments.get(i) != SPECULATE_NONE { any = true } i = i + 1 }
  if !any { return move plain }
  return run translateOsrWith(input, header, calls, &speculation, &arguments)
}

const SPECULATE_NONE: u8 = 0
const SPECULATE_INT: u8 = 1
const SPECULATE_NUMBER: u8 = 2

/// For each local of `f` (a translateOsr artefact): SPECULATE_INT when every value entering
/// its loop-header web from inside the loop is a boxed i32, SPECULATE_NUMBER when they are
/// boxed i32 or f64 (or the header deoptimized before, `doubleSites`), else SPECULATE_NONE.
effect fn osrSpeculation(f: &Function, localCount: u32, header: u32, doubleSites: &List<u32>) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u8>.make()
  run out.appendRepeated(SPECULATE_NONE, u32.toUsize(localCount))
  if f.blockCount() == 0 { return move out }
  let entry = f.blocks.get(0)
  if entry.instCount == 0 { return move out }
  let jump = f.inst(entry.firstInst + entry.instCount - 1)
  if jump.edge == NONE { return move out }
  let edge = f.edges.get(u32.toUsize(jump.edge))
  let target = f.blocks.get(u32.toUsize(edge.target))
  let mut widened = false
  let mut k: usize = 0
  while k < doubleSites.length() { if doubleSites.get(k) == header { widened = true } k = k + 1 }
  let mut g: u32 = 0
  while g < localCount && g < edge.argCount && g < target.paramCount {
    let entering = f.edgeArg(edge, g)
    // The web of header parameters this local's value flows around the loop in.
    let mut members = List<u32>.make()
    run members.append(f.paramAt(target, g))
    let mut ints = false let mut doubles = false let mut other = false
    let mut m: usize = 0
    while m < members.length() {
      let q = members.get(m)
      let info = f.value(q)
      let home = f.blocks.get(u32.toUsize(info.block))
      let mut position: u32 = 0
      while position < home.paramCount && f.paramAt(home, position) != q { position = position + 1 }
      let mut e: usize = 0
      while e < f.edges.length() {
        let into = f.edges.get(e)
        if into.target == info.block && position < into.argCount {
          let a = f.edgeArg(into, position)
          let ai = f.value(a)
          if a == entering || listHas(&members, a) { }
          else if ai.def == NONE && ai.ty == Type.Value { run members.append(a) }
          else if ai.def != NONE && f.inst(ai.def).op == Op.BoxI32 { ints = true }
          else if ai.def != NONE && f.inst(ai.def).op == Op.BoxF64 { doubles = true }
          else { other = true }
        }
        e = e + 1
      }
      m = m + 1
    }
    if !other && (ints || doubles) {
      if doubles || widened { out.set(u32.toUsize(g), SPECULATE_NUMBER) } else { out.set(u32.toUsize(g), SPECULATE_INT) }
    }
    g = g + 1
  }
  return move out
}
/// For each argument of `f` (a translateOsr artefact): SPECULATE_INT when every use of it is
/// an i32 unbox, SPECULATE_NUMBER when they are i32 or f64 unboxes with at least one f64,
/// else SPECULATE_NONE.
effect fn osrArgumentSpeculation(f: &Function, argumentCount: u32) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u8>.make()
  let mut ints = List<bool>.make() let mut doubles = List<bool>.make() let mut other = List<bool>.make()
  run out.appendRepeated(SPECULATE_NONE, u32.toUsize(argumentCount))
  run ints.appendRepeated(false, u32.toUsize(argumentCount))
  run doubles.appendRepeated(false, u32.toUsize(argumentCount))
  run other.appendRepeated(false, u32.toUsize(argumentCount))
  // Which argument each value is, if it is an Arg.
  let mut which = List<u32>.make()
  run which.appendRepeated(NONE, f.values.length())
  let mut i: usize = 0
  while i < f.insts.length() {
    let inst = f.insts.get(i)
    if inst.op == Op.Arg && inst.result != NONE && inst.k >= 0 && i32.wrappingToU32(inst.k) < argumentCount { which.set(u32.toUsize(inst.result), i32.wrappingToU32(inst.k)) }
    i = i + 1
  }
  // get_arg makes an owned copy: a retain of the argument is the argument too.
  let mut changed = true
  while changed {
    changed = false
    i = 0
    while i < f.insts.length() {
      let inst = f.insts.get(i)
      if inst.op == Op.Retain && inst.result != NONE && inst.a != NONE && u32.toUsize(inst.a) < which.length()
        && which.get(u32.toUsize(inst.a)) != NONE && which.get(u32.toUsize(inst.result)) == NONE {
        let n = which.get(u32.toUsize(inst.a))
        which.set(u32.toUsize(inst.result), n) changed = true
      }
      i = i + 1
    }
  }
  i = 0
  while i < f.insts.length() {
    let inst = f.insts.get(i)
    if inst.op != Op.Arg && inst.op != Op.Retain && inst.op != Op.Release {
      if inst.a != NONE && u32.toUsize(inst.a) < which.length() && which.get(u32.toUsize(inst.a)) != NONE {
        let n = u32.toUsize(which.get(u32.toUsize(inst.a)))
        if inst.op == Op.Unbox && f.value(inst.result).ty == Type.I32 { ints.set(n, true) }
        else if inst.op == Op.UnboxF64 { doubles.set(n, true) }
        else { other.set(n, true) }
      }
      if inst.b != NONE && u32.toUsize(inst.b) < which.length() && which.get(u32.toUsize(inst.b)) != NONE { other.set(u32.toUsize(which.get(u32.toUsize(inst.b))), true) }
    }
    i = i + 1
  }
  i = 0
  while i < f.edgeArgs.length() {
    let a = f.edgeArgs.get(i)
    if a != NONE && u32.toUsize(a) < which.length() && which.get(u32.toUsize(a)) != NONE { other.set(u32.toUsize(which.get(u32.toUsize(a))), true) }
    i = i + 1
  }
  i = 0
  while i < u32.toUsize(argumentCount) {
    if !other.get(i) && doubles.get(i) { out.set(i, SPECULATE_NUMBER) }
    else if !other.get(i) && ints.get(i) { out.set(i, SPECULATE_INT) }
    i = i + 1
  }
  return move out
}
fn listHas(list: &List<u32>, v: u32) -> bool {
  let mut i: usize = 0
  while i < list.length() { if list.get(i) == v { return true } i = i + 1 }
  return false
}

effect fn translateOsrWith(input: &FunctionInput, header: u32, calls: bool, speculation: &List<u8>, argumentSpeculation: &List<u8>) -> Function ! Refusal | OutOfMemoryError ? &mut Allocator {
  if !input.normal { fail refuse(NONE, 0, b"generator or async function") }
  if input.closureVars != 0 { fail refuse(NONE, 0, b"closure variables") }
  if input.scopeSlots != 0 { fail refuse(NONE, 0, b"a function scope") }
  if input.code.length() == 0 { fail refuse(NONE, 0, b"no code") }
  if op.opcodeInfo(op.OP_fuse_prefix, true).size != 5 { fail refuse(NONE, op.OP_fuse_prefix, b"fusion prefix size changed") }
  let begin = u32.toUsize(header)
  let region = run loopRegion(input, header)
  let shapeOf = run shapeAt(input, begin, true, calls, region.start, region.end)
  let back = run loopsBack(input, begin, calls, &region)
  if !back { fail refuse(header, byteAt(input, begin), b"every path around the loop leaves through an exit") }
  let length = input.code.length()
  let mut t = Translator { f: Function.make(input.argumentCount + input.localCount, input.localCount), blockAt: List<u32>.make(), current: 0,
    locals: List<u32>.make(), stack: List<u32>.make(), doubleSites: run copyList(&input.doubleSites), argNumbers: List<u32>.make(),
    depth: 0, rootPc: 0, rootLocals: List<u32>.make(), rootStack: List<u32>.make(), rootInst: 0, held: List<u32>.make(),
    args: List<u32>.make(), receiver: NONE, formals: 0, broken: false }
  run t.blockAt.appendRepeated(NONE, length + 1)
  let entry = run t.f.block()
  let mut pc: usize = 0
  while pc < length {
    if shapeOf.leader.get(pc) && shapeOf.start.get(pc) {
      let b = run t.f.block()
      t.blockAt.set(pc, b)
      let count = input.localCount + i32.wrappingToU32(shapeOf.depth.get(pc))
      let mut i: u32 = 0
      while i < count { drop run t.f.addParam(b, Type.Value, Own.Owned) i = i + 1 }
    }
    pc = pc + 1
  }
  // The entry: each local is an owner of the frame's value, as get_arg makes one.
  t.current = entry
  let mut i: u32 = 0
  while i < input.localCount {
    let a = run t.argument(input.argumentCount + i, header)
    let r = run t.f.emit(t.current, Op.Retain, true, Type.Value, Own.Owned, a, NONE, 0, header)
    run t.locals.append(r)
    i = i + 1
  }
  // Speculated locals: one guard each (an exit at the header with every local as it came),
  // then the local is the boxed number, its frame value released.
  i = 0
  while i < input.localCount && u32.toUsize(i) < speculation.length() {
    let kind = speculation.get(u32.toUsize(i))
    if kind != SPECULATE_NONE {
      let r = t.locals.get(u32.toUsize(i))
      let mut unboxed = NONE
      if kind == SPECULATE_INT { unboxed = run t.f.emit(t.current, Op.Unbox, true, Type.I32, Own.Unboxed, r, NONE, 0, header) }
      else { unboxed = run t.f.emit(t.current, Op.UnboxF64, true, Type.F64, Own.Unboxed, r, NONE, 0, header) }
      let guard = t.f.lastInst() run t.exitHere(guard, header)
      drop run t.f.emit(t.current, Op.Release, false, Type.I32, Own.Unboxed, r, NONE, 0, header)
      let number = run t.boxed(unboxed, header)
      t.locals.set(u32.toUsize(i), number)
    }
    i = i + 1
  }
  if argumentSpeculation.length() > 0 {
    run t.argNumbers.appendRepeated(NONE, u32.toUsize(input.argumentCount))
    i = 0
    while i < input.argumentCount && u32.toUsize(i) < argumentSpeculation.length() {
      let kind = argumentSpeculation.get(u32.toUsize(i))
      if kind != SPECULATE_NONE {
        let a = run t.argument(i, header)
        let mut unboxed = NONE
        if kind == SPECULATE_INT { unboxed = run t.f.emit(t.current, Op.Unbox, true, Type.I32, Own.Unboxed, a, NONE, 0, header) }
        else { unboxed = run t.f.emit(t.current, Op.UnboxF64, true, Type.F64, Own.Unboxed, a, NONE, 0, header) }
        let guard = t.f.lastInst() run t.exitHere(guard, header)
        let number = run t.boxed(unboxed, header)
        t.argNumbers.set(u32.toUsize(i), number)
      }
      i = i + 1
    }
  }
  let headerBlock = t.blockAt.get(begin)
  let edge = run t.edgeTo(headerBlock, header)
  run t.f.terminate(entry, Op.Jump, NONE, edge, header)
  pc = 0
  while pc < length {
    if shapeOf.leader.get(pc) && shapeOf.start.get(pc) {
      run t.enter(pc)
      let mut at = pc
      let mut previous = pc
      let mut open = true
      while open {
        if at != pc && shapeOf.leader.get(at) {
          run t.jumpTo(at, usize.toU32(previous))
          open = false
        } else if osrExit(byteAt(input, at), calls) || outside(at, region.start, region.end) {
          run sideExit(&mut t, usize.toU32(at))
          open = false
        } else {
          open = run t.instruction(input, at)
          previous = at
          at = at + sizeAt(input, at)
        }
      }
    }
    pc = pc + 1
  }
  run t.f.compact()
  return move t.f
}

/// Whether some path from the loop header `begin` comes back to it without an exit (an opcode
/// osrExit names, or leaving the region): OSR code with none would deopt on every entry.
effect fn loopsBack(input: &FunctionInput, begin: usize, calls: bool, region: &LoopRegion) -> bool ! OutOfMemoryError ? &mut Allocator {
  let length = input.code.length()
  let mut seen = List<bool>.make() run seen.appendRepeated(false, length + 1)
  let mut work = List<usize>.make()
  run work.append(begin)
  while work.length() > 0 {
    let mut pc = work.pop().unwrapOr(0)
    let mut going = true
    while going {
      if pc >= length || seen.get(pc) || outside(pc, region.start, region.end) { going = false continue }
      seen.set(pc, true)
      let opcode = byteAt(input, pc)
      let size = sizeAt(input, pc)
      if osrExit(opcode, calls) || isReturn(opcode) || size == 0 { going = false continue }
      if isBranch(opcode) || isGoto(opcode) {
        let target = targetOf(input, pc)
        if target == usize.toI64(begin) { return true }
        if target >= 0 { run work.append(i64.toUsize(target)) }
        if isBranch(opcode) { run work.append(pc + size) }
        going = false
      } else {
        pc = pc + size
        if pc == begin { return true }
      }
    }
  }
  return false
}

fn outside(pc: usize, low: u32, high: u32) -> bool { return pc < u32.toUsize(low) || pc > u32.toUsize(high) }

/// The bytecode range of a loop: from its header to its last back edge, inclusive.
pub struct LoopRegion { pub start: u32, pub end: u32 }

/// The outermost loop around `header`: the ranges [target, jump] of backward jumps that
/// overlap header's, merged until none overlaps more. On-stack-replacement code covers only
/// this range, so a huge function's code after the loop is not translated for each header,
/// and an exit outside it is the loop finishing (OsrEntry.start, end).
pub effect fn loopRegion(input: &FunctionInput, header: u32) -> LoopRegion ! OutOfMemoryError ? &mut Allocator {
  let length = input.code.length()
  let mut targets = List<u32>.make()
  let mut jumps = List<u32>.make()
  let mut pc: usize = 0
  while pc < length {
    let opcode = byteAt(input, pc)
    let size = sizeAt(input, pc)
    if size == 0 || pc + size > length { break }
    if isBranch(opcode) || isGoto(opcode) {
      let target = targetOf(input, pc)
      if target >= 0 && target <= usize.toI64(pc) { run targets.append(usize.toU32(i64.toUsize(target))) run jumps.append(usize.toU32(pc)) }
    }
    pc = pc + size
  }
  let mut start = header
  let mut end = header
  let mut changed = true
  while changed {
    changed = false
    let mut i: usize = 0
    while i < targets.length() {
      let low = targets.get(i)
      let high = jumps.get(i)
      if low <= end && high >= start && (low < start || high > end) {
        if low < start { start = low }
        if high > end { end = high }
        changed = true
      }
      i = i + 1
    }
  }
  return LoopRegion { start: start, end: end }
}

/// The targets of backward jumps in `input`, each once, in code order: where on-stack
/// replacement can enter. Read by decoding the code linearly.
pub effect fn loopHeaders(input: &FunctionInput) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let length = input.code.length()
  let mut marked = List<bool>.make() run marked.appendRepeated(false, length + 1)
  let mut pc: usize = 0
  while pc < length {
    let opcode = byteAt(input, pc)
    let size = sizeAt(input, pc)
    if size == 0 || pc + size > length { break }
    if isBranch(opcode) || isGoto(opcode) {
      let target = targetOf(input, pc)
      if target >= 0 && target <= usize.toI64(pc) { marked.set(i64.toUsize(target), true) }
    }
    pc = pc + size
  }
  let mut headers = List<u32>.make()
  pc = 0
  while pc < length { if marked.get(pc) { run headers.append(usize.toU32(pc)) } pc = pc + 1 }
  return move headers
}
