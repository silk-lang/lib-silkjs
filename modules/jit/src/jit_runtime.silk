//! The JIT as an engine embedder sees it: the state a JIT executable keeps per
//! runtime, the C-ABI callbacks it hands the engine (runtime setup, hot function
//! report), and the compiled code table the engine runs from
//! (docs/jit/compiled-entry.md). Compilation happens in the hot function report,
//! at an interrupt poll; it reads bytecode and never runs JavaScript.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silkjs.js_heap { HeapCell, HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_compiled as compiled
import silkjs.js_compiled_inline as inline
import silkjs.js_value { ValueBits }
import ssa_translate { CallTarget }
import silkjs.js_core_types { HOT_ENTRY_BUDGET, FunctionBytecode, CompiledEntry, OsrEntry, OSR_ONLY_CALL_WORDS, HostHook, NativeFunctionId }
import silkjs.js_runtime as runtime
import silkjs.js_feedback as feedback
import silkjs.js_libc_services { HotHandler, LIBC_HOT_FUNCTION_C }
import silkjs.cli_io as io
import silkjs.js_opcode_data as op
import code_memory { CodeMemory, CodeBlock, MemoryError }
import asm_x64 { Code, LinkError, UnboundLabelError }
import x64_lower { Lowered, Refusal }
import x64_lower as lower
import jit_recompile { History }
import jit_recompile as recompile
import ssa_input { inputOf }
import ssa_translate { loopHeaders, loopRegion, translateOsr, admits, Refusal as TranslateRefusal }
import ssa { Function }
import jit_helpers { CompiledEnv }
import jit_cost { Cost, now }

struct LoopBook { sites: List<u32>, spent: u64,
  /// With --jit-dump, the function's bytecode, to name the opcodes its code deoptimized at.
  code: List<u8> }

/// The loop header of a report from entries (CompiledTable.loopPc).
const NO_LOOP: u32 = 4294967295
/// Loop headers per table entry that get OSR code; polls at more are refused.
const OSR_HEADERS: usize = 8
/// Nanoseconds of OSR compilation per table entry after which its further headers are refused.
const OSR_BUDGET_NS: u64 = 50000000
/// Bytecode bytes of a loop (ssa_translate.loopRegion) above which OSR is refused.
const OSR_LOOP_BYTES: u32 = 16384

/// Functions one runtime can have compiled; the table never moves.
pub const CAPACITY: usize = 4096
/// u64 words of the runtime's activation stack (js_vm.runActivations): 2 MiB, room for about a
/// thousand nested activations before calls take native frames.
pub const ACTIVATION_WORDS: usize = 262144
/// Inline targets one runtime's code may name (each retained until the runtime goes).
pub const KEPT_CAPACITY: usize = 16384
/// Candidates looked up for one compilation, nested ones included, and how deep they nest.
const MAX_CANDIDATES: usize = 48
const CANDIDATE_DEPTH: u32 = 2
/// A callee longer than this many bytes of code is not a candidate (ssa_translate's limit).
const CANDIDATE_BYTES: usize = 96
/// Address space reserved for machine code.
const CODE_BYTES: usize = 67108864

pub struct Options {
  /// --jit: compile hot functions.
  pub enabled: bool,
  /// --jit-threshold=N: entries before a function is reported hot (engine default 1000).
  pub threshold: u32,
  /// --jit-stress=N: every compiled guard also fails on its Nth evaluation, and so on.
  pub stress: u32,
  /// --jit-deopt-limit=N: deopts after which the engine unlinks a function (0: never).
  pub deoptLimit: u32,
  /// --jit-stats: print counters to stderr at exit.
  pub stats: bool,
  /// --jit-dump: print each hot function's bytecode and the compile outcome to stderr.
  pub dump: bool,
  /// --jit-no-inline clears it: method calls whose site names one small plain function run
  /// that function's body in place, guarded by its identity (docs/jit/inlining.md).
  pub inlining: bool,
  /// --jit-calls: compile functions that make calls (call exits, compiled-entry.md 7.3). Off by
  /// default until calls between compiled functions are direct: through the engine a call costs
  /// more than the interpreter's inline call.
  pub calls: bool,
  /// --jit-compile-budget=N: bytecode bytes a function may have translated in all, over its
  /// normal and OSR lowerings and recompilations (0: no budget). Every lowering translates the
  /// whole body, once per loop header for OSR, so compile cost grows with size times headers
  /// times reports while the run it can speed up does not.
  pub compileBudget: u32,
  /// --jit-profile=N: a function reported hot at its entry first records feedback
  /// (js_feedback) for N of its instructions, and is compiled at its next report with the
  /// arithmetic sites that saw a double or an overflow as number sites (0: compile at once;
  /// default DEFAULT_PROFILE).
  pub profile: u32
}
/// The compile budget's default, in bytecode bytes (measured: K-doubles report, "Compile budget").
pub const DEFAULT_COMPILE_BUDGET: u32 = 32768
impl Options {
  pub fn make() -> Self {
    return Self { enabled: false, threshold: 0, stress: 0, deoptLimit: 8, stats: false, dump: false, calls: false, compileBudget: DEFAULT_COMPILE_BUDGET, profile: DEFAULT_PROFILE, inlining: true }
  }
}

pub struct Jit {
  pub options: Options,
  memory: Option<CodeMemory>,
  entries: List<CompiledEntry>,
  /// Storage lent to the runtime for its activation stack (never grows, so never moves).
  activations: List<u64>,
  /// Storage lent to the runtime for the inline targets it keeps alive (js_compiled_inline).
  kept: List<ValueBits>,
  /// Functions inlined into installed code, by site.
  pub inlinedSites: u64,
  /// One CompiledEnv, in storage that never moves (every entry's env points at it).
  pub env: List<CompiledEnv>,
  blocks: List<CodeBlock>,
  /// Countdown the stress configuration's guards share (CompiledEntry.data).
  stressCounter: i32,
  handler: HotHandler,
  pub runtime: ?*mut HeapHeader,
  pub reported: u64,
  pub compiledFunctions: u64,
  pub refused: u64,
  pub failed: u64,
  pub codeBytes: u64,
  /// The address the last installed code runs at.
  pub lastEntry: u64,
  /// Monotonic nanoseconds spent in compileHot, refusals included.
  pub compileNanoseconds: u64,
  /// Sums of the table's counters (collect).
  pub runs: u64,
  pub deopts: u64,
  pub polls: u64,
  pub unlinked: u64,
  /// Earlier compilations per function and their deopt sites (jit_recompile).
  history: History,
  /// Reports of functions compiled or refused before (recompilations attempted).
  pub recompiled: u64,
  /// Loop-header entries (docs/jit/osr.md): per linked function, the list its
  /// CompiledEntry.osr points into (never appended to once linked).
  osrLists: List<List<OsrEntry>>,
  /// Per table entry: the double sites it was compiled with (for its loop headers, compiled
  /// later) and the nanoseconds its loop headers took to compile.
  books: List<LoopBook>,
  pub osrCompiled: u64,
  pub osrRefused: u64,
  /// Functions linked for on-stack replacement only (their normal entry was refused).
  pub osrOnly: u64,
  pub osrRuns: u64,
  pub osrDeopts: u64,
  /// Compile time by phase and the sizes compiled (jit_cost).
  pub cost: Cost,
  /// Lowerings skipped by the compile budget (Options.compileBudget).
  pub overBudget: u64,
  /// Recompilations put off until the function ran more (jit_recompile.backoff).
  pub waited: u64,
  /// Functions sent to record feedback before their first compilation, and the number sites
  /// those recordings gave (Options.profile).
  pub profiled: u64,
  pub learned: u64,
  /// Functions refused because their recording showed a site the code would deoptimize at.
  pub foreseen: u64,
  /// Generic instruction exits in installed code (--jit-stats generic-sites).
  pub genericSites: u64
}
impl Jit {
  pub effect fn make(options: Options) -> Self ! OutOfMemoryError ? &mut Allocator {
    let entries = run List<CompiledEntry>.makeWithCapacity(CAPACITY)
    let activations = run List<u64>.makeWithCapacity(ACTIVATION_WORDS)
    let kept = run List<ValueBits>.makeWithCapacity(KEPT_CAPACITY)
    let mut env = run List<CompiledEnv>.makeWithCapacity(1)
    drop env.appendWithinCapacity(CompiledEnv.make())
    return Self { options: move options, memory: Option<CodeMemory>.none(), entries: move entries, activations: move activations, kept: move kept, inlinedSites: 0, env: move env, blocks: List<CodeBlock>.make(),
      stressCounter: 0, handler: HotHandler { function: hotAddress(), data: Pointer.null<u8>() }, runtime: Pointer.null<HeapHeader>(),
      reported: 0, compiledFunctions: 0, refused: 0, failed: 0, codeBytes: 0, lastEntry: 0, compileNanoseconds: 0, runs: 0, deopts: 0, polls: 0, unlinked: 0,
      history: History.make(), recompiled: 0,
      osrLists: List<List<OsrEntry>>.make(), books: List<LoopBook>.make(), osrCompiled: 0, osrRefused: 0, osrOnly: 0, osrRuns: 0, osrDeopts: 0, cost: Cost.make(), overBudget: 0, waited: 0, profiled: 0, learned: 0, foreseen: 0, genericSites: 0 }
  }
  /// The runtime setup callback (QjsOptions.runtimeSetup) and its data word for self.
  pub fn setupAddress() -> *const u8 {
    let function: extern "C" fn(*mut HeapHeader, ?*mut u8) -> () = jitRuntimeSetup
    let slot = unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut HeapHeader, ?*mut u8) -> (), *const *const u8>(Pointer.fromRef(&function))
    return unsafe Pointer.read<*const u8>(slot)
  }
  pub fn setupData(self: &mut Self) -> ?*mut u8 {
    return unsafe Intrinsic.pointerReinterpret<*mut Jit, *mut u8>(Pointer.fromMutRef<Jit>(&mut self))
  }
  /// The counters (--jit-stats) as one line.
  pub effect fn statsLine(self: &Self) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
    let mut line = List<u8>.make()
    run line.appendSlice(b"jit: reported ") run decimal(&mut line, self.reported)
    run line.appendSlice(b" compiled ") run decimal(&mut line, self.compiledFunctions)
    run line.appendSlice(b" refused ") run decimal(&mut line, self.refused)
    run line.appendSlice(b" failed ") run decimal(&mut line, self.failed)
    run line.appendSlice(b" runs ") run decimal(&mut line, self.runs)
    run line.appendSlice(b" deopts ") run decimal(&mut line, self.deopts)
    run line.appendSlice(b" polls ") run decimal(&mut line, self.polls)
    run line.appendSlice(b" unlinked ") run decimal(&mut line, self.unlinked)
    run line.appendSlice(b" recompiled ") run decimal(&mut line, self.recompiled)
    run line.appendSlice(b" direct-calls ") run decimal(&mut line, self.env.get(0).directCalls)
    run line.appendSlice(b" generic-sites ") run decimal(&mut line, self.genericSites)
    run line.appendSlice(b" generic-runs ") run decimal(&mut line, self.env.get(0).genericRuns)
    run line.appendSlice(b" inlined ") run decimal(&mut line, self.inlinedSites)
    run line.appendSlice(b" osr-compiled ") run decimal(&mut line, self.osrCompiled)
    run line.appendSlice(b" osr-refused ") run decimal(&mut line, self.osrRefused)
    run line.appendSlice(b" osr-only ") run decimal(&mut line, self.osrOnly)
    run line.appendSlice(b" osr-runs ") run decimal(&mut line, self.osrRuns)
    run line.appendSlice(b" osr-deopts ") run decimal(&mut line, self.osrDeopts)
    run line.appendSlice(b" code-bytes ") run decimal(&mut line, self.codeBytes)
    run line.appendSlice(b" compile-ns ") run decimal(&mut line, self.compileNanoseconds)
    run line.appendSlice(b" translate-ns ") run decimal(&mut line, self.cost.translate)
    run line.appendSlice(b" optimize-ns ") run decimal(&mut line, self.cost.optimize)
    run line.appendSlice(b" verify-ns ") run decimal(&mut line, self.cost.verify)
    run line.appendSlice(b" backend-ns ") run decimal(&mut line, self.cost.backend)
    run line.appendSlice(b" attempts ") run decimal(&mut line, self.cost.attempts)
    run line.appendSlice(b" bytecode-bytes ") run decimal(&mut line, self.cost.bytecodeBytes)
    run line.appendSlice(b" ssa-translated ") run decimal(&mut line, self.cost.translated)
    run line.appendSlice(b" ssa-optimized ") run decimal(&mut line, self.cost.optimized)
    run line.appendSlice(b" over-budget ") run decimal(&mut line, self.overBudget)
    run line.appendSlice(b" waited ") run decimal(&mut line, self.waited)
    run line.appendSlice(b" profiled ") run decimal(&mut line, self.profiled)
    run line.appendSlice(b" learned ") run decimal(&mut line, self.learned)
    run line.appendSlice(b" foreseen ") run decimal(&mut line, self.foreseen)
    run line.append(10)
    return move line
  }
  /// --jit-dump: the opcode each OSR entry last deoptimized at, with its deopts.
  pub effect fn dumpOsrDeopts(self: &Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let entries = self.entries.asSlice()
    let mut index: usize = 0
    while index < entries.length {
      let count = entries[index].osrCount
      if count != 0 {
        let list = unsafe Pointer.assumeMany<OsrEntry>(unsafe Intrinsic.pointerRequalify<?*mut OsrEntry, *const OsrEntry>(entries[index].osr))
        let mut i: u32 = 0
        while i < count {
          let osr = unsafe Pointer.read<OsrEntry>(unsafe Pointer.at<OsrEntry>(list, u32.toUsize(i)))
          if osr.deopts != 0 && osr.deoptOpcode != 0 {
            let mut line = List<u8>.make()
            run line.appendSlice(b"jit: osr deoptimized at: ") run line.appendSlice(op.opcodeName(u32.wrappingToU8(osr.deoptOpcode - 1), true))
            run line.appendSlice(b" x") run decimal(&mut line, u32.toU64(osr.deopts)) run line.append(10)
            io.stderr(line.asSlice())
          }
          i = i + 1
        }
      }
      // The entry code's own deopts: `jit: unlinked after: <opcodes>` or `jit: deopts at: <opcodes>`.
      if entries[index].deopts != 0 && index < self.books.length() {
        let code = self.books.asSlice()[index].code.asSlice()
        let mut line = List<u8>.make()
        if entries[index].deoptLimit != 0 && entries[index].deopts >= u32.toU64(entries[index].deoptLimit) { run line.appendSlice(b"jit: unlinked after:") }
        else { run line.appendSlice(b"jit: deopts at:") }
        let mut k: usize = 0
        while k < u8.toUsize(entries[index].deoptPcCount) {
          let pc = u32.toUsize(entries[index].deoptPcs[k])
          if pc < code.length { run line.append(32) run line.appendSlice(op.opcodeName(code[pc], true)) }
          k = k + 1
        }
        run line.append(10)
        io.stderr(line.asSlice())
      }
      index = index + 1
    }
  }
  /// Sums the compiled code table's counters into runs, deopts, polls and unlinked.
  pub fn collect(self: &mut Self) -> () {
    self.runs = 0 self.deopts = 0 self.polls = 0 self.unlinked = 0 self.osrRuns = 0 self.osrDeopts = 0
    let entries = self.entries.asSlice()
    let mut index: usize = 0
    while index < entries.length {
      let entry = &entries[index]
      self.runs = self.runs + entry.runs self.deopts = self.deopts + entry.deopts self.polls = self.polls + entry.polls
      self.osrRuns = self.osrRuns + entry.osrRuns self.osrDeopts = self.osrDeopts + entry.osrDeopts
      if entry.deoptLimit != 0 && entry.deopts >= u32.toU64(entry.deoptLimit) { self.unlinked = self.unlinked + 1 }
      index = index + 1
    }
  }
}

pub effect fn decimal(line: &mut List<u8>, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut digits: [u8; 20] = [0; 20]
  let mut count: usize = 0
  let mut rest = value
  while true {
    digits[count] = u64.wrappingToU8(rest % 10) + 48
    count = count + 1 rest = rest / 10
    if rest == 0 { break }
  }
  while count > 0 { count = count - 1 run line.append(digits[count]) }
}
effect fn hex(line: &mut List<u8>, value: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let table = b"0123456789abcdef"
  run line.append(table[u8.toUsize(u8.shiftRight(value, 4))]) run line.append(table[u8.toUsize(value & 15)])
}

fn hotAddress() -> *const u8 {
  let function: extern "C" fn(*mut HeapHeader, *mut HeapHeader, ?*mut u8) -> () = jitHotFunction
  let slot = unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut HeapHeader, *mut HeapHeader, ?*mut u8) -> (), *const *const u8>(Pointer.fromRef(&function))
  return unsafe Pointer.read<*const u8>(slot)
}
unsafe fn jitOf<'a>(anchor: &'a mut (), data: ?*mut u8) -> &'a mut Jit {
  return unsafe Pointer.borrowMut<(), Jit>(&mut anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Jit>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(data)))
}

/// QjsOptions.runtimeSetup: installs the hot handler and the compiled code table.
export "C" fn jitRuntimeSetup(rt: *mut HeapHeader, data: ?*mut u8) -> () {
  let mut anchor = ()
  let jit = unsafe jitOf(&mut anchor, data)
  if !jit.options.enabled { return () }
  unsafe attach(&mut jit, rt)
  jit.handler.data = data
  let handler = unsafe Intrinsic.pointerReinterpret<*mut HotHandler, *mut u8>(Pointer.fromMutRef<HotHandler>(&mut jit.handler))
  unsafe runtime.setHotFunctionHandler(rt, HostHook { callback: Option<NativeFunctionId>.some(NativeFunctionId.Host { id: LIBC_HOT_FUNCTION_C }), opaque: handler })
}
/// Gives rt jit's compiled code table and hot budget. An embedder that is not the libc
/// session sets its own hot function handler and calls compileHot from it.
pub unsafe fn attach(jit: &mut Jit, rt: *mut HeapHeader) -> () {
  jit.runtime = rt
  let mut env = CompiledEnv.make()
  env.runtime = rt
  jit.env.set(0, env)
  if jit.options.threshold != 0 { unsafe runtime.setHotEntryBudget(rt, jit.options.threshold) }
  let table = unsafe jit.entries.storage()
  unsafe runtime.setCompiledTable(rt, unsafe Intrinsic.pointerRequalify<?[*]mut CompiledEntry, ?*mut CompiledEntry>(table), usize.toU32(CAPACITY))
  let stack = unsafe jit.activations.storage()
  unsafe runtime.setActivationStack(rt, unsafe Intrinsic.pointerRequalify<?[*]mut u64, ?*mut u64>(stack), ACTIVATION_WORDS)
  let kept = unsafe jit.kept.storage()
  unsafe inline.setKept(rt, unsafe Intrinsic.pointerRequalify<?[*]mut ValueBits, ?*mut ValueBits>(kept), KEPT_CAPACITY)
}

/// LibcServices.hotFunction through HotHandler: compile bytecode or refuse it.
export "C" fn jitHotFunction(rt: *mut HeapHeader, bytecode: *mut HeapHeader, data: ?*mut u8) -> () {
  let mut anchor = ()
  let jit = unsafe jitOf(&mut anchor, data)
  let mut system = Allocator.systemAllocatorProvider()
  let started = now()
  let outcome = run Effect.result(unsafe compileHot(&mut jit, bytecode)) |> Effect.provideMut<Allocator>(&mut system)
  jit.compileNanoseconds = jit.compileNanoseconds + (now() - started)
  match move outcome {
    Result<(), OutOfMemoryError | MemoryError | LinkError>.Success { .. } => ()
    Result<(), OutOfMemoryError | MemoryError | LinkError>.Failure { .. } => { jit.failed = jit.failed + 1 }
  }
}

/// Options.profile unless --jit-profile says otherwise. Measured on Octane (compile-cost.md):
/// 200 misses too many sites, 2000 costs more in the observed loop than it saves.
pub const DEFAULT_PROFILE: u32 = 500
/// Recorded instructions from which a site the recording never reached counts as cold.
const SEEN_ENOUGH: u64 = 100
/// Entries a function runs while it records feedback before it is reported again.
const PROFILE_ENTRIES: u32 = 24

/// Stops bytecode's recording and adds to sites what it teaches the translator: arithmetic
/// sites that saw a double operand or an int32 overflow, branches that tested something other
/// than a boolean. Returns why the function should stay interpreted, or nothing: a call it
/// recorded reached a bytecode function that was reported and has no code to call (compiled
/// code deoptimizes at each such call, js_vm.compiledCall), or a property site the helpers
/// decline.
unsafe effect fn learn(jit: &mut Jit, rt: *mut HeapHeader, bytecode: *mut HeapHeader, sites: &mut List<u32>) -> &'static [u8] ! OutOfMemoryError ? &mut Allocator {
  drop unsafe feedback.stop(rt, bytecode)
  let seen = match run unsafe feedback.snapshot(rt, bytecode) {
    Option<feedback.Snapshot>.Some { value } => move value
    Option<feedback.Snapshot>.None => { return b"" }
  }
  let mut hopeless = false
  let mut why: &'static [u8] = b"it calls a function that stays interpreted"
  let mut index: usize = 0
  while index < seen.sites.length() {
    let site = seen.sites.get(index)
    let numeric = site.kind == feedback.KIND_BINARY || site.kind == feedback.KIND_UNARY
    let wide = u8.bitAnd(u8.bitOr(site.left, site.right), feedback.SEEN_DOUBLE) != 0 || u8.bitAnd(site.flags, feedback.SEEN_OVERFLOW) != 0
    // A branch the recording never reached is cold or late: ToBoolean there costs a helper call,
    // a wrong guess that it tests a boolean costs the function its code.
    let truthy = site.kind == feedback.KIND_BRANCH && (u8.bitAnd(site.flags, feedback.SEEN_NOT_BOOL) != 0 || (site.count == 0 && seen.observed >= SEEN_ENOUGH))
    if (numeric && wide) || truthy {
      let mut k: usize = 0
      let mut known = false
      while k < sites.length() { if sites.get(k) == site.offset { known = true } k = k + 1 }
      if !known { run sites.append(site.offset) jit.learned = jit.learned + 1 }
    }
    // Arithmetic and comparisons are compiled for numbers only.
    if numeric && site.count != 0 && u8.bitAnd(u8.bitOr(site.left, site.right), u8.bitOr(u8.bitOr(feedback.SEEN_STRING, feedback.SEEN_OBJECT), feedback.SEEN_OTHER)) != 0 {
      hopeless = true why = b"an operand of arithmetic or a comparison that is not a number"
    }
    // A store whose receivers had too many shapes for its caches, or a named read or store on
    // something that is not an object: the helpers decline those and the code would deoptimize.
    if site.kind == feedback.KIND_PROPERTY && site.count != 0 {
      if site.left != feedback.SEEN_OBJECT && site.opcode != op.OP_get_length { hopeless = true why = b"a named property of a value that is not an object" }
      else if site.shapeCount == feedback.MEGAMORPHIC_SHAPES && (site.opcode == op.OP_put_field || site.opcode == op.OP_put_loc_field_loc8 || site.opcode == op.OP_put_loc_field_arg8) {
        hopeless = true why = b"a store to objects of too many shapes"
      }
    }
    if site.kind == feedback.KIND_CALL && jit.options.calls {
      if site.first != feedback.NO_TARGET && unsafe codeless(rt, &seen.targets.get(u32.toUsize(site.first))) { hopeless = true }
      if site.second != feedback.NO_TARGET && unsafe codeless(rt, &seen.targets.get(u32.toUsize(site.second))) { hopeless = true }
    }
    index = index + 1
  }
  if hopeless { return why }
  return b""
}
/// Whether target is a bytecode function the engine reported hot that was refused: no code,
/// or code for its loops only, and not counting entries towards another report.
unsafe fn codeless(rt: *mut HeapHeader, target: &feedback.Target) -> bool {
  if target.kind != feedback.TARGET_BYTECODE { return false }
  let callee = match target.function { ValueBits.FunctionBytecode { reference } => reference _ => { return false } }
  let anchor = ()
  let code = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, callee)
  if code.compiled != 0 {
    let index = code.compiled
    drop code
    return unsafe compiled.callWords(rt, index) == u32.toUsize(OSR_ONLY_CALL_WORDS)
  }
  return code.hotness >= REPORTED_FLOOR
}
/// js_hotness parks a reported function's count at or above this.
const REPORTED_FLOOR: u32 = 2147483648

/// Compiles bytecode, a FunctionBytecode cell reported hot, and links it, or refuses it.
pub unsafe effect fn compileHot(jit: &mut Jit, bytecode: *mut HeapHeader) -> () ! OutOfMemoryError | MemoryError | LinkError ? &mut Allocator {
  let attached = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(jit.runtime)
  let loopPc = unsafe runtime.hotLoopPc(attached)
  let anchor = ()
  let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  // A poll in a linked function at a header with no OSR entry yet: that header alone.
  if function.compiled != 0 && loopPc != NO_LOOP {
    let index = u32.toUsize(function.compiled - 1)
    drop function
    run unsafe addHeader(&mut jit, bytecode, index, loopPc)
    return ()
  }
  jit.reported = jit.reported + 1
  if jit.entries.length() >= CAPACITY { jit.refused = jit.refused + 1 return () }
  if jit.options.dump { run unsafe dumpBytecode(&function) }
  let mut plan = run unsafe jit.history.plan(&function, Pointer.address<HeapHeader>(bytecode), &jit.entries)
  if plan.recompile { jit.recompiled = jit.recompiled + 1 }
  if jit.options.dump && plan.recompile { run unsafe dumpSites(&function, plan.sites.asSlice(), plan.kinds.asSlice(), plan.fresh, plan.refuse) }
  if jit.options.dump && plan.recompile && jit.options.profile != 0 { run unsafe dumpSeen(attached, bytecode, &function, plan.sites.asSlice(), plan.fresh) }
  if plan.refuse {
    jit.refused = jit.refused + 1
    if jit.options.dump { run say(b"jit: refused: ", plan.why) }
    return ()
  }
  // A first compilation learns its number sites from a short recording first: the function is
  // reported again after PROFILE_ENTRIES entries, or at the next poll in one of its loops.
  if jit.options.profile != 0 {
    if jit.history.profile(&plan) {
      // Recording costs observed-loop time: only for a function the translator can take.
      let input = run inputOf(&function)
      // A longer body needs a longer look: two more instructions per bytecode byte.
      let mut budget = jit.options.profile
      let extra = usize.toU32(input.code.length()) * 2
      if extra < u32.MAX - budget { budget = budget + extra }
      if (run admits(&input, jit.options.calls)) && run unsafe feedback.start(attached, bytecode, budget) {
        drop function
        let mut codeAnchor = () let owner = unsafe HeapCell.payloadMut<FunctionBytecode, ()>(&mut codeAnchor, bytecode)
        // Never above the hot budget: the engine takes such a count for a function without code
        // and deoptimizes compiled callers at their calls to it (js_vm.reportedWithoutCode).
        let mut entries = PROFILE_ENTRIES
        if jit.options.threshold != 0 && jit.options.threshold < entries { entries = jit.options.threshold }
        owner.hotness = entries
        drop owner
        jit.profiled = jit.profiled + 1
        jit.reported = jit.reported - 1
        if jit.options.dump { run say(b"jit: records feedback first", b"") }
        return ()
      }
    } else if !plan.recompile {
      let why = run unsafe learn(&mut jit, attached, bytecode, &mut plan.sites)
      if why.length != 0 {
        jit.refused = jit.refused + 1
        jit.foreseen = jit.foreseen + 1
        if jit.options.dump { run say(b"jit: refused: ", why) }
        run jit.history.remember(&plan, recompile.noEntry())
        return ()
      }
    }
  }
  // A recompilation after an unlink waits for more entries first (jit_recompile.backoff); a
  // report from a loop poll is a loop running now and compiles at once.
  if loopPc == NO_LOOP {
    let wait = jit.history.backoff(&plan)
    if wait != 0 {
      drop function
      let mut base = jit.options.threshold
      if base == 0 { base = HOT_ENTRY_BUDGET }
      let mut entries = u32.MAX / 4
      if base < entries / wait { entries = base * wait }
      let mut codeAnchor = () let owner = unsafe HeapCell.payloadMut<FunctionBytecode, ()>(&mut codeAnchor, bytecode)
      owner.hotness = entries
      drop owner
      jit.waited = jit.waited + 1
      jit.reported = jit.reported - 1
      jit.recompiled = jit.recompiled - 1
      if jit.options.dump { run say(b"jit: waits before recompiling", b"") }
      return ()
    }
  }
  let bytes = (unsafe function.code.asSlice()).length
  if !jit.history.charge(&plan, bytes, u32.toU64(jit.options.compileBudget)) {
    jit.refused = jit.refused + 1
    jit.overBudget = jit.overBudget + 1
    if jit.options.dump { run say(b"jit: refused: ", b"over the compile budget (--jit-compile-budget)") }
    run jit.history.remember(&plan, recompile.noEntry())
    return ()
  }
  let mut cost = Cost.make()
  cost.dump = jit.options.dump
  // What its method calls called last, to inline (docs/jit/inlining.md): cells[id] is the
  // FunctionBytecode cell of the target a CallTarget names.
  let mut cells = List<?*mut HeapHeader>.make()
  let mut targets = List<CallTarget>.make()
  if jit.options.calls && jit.options.inlining { targets = run unsafe candidates(&jit, bytecode, 0, &mut cells) }
  let lowered = run Effect.result(unsafe lower.lowerInlining(&function, jit.options.stress, jit.options.calls, &plan.sites, move targets, &mut cost))
  jit.cost.add(&cost)
  if jit.options.dump { run dumpCost(b"jit: cost entry", &cost) }
  drop function
  // OSR code only for the loop whose poll reported the function; other headers compile when
  // a poll lands at them (addHeader).
  let mut osr = List<OsrEntry>.make()
  let mut spent: u64 = 0
  if loopPc != NO_LOOP {
    let started = now()
    run osr.append(run unsafe compileHeader(&mut jit, bytecode, &plan.sites, loopPc))
    spent = now() - started
  }
  let result = match move lowered {
    Result<Lowered, OutOfMemoryError | UnboundLabelError>.Success { value } => move value
    Result<Lowered, OutOfMemoryError | UnboundLabelError>.Failure { .. } => { jit.failed = jit.failed + 1 return () }
  }
  let mut callWords: u32 = 0
  let mut genericSites: u32 = 0
    // The inline targets the code names, in symbol order.
  let mut used = List<?*mut HeapHeader>.make()
  if let Lowered.Code { callWords: words, inlined, genericSites: sites, .. } = &result {
    callWords = words genericSites = sites
    let mut k: usize = 0
    while k < inlined.length() { run used.append(cells.get(u32.toUsize(inlined.get(k)))) k = k + 1 }
  }
  let mut code = match move result {
    Lowered.Code { value, .. } => move value
    Lowered.Refused { reason } => {
      jit.refused = jit.refused + 1
      if jit.options.dump { run sayRefusal(&reason) }
      let mut linked = recompile.noEntry()
      if hasCode(&osr) { linked = run unsafe installOsrOnly(&mut jit, bytecode, move osr, &plan.sites, spent) }
      run jit.history.remember(&plan, linked)
      return ()
    }
  }
  if jit.options.dump { run dumpMachine(&code) }
  let installed = run unsafe installLinked(&mut jit, bytecode, &mut code, callWords, &plan.sites, spent, &used)
  if !installed { jit.refused = jit.refused + 1 return () }
  jit.inlinedSites = jit.inlinedSites + usize.toU64(used.length())
  run jit.history.remember(&plan, usize.toU32(jit.entries.length() - 1))
  jit.compiledFunctions = jit.compiledFunctions + 1
  jit.genericSites = jit.genericSites + u32.toU64(genericSites)
  if jit.options.dump { run say(b"jit: compiled", b"") }
  let last = jit.entries.length() - 1
  run unsafe attachOsr(&mut jit, last, move osr)
}

fn hasCode(list: &List<OsrEntry>) -> bool {
  let mut i: usize = 0
  while i < list.length() { if !Pointer.isNull<u8>(list.get(i).code) { return true } i = i + 1 }
  return false
}

/// Gives linked table entry index an OSR entry for loop header pc of bytecode: compiled, or
/// refused (null code) past OSR_HEADERS compiled headers or OSR_BUDGET_NS of compiling.
unsafe effect fn addHeader(jit: &mut Jit, bytecode: *mut HeapHeader, index: usize, pc: u32) -> () ! OutOfMemoryError | MemoryError | LinkError ? &mut Allocator {
  let mut list = List<OsrEntry>.make()
  let count = jit.entries.asSlice()[index].osrCount
  let pointer = jit.entries.asSlice()[index].osr
  if count != 0 {
    let old = unsafe Pointer.assumeMany<OsrEntry>(unsafe Intrinsic.pointerRequalify<?*mut OsrEntry, *const OsrEntry>(pointer))
    let mut i: u32 = 0
    while i < count { run list.append(unsafe Pointer.read<OsrEntry>(unsafe Pointer.at<OsrEntry>(old, u32.toUsize(i)))) i = i + 1 }
  }
  let mut compiled: usize = 0
  let mut i: usize = 0
  while i < list.length() { if !Pointer.isNull<u8>(list.get(i).code) { compiled = compiled + 1 } i = i + 1 }
  let over = compiled >= OSR_HEADERS || jit.books.asSlice()[index].spent >= OSR_BUDGET_NS
  if over {
    jit.osrRefused = jit.osrRefused + 1
    if jit.options.dump { run say(b"jit: osr refused: ", b"loop budget of the function used up") }
    run list.append(refusedHeader(pc))
  } else {
    let sites = run copySites(&jit.books.asSlice()[index].sites)
    let started = now()
    run list.append(run unsafe compileHeader(&mut jit, bytecode, &sites, pc))
    let books = jit.books.asMutSlice()
    books[index].spent = books[index].spent + (now() - started)
  }
  run unsafe attachOsr(&mut jit, index, move list)
}
effect fn copySites(from: &List<u32>) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u32>.make()
  run out.appendSlice(from.asSlice())
  return move out
}
fn refusedHeader(pc: u32) -> OsrEntry {
  return OsrEntry { pc: pc, depth: 0, code: Pointer.null<u8>(), callWords: 0, start: 0, end: 0, deopts: 0, wait: 0, deoptOpcode: 0 }
}

/// Compiles and publishes the on-stack-replacement entry for loop header pc of bytecode
/// (docs/jit/osr.md); a refusal (or a pc that is no loop header) is an entry with null code.
unsafe effect fn compileHeader(jit: &mut Jit, bytecode: *mut HeapHeader, doubleSites: &List<u32>, header: u32) -> OsrEntry ! OutOfMemoryError | MemoryError | LinkError ? &mut Allocator {
  let anchor = ()
  let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let input = run inputOf(&function)
  let headers = run loopHeaders(&input)
  let mut known = false
  let mut i: usize = 0
  while i < headers.length() { if headers.get(i) == header { known = true } i = i + 1 }
  if !known { return refusedHeader(header) }
  let region = run loopRegion(&input, header)
  if region.end - region.start > OSR_LOOP_BYTES {
    jit.osrRefused = jit.osrRefused + 1
    if jit.options.dump { run say(b"jit: osr refused: ", b"a loop of too much code") }
    return refusedHeader(header)
  }
  if jit.options.dump {
    match move run Effect.result(translateOsr(&input, header, jit.options.calls)) {
      Result<Function, TranslateRefusal | OutOfMemoryError>.Success { value } => { let mut out = List<u8>.make() run value.print(&mut out) io.stderr(out.asSlice()) }
      Result<Function, TranslateRefusal | OutOfMemoryError>.Failure { .. } => ()
    }
  }
  let mut cost = Cost.make()
  cost.dump = jit.options.dump
  let lowered = run Effect.result(unsafe lower.lowerOsr(&function, jit.options.stress, jit.options.calls, doubleSites, header, &mut cost))
  jit.cost.add(&cost)
  if jit.options.dump { run dumpCost(b"jit: cost osr", &cost) }
  drop function
  let result = match move lowered {
    Result<Lowered, OutOfMemoryError | UnboundLabelError>.Success { value } => move value
    Result<Lowered, OutOfMemoryError | UnboundLabelError>.Failure { .. } => { jit.failed = jit.failed + 1 return refusedHeader(header) }
  }
  let mut osrCallWords: u32 = 0
  let mut code = match move result {
    Lowered.Code { value, callWords, .. } => { osrCallWords = callWords move value }
    Lowered.Refused { reason } => {
      jit.osrRefused = jit.osrRefused + 1
      if jit.options.dump { run say(b"jit: osr refused: ", reason.text()) }
      return refusedHeader(header)
    }
  }
  if jit.memory.isNone() { jit.memory = Option<CodeMemory>.some(run CodeMemory.reserve(CODE_BYTES)) }
  let noSymbols: [usize; 1] = [0]
  let block = match &mut jit.memory {
    Option<CodeMemory>.Some { value } => run publish(&mut value, &mut code, Slice.view<usize>(&noSymbols, 0, 0))
    Option<CodeMemory>.None => { return refusedHeader(header) }
  }
  jit.codeBytes = jit.codeBytes + usize.toU64(code.bytes.length())
  let entry = OsrEntry { pc: header, depth: 0, code: block.entry(), callWords: osrCallWords, start: region.start, end: region.end, deopts: 0, wait: 0, deoptOpcode: 0 }
  run jit.blocks.append(move block)
  jit.osrCompiled = jit.osrCompiled + 1
  if jit.options.dump { run say(b"jit: osr compiled", b"") }
  return entry
}
/// Gives table entry index the loop-header entries in list (replacing any it had; the old
/// list stays allocated, as a poll may still hold an entry of it).
unsafe effect fn attachOsr(jit: &mut Jit, index: usize, list: List<OsrEntry>) -> () ! OutOfMemoryError ? &mut Allocator {
  if list.length() == 0 { return () }
  let count = usize.toU32(list.length())
  run jit.osrLists.append(move list)
  let stored = jit.osrLists.length() - 1
  let lists = jit.osrLists.asMutSlice()
  let pointer = unsafe Intrinsic.pointerRequalify<?[*]mut OsrEntry, ?*mut OsrEntry>(unsafe lists[stored].storage())
  let entries = jit.entries.asMutSlice()
  entries[index].osr = pointer
  entries[index].osrCount = count
}
unsafe effect fn codeCopy(dump: bool, bytecode: *mut HeapHeader) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut out = List<u8>.make()
  if !dump { return move out }
  let anchor = ()
  let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  run out.appendSlice(unsafe function.code.asSlice())
  return move out
}
/// Links bytecode, whose normal entry was refused, for on-stack replacement only.
/// Returns its table index (for jit_recompile, which reads its OSR deopt sites) or
/// recompile.noEntry() when the table is full.
unsafe effect fn installOsrOnly(jit: &mut Jit, bytecode: *mut HeapHeader, list: List<OsrEntry>, sites: &List<u32>, spent: u64) -> u32 ! OutOfMemoryError ? &mut Allocator {
  if jit.entries.length() >= CAPACITY { return recompile.noEntry() }
  let index = jit.entries.length()
  // The osr code reads the stress countdown through the entry's data word, as normal code does.
  let mut stress: ?*mut u8 = Pointer.null<u8>()
  if jit.options.stress != 0 {
    jit.stressCounter = u32.wrappingToI32(jit.options.stress)
    stress = unsafe Intrinsic.pointerReinterpret<*mut i32, *mut u8>(Pointer.fromMutRef<i32>(&mut jit.stressCounter))
  }
  let env = unsafe Intrinsic.pointerReinterpret<*mut CompiledEnv, *mut u8>(Pointer.fromMutRef<CompiledEnv>(&mut jit.env.asMutSlice()[0]))
  let added = jit.entries.appendWithinCapacity(blankEntry(Pointer.null<u8>(), stress, env, jit.options.deoptLimit, OSR_ONLY_CALL_WORDS))
  if !added { return recompile.noEntry() }
  let kept = run unsafe codeCopy(jit.options.dump, bytecode)
  run jit.books.append(LoopBook { sites: run copySites(&sites), spent: spent, code: move kept })
  run unsafe attachOsr(&mut jit, index, move list)
  let attached = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(jit.runtime)
  unsafe runtime.linkOsr(attached, bytecode, usize.toU32(index))
  jit.osrOnly = jit.osrOnly + 1
  return usize.toU32(index)
}
fn blankEntry(code: ?*const u8, data: ?*mut u8, env: ?*mut u8, deoptLimit: u32, callWords: u32) -> CompiledEntry {
  return CompiledEntry { code: code, data: data, env: env, deoptLimit: deoptLimit, frameCells: 0, leaf: 0, callWords: callWords, runs: 0, deopts: 0, polls: 0, deoptPcs: [0; 4], deoptPcCount: 0,
    osr: Pointer.null<OsrEntry>(), osrCount: 0, osrRuns: 0, osrDeopts: 0, deoptKinds: [0; 4], activationWords: 0, counter: Pointer.null<i32>(),
    directArity: compiled.DIRECT_NOT_READY, directRealm: Pointer.null<HeapHeader>(), directCode: Pointer.null<u8>() }
}

/// Links code, lowered from bytecode by this or another runtime's compiler (it holds no
/// process-local address until linked), publishes it at this runtime's next code address and
/// links bytecode to it. callWords: its call block size (Lowered.Code.callWords). False when
/// the table is full.
pub unsafe effect fn install(jit: &mut Jit, bytecode: *mut HeapHeader, code: &mut Code, callWords: u32, sites: &List<u32>, spent: u64) -> bool ! OutOfMemoryError | MemoryError | LinkError ? &mut Allocator {
  let none = List<?*mut HeapHeader>.make()
  return run unsafe installLinked(&mut jit, bytecode, &mut code, callWords, sites, spent, &none)
}
/// install for code that names inline targets: targets holds each one's FunctionBytecode
/// cell, in symbol order (Lowered.Code.inlined). Each is kept alive for the runtime's life
/// first; false, with nothing linked, when that cannot be done.
unsafe effect fn installLinked(jit: &mut Jit, bytecode: *mut HeapHeader, code: &mut Code, callWords: u32, sites: &List<u32>, spent: u64, targets: &List<?*mut HeapHeader>) -> bool ! OutOfMemoryError | MemoryError | LinkError ? &mut Allocator {
  if jit.entries.length() >= CAPACITY { return false }
  let attachedRuntime = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(jit.runtime)
  // Per target: the address of its cell, then of the first byte of its code.
  let mut symbols = List<usize>.make()
  let mut s: usize = 0
  while s < targets.length() {
    let cell = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(targets.get(s))
    if !(unsafe inline.keep(attachedRuntime, cell)) { return false }
    run symbols.append(Pointer.address<HeapHeader>(cell))
    run symbols.append(Pointer.address<u8>(unsafe inline.codeStart(cell)))
    s = s + 1
  }
  if jit.memory.isNone() { jit.memory = Option<CodeMemory>.some(run CodeMemory.reserve(CODE_BYTES)) }
  let block = match &mut jit.memory {
    Option<CodeMemory>.Some { value } => run publish(&mut value, &mut code, symbols.asSlice())
    Option<CodeMemory>.None => { return false }
  }
  let entry = block.entry()
  jit.codeBytes = jit.codeBytes + usize.toU64(code.bytes.length())
  run jit.blocks.append(move block)
  let mut stress: ?*mut u8 = Pointer.null<u8>()
  if jit.options.stress != 0 {
    jit.stressCounter = u32.wrappingToI32(jit.options.stress)
    stress = unsafe Intrinsic.pointerReinterpret<*mut i32, *mut u8>(Pointer.fromMutRef<i32>(&mut jit.stressCounter))
  }
  let index = jit.entries.length()
  let env = unsafe Intrinsic.pointerReinterpret<*mut CompiledEnv, *mut u8>(Pointer.fromMutRef<CompiledEnv>(&mut jit.env.asMutSlice()[0]))
  let added = jit.entries.appendWithinCapacity(blankEntry(entry, stress, env, jit.options.deoptLimit, callWords))
  if !added { return false }
  let kept = run unsafe codeCopy(jit.options.dump, bytecode)
  run jit.books.append(LoopBook { sites: run copySites(&sites), spent: spent, code: move kept })
  let attached = unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(jit.runtime)
  unsafe runtime.linkCompiled(attached, bytecode, usize.toU32(index))
  jit.lastEntry = usize.toU64(Pointer.address<u8>(entry))
  return true
}

/// The inline candidates of bytecode (docs/jit/inlining.md): for each get_field2 whose site
/// cache names a small plain function on a prototype, that function, with its own candidates
/// while depth allows. cells receives each one's FunctionBytecode cell address, at its id.
unsafe effect fn candidates(jit: &Jit, bytecode: *mut HeapHeader, depth: u32, cells: &mut List<?*mut HeapHeader>) -> List<CallTarget> ! OutOfMemoryError ? &mut Allocator {
  let mut targets = List<CallTarget>.make()
  let rt = match Pointer.nonNullMut<HeapHeader>(jit.runtime) { Option<*mut HeapHeader>.Some { value } => value Option<*mut HeapHeader>.None => { return move targets } }
  let anchor = ()
  let function = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, bytecode)
  let bytes = unsafe function.code.asSlice()
  // What the recording saw each call call (js_feedback): the one bytecode function of a site
  // with a single target.
  if jit.options.profile != 0 {
    if let Option<feedback.Snapshot>.Some { value: seen } = run unsafe feedback.snapshot(rt, bytecode) {
      let mut index: usize = 0
      while index < seen.sites.length() && cells.length() < MAX_CANDIDATES {
        let site = seen.sites.get(index)
        index = index + 1
        if site.kind != feedback.KIND_CALL || site.targets != 1 || site.first == feedback.NO_TARGET || site.opcode == op.OP_call_constructor { continue }
        let target = seen.targets.get(u32.toUsize(site.first))
        if target.kind != feedback.TARGET_BYTECODE { continue }
        let cell = match target.function { ValueBits.FunctionBytecode { reference } => reference _ => { continue } }
        if !unsafe inline.plainTarget(cell, bytecode) { continue }
        let callee = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, cell)
        if (unsafe callee.code.asSlice()).length > CANDIDATE_BYTES {
          if jit.options.dump && depth == 0 { run say(b"jit: no inline target: ", b"the function is too long") }
          continue
        }
        let mut input = run inputOf(&callee)
        let id = usize.toU32(cells.length())
        run cells.append(unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(cell))
        if depth < CANDIDATE_DEPTH { input.targets = run unsafe candidates(jit, cell, depth + 1, &mut cells) }
        run targets.append(CallTarget { pc: site.offset, id: id, input: move input, atCall: true })
      }
    }
  }
  let mut pc: usize = 0
  while pc < bytes.length && cells.length() < MAX_CANDIDATES {
    let opcode = bytes[pc]
    let size = u8.toUsize(op.opcodeInfo(opcode, true).size)
    if size == 0 || pc + size > bytes.length { break }
    if opcode == op.OP_get_field2 {
      if let Option<*mut HeapHeader>.Some { value: cell } = Pointer.nonNullMut<HeapHeader>(unsafe inline.methodTarget(rt, bytecode, usize.toU32(pc))) {
        let callee = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, cell)
        if (unsafe callee.code.asSlice()).length <= CANDIDATE_BYTES {
          let mut input = run inputOf(&callee)
          let id = usize.toU32(cells.length())
          run cells.append(unsafe Intrinsic.pointerRequalify<*mut HeapHeader, ?*mut HeapHeader>(cell))
          if depth < CANDIDATE_DEPTH { input.targets = run unsafe candidates(jit, cell, depth + 1, &mut cells) }
          run targets.append(CallTarget { pc: usize.toU32(pc), id: id, input: move input, atCall: false })
        } else if jit.options.dump && depth == 0 { run say(b"jit: no inline target: ", b"the method is too long") }
      } else if jit.options.dump && depth == 0 {
        let why = unsafe inline.methodMiss(rt, bytecode, usize.toU32(pc))
        let mut text: &'static [u8] = b"the slot holds no plain bytecode closure"
        if why == 1 { text = b"the site cache entry is another site's" }
        else if why == 2 { text = b"the site cache entry is not a prototype hit" }
        else if why == 3 { text = b"the site cache entry is stale" }
        else if why == 4 { text = b"no holder" }
        else if why == 6 { text = b"another realm's function" }
        run say(b"jit: no inline target: ", text)
      }
    }
    pc = pc + size
  }
  return move targets
}

/// Links code for the address it will run at, with symbols for its relocations, and
/// publishes it.
effect fn publish(memory: &mut CodeMemory, code: &mut Code, symbols: &[usize]) -> CodeBlock ! MemoryError | LinkError {
  let mut writer = run memory.allocate(code.bytes.length())
  run code.link(writer.address(), symbols)
  run writer.append(code.bytes.asSlice())
  return run writer.finish()
}
effect fn sayRefusal(reason: &Refusal) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut line = List<u8>.make()
  run line.appendSlice(b"jit: refused: ") run line.appendSlice(reason.text())
  if reason.hasOpcode { run line.appendSlice(b": ") run line.appendSlice(op.opcodeName(reason.opcode, true)) }
  run line.append(10)
  io.stderr(line.asSlice())
}
/// --jit-dump: one compilation's phase times and sizes.
effect fn dumpCost(prefix: &[u8], cost: &Cost) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut line = List<u8>.make()
  run line.appendSlice(prefix)
  run line.appendSlice(b" bytes ") run decimal(&mut line, cost.bytecodeBytes)
  run line.appendSlice(b" ssa ") run decimal(&mut line, cost.translated)
  run line.appendSlice(b" optimized ") run decimal(&mut line, cost.optimized)
  run line.appendSlice(b" translate-ns ") run decimal(&mut line, cost.translate)
  run line.appendSlice(b" optimize-ns ") run decimal(&mut line, cost.optimize)
  run line.appendSlice(b" verify-ns ") run decimal(&mut line, cost.verify)
  run line.appendSlice(b" backend-ns ") run decimal(&mut line, cost.backend)
  run line.append(10)
  io.stderr(line.asSlice())
}
effect fn say(prefix: &[u8], text: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut line = List<u8>.make()
  run line.appendSlice(prefix) run line.appendSlice(text) run line.append(10)
  io.stderr(line.asSlice())
}

/// --jit-dump: the machine code before linking, as hex (`llvm-mc --disassemble` reads it).
effect fn dumpMachine(code: &Code) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut line = List<u8>.make()
  run line.appendSlice(b"jit: machine")
  let bytes = code.bytes.asSlice()
  let mut index: usize = 0
  while index < bytes.length { run line.appendSlice(b" 0x") run hex(&mut line, bytes[index]) index = index + 1 }
  run line.append(10)
  io.stderr(line.asSlice())
}

/// --jit-dump: the opcodes at the sites a recompiled function deoptimized at so far (refused:
/// it is refused now, for deoptimizing again there or recompiling too often).
unsafe effect fn dumpSites(function: &FunctionBytecode, sites: &[u32], kinds: &[u8], fresh: usize, refused: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  let bytes = unsafe function.code.asSlice()
  let mut index: usize = fresh
  while index < sites.length {
    let pc = u32.toUsize(sites[index])
    if pc < bytes.length {
      if refused { run say(b"jit: refused after deoptimizing at: ", op.opcodeName(bytes[pc], true)) }
      else { run say(b"jit: deoptimized at: ", op.opcodeName(bytes[pc], true)) }
      // `jit: deopt operands: <opcode> <decisive>/<next>`, the kinds this compilation met there.
      if index < kinds.length && kinds[index] != 0 {
        let mut line = List<u8>.make()
        run line.appendSlice(b"jit: deopt operands: ") run line.appendSlice(op.opcodeName(bytes[pc], true))
        run line.append(32) run line.appendSlice(kindName(kinds[index] & 15))
        run line.append(47) run line.appendSlice(kindName(kinds[index] / 16))
        run line.append(10)
        io.stderr(line.asSlice())
      }
    }
    index = index + 1
  }
}
/// js_compiled.KIND_* by number.
fn kindName(kind: u8) -> &'static [u8] {
  if kind == 1 { return b"int" } if kind == 2 { return b"float64" } if kind == 3 { return b"bool" }
  if kind == 4 { return b"undefined" } if kind == 5 { return b"null" } if kind == 6 { return b"string" }
  if kind == 7 { return b"symbol-or-bigint" } if kind == 8 { return b"local-function" } if kind == 9 { return b"object" }
  if kind == 10 { return b"array" } if kind == 11 { return b"linked-function" } if kind == 12 { return b"bytecode-function" }
  if kind == 13 { return b"native-function" } if kind == 14 { return b"bound-function" } if kind == 15 { return b"other" }
  return b"-"
}
/// What the recording saw at each offset of sites from fresh on: `jit: seen <opcode> count N
/// left L right R flags F shapes S targets T` (js_feedback.Site).
unsafe effect fn dumpSeen(rt: *mut HeapHeader, bytecode: *mut HeapHeader, function: &FunctionBytecode, sites: &[u32], fresh: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let seen = match run unsafe feedback.snapshot(rt, bytecode) {
    Option<feedback.Snapshot>.Some { value } => move value
    Option<feedback.Snapshot>.None => { return () }
  }
  let bytes = unsafe function.code.asSlice()
  let mut index: usize = fresh
  while index < sites.length {
    let mut k: usize = 0
    let mut found = false
    while k < seen.sites.length() {
      let site = seen.sites.get(k)
      if site.offset == sites[index] {
        found = true
        let mut line = List<u8>.make()
        run line.appendSlice(b"jit: seen ") run line.appendSlice(op.opcodeName(site.opcode, true))
        run line.appendSlice(b" count ") run decimal(&mut line, u32.toU64(site.count))
        run line.appendSlice(b" left ") run decimal(&mut line, u8.toU64(site.left))
        run line.appendSlice(b" right ") run decimal(&mut line, u8.toU64(site.right))
        run line.appendSlice(b" flags ") run decimal(&mut line, u8.toU64(site.flags))
        run line.appendSlice(b" shapes ") run decimal(&mut line, u8.toU64(site.shapeCount))
        run line.appendSlice(b" targets ") run decimal(&mut line, u8.toU64(site.targets))
        run line.append(10)
        io.stderr(line.asSlice())
      }
      k = k + 1
    }
    if !found && u32.toUsize(sites[index]) < bytes.length { run say(b"jit: unseen ", op.opcodeName(bytes[u32.toUsize(sites[index])], true)) }
    index = index + 1
  }
}
unsafe effect fn dumpBytecode(function: &FunctionBytecode) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut line = List<u8>.make()
  run line.appendSlice(b"jit: hot args ") run decimal(&mut line, u16.toU64(function.argumentCount))
  run line.appendSlice(b" locals ") run decimal(&mut line, u16.toU64(function.variableCount))
  run line.appendSlice(b" stack ") run decimal(&mut line, u16.toU64(function.stackSize))
  run line.appendSlice(b" refs ") run decimal(&mut line, u16.toU64(function.varRefCount))
  run line.appendSlice(b" scope ") run decimal(&mut line, u16.toU64(function.scopeSlots))
  run line.appendSlice(b" mode ") run decimal(&mut line, u8.toU64(function.mode))
  run line.appendSlice(b" constants ") run decimal(&mut line, usize.toU64(function.constants.length()))
  run line.appendSlice(b" code")
  let bytes = unsafe function.code.asSlice()
  let mut index: usize = 0
  while index < bytes.length { run line.append(32) run hex(&mut line, bytes[index]) index = index + 1 }
  run line.append(10)
  io.stderr(line.asSlice())
}
