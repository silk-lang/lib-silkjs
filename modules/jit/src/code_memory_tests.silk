import code_memory { CodeMemory, MemoryError }
import silk.mem.pointer { Pointer }
import silk.testing.testing { Testing, AssertionError }

test effect fn generatedConstantUsesDirectCFunctionPointer() -> () ! MemoryError | AssertionError<'static> {
  let mut memory = run CodeMemory.reserve(65536)
  let mut writer = run memory.allocate(16)
  run writer.append(b"\x48\xb8\x2a\x00\x00\x00\x00\x00\x00\x00\xc3")
  let block = run writer.finish()
  let address = block.entry()
  let slot = unsafe Intrinsic.pointerReinterpret<*const *const u8, *const extern "C" fn() -> u64>(Pointer.fromRef(&address))
  let function = unsafe Pointer.read<extern "C" fn() -> u64>(slot)
  run Testing.expect(unsafe function() == 42, "Silk calls an RX buffer directly")
}
