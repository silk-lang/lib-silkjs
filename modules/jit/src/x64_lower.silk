//! From a hot FunctionBytecode to machine code for the compiled-entry ABI
//! (docs/jit/compiled-entry.md): bytecode -> SSA (ssa_translate, ssa_ownership, ssa_verify;
//! docs/jit/ssa.md) -> x64_backend. A function the translator, the verifier or the backend
//! does not take is refused with its reason.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silkjs.js_core_types { FunctionBytecode }
import asm_x64 { Code, UnboundLabelError }
import ssa { Function }
import ssa_input { inputOf }
import ssa_translate { translate, translateOsr, CallTarget, Refusal as TranslateRefusal }
import ssa_verify { verify, VerifyError }
import ssa_ownership
import ssa_calls as calls
import x64_backend { Lowering, Settings }
import x64_backend as backend
import silk.core.option { Option }
import value_layout { ValueLayout }
import value_layout as layouts

/// opcode is the bytecode the translator stopped at, or 0 with hasOpcode false (--jit-dump names it).
pub struct Refusal { pub why: &'static [u8], pub opcode: u8, pub hasOpcode: bool }
impl Refusal {
  pub fn text(self: &Self) -> &'static [u8] { return self.why }
}
/// Code and its call block size (js_core_types.CompiledEntry.callWords: 0 when it makes no
/// calls), or a refusal. inlined: the CallTarget.id of each inline target the code names, in
/// symbol order (Code.link's symbol 2k is target k's FunctionBytecode cell, 2k + 1 the first
/// byte of its code); empty when nothing was inlined.
pub union Lowered { Code { pub value: Code, pub callWords: u32, pub inlined: List<u32> }, Refused { pub reason: Refusal } }

/// Bodies shorter than this (in bytecode bytes: `return_undef`, a constant or an argument
/// returned) gain nothing compiled: entering compiled code costs more than the interpreter's
/// inline call that runs them.
const MIN_CODE_BYTES: usize = 3

pub unsafe effect fn lowerFunction(function: &FunctionBytecode, stress: u32, allowCalls: bool) -> Lowered ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let none = List<u32>.make()
  return run unsafe lowerEntry(function, stress, allowCalls, &none, NO_HEADER, List<CallTarget>.make())
}
/// lowerFunction with `doubleSites` (ssa_translate.FunctionInput.doubleSites) from earlier
/// compilations' deopts (jit_recompile).
pub unsafe effect fn lowerWithSites(function: &FunctionBytecode, stress: u32, allowCalls: bool, doubleSites: &List<u32>) -> Lowered ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  return run unsafe lowerEntry(function, stress, allowCalls, doubleSites, NO_HEADER, List<CallTarget>.make())
}
/// lowerWithSites that may inline the calls `targets` describes (docs/jit/inlining.md).
pub unsafe effect fn lowerInlining(function: &FunctionBytecode, stress: u32, allowCalls: bool, doubleSites: &List<u32>, targets: List<CallTarget>) -> Lowered ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  return run unsafe lowerEntry(function, stress, allowCalls, doubleSites, NO_HEADER, move targets)
}
/// lowerWithSites for an on-stack-replacement entry at loop header pc `header`
/// (ssa_translate.translateOsr). OSR code makes no calls: they are side exits there.
pub unsafe effect fn lowerOsr(function: &FunctionBytecode, stress: u32, doubleSites: &List<u32>, header: u32) -> Lowered ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  return run unsafe lowerEntry(function, stress, false, doubleSites, header, List<CallTarget>.make())
}
const NO_HEADER: u32 = 4294967295
unsafe effect fn lowerEntry(function: &FunctionBytecode, stress: u32, allowCalls: bool, doubleSites: &List<u32>, header: u32, targets: List<CallTarget>) -> Lowered ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  if header == NO_HEADER && (unsafe function.code.asSlice()).length < MIN_CODE_BYTES { return refused(b"a body too short to gain from compiling") }
  let mut input = run inputOf(function)
  run input.doubleSites.appendSlice(doubleSites.asSlice())
  input.targets = move targets
  let translated = if header == NO_HEADER { run Effect.result(translate(&input)) } else { run Effect.result(translateOsr(&input, header)) }
  let mut ssa = match move translated {
    Result<Function, TranslateRefusal | OutOfMemoryError>.Success { value } => move value
    Result<Function, TranslateRefusal | OutOfMemoryError>.Failure { error } => {
      match move error {
        TranslateRefusal { reason, opcode, .. } => { return Lowered.Refused { reason: Refusal { why: reason, opcode: opcode, hasOpcode: true } } }
        OutOfMemoryError { .. } => { fail OutOfMemoryError {} }
      }
    }
  }
  if !allowCalls && calls.makesCalls(&ssa) { return refused(b"a call (calls from compiled code need --jit-calls)") }
  run ssa_ownership.optimize(&mut ssa)
  match move run Effect.result(verify(&ssa)) {
    Result<(), VerifyError | OutOfMemoryError>.Success { .. } => ()
    Result<(), VerifyError | OutOfMemoryError>.Failure { error } => {
      match move error {
        VerifyError { reason, .. } => { return refused(reason) }
        OutOfMemoryError { .. } => { fail OutOfMemoryError {} }
      }
    }
  }
  let layout = match layouts.probe() {
    Option<ValueLayout>.Some { value } => value
    Option<ValueLayout>.None => { return refused(b"the engine's ValueBits layout is not one compiled code understands") }
  }
  match move run backend.lower(&ssa, Settings { stress: stress, layout: layout }) {
    Lowering.Code { value } => {
      let mut inlined = List<u32>.make()
      run inlined.appendSlice(ssa.inlineTargets.asSlice())
      return Lowered.Code { value: move value, callWords: calls.callWords(&ssa), inlined: move inlined }
    }
    Lowering.Unsupported { reason } => { return refused(reason.why) }
  }
}
fn refused(why: &'static [u8]) -> Lowered { return Lowered.Refused { reason: Refusal { why: why, opcode: 0, hasOpcode: false } } }
