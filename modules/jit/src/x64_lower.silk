//! From a hot FunctionBytecode to machine code for the compiled-entry ABI
//! (docs/jit/compiled-entry.md): bytecode -> SSA (ssa_translate, ssa_ownership, ssa_verify;
//! docs/jit/ssa.md) -> x64_backend. A function the translator, the verifier or the backend
//! does not take is refused with its reason.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silkjs.js_core_types { FunctionBytecode }
import asm_x64 { Code, UnboundLabelError }
import ssa { Function }
import ssa_input { inputOf }
import ssa_translate { translate, Refusal as TranslateRefusal }
import ssa_verify { verify, VerifyError }
import ssa_ownership
import x64_backend { Lowering, Settings }
import x64_backend as backend

/// opcode is the bytecode the translator stopped at, or 0 with hasOpcode false (--jit-dump names it).
pub struct Refusal { pub why: &'static [u8], pub opcode: u8, pub hasOpcode: bool }
impl Refusal {
  pub fn text(self: &Self) -> &'static [u8] { return self.why }
}
pub union Lowered { Code { pub value: Code }, Refused { pub reason: Refusal } }

pub unsafe effect fn lowerFunction(function: &FunctionBytecode, stress: u32) -> Lowered ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let input = run inputOf(function)
  let mut ssa = match move run Effect.result(translate(&input)) {
    Result<Function, TranslateRefusal | OutOfMemoryError>.Success { value } => move value
    Result<Function, TranslateRefusal | OutOfMemoryError>.Failure { error } => {
      match move error {
        TranslateRefusal { reason, opcode, .. } => { return Lowered.Refused { reason: Refusal { why: reason, opcode: opcode, hasOpcode: true } } }
        OutOfMemoryError { .. } => { fail OutOfMemoryError {} }
      }
    }
  }
  run ssa_ownership.optimize(&mut ssa)
  match move run Effect.result(verify(&ssa)) {
    Result<(), VerifyError | OutOfMemoryError>.Success { .. } => ()
    Result<(), VerifyError | OutOfMemoryError>.Failure { error } => {
      match move error {
        VerifyError { reason, .. } => { return refused(reason) }
        OutOfMemoryError { .. } => { fail OutOfMemoryError {} }
      }
    }
  }
  match move run backend.lower(&ssa, Settings { stress: stress }) {
    Lowering.Code { value } => { return Lowered.Code { value: move value } }
    Lowering.Unsupported { reason } => { return refused(reason.why) }
  }
}
fn refused(why: &'static [u8]) -> Lowered { return Lowered.Refused { reason: Refusal { why: why, opcode: 0, hasOpcode: false } } }
