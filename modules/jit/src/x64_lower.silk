//! From a hot FunctionBytecode to machine code for the compiled-entry ABI
//! (docs/jit/compiled-entry.md): bytecode -> SSA (ssa_translate, ssa_ownership, ssa_verify;
//! docs/jit/ssa.md) -> x64_backend. A function the translator, the verifier or the backend
//! does not take is refused with its reason.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silkjs.js_core_types { FunctionBytecode }
import asm_x64 { Code, UnboundLabelError }
import ssa { Function }
import ssa_input { inputOf }
import ssa_translate { translate, Refusal as TranslateRefusal }
import ssa_verify { verify, VerifyError }
import ssa_ownership
import ssa_calls as calls
import x64_backend { Lowering, Settings }
import x64_backend as backend
import silk.core.option { Option }
import value_layout { ValueLayout }
import value_layout as layouts

pub struct Refusal { pub why: &'static [u8] }
impl Refusal {
  pub fn text(self: &Self) -> &'static [u8] { return self.why }
}
/// Code and its call block size (js_core_types.CompiledEntry.callWords: 0 when it makes no
/// calls), or a refusal.
pub union Lowered { Code { pub value: Code, pub callWords: u32 }, Refused { pub reason: Refusal } }

/// Bodies shorter than this (in bytecode bytes: `return_undef`, a constant or an argument
/// returned) gain nothing compiled: entering compiled code costs more than the interpreter's
/// inline call that runs them.
const MIN_CODE_BYTES: usize = 3

pub unsafe effect fn lowerFunction(function: &FunctionBytecode, stress: u32, allowCalls: bool) -> Lowered ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  if (unsafe function.code.asSlice()).length < MIN_CODE_BYTES { return refused(b"a body too short to gain from compiling") }
  let input = run inputOf(function)
  let mut ssa = match move run Effect.result(translate(&input)) {
    Result<Function, TranslateRefusal | OutOfMemoryError>.Success { value } => move value
    Result<Function, TranslateRefusal | OutOfMemoryError>.Failure { error } => {
      match move error {
        TranslateRefusal { reason, .. } => { return refused(reason) }
        OutOfMemoryError { .. } => { fail OutOfMemoryError {} }
      }
    }
  }
  if !allowCalls && calls.makesCalls(&ssa) { return refused(b"a call (calls from compiled code need --jit-calls)") }
  run ssa_ownership.optimize(&mut ssa)
  match move run Effect.result(verify(&ssa)) {
    Result<(), VerifyError | OutOfMemoryError>.Success { .. } => ()
    Result<(), VerifyError | OutOfMemoryError>.Failure { error } => {
      match move error {
        VerifyError { reason, .. } => { return refused(reason) }
        OutOfMemoryError { .. } => { fail OutOfMemoryError {} }
      }
    }
  }
  let layout = match layouts.probe() {
    Option<ValueLayout>.Some { value } => value
    Option<ValueLayout>.None => { return refused(b"the engine's ValueBits layout is not one compiled code understands") }
  }
  match move run backend.lower(&ssa, Settings { stress: stress, layout: layout }) {
    Lowering.Code { value } => { return Lowered.Code { value: move value, callWords: calls.callWords(&ssa) } }
    Lowering.Unsupported { reason } => { return refused(reason.why) }
  }
}
fn refused(why: &'static [u8]) -> Lowered { return Lowered.Refused { reason: Refusal { why: why } } }
