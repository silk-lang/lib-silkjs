//! Lowering of a function to x86-64 for the compiled-entry ABI
//! (docs/jit/compiled-entry.md). Placeholder: refuses everything.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silkjs.js_core_types { FunctionBytecode }
import asm_x64 { Code }

pub struct Refusal { pub why: &'static [u8] }
impl Refusal {
  pub fn text(self: &Self) -> &'static [u8] { return self.why }
}
pub union Lowered { Code { pub value: Code }, Refused { pub reason: Refusal } }

pub effect fn lowerFunction(function: &FunctionBytecode, stress: bool) -> Lowered ! OutOfMemoryError ? &mut Allocator {
  return Lowered.Refused { reason: Refusal { why: b"not implemented" } }
}
