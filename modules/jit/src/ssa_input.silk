//! The translator's input read from an engine function: plain numbers and a copy of the code.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u16
import silkjs.js_core_types { FunctionBytecode, FunctionKind }
import silk.num.f64
import silk.num.i32
import silk.num.u32
import silk.num.usize
import silkjs.js_value { ValueBits }
import ssa_translate { FunctionInput, NumberConstant, CONSTANT_OTHER, CONSTANT_INT, CONSTANT_DOUBLE }

/// What `ssa_translate.translate` needs from `bytecode`. The caller keeps the function alive
/// for the call; the result owns its copy of the code.
pub effect fn inputOf(bytecode: &FunctionBytecode) -> FunctionInput ! OutOfMemoryError ? &mut Allocator {
  let mut code = List<u8>.make()
  run code.appendSlice(unsafe bytecode.code.asSlice())
  let mut numbers = List<NumberConstant>.make()
  let mut index: usize = 0
  while index < bytecode.constants.length() {
    let constant = match bytecode.constants.get(index) {
      ValueBits.Int { value } => NumberConstant { kind: CONSTANT_INT, bits: u32.toU64(i32.wrappingToU32(value)) }
      ValueBits.Float64 { value } => NumberConstant { kind: CONSTANT_DOUBLE, bits: f64.toBits(value) }
      _ => NumberConstant { kind: CONSTANT_OTHER, bits: 0 }
    }
    run numbers.append(constant)
    index = index + 1
  }
  return FunctionInput { code: move code, argumentCount: u16.toU32(bytecode.argumentCount), localCount: u16.toU32(bytecode.variableCount),
    closureVars: u16.toU32(bytecode.varRefCount), scopeSlots: u16.toU32(bytecode.scopeSlots), normal: bytecode.kind == FunctionKind.Normal,
    numberConstants: move numbers, doubleSites: List<u32>.make() }
}
