//! The translator's input read from an engine function: plain numbers and a copy of the code.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u16
import silkjs.js_core_types { FunctionBytecode, FunctionKind }
import ssa_translate { FunctionInput }

/// What `ssa_translate.translate` needs from `bytecode`. The caller keeps the function alive
/// for the call; the result owns its copy of the code.
pub effect fn inputOf(bytecode: &FunctionBytecode) -> FunctionInput ! OutOfMemoryError ? &mut Allocator {
  let mut code = List<u8>.make()
  run code.appendSlice(unsafe bytecode.code.asSlice())
  return FunctionInput { code: move code, argumentCount: u16.toU32(bytecode.argumentCount), localCount: u16.toU32(bytecode.variableCount),
    closureVars: u16.toU32(bytecode.varRefCount), scopeSlots: u16.toU32(bytecode.scopeSlots), normal: bytecode.kind == FunctionKind.Normal }
}
