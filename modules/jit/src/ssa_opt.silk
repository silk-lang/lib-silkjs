//! The optimization pipeline between the translator and the verifier: the ownership pass
//! (ssa_ownership.optimize), then the code quality passes (docs/jit/code-quality.md), one
//! file each (ssa_opt_*.silk) and one switch each, so a wrong answer or a slowdown can be
//! pinned on a pass by turning it off (`--jit-no-<pass>`).
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import ssa { Function }
import ssa_ownership
import ssa_opt_borrow as borrow
import ssa_opt_hoist as hoisting
import silk.collections.list { List }

/// `--jit-no-borrow` clears it: element, length and variable reads that borrow (ssa_opt_borrow).
pub const PASS_BORROW: u32 = 1
/// `--jit-no-hoist` clears it: loop-invariant guards and loads in front of their loop
/// (ssa_opt_hoist).
pub const PASS_HOIST: u32 = 2
pub const PASS_ALL: u32 = 3
/// Loop levels one function's instructions move out through.
const HOIST_ROUNDS: u32 = 2

/// Runs the ownership pass and every pass `passes` names over a translated function. The
/// result is compacted and holds the verifier's rules. `sites` are the offsets the function's
/// earlier code deoptimized at (jit_recompile).
pub effect fn pipeline(f: &mut Function, passes: u32, sites: &List<u32>) -> () ! OutOfMemoryError ? &mut Allocator {
  run ssa_ownership.optimize(&mut f)
  if u32.bitAnd(passes, PASS_BORROW) != 0 { if run borrow.borrowReads(&mut f) { run f.compact() } }
  if u32.bitAnd(passes, PASS_HOIST) != 0 {
    let mut round: u32 = 0
    while round < HOIST_ROUNDS && run hoisting.hoist(&mut f, sites) { run f.compact() round = round + 1 }
  }
}
