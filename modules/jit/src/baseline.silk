//! The baseline compiler (docs/jit/baseline.md): one x86-64 template per bytecode instruction,
//! on a frame the interpreter can take over at any instruction boundary.
//!
//! Frame. The code runs on the native stack, addressed from rbp:
//!   [rbp + 8]              return address
//!   [rbp]                  the caller's rbp
//!   [rbp - R, rbp)         the BaselineFrame record (js_baseline); its last word is the state
//!   below it               the cells [arguments][locals][operand stack], ascending
//! A frame starts bare: the prologue stores the function, the receiver, the arguments and
//! the bytecode's address, and nothing else of the record's StackFrame. The engine completes
//! and publishes the bare frames (js_baseline.build) whenever the code asks it for anything,
//! so whatever reads the frame chain finds every frame; the code unlinks a built frame when
//! it returns.
//! Every value lives in its cell, as the interpreter keeps it: an instruction reads its
//! operands from their cells into scratch registers and writes its result back. What the
//! templates do not cover leaves through the engine's service (SERVICE_FINISH): the
//! interpreter finishes the activation from that instruction on the same cells.
//!
//! Registers. r12 is the BaselineEnv and r13 the runtime, pinned over the whole run of
//! baseline code (the entry stub loads them). rbp is the frame. Everything else is scratch;
//! rbx, r14 and r15 are never touched.
//!
//! Calls into baseline code (the entry stub and call templates):
//!   rdi function (the closure object's cell), r11 its bytecode object, rsi argv, rdx argc,
//!   rcx:r8 `this` (tag word, payload). The result returns in rax (tag word) : rdx (payload); the Exception tag means
//!   the call threw and the exception is pending in the runtime.
//!
//! The code holds no address: helpers are reached through the environment, the engine's
//! service through the runtime, bytecode through the frame record.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.num.i32
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import asm_x64 { Alu, Assembler, Code, Cond, Label, Mem, PackedOp, Reg, Scale, ScalarOp, Shift, Unary, UnboundLabelError, Width, Xmm }
import value_layout { ValueLayout }
import value_layout as values
import baseline_env as env
import silkjs.js_baseline { BaselineLayout, Shape }
import silkjs.js_baseline as engine
import silkjs.js_compiled_objects { FieldLayout }
import silkjs.js_compiled_objects as objects
import silkjs.js_opcode_data as op
import silkjs.js_atom_data as atoms

/// What the code is compiled against: facts of one engine build.
pub struct Settings {
  pub layout: ValueLayout,
  pub frame: BaselineLayout,
  pub fields: FieldLayout,
  /// The code counts its direct calls in the environment (--jit-stats).
  pub count: bool
}
impl Copy for Settings {}

/// The settings of this engine build, or None when its value layout is not the one the
/// templates assume: a one-byte tag at offset 0 with small values, the payload in the
/// second word.
pub fn probe(count: bool) -> Option<Settings> {
  let layout = match values.probe() { Option<ValueLayout>.Some { value } => value Option<ValueLayout>.None => { return Option<Settings>.none() } }
  if layout.tagOffset != 0 || layout.tagWidth != 1 || layout.payloadOffset != 8 || layout.size != 16 { return Option<Settings>.none() }
  let mut t: usize = 0
  while t < values.TAG_COUNT {
    if layout.tags[t] != u32.MAX && layout.tags[t] > 127 { return Option<Settings>.none() }
    t = t + 1
  }
  if layout.tagOf(6) == u32.MAX { return Option<Settings>.none() }
  let frame = engine.layout()
  if (frame.frameBytes & 7) != 0 { return Option<Settings>.none() }
  // The entry stub keeps two zero words under its frame pointer where a record's state
  // would be (js_baseline.FRAME_STOP).
  let record = (frame.frameBytes + 15) / 16 * 16
  if frame.state + 16 < record || frame.state + 8 > record { return Option<Settings>.none() }
  return Option<Settings>.some(Settings { layout: layout, frame: frame, fields: objects.fieldLayout(), count: count })
}

/// What compile made of a function.
pub struct Outcome {
  /// The code, or None when the function is refused (why says why).
  pub code: Option<Code>,
  pub why: &'static [u8],
  /// The opcodes of reachable instructions that have no template: each leaves to the
  /// interpreter when it runs.
  pub uncovered: List<u8>,
  /// The opcodes of reachable instructions the engine runs one at a time (SERVICE_STEP).
  pub stepped: List<u8>,
  /// Where the code's parts start, for profiles: (code offset, bytecode offset, what) triples
  /// in code order; what is an instruction's opcode or a MARK_*.
  pub map: List<u32>,
  /// The construct entry's offset in the code.
  pub construct: u32
}
pub const MARK_PROLOGUE: u32 = 0x1000
pub const MARK_LEAVE: u32 = 0x1001
pub const MARK_FINISH: u32 = 0x1002
pub const MARK_OVERFLOW: u32 = 0x1003
pub const MARK_EXIT: u32 = 0x1004
/// The construct entry (js_baseline.link).
pub const MARK_CONSTRUCT: u32 = 0x1005
/// The resume table: one word a bytecode byte, zero or, for an instruction the code can be
/// entered at, the distance from its code up to the table in bits 0 to 23 and the operands
/// on the stack there above them.
pub const MARK_TABLE: u32 = 0x1006
/// The resume entry (js_baseline.resumeOf), when the function has one.
pub const MARK_RESUME: u32 = 0x1007
/// MARK_SLOW + a slow path's kind.
pub const MARK_SLOW: u32 = 0x1100

// ---- Bytecode steps -------------------------------------------------------------------

const FALL: u8 = 0
const BRANCH: u8 = 1
const JUMP: u8 = 2
const END: u8 = 3
const DEPART: u8 = 4
/// No template: the engine runs the instruction on the frame's cells (SERVICE_STEP) and the
/// code goes on after it.
const STEP: u8 = 5
/// An instruction the interpreter runs alone that never falls into the next one (a throw, a
/// jump the compiler does not follow): the code goes on wherever the frame is afterwards.
const LEAP: u8 = 6
/// A step request's next instruction that no frame is ever at.
const NOWHERE: u32 = 0xffffff

/// One instruction's shape: its bytes, how control leaves it, the operands it needs and how
/// the operand stack's depth changes along its fallthrough and its taken branch.
struct Step { size: usize, kind: u8, target: usize, needs: i32, fall: i32, taken: i32 }
impl Copy for Step {}

fn i8At(bytes: &[u8], at: usize) -> i32 {
  let b = u8.toI32(bytes[at])
  if b >= 128 { return b - 256 }
  return b
}
fn u16At(bytes: &[u8], at: usize) -> u32 { return u8.toU32(bytes[at]) | u32.shiftLeft(u8.toU32(bytes[at + 1]), 8) }
fn i16At(bytes: &[u8], at: usize) -> i32 {
  let v = u32.wrappingToI32(u16At(bytes, at))
  if v >= 32768 { return v - 65536 }
  return v
}
fn u32At(bytes: &[u8], at: usize) -> u32 { return u16At(bytes, at) | u32.shiftLeft(u16At(bytes, at + 2), 16) }
fn i32At(bytes: &[u8], at: usize) -> i32 { return u32.wrappingToI32(u32At(bytes, at)) }
/// pc + offset + displacement as an instruction offset, or usize.MAX when it is outside.
fn targetOf(pc: usize, offset: usize, displacement: i32, length: usize) -> usize {
  let at = usize.toU32(pc + offset)
  let moved = i32.wrappingAdd(u32.wrappingToI32(at), displacement)
  if moved < 0 { return usize.MAX }
  let target = u32.toUsize(i32.wrappingToU32(moved))
  if target >= length { return usize.MAX }
  return target
}
fn plain(size: usize, needs: i32, delta: i32) -> Step { return Step { size: size, kind: FALL, target: 0, needs: needs, fall: delta, taken: 0 } }
fn steps(size: usize, needs: i32, delta: i32) -> Step { return Step { size: size, kind: STEP, target: usize.MAX, needs: needs, fall: delta, taken: 0 } }
/// The step of an instruction without a template: one the interpreter runs alone and then
/// falls out of, with the operand counts of the opcode table, or a departure.
fn untemplated(bytes: &[u8], pc: usize, opcode: u8, size: usize) -> Step {
  let info = op.opcodeInfo(opcode, true)
  let format = info.format
  // catch pushes its handler's place and falls into the protected code. An exception leaves
  // through the engine, which unwinds to the handler: the code goes on there, with the
  // exception where the handler's place was.
  if opcode == op.OP_catch {
    if size != 5 { return departs(size) }
    return Step { size: 5, kind: STEP, target: targetOf(pc, 1, i32At(bytes, pc + 1), bytes.length), needs: 0, fall: 1, taken: 1 }
  }
  if opcode == op.OP_throw || opcode == op.OP_throw_error { return Step { size: size, kind: LEAP, target: usize.MAX, needs: u8.toI32(info.pops), fall: 0, taken: 0 } }
  if format == op.OP_FMT_label8 || format == op.OP_FMT_label16 || format == op.OP_FMT_label || format == op.OP_FMT_atom_label_u8
    || format == op.OP_FMT_atom_label_u16 || format == op.OP_FMT_label_u16 {
    if opcode == op.OP_gosub { return departs(size) }
    return Step { size: size, kind: LEAP, target: usize.MAX, needs: u8.toI32(info.pops), fall: 0, taken: 0 }
  }
  if opcode == op.OP_array_from {
    if size != 3 { return departs(size) }
    let argc = u32.wrappingToI32(u16At(bytes, pc + 1))
    return steps(3, argc, 1 - argc)
  }
  if format == op.OP_FMT_npop || format == op.OP_FMT_npopx || format == op.OP_FMT_npop_u16 { return departs(size) }
  // What never falls through, suspends the frame, or reads the frame as a whole.
  if opcode == op.OP_invalid || opcode == op.OP_extended || opcode == op.OP_return || opcode == op.OP_return_undef || opcode == op.OP_return_async
    || opcode == op.OP_tail_call || opcode == op.OP_tail_call_method || opcode == op.OP_throw || opcode == op.OP_throw_error
    || opcode == op.OP_ret || opcode == op.OP_eval || opcode == op.OP_apply_eval || opcode == op.OP_import
    || opcode == op.OP_initial_yield || opcode == op.OP_yield || opcode == op.OP_yield_star || opcode == op.OP_async_yield_star || opcode == op.OP_await
    || opcode == op.OP_using_dispose || opcode == op.OP_using_dispose_async || opcode == op.OP_using_check
    || opcode == op.OP_for_await_of_start || opcode == op.OP_for_await_of_next { return departs(size) }
  let mut total = size
  // A closure's creation takes the set_name after it (js_vm_factories.pushClosure).
  if (opcode == op.OP_fclosure || opcode == op.OP_fclosure8) && pc + size + 5 <= bytes.length && bytes[pc + size] == op.OP_set_name { total = size + 5 }
  let pops = u8.toI32(info.pops)
  return steps(total, pops, u8.toI32(info.pushes) - pops)
}
fn departs(size: usize) -> Step { return Step { size: size, kind: DEPART, target: 0, needs: 0, fall: 0, taken: 0 } }
fn branches(size: usize, kind: u8, target: usize, needs: i32, fall: i32, taken: i32) -> Step {
  return Step { size: size, kind: kind, target: target, needs: needs, fall: fall, taken: taken }
}

/// The step of the instruction at pc; size 0 for bytes that are not an instruction the
/// compiler can size.
fn stepOf(bytes: &[u8], pc: usize) -> Step {
  let opcode = bytes[pc]
  let size = u8.toUsize(op.opcodeInfo(opcode, true).size)
  if size == 0 || pc + size > bytes.length { return departs(0) }
  let n = bytes.length
  if opcode == op.OP_push_this || (opcode >= op.OP_get_loc0 && opcode <= op.OP_get_loc3) || (opcode >= op.OP_get_arg0 && opcode <= op.OP_get_arg3)
    || opcode == op.OP_push_0 || opcode == op.OP_push_1 || opcode == op.OP_undefined || opcode == op.OP_null
    || opcode == op.OP_push_false || opcode == op.OP_push_true || opcode == op.OP_push_empty_string {
    if size != 1 { return departs(size) }
    return plain(1, 0, 1)
  }
  if opcode == op.OP_get_loc8 || opcode == op.OP_push_i8 { if size != 2 { return departs(size) } return plain(2, 0, 1) }
  if opcode == op.OP_get_loc || opcode == op.OP_get_arg || opcode == op.OP_push_i16 || opcode == op.OP_get_var { if size != 3 { return departs(size) } return plain(3, 0, 1) }
  if opcode == op.OP_push_i32 { if size != 5 { return departs(size) } return plain(5, 0, 1) }
  if opcode >= op.OP_put_loc0 && opcode <= op.OP_put_loc3 { if size != 1 { return departs(size) } return plain(1, 1, -1) }
  if opcode == op.OP_put_loc8 { if size != 2 { return departs(size) } return plain(2, 1, -1) }
  if opcode == op.OP_put_loc { if size != 3 { return departs(size) } return plain(3, 1, -1) }
  if opcode == op.OP_set_loc8 { if size != 2 { return departs(size) } return plain(2, 1, 0) }
  if opcode == op.OP_set_loc { if size != 3 { return departs(size) } return plain(3, 1, 0) }
  if opcode == op.OP_drop { if size != 1 { return departs(size) } return plain(1, 1, -1) }
  if opcode == op.OP_dup { if size != 1 { return departs(size) } return plain(1, 1, 1) }
  if opcode == op.OP_nop { if size != 1 { return departs(size) } return plain(1, 0, 0) }
  if opcode == op.OP_return { if size != 1 { return departs(size) } return branches(1, END, 0, 1, 0, 0) }
  if opcode == op.OP_return_undef { if size != 1 { return departs(size) } return branches(1, END, 0, 0, 0, 0) }
  if opcode == op.OP_if_false8 || opcode == op.OP_if_true8 {
    if size != 2 { return departs(size) }
    return branches(2, BRANCH, targetOf(pc, 1, i8At(bytes, pc + 1), n), 1, -1, -1)
  }
  if opcode == op.OP_if_false || opcode == op.OP_if_true {
    if size != 5 { return departs(size) }
    return branches(5, BRANCH, targetOf(pc, 1, i32At(bytes, pc + 1), n), 1, -1, -1)
  }
  if opcode == op.OP_goto8 { if size != 2 { return departs(size) } return branches(2, JUMP, targetOf(pc, 1, i8At(bytes, pc + 1), n), 0, 0, 0) }
  if opcode == op.OP_goto16 { if size != 3 { return departs(size) } return branches(3, JUMP, targetOf(pc, 1, i16At(bytes, pc + 1), n), 0, 0, 0) }
  if opcode == op.OP_goto { if size != 5 { return departs(size) } return branches(5, JUMP, targetOf(pc, 1, i32At(bytes, pc + 1), n), 0, 0, 0) }
  if opcode == op.OP_if_nullish8 || opcode == op.OP_if_not_nullish8 || opcode == op.OP_if_null8 || opcode == op.OP_if_not_null8 {
    if size != 3 { return departs(size) }
    return branches(3, BRANCH, targetOf(pc, 2, i8At(bytes, pc + 2), n), 1, -1, -1)
  }
  if opcode == op.OP_if_true_keep8 || opcode == op.OP_if_false_keep8 {
    if size != 4 { return departs(size) }
    return branches(4, BRANCH, targetOf(pc, 2, i8At(bytes, pc + 2), n), 1, -1, 0)
  }
  if opcode == op.OP_is_undefined_or_null || opcode == op.OP_inc || opcode == op.OP_dec || opcode == op.OP_lnot || opcode == op.OP_get_length {
    if size != 1 { return departs(size) }
    return plain(1, 1, 0)
  }
  if opcode == op.OP_insert2 { if size != 1 { return departs(size) } return plain(1, 2, 1) }
  if opcode == op.OP_push_atom_value { if size != 5 { return departs(size) } return plain(5, 0, 1) }
  if opcode == op.OP_inc_loc || opcode == op.OP_dec_loc { if size != 2 { return departs(size) } return plain(2, 0, 0) }
  if opcode == op.OP_add_imm || opcode == op.OP_and_imm || opcode == op.OP_sar_imm { if size != 3 { return departs(size) } return plain(3, 1, 0) }
  if opcode == op.OP_get_loc_field8 || opcode == op.OP_get_arg_field8 { if size != 14 { return departs(size) } return plain(14, 0, 1) }
  if opcode == op.OP_get_field { if size != 13 { return departs(size) } return plain(13, 1, 0) }
  if opcode == op.OP_get_field2 { if size != 5 { return departs(size) } return plain(5, 1, 1) }
  if opcode == op.OP_put_field { if size != 13 { return departs(size) } return plain(13, 2, -2) }
  if opcode == op.OP_get_array_el { if size != 1 { return departs(size) } return plain(1, 2, -1) }
  if opcode == op.OP_put_array_el { if size != 1 { return departs(size) } return plain(1, 3, -3) }
  if opcode == op.OP_put_loc_field_loc8 || opcode == op.OP_put_loc_field_arg8 { if size != 15 { return departs(size) } return plain(15, 0, 0) }
  if opcode == op.OP_call_method {
    if size != 3 { return departs(size) }
    let argc = u32.wrappingToI32(u16At(bytes, pc + 1))
    return plain(3, argc + 2, 0 - (argc + 1))
  }
  if opcode == op.OP_call {
    if size != 3 { return departs(size) }
    let argc = u32.wrappingToI32(u16At(bytes, pc + 1))
    return plain(3, argc + 1, 0 - argc)
  }
  if opcode == op.OP_call_constructor {
    if size != 3 { return departs(size) }
    let argc = u32.wrappingToI32(u16At(bytes, pc + 1))
    return plain(3, argc + 2, 0 - (argc + 1))
  }
  if opcode >= op.OP_call0 && opcode <= op.OP_call3 {
    if size != 1 { return departs(size) }
    let argc = u8.toI32(opcode - op.OP_call0)
    return plain(1, argc + 1, 0 - argc)
  }
  if opcode == op.OP_eq || opcode == op.OP_neq || opcode == op.OP_strict_eq || opcode == op.OP_strict_neq
    || opcode == op.OP_lt || opcode == op.OP_lte || opcode == op.OP_gt || opcode == op.OP_gte
    || opcode == op.OP_add || opcode == op.OP_sub || opcode == op.OP_and || opcode == op.OP_or || opcode == op.OP_xor
    || opcode == op.OP_mul || opcode == op.OP_div || opcode == op.OP_mod {
    if size != 1 { return departs(size) }
    return plain(1, 2, -1)
  }
  if opcode == op.OP_fuse_prefix { if size != 5 { return departs(size) } return plain(5, 0, 0) }
  if opcode == op.OP_object || opcode == op.OP_instanceof || opcode == op.OP_typeof_is_undefined || opcode == op.OP_typeof_is_function {
    if size != 1 { return departs(size) }
    if opcode == op.OP_object { return plain(1, 0, 1) }
    if opcode == op.OP_instanceof { return plain(1, 2, -1) }
    return plain(1, 1, 0)
  }
  if opcode == op.OP_typeof_is { if size != 2 { return departs(size) } return plain(2, 1, 0) }
  if opcode == op.OP_define_field { if size != 5 { return departs(size) } return plain(5, 2, -1) }
  if opcode == op.OP_array_from && size == 3 {
    let argc = u32.wrappingToI32(u16At(bytes, pc + 1))
    if argc <= 16 { return plain(3, argc, 1 - argc) }
  }
  if opcode == op.OP_add_loc_loc8 || opcode == op.OP_sub_loc_loc8 || opcode == op.OP_mul_loc_loc8
    || opcode == op.OP_step_loc8 || opcode == op.OP_step_arg8
    || opcode == op.OP_get_loc_el8 || opcode == op.OP_get_arg_el8 || opcode == op.OP_get_loc_el_arg8 || opcode == op.OP_get_arg_el_arg8
    || opcode == op.OP_get_scope0 {
    if size != 3 { return departs(size) }
    return plain(3, 0, 1)
  }
  if opcode == op.OP_add_top_loc8 || opcode == op.OP_sub_top_loc8 || opcode == op.OP_mul_top_loc8
    || opcode == op.OP_add_top_arg8 || opcode == op.OP_sub_top_arg8 || opcode == op.OP_mul_top_arg8
    || opcode == op.OP_strict_eq_imm8 || opcode == op.OP_strict_neq_imm8 {
    if size != 2 { return departs(size) }
    return plain(2, 1, 0)
  }
  if opcode == op.OP_shl_imm || opcode == op.OP_or_imm || opcode == op.OP_set_arg || opcode == op.OP_set_scope0 { if size != 3 { return departs(size) } return plain(3, 1, 0) }
  if opcode == op.OP_put_arg || opcode == op.OP_put_scope0 { if size != 3 { return departs(size) } return plain(3, 1, -1) }
  if opcode == op.OP_shl || opcode == op.OP_sar || opcode == op.OP_shr || opcode == op.OP_nip { if size != 1 { return departs(size) } return plain(1, 2, -1) }
  if opcode == op.OP_swap { if size != 1 { return departs(size) } return plain(1, 2, 0) }
  if opcode == op.OP_add_loc { if size != 2 { return departs(size) } return plain(2, 1, -1) }
  if opcode == op.OP_put_var { if size != 3 { return departs(size) } return plain(3, 1, -1) }
  if opcode == op.OP_get_array_el3 || opcode == op.OP_dup1 { if size != 1 { return departs(size) } return plain(1, 2, 1) }
  if opcode == op.OP_insert3 || opcode == op.OP_perm3 {
    if size != 1 { return departs(size) }
    if opcode == op.OP_perm3 { return plain(1, 3, 0) }
    return plain(1, 3, 1)
  }
  if opcode == op.OP_insert4 { if size != 1 { return departs(size) } return plain(1, 4, 1) }
  if opcode == op.OP_neg || opcode == op.OP_not || opcode == op.OP_plus || opcode == op.OP_is_undefined || opcode == op.OP_is_null {
    if size != 1 { return departs(size) }
    return plain(1, 1, 0)
  }
  if opcode == op.OP_post_inc || opcode == op.OP_post_dec { if size != 1 { return departs(size) } return plain(1, 1, 1) }
  if opcode == op.OP_get_loc_length8 || opcode == op.OP_get_arg_length8 || opcode == op.OP_push_const8 { if size != 2 { return departs(size) } return plain(2, 0, 1) }
  if opcode == op.OP_push_const { if size != 5 { return departs(size) } return plain(5, 0, 1) }
  return untemplated(bytes, pc, opcode, size)
}

// ---- The frame --------------------------------------------------------------------------

/// Where a function's frame keeps things, from rbp.
struct Plan {
  layout: ValueLayout,
  f: BaselineLayout,
  fields: FieldLayout,
  /// The BaselineFrame record and the first cell (the argument area), from rbp; the bytes
  /// of the frame below rbp.
  record: i32,
  cells: i32,
  below: i32,
  arguments: u32,
  locals: u32,
  stack: u32,
  /// The bytecode's first byte, from the word the record's code holds (Shape.codeDelta).
  codeDelta: i32,
  /// The function's constants (Shape.constantsWord, constantsDelta) and how many it has.
  constantsWord: u32,
  constantsDelta: i32,
  constants: u32,
  count: bool,
  /// A known local function (Shape.known): no closure object, the scope from its caller.
  known: bool,
  /// The code has a lazy arguments slot (engine.LAZY_ARGUMENTS).
  lazy: bool
}
impl Copy for Plan {}
fn signed(value: u32) -> i32 { return u32.wrappingToI32(value) }
impl Plan {
  fn of(settings: &Settings, shape: &Shape) -> Plan {
    let record = (settings.frame.frameBytes + 15) / 16 * 16
    let cells = (shape.arguments + shape.locals + shape.stack) * 16
    return Plan { layout: settings.layout, f: settings.frame, fields: settings.fields,
      record: 0 - signed(record), cells: 0 - signed(record + cells), below: signed(record + cells),
      arguments: shape.arguments, locals: shape.locals, stack: shape.stack, codeDelta: signed(shape.codeDelta),
      constantsWord: shape.constantsWord, constantsDelta: signed(shape.constantsDelta), constants: shape.constants, count: settings.count, known: shape.known, lazy: false }
  }
  /// A field of the record, and of its StackFrame.
  fn rec(self: &Self, offset: u32) -> Mem { return Mem.at(Reg.Rbp, self.record + signed(offset)) }
  fn sf(self: &Self, offset: u32) -> Mem { return Mem.at(Reg.Rbp, self.record + signed(self.f.frame + offset)) }
  /// The rbp displacement of the frame's own argument cell, local and operand cell index.
  fn argumentAt(self: &Self, index: u32) -> i32 { return self.cells + signed(index * 16) }
  fn localAt(self: &Self, index: u32) -> i32 { return self.cells + signed((self.arguments + index) * 16) }
  fn operandAt(self: &Self, depth: i32) -> i32 { return self.cells + signed((self.arguments + self.locals) * 16) + depth * 16 }
  fn tag(self: &Self, engineTag: i32) -> i32 { return signed(self.layout.tagOf(engineTag)) }
  fn int(self: &Self) -> i32 { return signed(self.layout.int()) }
  fn float(self: &Self) -> i32 { return signed(self.layout.float64()) }
  fn boolean(self: &Self) -> i32 { return signed(self.layout.boolean()) }
  fn null(self: &Self) -> i32 { return signed(self.layout.null()) }
  fn undefined(self: &Self) -> i32 { return signed(self.layout.undefined()) }
  fn object(self: &Self) -> i32 { return signed(self.layout.object()) }
  fn exception(self: &Self) -> i32 { return signed(self.layout.tagOf(6)) }
}
/// The tag word and the payload word of the cell at rbp displacement at.
fn word(at: i32) -> Mem { return Mem.at(Reg.Rbp, at) }
fn payload(at: i32) -> Mem { return Mem.at(Reg.Rbp, at + 8) }
/// A value cell anywhere: its tag word at base + at (the frame's own cells are rbp's).
struct Cell { base: Reg, at: i32 }
impl Copy for Cell {}
impl Cell {
  fn word(self: &Self) -> Mem { return Mem.at(self.base, self.at) }
  fn payload(self: &Self) -> Mem { return Mem.at(self.base, self.at + 8) }
}
fn framed(at: i32) -> Cell { return Cell { base: Reg.Rbp, at: at } }

/// A place the code hands the activation to the interpreter at: the bytecode offset it
/// continues at, with depth operands on its stack; throwing, an exception is pending.
struct Exit { label: Label, pc: u32, depth: u32, throwing: bool }
impl Copy for Exit {}

const S_RELEASE: u8 = 0
const S_RELEASE_OBJECT: u8 = 1
const S_HELPER: u8 = 2
const S_EQUAL: u8 = 3
const S_TRUTHY: u8 = 4
const S_BACK_EDGE: u8 = 5
const S_CALL: u8 = 6
const S_VARIABLE: u8 = 8
const S_ATTACHED: u8 = 9
/// S_HELPER whose second cell is an argument (b its offset in the argument area).
const S_HELPER_ARGUMENT: u8 = 10
/// arithmetic(a, b, opcode k): the result is in a at back; other when the helper declines.
const S_ARITHMETIC: u8 = 11
/// helper k on cell a alone: back when it answered, other when it declines.
const S_CELL: u8 = 12
/// S_TRUTHY that leaves the value its count.
const S_TRUTH: u8 = 13
/// The instruction at pc through the engine's step service, then back (the next
/// instruction): a its operands afterwards, b the next instruction's offset, k its opcode.
const S_STEP: u8 = 14
/// S_RELEASE of the cell at reg + a.
const S_RELEASE_AT: u8 = 15
/// SERVICE_QUICK for the instruction at pc with a the cell above its operands: back when
/// the engine did it, other when it declined.
const S_QUICK: u8 = 16
const S_KNOWN: u8 = 17
const S_LENGTH: u8 = 18
const S_TRUNCATE: u8 = 19
const S_NATIVE: u8 = 20
/// S_HELPER.b when the helper takes no second cell.
const NO_CELL: i32 = 1
/// Code kept out of the straight path: a last release, a cache miss, a poll, a generic call.
struct Slow { kind: u8, entry: Label, back: Label, other: Label, a: i32, b: i32, c: i32, k: u32, pc: u32, depth: u32, reg: Reg, flag: bool }
impl Copy for Slow {}

struct Emitter {
  a: Assembler,
  p: Plan,
  exits: List<Exit>,
  slows: List<Slow>,
  /// The label of each reachable instruction, by offset (others hold the first label).
  labels: List<Label>,
  /// The bytecode.
  codes: List<u8>,
  /// Every exit jumps here with the request in ecx.
  finish: Label,
  /// A step that ended the activation jumps here with the service's answer in eax.
  stepEnded: Label,
  /// Returns rax:rdx: releases the frame's cells and unlinks it.
  leave: Label,
  /// The prologue found no room for the frame.
  overflow: Label,
  /// In the prologue, after the head the construct entry repeats.
  entered: Label,
  /// The tail that takes the frame on from where a service left it (js_baseline.moved).
  moved: Label,
  /// The resume table (MARK_TABLE).
  table: Label,
  /// A return instruction of the function for an activation that entered at a back edge to
  /// end at (js_baseline.SERVICE_RESUME), one that returns its operand when returnsValue;
  /// u32.MAX when the function gets no resume entry.
  returnPc: u32,
  returnsValue: bool,
  /// Outcome.map, as the code grows.
  map: List<u32>
}

impl Emitter {
  effect fn exit(self: &mut Self, pc: usize, depth: i32, throwing: bool) -> Label ! OutOfMemoryError ? &mut Allocator {
    let at = usize.toU32(pc)
    let deep = i32.wrappingToU32(depth)
    let mut index: usize = 0
    while index < self.exits.length() {
      let known = self.exits.get(index)
      if known.pc == at && known.depth == deep && known.throwing == throwing { return known.label }
      index = index + 1
    }
    let label = run self.a.label()
    run self.exits.append(Exit { label: label, pc: at, depth: deep, throwing: throwing })
    return label
  }
  effect fn mark(self: &mut Self, pc: u32, what: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let at = usize.toU32(self.a.offset())
    run self.map.append(at)
    run self.map.append(pc)
    run self.map.append(what)
  }
  effect fn slow(self: &mut Self, kind: u8, back: Label, other: Label, a: i32, b: i32, k: u32, pc: usize, depth: i32, reg: Reg, flag: bool) -> Label ! OutOfMemoryError ? &mut Allocator {
    let entry = run self.a.label()
    run self.slows.append(Slow { kind: kind, entry: entry, back: back, other: other, a: a, b: b, c: a, k: k, pc: usize.toU32(pc), depth: i32.wrappingToU32(depth), reg: reg, flag: flag })
    return entry
  }
  /// S_ARITHMETIC of cell a and cell b (an argument's offset when argument) into cell c.
  effect fn slowOut(self: &mut Self, back: Label, other: Label, a: i32, b: i32, c: i32, k: u32, pc: usize, depth: i32, argument: bool) -> Label ! OutOfMemoryError ? &mut Allocator {
    let entry = run self.a.label()
    run self.slows.append(Slow { kind: S_ARITHMETIC, entry: entry, back: back, other: other, a: a, b: b, c: c, k: k, pc: usize.toU32(pc), depth: i32.wrappingToU32(depth), reg: Reg.Rax, flag: argument })
    return entry
  }
  /// Jumps to notHeap unless reg, a tag byte zero-extended, is a heap variant's. Changes reg
  /// (S_RELEASE undoes it).
  effect fn heapRange(self: &mut Self, reg: Reg, notHeap: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let lowest = signed(self.p.layout.heapLowest)
    if lowest != 0 { run self.a.aluImm(Alu.Sub, Width.W32, reg, lowest) }
    run self.a.aluImm(Alu.Cmp, Width.W32, reg, signed(self.p.layout.heapHighest - self.p.layout.heapLowest))
    run self.a.jcc(Cond.Above, notHeap)
  }
  /// The heap variants' tags start at 0: one byte compare tells a heap reference.
  fn heapFromZero(self: &Self) -> bool { return self.p.layout.heapLowest == 0 }
  fn heapTop(self: &Self) -> u8 { return u32.wrappingToU8(self.p.layout.heapHighest) }
  /// Jumps to notHeap unless the value whose tag word is in tagWord is a heap reference.
  /// Clobbers r10 unless the heap tags start at 0.
  effect fn unlessHeap(self: &mut Self, tagWord: Reg, notHeap: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.heapFromZero() {
      let top = self.heapTop()
      run self.a.cmp8Imm(tagWord, top)
      run self.a.jcc(Cond.Above, notHeap)
      return ()
    }
    run self.a.zeroExtend8(Reg.R10, tagWord)
    run self.heapRange(Reg.R10, notHeap)
  }
  /// Jumps to notHeap unless the cell whose tag is at tagAt holds a heap reference. Clobbers
  /// r10 unless the heap tags start at 0.
  effect fn unlessHeapAt(self: &mut Self, tagAt: Mem, notHeap: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.heapFromZero() {
      let top = self.heapTop()
      run self.a.cmp8MemImm(tagAt, top)
      run self.a.jcc(Cond.Above, notHeap)
      return ()
    }
    run self.a.loadZero8(Reg.R10, tagAt)
    run self.heapRange(Reg.R10, notHeap)
  }
  /// Adds a count to the value whose tag word is in tagWord and payload in pointer, when it
  /// is a heap reference. Clobbers r10.
  effect fn retain(self: &mut Self, tagWord: Reg, pointer: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    let skip = run self.a.label()
    run self.unlessHeap(tagWord, skip)
    run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(pointer, 0), 1)
    self.a.bind(skip)
  }
  /// Drops the count the value in the cell at rbp displacement at holds; the cell keeps its
  /// bits. Clobbers r10 and r11.
  effect fn releaseCell(self: &mut Self, at: i32) -> () ! OutOfMemoryError ? &mut Allocator {
    let skip = run self.a.label()
    run self.unlessHeapAt(word(at), skip)
    run self.a.load(Width.W64, Reg.R11, payload(at))
    // The count drops first; the slow path puts it back for the engine's release.
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.R11, 0), 1)
    let last = run self.slow(S_RELEASE, skip, skip, at, 0, 0, 0, 0, Reg.R11, false)
    run self.a.jcc(Cond.LessOrEqual, last)
    self.a.bind(skip)
  }
  /// releaseCell of a cell anywhere; its base register must not be r10 or r11.
  effect fn releaseAt(self: &mut Self, cell: Cell) -> () ! OutOfMemoryError ? &mut Allocator {
    let skip = run self.a.label()
    run self.unlessHeapAt(cell.word(), skip)
    run self.a.load(Width.W64, Reg.R11, cell.payload())
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.R11, 0), 1)
    let last = run self.slow(S_RELEASE_AT, skip, skip, cell.at, 0, 0, 0, 0, cell.base, false)
    run self.a.jcc(Cond.LessOrEqual, last)
    self.a.bind(skip)
  }
  /// Pops the top operand (at depth - 1) into target, or copies it (keep). target's base
  /// must not be rax, rdx, r10 or r11.
  effect fn storeInto(self: &mut Self, target: Cell, depth: i32, keep: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    let top = self.p.operandAt(depth - 1)
    run self.a.load(Width.W64, Reg.Rax, word(top))
    run self.a.load(Width.W64, Reg.Rdx, payload(top))
    if keep { run self.retain(Reg.Rax, Reg.Rdx) }
    run self.releaseAt(target)
    run self.a.store(Width.W64, target.word(), Reg.Rax)
    run self.a.store(Width.W64, target.payload(), Reg.Rdx)
  }
  /// rcx = the frame's argument cells.
  effect fn argumentBase(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.a.load(Width.W64, Reg.Rcx, self.p.sf(self.p.f.argumentsData))
  }
  /// add, sub or mul (opcode) of the frame cell left and right into the frame cell out (left
  /// itself, or a cell that holds nothing): two Ints with an Int result here, two doubles
  /// in the slow path, other numbers through the helper, anything else as a step.
  effect fn binary(self: &mut Self, opcode: u8, left: i32, right: Cell, out: i32, argument: bool, pc: usize, depth: i32, step: &Step) -> () ! OutOfMemoryError ? &mut Allocator {
    let p = self.p
    let exit = run self.bail(pc, depth, step)
    let done = run self.a.label()
    let other = run self.slowOut(done, exit, left, right.at, out, u8.toU32(opcode), pc, depth, argument)
    run self.tagIs(word(left), p.int(), other)
    run self.tagIs(right.word(), p.int(), other)
    run self.a.load(Width.W32, Reg.Rax, payload(left))
    if opcode == op.OP_mul {
      // An Int product that is not 0 (which may be -0: the helper tells).
      run self.a.load(Width.W32, Reg.Rdx, right.payload())
      run self.a.imul(Width.W32, Reg.Rax, Reg.Rdx)
      run self.a.jcc(Cond.Overflow, other)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, other)
    } else {
      let mut operation = Alu.Add
      if opcode == op.OP_sub { operation = Alu.Sub }
      run self.a.aluLoad(operation, Width.W32, Reg.Rax, right.payload())
      run self.a.jcc(Cond.Overflow, other)
    }
    if out != left { run self.a.storeImm(Width.W64, word(out), p.int()) }
    run self.a.store(Width.W64, payload(out), Reg.Rax)
    self.a.bind(done)
  }
  /// Drops a count of the object whose cell address is in reg. Clobbers r10 and r11 on its
  /// slow path only.
  effect fn releaseObject(self: &mut Self, reg: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    let done = run self.a.label()
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(reg, 0), 1)
    let last = run self.slow(S_RELEASE_OBJECT, done, done, 0, 0, 0, 0, 0, reg, false)
    run self.a.jcc(Cond.LessOrEqual, last)
    self.a.bind(done)
  }
  /// Jumps to otherwise unless the cell at tagAt holds a value of tag.
  effect fn tagIs(self: &mut Self, tagAt: Mem, tag: i32, otherwise: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.a.cmp8MemImm(tagAt, i32.wrappingToU8(tag))
    run self.a.jcc(Cond.NotEqual, otherwise)
  }
  /// Calls helper index (a C function; every scratch register is lost).
  effect fn helper(self: &mut Self, index: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.a.mov(Width.W64, Reg.Rdi, Reg.R12)
    run self.a.callMem(Mem.at(Reg.R12, env.helperOffset(index)))
  }
  /// reg = the address of the operand of the instruction at pc (what the caches key on).
  effect fn operandInto(self: &mut Self, reg: Reg, pc: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.a.load(Width.W64, reg, self.p.rec(self.p.f.code))
    run self.a.lea(Width.W64, reg, Mem.at(reg, self.p.codeDelta + signed(usize.toU32(pc + 1))))
  }
  /// Writes an Int of the value in reg, zero-extended from its low half, or a Bool of its 0
  /// or 1, into the cell at at.
  effect fn boxed(self: &mut Self, at: i32, tag: i32, reg: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.a.storeImm(Width.W64, word(at), tag)
    run self.a.store(Width.W64, payload(at), reg)
  }
  /// The engine's service on this frame: request in ecx, then base in r8 and count in r9.
  effect fn engineCall(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let f = self.p.f
    run self.a.load(Width.W64, Reg.Rdi, Mem.at(Reg.R13, signed(f.serviceHooks)))
    run self.a.load(Width.W64, Reg.Rsi, Mem.at(Reg.R13, signed(f.serviceAllocator)))
    run self.a.lea(Width.W64, Reg.Rdx, self.p.rec(0))
    run self.a.callMem(Mem.at(Reg.R13, signed(f.serviceEntry)))
  }

  /// The running function's bytecode object into reg.
  effect fn bytecodeInto(self: &mut Self, reg: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    let f = self.p.f
    run self.a.load(Width.W64, reg, self.p.sf(f.currentFunction + 8))
    if !self.p.known { run self.a.load(Width.W64, reg, Mem.at(reg, signed(f.closureBytecode))) }
  }
  /// The scope the running function's code reads (it has none of its own): the one its
  /// closure captured, or the one a known local function's caller passed.
  effect fn scopeInto(self: &mut Self, reg: Reg) -> () ! OutOfMemoryError ? &mut Allocator {
    let f = self.p.f
    if self.p.known { run self.a.load(Width.W64, reg, self.p.rec(f.scope)) return () }
    run self.a.load(Width.W64, reg, self.p.sf(f.currentFunction + 8))
    run self.a.load(Width.W64, reg, Mem.at(reg, signed(f.closureScope)))
  }

  // ---- Prologue and the shared tails ----------------------------------------------------

  effect fn prologue(self: &mut Self, shape: &Shape) -> () ! OutOfMemoryError ? &mut Allocator {
    let f = self.p.f
    let p = self.p
    let overflow = self.overflow
    run self.a.push(Reg.Rbp)
    run self.a.mov(Width.W64, Reg.Rbp, Reg.Rsp)
    run self.a.aluImm(Alu.Sub, Width.W64, Reg.Rsp, p.below)
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rsp, Mem.at(Reg.R13, signed(f.stackLimit)))
    run self.a.jcc(Cond.Below, overflow)
    // The word that leads to the bytecode's first byte, through the bytecode object in r11.
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, signed(shape.codeWord)))
    run self.a.store(Width.W64, p.rec(f.code), Reg.R9)
    // A bare frame (js_baseline.FRAME_BARE): what a call needs. The engine completes the
    // StackFrame when the code asks it for anything (js_baseline.build).
    run self.a.storeImm(Width.W64, p.rec(f.state), u64.wrappingToI32(engine.FRAME_BARE))
    self.a.bind(self.entered)
    if p.known {
      // No closure object: the frame names the bytecode, rdi is the scope, `this` undefined.
      run self.a.storeImm(Width.W64, p.sf(f.currentFunction), p.tag(-2))
      run self.a.store(Width.W64, p.sf(f.currentFunction + 8), Reg.R11)
      run self.a.store(Width.W64, p.rec(f.scope), Reg.Rdi)
      run self.a.storeImm(Width.W64, p.sf(f.thisValue), p.undefined())
      run self.a.storeImm(Width.W64, p.sf(f.thisValue + 8), 0)
    } else {
      run self.a.storeImm(Width.W64, p.sf(f.currentFunction), p.object())
      run self.a.store(Width.W64, p.sf(f.currentFunction + 8), Reg.Rdi)
      run self.a.store(Width.W64, p.sf(f.thisValue), Reg.Rcx)
      run self.a.store(Width.W64, p.sf(f.thisValue + 8), Reg.R8)
    }
    run self.a.store(Width.W64, p.rec(f.argv), Reg.Rsi)
    run self.a.store(Width.W64, p.rec(f.argc), Reg.Rdx)
    // Arguments: the caller's cells, or the frame's own copy when the function writes a
    // parameter or the caller passed fewer than it declares (js_vm_activation.describe).
    let argumentsDone = run self.a.label()
    if p.arguments != 0 {
      let borrow = run self.a.label()
      if !shape.copies {
        run self.a.aluImm(Alu.Cmp, Width.W64, Reg.Rdx, signed(p.arguments))
        run self.a.jcc(Cond.AboveOrEqual, borrow)
      }
      let mut index: u32 = 0
      while index < p.arguments {
        let missing = run self.a.label()
        let next = run self.a.label()
        let at = p.argumentAt(index)
        run self.a.aluImm(Alu.Cmp, Width.W64, Reg.Rdx, signed(index))
        run self.a.jcc(Cond.BelowOrEqual, missing)
        run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rsi, signed(index * 16)))
        run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.Rsi, signed(index * 16 + 8)))
        run self.a.store(Width.W64, word(at), Reg.Rax)
        run self.a.store(Width.W64, payload(at), Reg.R9)
        run self.retain(Reg.Rax, Reg.R9)
        run self.a.jmp(next)
        self.a.bind(missing)
        run self.a.storeImm(Width.W64, word(at), p.undefined())
        self.a.bind(next)
        index = index + 1
      }
      run self.a.lea(Width.W64, Reg.Rax, word(p.argumentAt(0)))
      run self.a.store(Width.W64, p.sf(f.argumentsData), Reg.Rax)
      run self.a.jmp(argumentsDone)
      self.a.bind(borrow)
    }
    run self.a.store(Width.W64, p.sf(f.argumentsData), Reg.Rsi)
    self.a.bind(argumentsDone)
    let mut local: u32 = 0
    while local < p.locals {
      run self.a.storeImm(Width.W64, word(p.localAt(local)), p.undefined())
      local = local + 1
    }
  }

  /// The shared tails: the construct entry, `leave` (return rax:rdx) and `finish` (the
  /// interpreter finishes the activation), then every exit and slow path.
  effect fn tails(self: &mut Self, shape: &Shape) -> () ! OutOfMemoryError ? &mut Allocator {
    let f = self.p.f
    let p = self.p
    // The construct entry: the prologue's head with the frame in the construct state, which
    // tells the engine that new.target is the function (js_baseline.build).
    // The four bytes before it: how far on the resume entry is (compile writes it), or 0.
    run self.a.data32(0)
    run self.mark(0, MARK_CONSTRUCT)
    run self.a.push(Reg.Rbp)
    run self.a.mov(Width.W64, Reg.Rbp, Reg.Rsp)
    run self.a.aluImm(Alu.Sub, Width.W64, Reg.Rsp, p.below)
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rsp, Mem.at(Reg.R13, signed(f.stackLimit)))
    run self.a.jcc(Cond.Below, self.overflow)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, signed(shape.codeWord)))
    run self.a.store(Width.W64, p.rec(f.code), Reg.R9)
    run self.a.storeImm(Width.W64, p.rec(f.state), u64.wrappingToI32(engine.FRAME_BARE_CONSTRUCT))
    run self.a.jmp(self.entered)
    // The resume entry: an activation the interpreter was running goes on here from a back
    // edge. rsi is its js_baseline.Resume in place of the arguments; the engine fills the
    // cells from it and says where the activation was (SERVICE_RESUME).
    if self.returnPc != u32.MAX {
      run self.mark(0, MARK_RESUME)
      run self.a.push(Reg.Rbp)
      run self.a.mov(Width.W64, Reg.Rbp, Reg.Rsp)
      run self.a.aluImm(Alu.Sub, Width.W64, Reg.Rsp, p.below)
      run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rsp, Mem.at(Reg.R13, signed(f.stackLimit)))
      run self.a.jcc(Cond.Below, self.overflow)
      run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, signed(shape.codeWord)))
      run self.a.store(Width.W64, p.rec(f.code), Reg.R9)
      run self.a.storeImm(Width.W64, p.rec(f.state), u64.wrappingToI32(engine.FRAME_BARE))
      if p.known {
        run self.a.storeImm(Width.W64, p.sf(f.currentFunction), p.tag(-2))
        run self.a.store(Width.W64, p.sf(f.currentFunction + 8), Reg.R11)
        run self.a.store(Width.W64, p.rec(f.scope), Reg.Rdi)
        run self.a.storeImm(Width.W64, p.sf(f.thisValue), p.undefined())
        run self.a.storeImm(Width.W64, p.sf(f.thisValue + 8), 0)
      } else {
        run self.a.storeImm(Width.W64, p.sf(f.currentFunction), p.object())
        run self.a.store(Width.W64, p.sf(f.currentFunction + 8), Reg.Rdi)
        run self.a.store(Width.W64, p.sf(f.thisValue), Reg.Rcx)
        run self.a.store(Width.W64, p.sf(f.thisValue + 8), Reg.R8)
      }
      run self.a.store(Width.W64, p.rec(f.argv), Reg.Rsi)
      run self.a.store(Width.W64, p.rec(f.argc), Reg.Rdx)
      let mut request = engine.SERVICE_RESUME
      if self.returnsValue { request = request | engine.RESUME_VALUE }
      run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(request))
      run self.a.movImm32(Reg.R8, 0)
      run self.a.movImm32(Reg.R9, self.returnPc)
      run self.engineCall()
      run self.a.jmp(self.moved)
    }
    // leave: the frame's own cells drop their counts; rax:rdx pass through (release keeps
    // every register but r10 and r11).
    run self.mark(0, MARK_LEAVE)
    self.a.bind(self.leave)
    if p.arguments != 0 {
      let borrowed = run self.a.label()
      run self.a.lea(Width.W64, Reg.Rcx, word(p.argumentAt(0)))
      run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.Rcx, p.sf(f.argumentsData))
      run self.a.jcc(Cond.NotEqual, borrowed)
      let mut index: u32 = 0
      while index < p.arguments { run self.releaseCell(p.argumentAt(index)) index = index + 1 }
      self.a.bind(borrowed)
    }
    let mut local: u32 = 0
    while local < p.locals { run self.releaseCell(p.localAt(local)) local = local + 1 }
    // A frame the engine built is published: unlink it.
    let built = run self.a.label()
    let epilogue = run self.a.label()
    run self.a.aluStoreImm(Alu.Cmp, Width.W64, p.rec(f.state), u64.wrappingToI32(engine.FRAME_BARE_CONSTRUCT))
    run self.a.jcc(Cond.Above, built)
    self.a.bind(epilogue)
    run self.a.mov(Width.W64, Reg.Rsp, Reg.Rbp)
    run self.a.pop(Reg.Rbp)
    run self.a.ret()
    self.a.bind(built)
    run self.a.load(Width.W64, Reg.Rcx, p.sf(f.previous))
    run self.a.store(Width.W64, Mem.at(Reg.R13, signed(f.currentStackFrame)), Reg.Rcx)
    run self.a.jmp(epilogue)
    // finish: ecx holds the request and r9 the operands on the stack; the engine builds
    // the frame, runs the rest and releases the cells.
    run self.mark(0, MARK_FINISH)
    self.a.bind(self.finish)
    run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.R12, env.DEPARTURES_OFFSET), 1)
    run self.a.movImm32(Reg.R8, 0)
    run self.engineCall()
    let threw = run self.a.label()
    let ended = run self.a.label()
    let handled = run self.a.label()
    // A handler of the frame's own took the exception (js_vm.baselineFinish).
    run self.a.cmp8Imm(Reg.Rax, u64.wrappingToU8(engine.SERVICE_MOVED))
    run self.a.jcc(Cond.Equal, handled)
    self.a.bind(ended)
    run self.a.load(Width.W64, Reg.Rcx, p.sf(f.previous))
    run self.a.store(Width.W64, Mem.at(Reg.R13, signed(f.currentStackFrame)), Reg.Rcx)
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.NotEqual, threw)
    run self.a.load(Width.W64, Reg.Rax, p.rec(f.result))
    run self.a.load(Width.W64, Reg.Rdx, p.rec(f.result + 8))
    run self.a.mov(Width.W64, Reg.Rsp, Reg.Rbp)
    run self.a.pop(Reg.Rbp)
    run self.a.ret()
    self.a.bind(threw)
    run self.a.movImm32(Reg.Rax, i32.wrappingToU32(p.exception()))
    run self.a.mov(Width.W64, Reg.Rsp, Reg.Rbp)
    run self.a.pop(Reg.Rbp)
    run self.a.ret()
    // A step that ended the activation in the interpreter (js_vm.baselineStep: 1 with the
    // result, 2 when it threw): the finish tail's 0 and 1.
    self.a.bind(self.stepEnded)
    run self.a.cmp8Imm(Reg.Rax, u64.wrappingToU8(engine.SERVICE_MOVED))
    run self.a.jcc(Cond.Equal, self.moved)
    run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.R12, env.DEPARTURES_OFFSET), 1)
    run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.R12, env.STEPS_ENDED_OFFSET), 1)
    run self.a.aluImm(Alu.Sub, Width.W32, Reg.Rax, 1)
    run self.a.jmp(ended)
    self.a.bind(handled)
    run self.a.aluStoreImm(Alu.Sub, Width.W64, Mem.at(Reg.R12, env.DEPARTURES_OFFSET), 1)
    // moved: rax is a service's answer that the frame is at another instruction
    // (js_baseline.moved). The code goes on there when the resume table has that instruction
    // with as many operands; the interpreter finishes the activation otherwise.
    self.a.bind(self.moved)
    let none = run self.a.label()
    run self.a.mov(Width.W64, Reg.Rcx, Reg.Rax)
    run self.a.shiftImm(Shift.Shr, Width.W64, Reg.Rcx, 8)
    run self.a.mov(Width.W32, Reg.Rcx, Reg.Rcx)
    run self.a.mov(Width.W64, Reg.R9, Reg.Rax)
    run self.a.shiftImm(Shift.Shr, Width.W64, Reg.R9, 40)
    run self.a.aluImm(Alu.Cmp, Width.W64, Reg.Rcx, signed(usize.toU32(self.codes.length())))
    run self.a.jcc(Cond.AboveOrEqual, none)
    run self.a.leaLabel(Reg.Rdx, self.table)
    run self.a.load(Width.W32, Reg.Rax, Mem.indexed(Reg.Rdx, Reg.Rcx, Scale.Four, 0))
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.Equal, none)
    run self.a.mov(Width.W32, Reg.Rsi, Reg.Rax)
    run self.a.shiftImm(Shift.Shr, Width.W32, Reg.Rsi, 24)
    run self.a.alu(Alu.Cmp, Width.W64, Reg.Rsi, Reg.R9)
    run self.a.jcc(Cond.NotEqual, none)
    run self.a.aluImm(Alu.And, Width.W32, Reg.Rax, 0xffffff)
    run self.a.alu(Alu.Sub, Width.W64, Reg.Rdx, Reg.Rax)
    run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.R12, env.RESUMES_OFFSET), 1)
    run self.a.jmpReg(Reg.Rdx)
    self.a.bind(none)
    run self.a.store(Width.W64, p.sf(f.currentPc), Reg.Rcx)
    run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(engine.SERVICE_FINISH))
    run self.a.jmp(self.finish)
    // No room on the native stack. The function has no frame; the engine throws.
    run self.mark(0, MARK_OVERFLOW)
    self.a.bind(self.overflow)
    run self.a.mov(Width.W64, Reg.Rsp, Reg.Rbp)
    // The entered function's bytecode, still in r11, tells the engine the realm.
    run self.a.mov(Width.W64, Reg.R8, Reg.R11)
    run self.a.load(Width.W64, Reg.Rdi, Mem.at(Reg.R13, signed(f.serviceHooks)))
    run self.a.load(Width.W64, Reg.Rsi, Mem.at(Reg.R13, signed(f.serviceAllocator)))
    // Where the caller's record is if the caller is baseline code (the engine tells).
    run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.Rbp, 0))
    run self.a.lea(Width.W64, Reg.Rdx, Mem.at(Reg.Rdx, p.record))
    run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(engine.SERVICE_OVERFLOW))
    run self.a.movImm32(Reg.R9, 0)
    run self.a.callMem(Mem.at(Reg.R13, signed(f.serviceEntry)))
    run self.a.movImm32(Reg.Rax, i32.wrappingToU32(p.exception()))
    run self.a.pop(Reg.Rbp)
    run self.a.ret()
    // Slow paths may ask for more exits; exits ask for nothing.
    let mut s: usize = 0
    while s < self.slows.length() {
      let item = self.slows.get(s)
      run self.slowPath(&item)
      s = s + 1
    }
    let mut e: usize = 0
    while e < self.exits.length() {
      let item = self.exits.get(e)
      run self.mark(item.pc, MARK_EXIT)
      self.a.bind(item.label)
      run self.a.storeImm(Width.W64, p.sf(f.currentPc), signed(item.pc))
      if p.count { run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.R12, env.EXIT_COUNTS_OFFSET + 8 * u8.toI32(self.codes.get(u32.toUsize(item.pc)))), 1) }
      run self.a.movImm32(Reg.R9, item.depth)
      let mut request = engine.SERVICE_FINISH
      if item.throwing { request = request | engine.FINISH_THROWING }
      run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(request))
      run self.a.jmp(self.finish)
      e = e + 1
    }
    // The resume table, which compile fills once the code is placed.
    run self.mark(0, MARK_TABLE)
    self.a.bind(self.table)
    let mut entry: usize = 0
    while entry < self.codes.length() { run self.a.data32(0) entry = entry + 1 }
  }

  /// Where a template sends what it does not handle, with the frame as the instruction found
  /// it: the engine runs that instruction alone and the code goes on after it, or wherever
  /// the frame is then.
  effect fn bail(self: &mut Self, pc: usize, depth: i32, step: &Step) -> Label ! OutOfMemoryError ? &mut Allocator {
    let opcode = u8.toU32(self.codes.get(pc))
    if (step.kind != FALL && step.kind != BRANCH && step.kind != STEP) || pc + step.size >= self.labels.length() {
      let never = self.leave
      return run self.slow(S_STEP, never, never, 0, u32.wrappingToI32(NOWHERE), opcode, pc, depth, Reg.Rax, false)
    }
    let back = self.labels.get(pc + step.size)
    return run self.slow(S_STEP, back, back, depth + step.fall, signed(usize.toU32(pc + step.size)), opcode, pc, depth, Reg.Rax, false)
  }
  /// bail for a template of the instruction at pc and the one after it (fused): the engine
  /// runs the first alone, then the second if the frame is at it, which the code has no
  /// entry for.
  effect fn bailPair(self: &mut Self, pc: usize, depth: i32, step: &Step, follow: &Step) -> Label ! OutOfMemoryError ? &mut Allocator {
    let opcode = u8.toU32(self.codes.get(pc))
    let second = pc + step.size
    if (follow.kind != FALL && follow.kind != BRANCH && follow.kind != STEP) || second + follow.size >= self.labels.length() {
      let never = self.leave
      return run self.slow(S_STEP, never, never, 0, u32.wrappingToI32(NOWHERE), opcode, pc, depth, Reg.Rax, false)
    }
    let back = self.labels.get(second + follow.size)
    return run self.slow(S_STEP, back, back, depth + step.fall, signed(usize.toU32(second)), opcode, pc, depth, Reg.Rax, true)
  }
  /// SERVICE_QUICK for the instruction at pc, with top the cell above its operands: eax is 0
  /// when the engine did it.
  effect fn quick(self: &mut Self, pc: u32, top: i32) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(engine.SERVICE_QUICK) | u32.shiftLeft(pc, 8))
    run self.a.lea(Width.W64, Reg.R8, word(top))
    run self.a.movImm32(Reg.R9, 0)
    run self.engineCall()
  }
  /// keyedSlot by the site cache entry of the define_field at pc (js_vm_object_ops
  /// defineFieldCached): an own entry of the shape version of a plain object. r11 = the
  /// slot, rsi = the object; or a jump to miss. Clobbers rax, r8, r9, r10.
  effect fn definedSlot(self: &mut Self, tagAt: Mem, payloadAt: Mem, pc: usize, miss: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let fields = self.p.fields
    let entries = signed(fields.fieldCache)
    let objectTag = self.p.object()
    run self.tagIs(tagAt, objectTag, miss)
    run self.a.load(Width.W64, Reg.Rsi, payloadAt)
    run self.a.cmp16MemImm(Mem.at(Reg.Rsi, signed(fields.objectClass)), u32.wrappingToU16(fields.plainClass))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.loadZero8(Reg.R10, Mem.at(Reg.Rsi, signed(fields.objectFlags)))
    run self.a.testImm(Width.W32, Reg.R10, signed(fields.exotic))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rsi, signed(fields.objectShape)))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, signed(fields.shapeVersion)))
    run self.operandInto(Reg.R9, pc)
    run self.a.mov(Width.W64, Reg.R8, Reg.R9)
    run self.a.aluImm(Alu.And, Width.W32, Reg.R8, 4095)
    run self.a.imulImm(Width.W64, Reg.R8, Reg.R8, signed(fields.entryStride))
    run self.a.alu(Alu.Add, Width.W64, Reg.R8, Reg.R13)
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R9, Mem.at(Reg.R8, entries + signed(fields.entrySite)))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R8, entries + signed(fields.entryKey)))
    run self.a.mov(Width.W64, Reg.R10, Reg.R9)
    run self.a.shiftImm(Shift.Shr, Width.W64, Reg.R9, 16)
    run self.a.alu(Alu.Cmp, Width.W64, Reg.R9, Reg.Rax)
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.aluImm(Alu.And, Width.W32, Reg.R10, 65535)
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R10, 4)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.Rsi, signed(fields.objectSlots)))
    run self.a.alu(Alu.Add, Width.W64, Reg.R11, Reg.R10)
  }
  /// The step request for the instruction at pc: eax is 0 when the code goes on after it.
  effect fn stepRequest(self: &mut Self, opcode: u8, pc: u32, depth: u32, next: u32, after: u32) -> () ! OutOfMemoryError ? &mut Allocator {
    let f = self.p.f
    let p = self.p
    run self.a.storeImm(Width.W64, p.sf(f.currentPc), signed(pc))
    run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.R12, env.STEPS_OFFSET), 1)
    if p.count { run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.R12, env.STEP_COUNTS_OFFSET + 8 * u8.toI32(opcode)), 1) }
    run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(engine.SERVICE_STEP) | u32.shiftLeft(next, 8))
    run self.a.movImm32(Reg.R8, after)
    run self.a.movImm32(Reg.R9, depth)
    run self.engineCall()
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.NotEqual, self.stepEnded)
  }
  /// The instruction at pc, which has no template, through the engine: the interpreter runs
  /// it on the frame's cells, and the code goes on after it unless that ended the activation.
  effect fn stepped(self: &mut Self, opcode: u8, pc: usize, depth: i32, step: &Step) -> () ! OutOfMemoryError ? &mut Allocator {
    if step.kind == LEAP || step.kind == JUMP {
      run self.stepRequest(opcode, usize.toU32(pc), i32.wrappingToU32(depth), NOWHERE, 0)
      run self.a.ud2()
      return ()
    }
    run self.stepRequest(opcode, usize.toU32(pc), i32.wrappingToU32(depth), usize.toU32(pc + step.size), i32.wrappingToU32(depth + step.fall))
  }

  /// A poll through the engine with the frame at instruction pc holding depth operands;
  /// afterwards the code goes on at back, or the interpreter takes the frame there when the
  /// poll threw or turned instruction observation on.
  effect fn poll(self: &mut Self, pc: usize, depth: i32, back: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let f = self.p.f
    let p = self.p
    let threw = run self.exit(pc, depth, true)
    let observed = run self.exit(pc, depth, false)
    run self.a.storeImm(Width.W64, p.sf(f.currentPc), signed(usize.toU32(pc)))
    run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(engine.SERVICE_POLL))
    run self.a.movImm32(Reg.R8, 0)
    run self.a.movImm32(Reg.R9, 0)
    run self.engineCall()
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.NotEqual, threw)
    run self.a.loadZero8(Reg.Rax, Mem.at(Reg.R13, signed(f.observe)))
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.NotEqual, observed)
    run self.a.jmp(back)
  }

  effect fn slowPath(self: &mut Self, item: &Slow) -> () ! OutOfMemoryError ? &mut Allocator {
    let f = self.p.f
    let p = self.p
    run self.mark(item.pc, MARK_SLOW + u8.toU32(item.kind))
    self.a.bind(item.entry)
    if item.kind == S_STEP {
      run self.stepRequest(u32.toU8(item.k), item.pc, item.depth, i32.wrappingToU32(item.b), i32.wrappingToU32(item.a))
      if item.flag {
        // bailPair: the frame is at the pair's second instruction.
        let second = u32.toUsize(i32.wrappingToU32(item.b))
        let follow = stepOf(self.codes.asSlice(), second)
        let then = self.codes.get(second)
        let size = follow.size
        let fall = follow.fall
        run self.stepRequest(then, usize.toU32(second), i32.wrappingToU32(item.a), usize.toU32(second + size), i32.wrappingToU32(item.a + fall))
      }
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == S_QUICK {
      run self.quick(item.pc, item.a)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.NotEqual, item.other)
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == S_RELEASE {
      // The value of the cell at a, whose payload is in r11, held its last count (or one
      // that never drops): the count goes back and the engine releases it.
      run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.R11, 0), 1)
      run self.a.loadZero8(Reg.R10, word(item.a))
      run self.a.callMem(Mem.at(Reg.R12, env.helperOffset(env.RELEASE_STUB)))
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == S_RELEASE_OBJECT {
      run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(item.reg, 0), 1)
      run self.a.movImm32(Reg.R10, i32.wrappingToU32(p.object()))
      run self.a.mov(Width.W64, Reg.R11, item.reg)
      run self.a.callMem(Mem.at(Reg.R12, env.helperOffset(env.RELEASE_STUB)))
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == S_HELPER || item.kind == S_HELPER_ARGUMENT {
      // helper(env, operand address, cell a, cell b or none, k) -> 0: the interpreter runs it.
      run self.operandInto(Reg.Rsi, u32.toUsize(item.pc))
      if item.flag {
        run self.a.load(Width.W64, Reg.Rdx, p.sf(f.argumentsData))
        run self.a.lea(Width.W64, Reg.Rdx, Mem.at(Reg.Rdx, item.a))
      } else { run self.a.lea(Width.W64, Reg.Rdx, word(item.a)) }
      if item.kind == S_HELPER_ARGUMENT {
        run self.a.load(Width.W64, Reg.Rcx, p.sf(f.argumentsData))
        run self.a.lea(Width.W64, Reg.Rcx, Mem.at(Reg.Rcx, item.b))
      } else if item.b != NO_CELL { run self.a.lea(Width.W64, Reg.Rcx, word(item.b)) }
      // get_field2's helper reads a primitive's method in the function's realm.
      if (item.k & 255) == env.GET_FIELD2 { run self.bytecodeInto(Reg.R8) } else { run self.a.movImm32(Reg.R8, u32.shiftRight(item.k, 8)) }
      run self.helper(item.k & 255)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, item.other)
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == S_RELEASE_AT {
      run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.R11, 0), 1)
      run self.a.loadZero8(Reg.R10, Mem.at(item.reg, item.a))
      run self.a.callMem(Mem.at(Reg.R12, env.helperOffset(env.RELEASE_STUB)))
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == S_ARITHMETIC {
      let opcode = u32.wrappingToU8(item.k)
      let mut right = framed(item.b)
      if item.flag { run self.argumentBase() right = Cell { base: Reg.Rcx, at: item.b } }
      let arithmetic = opcode == op.OP_add || opcode == op.OP_sub || opcode == op.OP_mul || opcode == op.OP_div
      let ordering = opcode == op.OP_lt || opcode == op.OP_lte || opcode == op.OP_gt || opcode == op.OP_gte
      if arithmetic || ordering {
        // Two doubles, or a double and an Int, as the interpreter's own arms and numericFast
        // answer them. Two Ints here overflowed, or are a product or a quotient: the helper's,
        // as is a division with an Int on either side.
        let general = run self.a.label()
        let ready = run self.a.label()
        let mut leftInt = run self.a.label()
        let mut rightInt = run self.a.label()
        let mixed = opcode != op.OP_div
        if !mixed { leftInt = general rightInt = general }
        run self.tagIs(word(item.a), p.float(), leftInt)
        run self.a.loadDouble(Xmm.Xmm0, payload(item.a))
        run self.tagIs(right.word(), p.float(), rightInt)
        run self.a.loadDouble(Xmm.Xmm1, right.payload())
        self.a.bind(ready)
        if arithmetic {
          let mut operation = ScalarOp.Add
          if opcode == op.OP_sub { operation = ScalarOp.Sub }
          if opcode == op.OP_mul { operation = ScalarOp.Mul }
          if opcode == op.OP_div { operation = ScalarOp.Div }
          run self.a.scalar(operation, Xmm.Xmm0, Xmm.Xmm1)
          run self.a.storeImm(Width.W64, word(item.c), p.float())
          run self.a.storeDouble(payload(item.c), Xmm.Xmm0)
        } else {
          // a < b when b is above a, and so on: an unordered pair is above nothing.
          if opcode == op.OP_lt || opcode == op.OP_lte { run self.a.packed(PackedOp.Ucomisd, Xmm.Xmm1, Xmm.Xmm0) }
          else { run self.a.packed(PackedOp.Ucomisd, Xmm.Xmm0, Xmm.Xmm1) }
          let mut cond = Cond.Above
          if opcode == op.OP_lte || opcode == op.OP_gte { cond = Cond.AboveOrEqual }
          run self.a.setcc(cond, Reg.Rax)
          run self.a.zeroExtend8(Reg.Rax, Reg.Rax)
          run self.boxed(item.c, p.boolean(), Reg.Rax)
        }
        run self.a.jmp(item.back)
        if mixed {
          self.a.bind(leftInt)
          run self.tagIs(word(item.a), p.int(), general)
          run self.tagIs(right.word(), p.float(), general)
          run self.a.load(Width.W32, Reg.Rax, payload(item.a))
          run self.a.intToDouble(Width.W32, Xmm.Xmm0, Reg.Rax)
          run self.a.loadDouble(Xmm.Xmm1, right.payload())
          run self.a.jmp(ready)
          self.a.bind(rightInt)
          run self.tagIs(right.word(), p.int(), general)
          run self.a.load(Width.W32, Reg.Rax, right.payload())
          run self.a.intToDouble(Width.W32, Xmm.Xmm1, Reg.Rax)
          run self.a.jmp(ready)
        }
        self.a.bind(general)
      }
      let text = run self.a.label()
      if opcode == op.OP_add {
        // A string on either side is no number: straight to the join.
        run self.a.cmp8MemImm(word(item.a), i32.wrappingToU8(p.tag(-7)))
        run self.a.jcc(Cond.Equal, text)
        run self.a.cmp8MemImm(right.word(), i32.wrappingToU8(p.tag(-7)))
        run self.a.jcc(Cond.Equal, text)
      }
      run self.a.lea(Width.W64, Reg.Rsi, word(item.a))
      run self.a.lea(Width.W64, Reg.Rdx, right.word())
      run self.a.movImm32(Reg.Rcx, item.k)
      run self.a.lea(Width.W64, Reg.R8, word(item.c))
      run self.helper(env.ARITHMETIC)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      if opcode != op.OP_add {
        run self.a.jcc(Cond.Equal, item.other)
        run self.a.jmp(item.back)
        return ()
      }
      run self.a.jcc(Cond.NotEqual, item.back)
      self.a.bind(text)
      // A string and a string or number: the engine joins them (SERVICE_CONCAT). The text
      // replaces the left value, in the out cell; a right operand on the stack is consumed.
      let threw = run self.exit(u32.toUsize(item.pc), u32.wrappingToI32(item.depth), true)
      run self.a.storeImm(Width.W64, p.sf(f.currentPc), signed(item.pc))
      if item.c != item.a {
        run self.a.load(Width.W64, Reg.Rax, word(item.a))
        run self.a.load(Width.W64, Reg.Rdx, payload(item.a))
        run self.a.store(Width.W64, word(item.c), Reg.Rax)
        run self.a.store(Width.W64, payload(item.c), Reg.Rdx)
        run self.retain(Reg.Rax, Reg.Rdx)
      }
      let owned = !item.flag && item.b >= p.operandAt(0)
      let mut request = engine.SERVICE_CONCAT
      if !owned { request = request | engine.CONCAT_BORROWED }
      // The result of an add on the stack may take a following literal with it (CONCAT_STACK).
      if item.c >= p.operandAt(0) && item.pc < 0x10000 { request = request | engine.CONCAT_STACK | u64.shiftLeft(u32.toU64(item.pc), 16) }
      if item.flag { run self.argumentBase() run self.a.lea(Width.W64, Reg.R9, Mem.at(Reg.Rcx, item.b)) }
      else { run self.a.lea(Width.W64, Reg.R9, word(item.b)) }
      run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(request))
      run self.a.lea(Width.W64, Reg.R8, word(item.c))
      run self.engineCall()
      run self.a.test(Width.W64, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, item.back)
      run self.a.cmp8Imm(Reg.Rax, 1)
      run self.a.jcc(Cond.Equal, threw)
      run self.a.cmp8Imm(Reg.Rax, u64.wrappingToU8(engine.SERVICE_MOVED))
      run self.a.jcc(Cond.Equal, self.moved)
      if item.c != item.a { run self.releaseCell(item.c) }
      run self.a.jmp(item.other)
      return ()
    }
    if item.kind == S_EQUAL {
      run self.a.lea(Width.W64, Reg.Rsi, word(item.a))
      run self.a.lea(Width.W64, Reg.Rdx, word(item.b))
      run self.a.movImm32(Reg.Rcx, item.k)
      run self.helper(env.EQUAL)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, item.other)
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == S_CELL {
      // helper k(env, cell a, b).
      run self.a.lea(Width.W64, Reg.Rsi, word(item.a))
      run self.a.movImm32(Reg.Rdx, i32.wrappingToU32(item.b))
      run self.helper(item.k)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, item.other)
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == S_TRUTHY || item.kind == S_TRUTH {
      // The value in cell a, consumed (S_TRUTHY) or kept: true goes to other, false to back.
      // An object (but the falsy kind), a flat string by its length, undefined, null and an
      // Int are answered here; the helper has the rest.
      let consumed = item.kind == S_TRUTHY
      let general = run self.a.label()
      let unlike = run self.a.label()
      let text = run self.a.label()
      let empty = run self.a.label()
      run self.tagIs(word(item.a), p.object(), unlike)
      run self.a.load(Width.W64, Reg.R11, payload(item.a))
      run self.a.loadZero8(Reg.R10, Mem.at(Reg.R11, signed(p.fields.objectFlags)))
      run self.a.testImm(Width.W32, Reg.R10, signed(f.falsyObject))
      run self.a.jcc(Cond.NotEqual, general)
      if consumed { run self.releaseCell(item.a) }
      run self.a.jmp(item.other)
      self.a.bind(unlike)
      run self.a.cmp8MemImm(word(item.a), i32.wrappingToU8(p.undefined()))
      run self.a.jcc(Cond.Equal, item.back)
      run self.a.cmp8MemImm(word(item.a), i32.wrappingToU8(p.null()))
      run self.a.jcc(Cond.Equal, item.back)
      run self.a.cmp8MemImm(word(item.a), i32.wrappingToU8(p.tag(-7)))
      run self.a.jcc(Cond.Equal, text)
      run self.tagIs(word(item.a), p.int(), general)
      run self.a.load(Width.W32, Reg.Rax, payload(item.a))
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.NotEqual, item.other)
      run self.a.jmp(item.back)
      self.a.bind(text)
      run self.a.load(Width.W64, Reg.R11, payload(item.a))
      run self.a.load(Width.W32, Reg.Rax, Mem.at(Reg.R11, signed(f.stringLength)))
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, empty)
      if consumed { run self.releaseCell(item.a) }
      run self.a.jmp(item.other)
      self.a.bind(empty)
      if consumed { run self.releaseCell(item.a) }
      run self.a.jmp(item.back)
      self.a.bind(general)
      run self.a.lea(Width.W64, Reg.Rsi, word(item.a))
      if item.kind == S_TRUTHY { run self.helper(env.TRUTHY) } else { run self.helper(env.TRUTH) }
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.NotEqual, item.other)
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == S_BACK_EDGE {
      // A taken backward branch to pc (label other): charge the counter, poll when it runs out.
      // The counter is the function's realm's (js_interrupts.counter).
      run self.bytecodeInto(Reg.Rax)
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, signed(f.bytecodeRealm)))
      run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.Rax, signed(f.interruptCounter)), 1)
      run self.a.jcc(Cond.Greater, item.other)
      run self.a.storeImm(Width.W32, Mem.at(Reg.Rax, signed(f.interruptCounter)), signed(f.interruptPeriod))
      run self.poll(u32.toUsize(item.pc), signed(item.depth), item.other)
      return ()
    }
    if item.kind == S_VARIABLE {
      // get_var k into cell a, or (flag) put_var k of cell a, through the engine; 0: the
      // interpreter runs it.
      run self.a.load(Width.W64, Reg.Rsi, p.sf(f.currentFunction + 8))
      if p.known { run self.a.movImm32(Reg.Rdx, item.k | engine.KNOWN_VARIABLE) } else { run self.a.movImm32(Reg.Rdx, item.k) }
      run self.a.lea(Width.W64, Reg.Rcx, word(item.a))
      if item.flag { run self.helper(env.PUT_VAR) } else { run self.helper(env.GET_VAR) }
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, item.other)
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == S_ATTACHED {
      // The variable cell in rax lives in a frame: r11 = its local's cell (an argument is
      // the engine's, at other).
      run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.Rax, signed(f.refFrame)))
      run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.Rax, signed(f.refSlot)))
      run self.a.mov(Width.W64, Reg.R10, Reg.R9)
      run self.a.shiftImm(Shift.Shr, Width.W64, Reg.R10, 48)
      run self.a.testImm(Width.W32, Reg.R10, 1)
      run self.a.jcc(Cond.NotEqual, item.other)
      run self.a.mov(Width.W32, Reg.R9, Reg.R9)
      run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R9, 4)
      run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, signed(f.localsData)))
      run self.a.alu(Alu.Add, Width.W64, Reg.R11, Reg.R9)
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == S_LENGTH {
      // The length of the string in cell b (an argument's offset when flag) into cell a;
      // other: not a string. A flat string's is read here, and the string dropped when the
      // length takes its cell; a rope's is the helper's.
      let rope = run self.a.label()
      let mut source = framed(item.b)
      if item.flag { run self.argumentBase() source = Cell { base: Reg.Rcx, at: item.b } }
      run self.a.cmp8MemImm(source.word(), i32.wrappingToU8(p.tag(-7)))
      run self.a.jcc(Cond.NotEqual, rope)
      run self.a.load(Width.W64, Reg.R11, source.payload())
      run self.a.load(Width.W32, Reg.Rax, Mem.at(Reg.R11, signed(f.stringLength)))
      if !item.flag && item.a == item.b { run self.releaseCell(item.a) }
      run self.boxed(item.a, p.int(), Reg.Rax)
      run self.a.jmp(item.back)
      self.a.bind(rope)
      if item.flag { run self.a.lea(Width.W64, Reg.Rsi, Mem.at(Reg.Rcx, item.b)) }
      else { run self.a.lea(Width.W64, Reg.Rsi, word(item.b)) }
      run self.a.lea(Width.W64, Reg.Rdx, word(item.a))
      run self.helper(env.LENGTH)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, item.other)
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == S_TRUNCATE {
      // The Float64 in cell a becomes the Int it truncates to (ToInt32 of a double in the
      // Int range), in eax too; other: any other value, or a double out of range
      // (cvttsd2si's 0x80000000, which -2^31 itself gives as well).
      run self.tagIs(word(item.a), p.float(), item.other)
      run self.a.loadDouble(Xmm.Xmm0, payload(item.a))
      run self.a.doubleToInt(Width.W32, Reg.Rax, Xmm.Xmm0)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, -0x80000000)
      run self.a.jcc(Cond.Equal, item.other)
      run self.a.storeImm(Width.W64, word(item.a), p.int())
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == S_KNOWN {
      // A call of a known local function (its bytecode in cell a, k arguments after it) that
      // has baseline code, in the scope the interpreter would give it: the one of its level
      // on the caller's chain (js_scopes.atLevel). back: the result is stored; other: the
      // interpreter's (not such a value, or no code yet).
      let callee = item.a
      let found = run self.a.label()
      let walk = run self.a.label()
      let threw = run self.exit(u32.toUsize(item.pc) + 1, signed(item.depth), true)
      run self.tagIs(word(callee), p.tag(-2), item.other)
      run self.a.load(Width.W64, Reg.R11, payload(callee))
      run self.a.load(Width.W32, Reg.Rax, Mem.at(Reg.R11, signed(f.bytecodeBaseline)))
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, item.other)
      run self.a.storeImm(Width.W64, p.sf(f.currentPc), signed(item.pc + 1))
      run self.a.load(Width.W32, Reg.Rcx, Mem.at(Reg.R11, signed(f.knownLevel)))
      run self.a.movImm32(Reg.Rdi, 0)
      run self.a.test(Width.W32, Reg.Rcx, Reg.Rcx)
      run self.a.jcc(Cond.Equal, found)
      run self.scopeInto(Reg.Rdi)
      self.a.bind(walk)
      run self.a.aluLoad(Alu.Cmp, Width.W32, Reg.Rcx, Mem.at(Reg.Rdi, signed(f.scopeLevel)))
      run self.a.jcc(Cond.Equal, found)
      run self.a.load(Width.W64, Reg.Rdi, Mem.at(Reg.Rdi, signed(f.scopeParent)))
      run self.a.jmp(walk)
      self.a.bind(found)
      run self.a.load(Width.W64, Reg.R10, Mem.at(Reg.R13, signed(f.table)))
      run self.a.lea(Width.W64, Reg.Rsi, word(callee + 16))
      run self.a.movImm32(Reg.Rdx, item.k)
      if p.count { run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.R12, env.DIRECT_CALLS_OFFSET), 1) }
      run self.a.callMem(Mem.indexed(Reg.R10, Reg.Rax, Scale.Eight, -8))
      run self.a.cmp8Imm(Reg.Rax, i32.wrappingToU8(p.exception()))
      run self.a.jcc(Cond.Equal, threw)
      // The operands were borrowed for the call; the callee's cell holds a count of its bytecode.
      let mut index: u32 = 0
      while index <= item.k { run self.releaseCell(callee + signed(index * 16)) index = index + 1 }
      run self.a.store(Width.W64, word(callee), Reg.Rax)
      run self.a.store(Width.W64, payload(callee), Reg.Rdx)
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == S_NATIVE {
      // The callee (cell a, k arguments after it, flag a method call) is an object and no
      // bytecode function: the engine's call, which for a native is the frameless one the
      // interpreter makes. back: the result is in rax:rdx; other: it threw.
      run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.R12, env.SERVICE_CALLS_OFFSET), 1)
      let mut request = engine.SERVICE_CALL | engine.CALL_NATIVE
      if item.flag { request = request | engine.CALL_METHOD }
      run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(request))
      run self.a.lea(Width.W64, Reg.R8, word(item.a))
      run self.a.movImm32(Reg.R9, item.k)
      run self.engineCall()
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.NotEqual, item.other)
      run self.a.load(Width.W64, Reg.Rax, p.rec(f.result))
      run self.a.load(Width.W64, Reg.Rdx, p.rec(f.result + 8))
      run self.a.jmp(item.back)
      return ()
    }
    if item.kind == S_CALL {
      // The callee has no baseline code: through the engine. a is its cell, k the argument
      // count, flag a method call; other the exit of a call that threw.
      run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.R12, env.SERVICE_CALLS_OFFSET), 1)
      let mut request = engine.SERVICE_CALL
      if item.flag { request = request | engine.CALL_METHOD }
      run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(request))
      run self.a.lea(Width.W64, Reg.R8, word(item.a))
      run self.a.movImm32(Reg.R9, item.k)
      run self.engineCall()
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.NotEqual, item.other)
      run self.a.load(Width.W64, Reg.Rax, p.rec(f.result))
      run self.a.load(Width.W64, Reg.Rdx, p.rec(f.result + 8))
      run self.a.jmp(item.back)
      return ()
    }
  }

  // ---- Templates ------------------------------------------------------------------------

  /// Pushes a copy of the cell at (tagAt, payloadAt) into operand cell depth.
  effect fn pushCopy(self: &mut Self, tagAt: Mem, payloadAt: Mem, depth: i32) -> () ! OutOfMemoryError ? &mut Allocator {
    let dest = self.p.operandAt(depth)
    run self.a.load(Width.W64, Reg.Rax, tagAt)
    run self.a.load(Width.W64, Reg.Rdx, payloadAt)
    run self.a.store(Width.W64, word(dest), Reg.Rax)
    run self.a.store(Width.W64, payload(dest), Reg.Rdx)
    run self.retain(Reg.Rax, Reg.Rdx)
  }
  /// Pops the top operand (at depth - 1) into the local at `at`, or copies it (keep).
  effect fn storeLocal(self: &mut Self, at: i32, depth: i32, keep: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    let top = self.p.operandAt(depth - 1)
    run self.a.load(Width.W64, Reg.Rax, word(top))
    run self.a.load(Width.W64, Reg.Rdx, payload(top))
    if keep { run self.retain(Reg.Rax, Reg.Rdx) }
    run self.releaseCell(at)
    run self.a.store(Width.W64, word(at), Reg.Rax)
    run self.a.store(Width.W64, payload(at), Reg.Rdx)
  }
  effect fn pushInt(self: &mut Self, value: i32, depth: i32) -> () ! OutOfMemoryError ? &mut Allocator {
    let dest = self.p.operandAt(depth)
    run self.a.storeImm(Width.W64, word(dest), self.p.int())
    if value >= 0 { run self.a.storeImm(Width.W64, payload(dest), value) }
    else {
      run self.a.movImm32(Reg.Rax, i32.wrappingToU32(value))
      run self.a.store(Width.W64, payload(dest), Reg.Rax)
    }
  }
  /// The label a branch to target jumps to: the target itself, or for a backward branch a
  /// block that charges the interrupt counter first.
  effect fn edge(self: &mut Self, pc: usize, target: usize, depth: i32) -> Label ! OutOfMemoryError ? &mut Allocator {
    let label = self.labels.get(target)
    if target > pc { return label }
    return run self.slow(S_BACK_EDGE, label, label, 0, 0, 0, target, depth, Reg.Rax, false)
  }
  /// r11 = the address of the slot the inline key of the field instruction at pc names in
  /// the object of the cell at (tagAt, payloadAt), rsi = that object; or a jump to miss:
  /// not an object, or the key's shape version is not its shape's (js_vm_property_ops
  /// fieldKeyAt: version << 16 | slot at the operand + 4). Clobbers rax and r10.
  effect fn keyedSlot(self: &mut Self, tagAt: Mem, payloadAt: Mem, pc: usize, miss: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let fields = self.p.fields
    let objectTag = self.p.object()
    run self.tagIs(tagAt, objectTag, miss)
    run self.a.load(Width.W64, Reg.Rsi, payloadAt)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rsi, signed(fields.objectShape)))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, signed(fields.shapeVersion)))
    // version << 16 against the key leaves the slot index, or more when the versions differ
    // (a version stays far below 2^47: the key's top bits are flags).
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.Rax, 16)
    run self.a.load(Width.W64, Reg.R10, self.p.rec(self.p.f.code))
    run self.a.aluLoad(Alu.Xor, Width.W64, Reg.Rax, Mem.at(Reg.R10, self.p.codeDelta + signed(usize.toU32(pc + 5))))
    run self.a.aluImm(Alu.Cmp, Width.W64, Reg.Rax, 65535)
    run self.a.jcc(Cond.Above, miss)
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.Rax, 4)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.Rsi, signed(fields.objectSlots)))
    run self.a.alu(Alu.Add, Width.W64, Reg.R11, Reg.Rax)
  }
  /// Drops the count of the value in the slot at r11 before a store over it, or jumps to
  /// miss when it holds the last one (js_vm_property_ops.storeOwnSlot). Clobbers r9, r10.
  effect fn displace(self: &mut Self, miss: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let kept = run self.a.label()
    run self.unlessHeapAt(Mem.at(Reg.R11, 0), kept)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R11, 8))
    run self.a.aluStoreImm(Alu.Cmp, Width.W32, Mem.at(Reg.R9, 0), 1)
    run self.a.jcc(Cond.LessOrEqual, miss)
    run self.a.aluStoreImm(Alu.Sub, Width.W32, Mem.at(Reg.R9, 0), 1)
    self.a.bind(kept)
  }
  /// keyedSlot by the site cache entry of the get_field2 at pc (js_vm_property_ops
  /// readFieldCachedAt): an own entry of the object's shape version, or a prototype entry for
  /// it while RuntimeState.shapeEpoch is the entry's (then the slot is in the entry's
  /// holder). An exotic object's prototype entry misses. Clobbers rax, r8, r9, r10.
  effect fn cachedSlot(self: &mut Self, tagAt: Mem, payloadAt: Mem, pc: usize, miss: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let fields = self.p.fields
    let entries = signed(fields.fieldCache)
    let objectTag = self.p.object()
    let proto = run self.a.label()
    let found = run self.a.label()
    run self.tagIs(tagAt, objectTag, miss)
    run self.a.load(Width.W64, Reg.Rsi, payloadAt)
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rsi, signed(fields.objectShape)))
    run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, signed(fields.shapeVersion)))
    // r9 = the site (the operand's address), r8 = its entry less the cache's offset.
    run self.operandInto(Reg.R9, pc)
    run self.a.mov(Width.W64, Reg.R8, Reg.R9)
    run self.a.aluImm(Alu.And, Width.W32, Reg.R8, 4095)
    run self.a.imulImm(Width.W64, Reg.R8, Reg.R8, signed(fields.entryStride))
    run self.a.alu(Alu.Add, Width.W64, Reg.R8, Reg.R13)
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R9, Mem.at(Reg.R8, entries + signed(fields.entrySite)))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R8, entries + signed(fields.entryKey)))
    run self.a.mov(Width.W64, Reg.R10, Reg.R9)
    run self.a.shiftImm(Shift.Shr, Width.W64, Reg.R9, 16)
    run self.a.alu(Alu.Cmp, Width.W64, Reg.R9, Reg.Rax)
    run self.a.jcc(Cond.NotEqual, proto)
    run self.a.aluImm(Alu.And, Width.W32, Reg.R10, 65535)
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R10, 4)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.Rsi, signed(fields.objectSlots)))
    run self.a.alu(Alu.Add, Width.W64, Reg.R11, Reg.R10)
    run self.a.jmp(found)
    self.a.bind(proto)
    run self.a.loadZero8(Reg.R10, Mem.at(Reg.Rsi, signed(fields.objectFlags)))
    run self.a.testImm(Width.W32, Reg.R10, signed(fields.exotic))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.movImm64(Reg.R10, fields.protoKey)
    run self.a.alu(Alu.Or, Width.W64, Reg.Rax, Reg.R10)
    run self.a.alu(Alu.Cmp, Width.W64, Reg.R9, Reg.Rax)
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R8, entries + signed(fields.entryEpoch)))
    run self.a.aluLoad(Alu.Cmp, Width.W64, Reg.R9, Mem.at(Reg.R13, signed(fields.shapeEpoch)))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R8, entries + signed(fields.entryHolder)))
    run self.a.load(Width.W64, Reg.R9, Mem.at(Reg.R8, entries + signed(fields.entryHolderIndex)))
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R9, 4)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.R11, signed(fields.objectSlots)))
    run self.a.alu(Alu.Add, Width.W64, Reg.R11, Reg.R9)
    self.a.bind(found)
  }
  /// r11 = the address of the element the Int in cell index names in the fast Array in cell
  /// object, rsi = that Array; or a jump to miss: not a fast Array, not an Int, or outside
  /// its elements. Clobbers rax and r8.
  effect fn elementSlot(self: &mut Self, object: i32, index: i32, miss: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.elementSlotAt(framed(object), framed(index), miss)
  }
  /// elementSlot of cells anywhere; their base registers must not be rax, rsi, r8 or r11.
  effect fn elementSlotAt(self: &mut Self, object: Cell, index: Cell, miss: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let fields = self.p.fields
    let objectTag = self.p.object()
    let intTag = self.p.int()
    run self.tagIs(object.word(), objectTag, miss)
    run self.tagIs(index.word(), intTag, miss)
    run self.a.load(Width.W64, Reg.Rsi, object.payload())
    run self.a.loadZero16(Reg.R8, Mem.at(Reg.Rsi, signed(fields.objectClass)))
    run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R8, signed(fields.arrayClass))
    run self.a.jcc(Cond.NotEqual, miss)
    run self.a.loadZero8(Reg.R8, Mem.at(Reg.Rsi, signed(fields.objectFlags)))
    run self.a.testImm(Width.W32, Reg.R8, signed(fields.fastArray))
    run self.a.jcc(Cond.Equal, miss)
    run self.a.load(Width.W32, Reg.R8, index.payload())
    run self.a.aluLoad(Alu.Cmp, Width.W32, Reg.R8, Mem.at(Reg.Rsi, signed(fields.elementCount)))
    run self.a.jcc(Cond.AboveOrEqual, miss)
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.Rsi, signed(fields.elements)))
    run self.a.shiftImm(Shift.Shl, Width.W64, Reg.R8, 4)
    run self.a.alu(Alu.Add, Width.W64, Reg.R11, Reg.R8)
  }
  /// Both operands (cells a and b) must be Ints, else otherwise. Clobbers rax.
  effect fn bothInt(self: &mut Self, a: i32, b: i32, otherwise: Label) -> () ! OutOfMemoryError ? &mut Allocator {
    let intTag = self.p.int()
    run self.tagIs(word(a), intTag, otherwise)
    run self.tagIs(word(b), intTag, otherwise)
  }

  /// A call of the function in operand cell `callee` on argc arguments after it, with the
  /// cell before it as `this` when method; the result replaces them.
  effect fn call(self: &mut Self, pc: usize, depth: i32, argc: u32, method: bool, step: &Step) -> () ! OutOfMemoryError ? &mut Allocator {
    let f = self.p.f
    let p = self.p
    let callee = p.operandAt(depth - signed(argc) - 1)
    let mut first = callee
    if method { first = callee - 16 }
    let interpret = run self.bail(pc, depth, step)
    let threw = run self.exit(pc + 1, depth, true)
    let after = run self.a.label()
    let generic = run self.slow(S_CALL, after, threw, callee, 0, argc, pc, depth, Reg.Rax, method)
    // A closure object is called here; a known local function, which has no object, out of
    // line (S_KNOWN). What is not callable throws its own error in the interpreter.
    // f.apply(x, arguments) with the arguments object unmade is the interpreter's.
    if p.lazy && method && argc == 2 { run self.a.cmp8MemImm(word(callee + 32), i32.wrappingToU8(p.tag(4))) run self.a.jcc(Cond.Equal, interpret) }
    let native = run self.slow(S_NATIVE, after, threw, callee, 0, argc, pc, depth, Reg.Rax, method)
    let stored = run self.a.label()
    let mut other = interpret
    if !method { other = run self.slow(S_KNOWN, stored, interpret, callee, 0, argc, pc, depth, Reg.Rax, false) }
    run self.tagIs(word(callee), p.object(), other)
    run self.a.load(Width.W64, Reg.Rdi, payload(callee))
    run self.a.storeImm(Width.W64, p.sf(f.currentPc), signed(usize.toU32(pc + 1)))
    run self.a.cmp16MemImm(Mem.at(Reg.Rdi, signed(f.objectClass)), u32.wrappingToU16(f.bytecodeClass))
    run self.a.jcc(Cond.NotEqual, native)
    // r11, the callee's bytecode object, is part of the call.
    run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.Rdi, signed(f.closureBytecode)))
    run self.a.load(Width.W32, Reg.Rax, Mem.at(Reg.R11, signed(f.bytecodeBaseline)))
    run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
    run self.a.jcc(Cond.Equal, generic)
    run self.a.load(Width.W64, Reg.R10, Mem.at(Reg.R13, signed(f.table)))
    run self.a.lea(Width.W64, Reg.Rsi, word(callee + 16))
    run self.a.movImm32(Reg.Rdx, argc)
    if method {
      run self.a.load(Width.W64, Reg.Rcx, word(first))
      run self.a.load(Width.W64, Reg.R8, payload(first))
    } else {
      run self.a.movImm32(Reg.Rcx, i32.wrappingToU32(p.undefined()))
      run self.a.movImm32(Reg.R8, 0)
    }
    if p.count { run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.R12, env.DIRECT_CALLS_OFFSET), 1) }
    run self.a.callMem(Mem.indexed(Reg.R10, Reg.Rax, Scale.Eight, -8))
    run self.a.cmp8Imm(Reg.Rax, i32.wrappingToU8(p.exception()))
    run self.a.jcc(Cond.Equal, threw)
    self.a.bind(after)
    // The operands were borrowed for the call: drop them, then the result takes their place.
    let mut index: u32 = 0
    while index < argc { run self.releaseCell(callee + 16 + signed(index * 16)) index = index + 1 }
    // The callee is an object, as checked above.
    run self.a.load(Width.W64, Reg.R11, payload(callee))
    run self.releaseObject(Reg.R11)
    if method { run self.releaseCell(first) }
    run self.a.store(Width.W64, word(first), Reg.Rax)
    run self.a.store(Width.W64, payload(first), Reg.Rdx)
    self.a.bind(stored)
  }

  /// One template for the instruction at pc and the one after it, which no branch reaches and
  /// which only consumes what the first makes: the second's bytes, or 0 for no such pair.
  /// entered: a branch reaches the function's first instruction.
  effect fn fused(self: &mut Self, bytes: &[u8], pc: usize, depth: i32, step: &Step, entered: bool) -> usize ! OutOfMemoryError ? &mut Allocator {
    let f = self.p.f
    let p = self.p
    let opcode = bytes[pc]
    let second = pc + step.size
    let then = bytes[second]
    let follow = stepOf(bytes, second)
    if follow.size == 0 || follow.kind == DEPART { return 0 }
    if opcode == op.OP_push_this && ((then >= op.OP_put_loc0 && then <= op.OP_put_loc3) || then == op.OP_put_loc8) {
      // The receiver goes straight into the local.
      let mut index: u32 = 0
      if then == op.OP_put_loc8 { index = u8.toU32(bytes[second + 1]) } else { index = u8.toU32(then) - u8.toU32(op.OP_put_loc0) }
      if index >= p.locals { return 0 }
      let at = p.localAt(index)
      let other = run self.bailPair(pc, depth, step, &follow)
      run self.tagIs(p.sf(f.thisValue), p.object(), other)
      run self.a.load(Width.W64, Reg.Rdx, p.sf(f.thisValue + 8))
      run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.Rdx, 0), 1)
      // At the function's first instruction a local still holds undefined.
      if pc != 0 || entered { run self.releaseCell(at) }
      run self.a.storeImm(Width.W64, word(at), p.object())
      run self.a.store(Width.W64, payload(at), Reg.Rdx)
      return follow.size
    }
    if then != op.OP_if_false8 && then != op.OP_if_true8 && then != op.OP_if_false && then != op.OP_if_true { return 0 }
    let whenTrue = then == op.OP_if_true8 || then == op.OP_if_true
    let top = p.operandAt(depth - 1)
    let under = p.operandAt(depth - 2)
    if opcode == op.OP_is_undefined_or_null {
      // The test branches; no Bool is made.
      let taken = run self.edge(second, follow.target, depth - 1)
      let after = run self.a.label()
      let mut nullish = after
      if whenTrue { nullish = taken }
      run self.a.cmp8MemImm(word(top), i32.wrappingToU8(p.null()))
      run self.a.jcc(Cond.Equal, nullish)
      run self.a.cmp8MemImm(word(top), i32.wrappingToU8(p.undefined()))
      run self.a.jcc(Cond.Equal, nullish)
      run self.releaseCell(top)
      if !whenTrue { run self.a.jmp(taken) }
      self.a.bind(after)
      return follow.size
    }
    let equality = opcode == op.OP_eq || opcode == op.OP_neq || opcode == op.OP_strict_eq || opcode == op.OP_strict_neq
    let ordering = opcode == op.OP_lt || opcode == op.OP_lte || opcode == op.OP_gt || opcode == op.OP_gte
    if !equality && !ordering { return 0 }
    // Two Ints compare and branch. Anything else is the single templates' work: the
    // interpreter's, or a helper's Bool (== and != of what needs no coercion, an ordering of
    // two numbers), which the truthy path branches on.
    let taken = run self.edge(second, follow.target, depth - 2)
    let after = run self.a.label()
    let other = run self.bailPair(pc, depth, step, &follow)
    let mut mixed = other
    let mut onTrue = after
    let mut onFalse = taken
    if whenTrue { onTrue = taken onFalse = after }
    let test = run self.slow(S_TRUTHY, onFalse, onTrue, under, 0, 0, second, depth - 1, Reg.Rax, false)
    if ordering { mixed = run self.slow(S_ARITHMETIC, test, other, under, top, u8.toU32(opcode), pc, depth, Reg.Rax, false) }
    else {
      let mut k: u32 = 0
      if opcode == op.OP_neq || opcode == op.OP_strict_neq { k = 1 }
      if opcode == op.OP_strict_eq || opcode == op.OP_strict_neq { k = k + 2 }
      mixed = run self.slow(S_EQUAL, test, other, under, top, k, pc, depth, Reg.Rax, false)
    }
    run self.bothInt(under, top, mixed)
    run self.a.load(Width.W32, Reg.Rax, payload(under))
    run self.a.aluLoad(Alu.Cmp, Width.W32, Reg.Rax, payload(top))
    let mut cond = Cond.Equal
    let mut inverse = Cond.NotEqual
    if opcode == op.OP_neq || opcode == op.OP_strict_neq { cond = Cond.NotEqual inverse = Cond.Equal }
    if opcode == op.OP_lt { cond = Cond.Less inverse = Cond.GreaterOrEqual }
    if opcode == op.OP_lte { cond = Cond.LessOrEqual inverse = Cond.Greater }
    if opcode == op.OP_gt { cond = Cond.Greater inverse = Cond.LessOrEqual }
    if opcode == op.OP_gte { cond = Cond.GreaterOrEqual inverse = Cond.Less }
    if whenTrue { run self.a.jcc(cond, taken) } else { run self.a.jcc(inverse, taken) }
    self.a.bind(after)
    return follow.size
  }

  /// The template of the instruction at pc, entered with depth operands. False when it has
  /// none: the caller emits a jump to its exit.
  effect fn template(self: &mut Self, bytes: &[u8], pc: usize, depth: i32, step: &Step) -> bool ! OutOfMemoryError ? &mut Allocator {
    let f = self.p.f
    let p = self.p
    let opcode = bytes[pc]
    let top = p.operandAt(depth - 1)
    let under = p.operandAt(depth - 2)
    let next = p.operandAt(depth)
    // The fusion prefix may always do nothing: the instructions it covers run themselves.
    if opcode == op.OP_nop || opcode == op.OP_fuse_prefix { return true }
    if opcode == op.OP_push_this {
      // An object receiver needs no conversion; anything else is the interpreter's.
      let other = run self.bail(pc, depth, step)
      run self.tagIs(p.sf(f.thisValue), p.object(), other)
      run self.a.load(Width.W64, Reg.Rdx, p.sf(f.thisValue + 8))
      run self.a.storeImm(Width.W64, word(next), p.object())
      run self.a.store(Width.W64, payload(next), Reg.Rdx)
      run self.a.aluStoreImm(Alu.Add, Width.W32, Mem.at(Reg.Rdx, 0), 1)
      return true
    }
    if (opcode >= op.OP_get_loc0 && opcode <= op.OP_get_loc3) || opcode == op.OP_get_loc8 || opcode == op.OP_get_loc {
      let mut index: u32 = 0
      if opcode == op.OP_get_loc8 { index = u8.toU32(bytes[pc + 1]) }
      else if opcode == op.OP_get_loc { index = u16At(bytes, pc + 1) }
      else { index = u8.toU32(opcode - op.OP_get_loc0) }
      if index >= p.locals { return false }
      let at = p.localAt(index)
      run self.pushCopy(word(at), payload(at), depth)
      return true
    }
    if (opcode >= op.OP_put_loc0 && opcode <= op.OP_put_loc3) || opcode == op.OP_put_loc8 || opcode == op.OP_put_loc
      || opcode == op.OP_set_loc8 || opcode == op.OP_set_loc {
      let mut index: u32 = 0
      if opcode == op.OP_put_loc8 || opcode == op.OP_set_loc8 { index = u8.toU32(bytes[pc + 1]) }
      else if opcode == op.OP_put_loc || opcode == op.OP_set_loc { index = u16At(bytes, pc + 1) }
      else { index = u8.toU32(opcode - op.OP_put_loc0) }
      if index >= p.locals { return false }
      run self.storeLocal(p.localAt(index), depth, opcode == op.OP_set_loc8 || opcode == op.OP_set_loc)
      return true
    }
    if (opcode >= op.OP_get_arg0 && opcode <= op.OP_get_arg3) || opcode == op.OP_get_arg {
      let mut index: u32 = 0
      if opcode == op.OP_get_arg { index = u16At(bytes, pc + 1) } else { index = u8.toU32(opcode - op.OP_get_arg0) }
      if index >= p.arguments { return false }
      run self.a.load(Width.W64, Reg.Rcx, p.sf(f.argumentsData))
      run self.pushCopy(Mem.at(Reg.Rcx, signed(index * 16)), Mem.at(Reg.Rcx, signed(index * 16 + 8)), depth)
      return true
    }
    if opcode == op.OP_push_0 { run self.pushInt(0, depth) return true }
    if opcode == op.OP_push_1 { run self.pushInt(1, depth) return true }
    if opcode == op.OP_push_i8 { run self.pushInt(i8At(bytes, pc + 1), depth) return true }
    if opcode == op.OP_push_i16 { run self.pushInt(i16At(bytes, pc + 1), depth) return true }
    if opcode == op.OP_push_i32 { run self.pushInt(i32At(bytes, pc + 1), depth) return true }
    if opcode == op.OP_undefined { run self.a.storeImm(Width.W64, word(next), p.undefined()) return true }
    if opcode == op.OP_null { run self.a.storeImm(Width.W64, word(next), p.null()) return true }
    if opcode == op.OP_push_false || opcode == op.OP_push_true {
      run self.a.storeImm(Width.W64, word(next), p.boolean())
      let mut truth: i32 = 0
      if opcode == op.OP_push_true { truth = 1 }
      run self.a.storeImm(Width.W64, payload(next), truth)
      return true
    }
    if opcode == op.OP_drop { run self.releaseCell(top) return true }
    if opcode == op.OP_dup { run self.pushCopy(word(top), payload(top), depth) return true }
    if opcode == op.OP_return {
      // Operands under the result drop their counts, as the interpreter's release does.
      if depth < 1 || depth > 5 { return false }
      let mut cell: i32 = 0
      while cell < depth - 1 { run self.releaseCell(p.operandAt(cell)) cell = cell + 1 }
      run self.a.load(Width.W64, Reg.Rax, word(top))
      run self.a.load(Width.W64, Reg.Rdx, payload(top))
      run self.a.jmp(self.leave)
      return true
    }
    if opcode == op.OP_return_undef {
      if depth > 4 { return false }
      let mut cell: i32 = 0
      while cell < depth { run self.releaseCell(p.operandAt(cell)) cell = cell + 1 }
      run self.a.movImm32(Reg.Rax, i32.wrappingToU32(p.undefined()))
      run self.a.movImm32(Reg.Rdx, 0)
      run self.a.jmp(self.leave)
      return true
    }
    if opcode == op.OP_goto8 || opcode == op.OP_goto16 || opcode == op.OP_goto {
      let dest = run self.edge(pc, step.target, depth)
      run self.a.jmp(dest)
      return true
    }
    if opcode == op.OP_if_false8 || opcode == op.OP_if_true8 || opcode == op.OP_if_false || opcode == op.OP_if_true {
      let whenTrue = opcode == op.OP_if_true8 || opcode == op.OP_if_true
      let taken = run self.edge(pc, step.target, depth - 1)
      let after = run self.a.label()
      let mut onTrue = after
      let mut onFalse = taken
      if whenTrue { onTrue = taken onFalse = after }
      let other = run self.slow(S_TRUTHY, onFalse, onTrue, top, 0, 0, pc, depth, Reg.Rax, false)
      run self.tagIs(word(top), p.boolean(), other)
      run self.a.cmp8MemImm(payload(top), 0)
      if whenTrue { run self.a.jcc(Cond.NotEqual, taken) } else { run self.a.jcc(Cond.Equal, taken) }
      self.a.bind(after)
      return true
    }
    if opcode == op.OP_if_true_keep8 || opcode == op.OP_if_false_keep8 {
      // The taken branch keeps the value; the other drops it (a Bool has no count).
      let whenTrue = opcode == op.OP_if_true_keep8
      let taken = run self.edge(pc, step.target, depth)
      let after = run self.a.label()
      let dropped = run self.a.label()
      let mut onTrue = dropped
      let mut onFalse = taken
      if whenTrue { onTrue = taken onFalse = dropped }
      let other = run self.slow(S_TRUTH, onFalse, onTrue, top, 0, 0, pc, depth, Reg.Rax, false)
      run self.tagIs(word(top), p.boolean(), other)
      run self.a.cmp8MemImm(payload(top), 0)
      if whenTrue { run self.a.jcc(Cond.NotEqual, taken) } else { run self.a.jcc(Cond.Equal, taken) }
      run self.a.jmp(after)
      self.a.bind(dropped)
      run self.releaseCell(top)
      self.a.bind(after)
      return true
    }
    if opcode == op.OP_insert2 {
      // a b -> b a b
      run self.a.load(Width.W64, Reg.Rax, word(top))
      run self.a.load(Width.W64, Reg.Rdx, payload(top))
      run self.a.load(Width.W64, Reg.Rcx, word(under))
      run self.a.load(Width.W64, Reg.R8, payload(under))
      run self.a.store(Width.W64, word(next), Reg.Rax)
      run self.a.store(Width.W64, payload(next), Reg.Rdx)
      run self.a.store(Width.W64, word(top), Reg.Rcx)
      run self.a.store(Width.W64, payload(top), Reg.R8)
      run self.a.store(Width.W64, word(under), Reg.Rax)
      run self.a.store(Width.W64, payload(under), Reg.Rdx)
      run self.retain(Reg.Rax, Reg.Rdx)
      return true
    }
    if opcode == op.OP_lnot {
      let other = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let general = run self.slow(S_CELL, done, other, top, 0, env.NOT, pc, depth, Reg.Rax, false)
      run self.tagIs(word(top), p.boolean(), general)
      run self.a.aluStoreImm(Alu.Xor, Width.W32, payload(top), 1)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_object || opcode == op.OP_array_from {
      // Through the engine, without the interpreter: the literal's object from the shape its
      // site learned, or the array of the values on the stack.
      let other = run self.bail(pc, depth, step)
      run self.quick(usize.toU32(pc), next)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.NotEqual, other)
      return true
    }
    if opcode == op.OP_define_field {
      // A literal born with its final shape takes the value into the slot its site cached;
      // anything else is the engine's.
      let other = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let miss = run self.slow(S_QUICK, done, other, next, 0, 0, pc, depth, Reg.Rax, false)
      run self.definedSlot(word(under), payload(under), pc, miss)
      run self.displace(miss)
      run self.a.load(Width.W64, Reg.Rax, word(top))
      run self.a.load(Width.W64, Reg.Rdx, payload(top))
      run self.a.store(Width.W64, Mem.at(Reg.R11, 0), Reg.Rax)
      run self.a.store(Width.W64, Mem.at(Reg.R11, 8), Reg.Rdx)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_instanceof {
      let other = run self.bail(pc, depth, step)
      run self.a.lea(Width.W64, Reg.Rsi, word(under))
      run self.a.movImm32(Reg.Rdx, 0)
      run self.helper(env.INSTANCE_OF)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, other)
      return true
    }
    if opcode == op.OP_typeof_is || opcode == op.OP_typeof_is_undefined || opcode == op.OP_typeof_is_function {
      let other = run self.bail(pc, depth, step)
      let mut how = u8.toU32(opcode)
      if opcode == op.OP_typeof_is { how = how | u32.shiftLeft(u8.toU32(bytes[pc + 1]), 8) }
      run self.a.lea(Width.W64, Reg.Rsi, word(top))
      run self.a.movImm32(Reg.Rdx, how)
      run self.helper(env.TYPEOF_IS)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, other)
      return true
    }
    if opcode == op.OP_get_length {
      // An Array's length is its first own property, a plain number (js_vm_property_ops
      // lengthOperand); any other value's is the interpreter's.
      let other = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let text = run self.slow(S_LENGTH, done, other, top, top, 0, pc, depth, Reg.Rax, false)
      run self.tagIs(word(top), p.object(), text)
      run self.a.load(Width.W64, Reg.Rsi, payload(top))
      run self.a.cmp16MemImm(Mem.at(Reg.Rsi, signed(p.fields.objectClass)), u32.wrappingToU16(p.fields.arrayClass))
      run self.a.jcc(Cond.NotEqual, other)
      run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.Rsi, signed(p.fields.objectSlots)))
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, 0))
      run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.R11, 8))
      run self.a.store(Width.W64, word(top), Reg.Rax)
      run self.a.store(Width.W64, payload(top), Reg.Rdx)
      run self.releaseObject(Reg.Rsi)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_push_atom_value || opcode == op.OP_push_empty_string {
      let other = run self.bail(pc, depth, step)
      let mut atom = atoms.JS_ATOM_empty_string
      if opcode == op.OP_push_atom_value { atom = u32At(bytes, pc + 1) }
      run self.a.movImm32(Reg.Rsi, atom)
      run self.a.lea(Width.W64, Reg.Rdx, word(next))
      run self.helper(env.ATOM_VALUE)
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, other)
      return true
    }
    if opcode == op.OP_call_constructor {
      // Through the engine: function, new.target, arguments; the result replaces them.
      let argc = u16At(bytes, pc + 1)
      let callee = p.operandAt(depth - signed(argc) - 2)
      let threw = run self.exit(pc + 1, depth, true)
      run self.a.storeImm(Width.W64, p.sf(f.currentPc), signed(usize.toU32(pc + 1)))
      run self.a.aluStoreImm(Alu.Add, Width.W64, Mem.at(Reg.R12, env.SERVICE_CALLS_OFFSET), 1)
      run self.a.movImm32(Reg.Rcx, u64.wrappingToU32(engine.SERVICE_CONSTRUCT))
      run self.a.lea(Width.W64, Reg.R8, word(callee))
      run self.a.movImm32(Reg.R9, argc)
      run self.engineCall()
      run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.NotEqual, threw)
      let mut index: u32 = 0
      while index < argc + 2 { run self.releaseCell(callee + signed(index * 16)) index = index + 1 }
      run self.a.load(Width.W64, Reg.Rax, p.rec(f.result))
      run self.a.load(Width.W64, Reg.Rdx, p.rec(f.result + 8))
      run self.a.store(Width.W64, word(callee), Reg.Rax)
      run self.a.store(Width.W64, payload(callee), Reg.Rdx)
      return true
    }
    if opcode == op.OP_if_nullish8 || opcode == op.OP_if_not_nullish8 || opcode == op.OP_if_null8 || opcode == op.OP_if_not_null8 {
      // null (and undefined, for the nullish pair) against everything else, which has a count.
      let negated = opcode == op.OP_if_not_nullish8 || opcode == op.OP_if_not_null8
      let taken = run self.edge(pc, step.target, depth - 1)
      let after = run self.a.label()
      let mut nullish = taken
      if negated { nullish = after }
      run self.a.loadZero8(Reg.Rax, word(top))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, p.null())
      run self.a.jcc(Cond.Equal, nullish)
      if opcode == op.OP_if_nullish8 || opcode == op.OP_if_not_nullish8 {
        run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, p.undefined())
        run self.a.jcc(Cond.Equal, nullish)
      }
      run self.releaseCell(top)
      if negated { run self.a.jmp(taken) }
      self.a.bind(after)
      return true
    }
    if opcode == op.OP_is_undefined_or_null {
      let yes = run self.a.label()
      let done = run self.a.label()
      run self.a.loadZero8(Reg.Rax, word(top))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, p.null())
      run self.a.jcc(Cond.Equal, yes)
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.Rax, p.undefined())
      run self.a.jcc(Cond.Equal, yes)
      run self.releaseCell(top)
      run self.a.storeImm(Width.W64, payload(top), 0)
      run self.a.jmp(done)
      self.a.bind(yes)
      run self.a.storeImm(Width.W64, payload(top), 1)
      self.a.bind(done)
      run self.a.storeImm(Width.W64, word(top), p.boolean())
      return true
    }
    if opcode == op.OP_get_loc_field8 || opcode == op.OP_get_arg_field8 {
      let index = u8.toU32(bytes[pc + 13])
      let other = run self.bail(pc, depth, step)
      let done = run self.a.label()
      if opcode == op.OP_get_loc_field8 {
        if index >= p.locals { return false }
        let at = p.localAt(index)
        let miss = run self.slow(S_HELPER, done, other, at, next, env.GET_FIELD, pc, depth, Reg.Rax, false)
        run self.keyedSlot(word(at), payload(at), pc, miss)
      } else {
        if index >= p.arguments { return false }
        let miss = run self.slow(S_HELPER, done, other, signed(index * 16), next, env.GET_FIELD, pc, depth, Reg.Rax, true)
        run self.a.load(Width.W64, Reg.Rcx, p.sf(f.argumentsData))
        run self.keyedSlot(Mem.at(Reg.Rcx, signed(index * 16)), Mem.at(Reg.Rcx, signed(index * 16 + 8)), pc, miss)
      }
      run self.pushCopy(Mem.at(Reg.R11, 0), Mem.at(Reg.R11, 8), depth)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_get_field {
      let other = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let miss = run self.slow(S_HELPER, done, other, top, NO_CELL, env.GET_FIELD_TOP, pc, depth, Reg.Rax, false)
      run self.keyedSlot(word(top), payload(top), pc, miss)
      // The field replaces the object, which keeps it alive until its own count drops.
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, 0))
      run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.R11, 8))
      run self.a.store(Width.W64, word(top), Reg.Rax)
      run self.a.store(Width.W64, payload(top), Reg.Rdx)
      run self.retain(Reg.Rax, Reg.Rdx)
      run self.releaseObject(Reg.Rsi)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_get_field2 {
      // The object stays; its field is pushed, by the site cache.
      let other = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let miss = run self.slow(S_HELPER, done, other, top, next, env.GET_FIELD2, pc, depth, Reg.Rax, false)
      run self.cachedSlot(word(top), payload(top), pc, miss)
      run self.pushCopy(Mem.at(Reg.R11, 0), Mem.at(Reg.R11, 8), depth)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_get_array_el {
      let other = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let miss = run self.slow(S_HELPER, done, other, under, NO_CELL, env.GET_ELEMENT, pc, depth, Reg.Rax, false)
      run self.elementSlot(under, top, miss)
      // The element replaces the Array, which keeps it alive until its own count drops.
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, 0))
      run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.R11, 8))
      run self.a.store(Width.W64, word(under), Reg.Rax)
      run self.a.store(Width.W64, payload(under), Reg.Rdx)
      run self.retain(Reg.Rax, Reg.Rdx)
      run self.releaseObject(Reg.Rsi)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_put_array_el {
      // Inline: a value that is no heap reference over one that is none (FastArrayData.store
      // then changes no flag and no count). The rest is the engine's.
      let target = p.operandAt(depth - 3)
      let other = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let oldPlain = run self.a.label()
      let newPlain = run self.a.label()
      let miss = run self.slow(S_HELPER, done, other, target, NO_CELL, env.PUT_ELEMENT, pc, depth, Reg.Rax, false)
      run self.elementSlot(target, under, miss)
      run self.unlessHeapAt(Mem.at(Reg.R11, 0), oldPlain)
      run self.a.jmp(miss)
      self.a.bind(oldPlain)
      run self.a.load(Width.W64, Reg.Rax, word(top))
      run self.unlessHeap(Reg.Rax, newPlain)
      run self.a.jmp(miss)
      self.a.bind(newPlain)
      run self.a.load(Width.W64, Reg.Rdx, payload(top))
      run self.a.store(Width.W64, Mem.at(Reg.R11, 0), Reg.Rax)
      run self.a.store(Width.W64, Mem.at(Reg.R11, 8), Reg.Rdx)
      run self.releaseObject(Reg.Rsi)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_put_field {
      let other = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let miss = run self.slow(S_HELPER, done, other, under, top, env.PUT_FIELD | 256, pc, depth, Reg.Rax, false)
      run self.keyedSlot(word(under), payload(under), pc, miss)
      run self.displace(miss)
      // The operand's count moves into the slot; the object operand's drops.
      run self.a.load(Width.W64, Reg.Rax, word(top))
      run self.a.load(Width.W64, Reg.Rdx, payload(top))
      run self.a.store(Width.W64, Mem.at(Reg.R11, 0), Reg.Rax)
      run self.a.store(Width.W64, Mem.at(Reg.R11, 8), Reg.Rdx)
      run self.releaseObject(Reg.Rsi)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_put_loc_field_arg8 {
      let target = u8.toU32(bytes[pc + 13])
      let source = u8.toU32(bytes[pc + 14])
      if target >= p.locals || source >= p.arguments { return false }
      let other = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let at = p.localAt(target)
      let miss = run self.slow(S_HELPER_ARGUMENT, done, other, at, signed(source * 16), env.PUT_FIELD, pc, depth, Reg.Rax, false)
      run self.keyedSlot(word(at), payload(at), pc, miss)
      run self.displace(miss)
      run self.a.load(Width.W64, Reg.Rcx, p.sf(f.argumentsData))
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rcx, signed(source * 16)))
      run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.Rcx, signed(source * 16 + 8)))
      run self.a.store(Width.W64, Mem.at(Reg.R11, 0), Reg.Rax)
      run self.a.store(Width.W64, Mem.at(Reg.R11, 8), Reg.Rdx)
      run self.retain(Reg.Rax, Reg.Rdx)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_put_loc_field_loc8 {
      let target = u8.toU32(bytes[pc + 13])
      let source = u8.toU32(bytes[pc + 14])
      if target >= p.locals || source >= p.locals { return false }
      let other = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let at = p.localAt(target)
      let sourceAt = p.localAt(source)
      let miss = run self.slow(S_HELPER, done, other, at, sourceAt, env.PUT_FIELD, pc, depth, Reg.Rax, false)
      run self.keyedSlot(word(at), payload(at), pc, miss)
      run self.displace(miss)
      run self.a.load(Width.W64, Reg.Rax, word(sourceAt))
      run self.a.load(Width.W64, Reg.Rdx, payload(sourceAt))
      run self.a.store(Width.W64, Mem.at(Reg.R11, 0), Reg.Rax)
      run self.a.store(Width.W64, Mem.at(Reg.R11, 8), Reg.Rdx)
      run self.retain(Reg.Rax, Reg.Rdx)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_get_var {
      // The closure's variable cell: one that owns its value, or one still in its frame.
      let index = u16At(bytes, pc + 1)
      let other = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let found = run self.a.label()
      let miss = run self.slow(S_VARIABLE, done, other, next, 0, index, pc, depth, Reg.Rax, false)
      if f.refTag == u32.MAX || index > 4096 { run self.a.jmp(miss) self.a.bind(done) return true }
      let attached = run self.slow(S_ATTACHED, found, miss, 0, 0, 0, pc, depth, Reg.Rax, false)
      run self.a.load(Width.W64, Reg.Rax, p.sf(f.currentFunction + 8))
      if p.known { run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, signed(f.knownRefs))) }
      else { run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, signed(f.closureVarRefs))) }
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.Rax, signed(f.boxHeader + index * 8)))
      run self.a.test(Width.W64, Reg.Rax, Reg.Rax)
      run self.a.jcc(Cond.Equal, miss)
      run self.a.loadZero8(Reg.R10, Mem.at(Reg.Rax, signed(f.refTag)))
      run self.a.aluImm(Alu.Cmp, Width.W32, Reg.R10, signed(f.refDetached))
      run self.a.jcc(Cond.NotEqual, attached)
      run self.a.lea(Width.W64, Reg.R11, Mem.at(Reg.Rax, signed(f.refValue)))
      self.a.bind(found)
      // A binding still in its dead zone throws: the interpreter's.
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, 0))
      run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.R11, 8))
      run self.a.cmp8Imm(Reg.Rax, i32.wrappingToU8(p.tag(4)))
      run self.a.jcc(Cond.Equal, miss)
      run self.a.store(Width.W64, word(next), Reg.Rax)
      run self.a.store(Width.W64, payload(next), Reg.Rdx)
      run self.retain(Reg.Rax, Reg.Rdx)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_put_var {
      let other = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let store = run self.slow(S_VARIABLE, done, other, top, 0, u16At(bytes, pc + 1), pc, depth, Reg.Rax, true)
      run self.a.jmp(store)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_add_loc {
      let index = u8.toU32(bytes[pc + 1])
      if index >= p.locals { return false }
      run self.binary(op.OP_add, p.localAt(index), framed(top), p.localAt(index), false, pc, depth, step)
      return true
    }
    if opcode == op.OP_get_array_el3 {
      // a i -> a i a[i]
      let other = run self.bail(pc, depth, step)
      run self.elementSlot(under, top, other)
      run self.pushCopy(Mem.at(Reg.R11, 0), Mem.at(Reg.R11, 8), depth)
      return true
    }
    if opcode == op.OP_dup1 {
      // a b -> a a b
      run self.a.load(Width.W64, Reg.Rcx, word(top))
      run self.a.load(Width.W64, Reg.R8, payload(top))
      run self.a.load(Width.W64, Reg.Rax, word(under))
      run self.a.load(Width.W64, Reg.Rdx, payload(under))
      run self.a.store(Width.W64, word(next), Reg.Rcx)
      run self.a.store(Width.W64, payload(next), Reg.R8)
      run self.a.store(Width.W64, word(top), Reg.Rax)
      run self.a.store(Width.W64, payload(top), Reg.Rdx)
      run self.retain(Reg.Rax, Reg.Rdx)
      return true
    }
    if opcode == op.OP_perm3 {
      // a b c -> b a c
      let third = p.operandAt(depth - 3)
      run self.a.load(Width.W64, Reg.Rax, word(under))
      run self.a.load(Width.W64, Reg.Rdx, payload(under))
      run self.a.load(Width.W64, Reg.Rcx, word(third))
      run self.a.load(Width.W64, Reg.R8, payload(third))
      run self.a.store(Width.W64, word(third), Reg.Rax)
      run self.a.store(Width.W64, payload(third), Reg.Rdx)
      run self.a.store(Width.W64, word(under), Reg.Rcx)
      run self.a.store(Width.W64, payload(under), Reg.R8)
      return true
    }
    if opcode == op.OP_insert3 || opcode == op.OP_insert4 {
      // The top value goes under the count operands as well (js_vm_values.insertTop).
      let mut count: i32 = 3
      if opcode == op.OP_insert4 { count = 4 }
      run self.a.load(Width.W64, Reg.Rax, word(top))
      run self.a.load(Width.W64, Reg.Rdx, payload(top))
      let mut d: i32 = 1
      while d <= count {
        run self.a.load(Width.W64, Reg.Rcx, word(p.operandAt(depth - d)))
        run self.a.load(Width.W64, Reg.R8, payload(p.operandAt(depth - d)))
        run self.a.store(Width.W64, word(p.operandAt(depth + 1 - d)), Reg.Rcx)
        run self.a.store(Width.W64, payload(p.operandAt(depth + 1 - d)), Reg.R8)
        d = d + 1
      }
      run self.a.store(Width.W64, word(p.operandAt(depth - count)), Reg.Rax)
      run self.a.store(Width.W64, payload(p.operandAt(depth - count)), Reg.Rdx)
      run self.retain(Reg.Rax, Reg.Rdx)
      return true
    }
    if opcode == op.OP_call_method { run self.call(pc, depth, u16At(bytes, pc + 1), true, step) return true }
    if opcode == op.OP_call { run self.call(pc, depth, u16At(bytes, pc + 1), false, step) return true }
    if opcode >= op.OP_call0 && opcode <= op.OP_call3 { run self.call(pc, depth, u8.toU32(opcode - op.OP_call0), false, step) return true }
    if opcode == op.OP_eq || opcode == op.OP_neq || opcode == op.OP_strict_eq || opcode == op.OP_strict_neq {
      let negate = opcode == op.OP_neq || opcode == op.OP_strict_neq
      let done = run self.a.label()
      let other = run self.bail(pc, depth, step)
      let mut k: u32 = 0
      if negate { k = 1 }
      if opcode == op.OP_strict_eq || opcode == op.OP_strict_neq { k = k + 2 }
      let mixed = run self.slow(S_EQUAL, done, other, under, top, k, pc, depth, Reg.Rax, false)
      run self.bothInt(under, top, mixed)
      run self.a.load(Width.W32, Reg.Rax, payload(under))
      run self.a.aluLoad(Alu.Cmp, Width.W32, Reg.Rax, payload(top))
      if negate { run self.a.setcc(Cond.NotEqual, Reg.Rax) } else { run self.a.setcc(Cond.Equal, Reg.Rax) }
      run self.a.zeroExtend8(Reg.Rax, Reg.Rax)
      run self.boxed(under, p.boolean(), Reg.Rax)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_lt || opcode == op.OP_lte || opcode == op.OP_gt || opcode == op.OP_gte {
      let other = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let mixed = run self.slow(S_ARITHMETIC, done, other, under, top, u8.toU32(opcode), pc, depth, Reg.Rax, false)
      run self.bothInt(under, top, mixed)
      run self.a.load(Width.W32, Reg.Rax, payload(under))
      run self.a.aluLoad(Alu.Cmp, Width.W32, Reg.Rax, payload(top))
      let mut cond = Cond.Less
      if opcode == op.OP_lte { cond = Cond.LessOrEqual }
      if opcode == op.OP_gt { cond = Cond.Greater }
      if opcode == op.OP_gte { cond = Cond.GreaterOrEqual }
      run self.a.setcc(cond, Reg.Rax)
      run self.a.zeroExtend8(Reg.Rax, Reg.Rax)
      run self.boxed(under, p.boolean(), Reg.Rax)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_add || opcode == op.OP_sub || opcode == op.OP_mul { run self.binary(opcode, under, framed(top), under, false, pc, depth, step) return true }
    if opcode == op.OP_and || opcode == op.OP_or || opcode == op.OP_xor {
      // Ints whose result is an Int; another pair of numbers is the helper's, anything else
      // the interpreter's.
      let exit = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let other = run self.slow(S_ARITHMETIC, done, exit, under, top, u8.toU32(opcode), pc, depth, Reg.Rax, false)
      run self.bothInt(under, top, other)
      run self.a.load(Width.W32, Reg.Rax, payload(under))
      let mut operation = Alu.Add
      if opcode == op.OP_sub { operation = Alu.Sub }
      if opcode == op.OP_and { operation = Alu.And }
      if opcode == op.OP_or { operation = Alu.Or }
      if opcode == op.OP_xor { operation = Alu.Xor }
      run self.a.aluLoad(operation, Width.W32, Reg.Rax, payload(top))
      if opcode == op.OP_add || opcode == op.OP_sub { run self.a.jcc(Cond.Overflow, other) }
      run self.a.store(Width.W64, payload(under), Reg.Rax)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_div || opcode == op.OP_mod {
      // Two doubles divide in the slow path; the helper answers other numbers.
      let exit = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let other = run self.slow(S_ARITHMETIC, done, exit, under, top, u8.toU32(opcode), pc, depth, Reg.Rax, false)
      run self.a.jmp(other)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_add_loc_loc8 || opcode == op.OP_sub_loc_loc8 || opcode == op.OP_mul_loc_loc8 {
      let a = u8.toU32(bytes[pc + 1])
      let b = u8.toU32(bytes[pc + 2])
      if a >= p.locals || b >= p.locals { return false }
      let mut operator = op.OP_add
      if opcode == op.OP_sub_loc_loc8 { operator = op.OP_sub }
      if opcode == op.OP_mul_loc_loc8 { operator = op.OP_mul }
      run self.binary(operator, p.localAt(a), framed(p.localAt(b)), next, false, pc, depth, step)
      return true
    }
    if opcode == op.OP_add_top_loc8 || opcode == op.OP_sub_top_loc8 || opcode == op.OP_mul_top_loc8 {
      let b = u8.toU32(bytes[pc + 1])
      if b >= p.locals { return false }
      let mut operator = op.OP_add
      if opcode == op.OP_sub_top_loc8 { operator = op.OP_sub }
      if opcode == op.OP_mul_top_loc8 { operator = op.OP_mul }
      run self.binary(operator, top, framed(p.localAt(b)), top, false, pc, depth, step)
      return true
    }
    if opcode == op.OP_add_top_arg8 || opcode == op.OP_sub_top_arg8 || opcode == op.OP_mul_top_arg8 {
      let b = u8.toU32(bytes[pc + 1])
      if b >= p.arguments { return false }
      let mut operator = op.OP_add
      if opcode == op.OP_sub_top_arg8 { operator = op.OP_sub }
      if opcode == op.OP_mul_top_arg8 { operator = op.OP_mul }
      run self.argumentBase()
      run self.binary(operator, top, Cell { base: Reg.Rcx, at: signed(b * 16) }, top, true, pc, depth, step)
      return true
    }
    if opcode == op.OP_step_loc8 || opcode == op.OP_step_arg8 {
      // The slot steps by one (down when the mode has 2) and its new value (the mode has 1)
      // or its old one is pushed: an Int that stays one here.
      let index = u8.toU32(bytes[pc + 1])
      let mode = bytes[pc + 2]
      let mut cell = framed(0)
      if opcode == op.OP_step_loc8 {
        if index >= p.locals { return false }
        cell = framed(p.localAt(index))
      } else {
        if index >= p.arguments { return false }
        run self.argumentBase()
        cell = Cell { base: Reg.Rcx, at: signed(index * 16) }
      }
      let other = run self.bail(pc, depth, step)
      run self.tagIs(cell.word(), p.int(), other)
      run self.a.load(Width.W32, Reg.Rax, cell.payload())
      run self.a.mov(Width.W32, Reg.Rdx, Reg.Rax)
      if (mode & 2) != 0 { run self.a.aluImm(Alu.Sub, Width.W32, Reg.Rdx, 1) } else { run self.a.aluImm(Alu.Add, Width.W32, Reg.Rdx, 1) }
      run self.a.jcc(Cond.Overflow, other)
      run self.a.store(Width.W64, cell.payload(), Reg.Rdx)
      run self.a.storeImm(Width.W64, word(next), p.int())
      if (mode & 1) != 0 { run self.a.store(Width.W64, payload(next), Reg.Rdx) } else { run self.a.store(Width.W64, payload(next), Reg.Rax) }
      return true
    }
    if opcode == op.OP_post_inc || opcode == op.OP_post_dec {
      let other = run self.bail(pc, depth, step)
      run self.tagIs(word(top), p.int(), other)
      run self.a.load(Width.W32, Reg.Rax, payload(top))
      if opcode == op.OP_post_inc { run self.a.aluImm(Alu.Add, Width.W32, Reg.Rax, 1) } else { run self.a.aluImm(Alu.Sub, Width.W32, Reg.Rax, 1) }
      run self.a.jcc(Cond.Overflow, other)
      run self.boxed(next, p.int(), Reg.Rax)
      return true
    }
    if opcode == op.OP_shl || opcode == op.OP_sar || opcode == op.OP_shr {
      let exit = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let other = run self.slow(S_ARITHMETIC, done, exit, under, top, u8.toU32(opcode), pc, depth, Reg.Rax, false)
      run self.bothInt(under, top, other)
      run self.a.load(Width.W32, Reg.Rax, payload(under))
      run self.a.load(Width.W32, Reg.Rcx, payload(top))
      let mut shift = Shift.Shl
      if opcode == op.OP_sar { shift = Shift.Sar }
      if opcode == op.OP_shr { shift = Shift.Shr }
      run self.a.shiftCl(shift, Width.W32, Reg.Rax)
      if opcode == op.OP_shr {
        // Above the Int range with its top bit set: the helper makes the double.
        run self.a.test(Width.W32, Reg.Rax, Reg.Rax)
        run self.a.jcc(Cond.Sign, other)
      }
      run self.a.store(Width.W64, payload(under), Reg.Rax)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_shl_imm || opcode == op.OP_or_imm {
      let other = run self.bail(pc, depth, step)
      // x | 0 of a double in the Int range truncates it.
      let loaded = run self.a.label()
      let truncate = run self.slow(S_TRUNCATE, loaded, other, top, 0, 0, pc, depth, Reg.Rax, false)
      run self.tagIs(word(top), p.int(), truncate)
      run self.a.load(Width.W32, Reg.Rax, payload(top))
      self.a.bind(loaded)
      if opcode == op.OP_or_imm { run self.a.aluImm(Alu.Or, Width.W32, Reg.Rax, i16At(bytes, pc + 1)) }
      else {
        let count = i32.wrappingToU32(i16At(bytes, pc + 1)) & 31
        if count != 0 { run self.a.shiftImm(Shift.Shl, Width.W32, Reg.Rax, u32.wrappingToU8(count)) }
      }
      run self.a.store(Width.W64, payload(top), Reg.Rax)
      return true
    }
    if opcode == op.OP_neg || opcode == op.OP_not || opcode == op.OP_plus {
      // An Int whose result is one; the helper answers the other numbers.
      let other = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let general = run self.slow(S_CELL, done, other, top, u8.toI32(opcode), env.UNARY, pc, depth, Reg.Rax, false)
      run self.tagIs(word(top), p.int(), general)
      if opcode != op.OP_plus {
        run self.a.load(Width.W32, Reg.Rax, payload(top))
        if opcode == op.OP_neg {
          // Not 0 (its negation is -0) nor the minimum.
          run self.a.unary(Unary.Neg, Width.W32, Reg.Rax)
          run self.a.jcc(Cond.Overflow, general)
          run self.a.jcc(Cond.Equal, general)
        } else { run self.a.unary(Unary.Not, Width.W32, Reg.Rax) }
        run self.a.store(Width.W64, payload(top), Reg.Rax)
      }
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_strict_eq_imm8 || opcode == op.OP_strict_neq_imm8 {
      // Only a number equals the constant; any other value is released and differs.
      let k = i8At(bytes, pc + 1)
      let done = run self.a.label()
      let notInt = run self.a.label()
      let notNumber = run self.a.label()
      let mut same = Cond.Equal
      if opcode == op.OP_strict_neq_imm8 { same = Cond.NotEqual }
      run self.tagIs(word(top), p.int(), notInt)
      run self.a.aluStoreImm(Alu.Cmp, Width.W32, payload(top), k)
      run self.a.setcc(same, Reg.Rax)
      run self.a.zeroExtend8(Reg.Rax, Reg.Rax)
      run self.boxed(top, p.boolean(), Reg.Rax)
      run self.a.jmp(done)
      self.a.bind(notInt)
      run self.tagIs(word(top), p.float(), notNumber)
      run self.a.loadDouble(Xmm.Xmm0, payload(top))
      run self.a.movImm32(Reg.Rax, i32.wrappingToU32(k))
      run self.a.intToDouble(Width.W32, Xmm.Xmm1, Reg.Rax)
      run self.a.packed(PackedOp.Ucomisd, Xmm.Xmm0, Xmm.Xmm1)
      // Equal and ordered.
      run self.a.setcc(Cond.Equal, Reg.Rax)
      run self.a.setcc(Cond.NoParity, Reg.Rdx)
      run self.a.alu(Alu.And, Width.W32, Reg.Rax, Reg.Rdx)
      run self.a.aluImm(Alu.And, Width.W32, Reg.Rax, 1)
      if opcode == op.OP_strict_neq_imm8 { run self.a.aluImm(Alu.Xor, Width.W32, Reg.Rax, 1) }
      run self.boxed(top, p.boolean(), Reg.Rax)
      run self.a.jmp(done)
      self.a.bind(notNumber)
      run self.releaseCell(top)
      run self.a.storeImm(Width.W64, word(top), p.boolean())
      let mut differs: i32 = 0
      if opcode == op.OP_strict_neq_imm8 { differs = 1 }
      run self.a.storeImm(Width.W64, payload(top), differs)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_is_undefined || opcode == op.OP_is_null {
      let mut tag = p.undefined()
      if opcode == op.OP_is_null { tag = p.null() }
      run self.a.cmp8MemImm(word(top), i32.wrappingToU8(tag))
      run self.a.setcc(Cond.Equal, Reg.Rax)
      run self.a.zeroExtend8(Reg.Rax, Reg.Rax)
      run self.releaseCell(top)
      run self.boxed(top, p.boolean(), Reg.Rax)
      return true
    }
    if opcode == op.OP_nip {
      run self.releaseCell(under)
      run self.a.load(Width.W64, Reg.Rax, word(top))
      run self.a.load(Width.W64, Reg.Rdx, payload(top))
      run self.a.store(Width.W64, word(under), Reg.Rax)
      run self.a.store(Width.W64, payload(under), Reg.Rdx)
      return true
    }
    if opcode == op.OP_swap {
      run self.a.load(Width.W64, Reg.Rax, word(top))
      run self.a.load(Width.W64, Reg.Rdx, payload(top))
      run self.a.load(Width.W64, Reg.Rcx, word(under))
      run self.a.load(Width.W64, Reg.R8, payload(under))
      run self.a.store(Width.W64, word(under), Reg.Rax)
      run self.a.store(Width.W64, payload(under), Reg.Rdx)
      run self.a.store(Width.W64, word(top), Reg.Rcx)
      run self.a.store(Width.W64, payload(top), Reg.R8)
      return true
    }
    if opcode == op.OP_put_arg || opcode == op.OP_set_arg {
      let index = u16At(bytes, pc + 1)
      if index >= p.arguments { return false }
      run self.argumentBase()
      run self.storeInto(Cell { base: Reg.Rcx, at: signed(index * 16) }, depth, opcode == op.OP_set_arg)
      return true
    }
    if opcode == op.OP_push_const8 || opcode == op.OP_push_const {
      let mut index: u32 = 0
      if opcode == op.OP_push_const8 { index = u8.toU32(bytes[pc + 1]) } else { index = u32At(bytes, pc + 1) }
      if p.constantsWord == u32.MAX || p.constantsWord > 2040 || index >= p.constants { return false }
      // Through the closure to its bytecode's constants.
      run self.bytecodeInto(Reg.Rcx)
      run self.a.load(Width.W64, Reg.Rcx, Mem.at(Reg.Rcx, signed(p.constantsWord)))
      let at = p.constantsDelta + signed(index * 16)
      run self.pushCopy(Mem.at(Reg.Rcx, at), Mem.at(Reg.Rcx, at + 8), depth)
      return true
    }
    if opcode == op.OP_get_scope0 || opcode == op.OP_put_scope0 || opcode == op.OP_set_scope0 {
      // A slot of the scope the closure captured (the compiler emits these only where
      // there is one).
      let slot = u16At(bytes, pc + 1)
      if slot >= 4096 { return false }
      run self.scopeInto(Reg.Rcx)
      let cell = Cell { base: Reg.Rcx, at: signed(f.scopeSlots + slot * 16) }
      if opcode == op.OP_get_scope0 { run self.pushCopy(cell.word(), cell.payload(), depth) }
      else { run self.storeInto(cell, depth, opcode == op.OP_set_scope0) }
      return true
    }
    if opcode == op.OP_get_loc_el8 || opcode == op.OP_get_arg_el8 || opcode == op.OP_get_loc_el_arg8 || opcode == op.OP_get_arg_el_arg8 {
      // The element of a fast Array in a slot, named by the Int in another, with neither
      // retained; anything else is the interpreter's.
      let a = u8.toU32(bytes[pc + 1])
      let b = u8.toU32(bytes[pc + 2])
      let arrayArgument = opcode == op.OP_get_arg_el8 || opcode == op.OP_get_arg_el_arg8
      let indexArgument = opcode == op.OP_get_loc_el_arg8 || opcode == op.OP_get_arg_el_arg8
      let mut array = framed(0)
      let mut index = framed(0)
      if arrayArgument { if a >= p.arguments { return false } array = Cell { base: Reg.Rcx, at: signed(a * 16) } }
      else { if a >= p.locals { return false } array = framed(p.localAt(a)) }
      if indexArgument { if b >= p.arguments { return false } index = Cell { base: Reg.Rcx, at: signed(b * 16) } }
      else { if b >= p.locals { return false } index = framed(p.localAt(b)) }
      if arrayArgument || indexArgument { run self.argumentBase() }
      let other = run self.bail(pc, depth, step)
      run self.elementSlotAt(array, index, other)
      run self.pushCopy(Mem.at(Reg.R11, 0), Mem.at(Reg.R11, 8), depth)
      return true
    }
    if opcode == op.OP_get_loc_length8 || opcode == op.OP_get_arg_length8 {
      let index = u8.toU32(bytes[pc + 1])
      let mut cell = framed(0)
      if opcode == op.OP_get_loc_length8 {
        if index >= p.locals { return false }
        cell = framed(p.localAt(index))
      } else {
        if index >= p.arguments { return false }
        run self.argumentBase()
        cell = Cell { base: Reg.Rcx, at: signed(index * 16) }
      }
      let other = run self.bail(pc, depth, step)
      let done = run self.a.label()
      let text = run self.slow(S_LENGTH, done, other, next, cell.at, 0, pc, depth, Reg.Rax, opcode == op.OP_get_arg_length8)
      run self.tagIs(cell.word(), p.object(), text)
      run self.a.load(Width.W64, Reg.Rsi, cell.payload())
      run self.a.cmp16MemImm(Mem.at(Reg.Rsi, signed(p.fields.objectClass)), u32.wrappingToU16(p.fields.arrayClass))
      run self.a.jcc(Cond.NotEqual, other)
      run self.a.load(Width.W64, Reg.R11, Mem.at(Reg.Rsi, signed(p.fields.objectSlots)))
      run self.a.load(Width.W64, Reg.Rax, Mem.at(Reg.R11, 0))
      run self.a.load(Width.W64, Reg.Rdx, Mem.at(Reg.R11, 8))
      run self.a.store(Width.W64, word(next), Reg.Rax)
      run self.a.store(Width.W64, payload(next), Reg.Rdx)
      self.a.bind(done)
      return true
    }
    if opcode == op.OP_inc || opcode == op.OP_dec || opcode == op.OP_add_imm || opcode == op.OP_and_imm || opcode == op.OP_sar_imm {
      let other = run self.bail(pc, depth, step)
      run self.tagIs(word(top), p.int(), other)
      run self.a.load(Width.W32, Reg.Rax, payload(top))
      if opcode == op.OP_inc { run self.a.aluImm(Alu.Add, Width.W32, Reg.Rax, 1) run self.a.jcc(Cond.Overflow, other) }
      else if opcode == op.OP_dec { run self.a.aluImm(Alu.Sub, Width.W32, Reg.Rax, 1) run self.a.jcc(Cond.Overflow, other) }
      else if opcode == op.OP_add_imm { run self.a.aluImm(Alu.Add, Width.W32, Reg.Rax, i16At(bytes, pc + 1)) run self.a.jcc(Cond.Overflow, other) }
      else if opcode == op.OP_and_imm { run self.a.aluImm(Alu.And, Width.W32, Reg.Rax, i16At(bytes, pc + 1)) }
      else {
        let count = i32.wrappingToU32(i16At(bytes, pc + 1)) & 31
        if count != 0 { run self.a.shiftImm(Shift.Sar, Width.W32, Reg.Rax, u32.wrappingToU8(count)) }
      }
      run self.a.store(Width.W64, payload(top), Reg.Rax)
      return true
    }
    if opcode == op.OP_inc_loc || opcode == op.OP_dec_loc {
      let index = u8.toU32(bytes[pc + 1])
      if index >= p.locals { return false }
      let at = p.localAt(index)
      let other = run self.bail(pc, depth, step)
      run self.tagIs(word(at), p.int(), other)
      run self.a.load(Width.W32, Reg.Rax, payload(at))
      if opcode == op.OP_inc_loc { run self.a.aluImm(Alu.Add, Width.W32, Reg.Rax, 1) } else { run self.a.aluImm(Alu.Sub, Width.W32, Reg.Rax, 1) }
      run self.a.jcc(Cond.Overflow, other)
      run self.a.store(Width.W64, payload(at), Reg.Rax)
      return true
    }
    return false
  }
}

/// Compiles bytes, the bytecode of a function of shape, or refuses it.
pub effect fn compile(settings: &Settings, shape: &Shape, bytes: &[u8]) -> Outcome ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut uncovered = List<u8>.make()
  let mut stepped = List<u8>.make()
  if shape.codeWord == u32.MAX || shape.codeWord > 2040 { return Outcome { code: Option<Code>.none(), why: b"no word holds the code's address", uncovered: move uncovered, stepped: move stepped, map: List<u32>.make(), construct: 0 } }
  if bytes.length == 0 || bytes.length > 1048576 { return Outcome { code: Option<Code>.none(), why: b"no code, or too much", uncovered: move uncovered, stepped: move stepped, map: List<u32>.make(), construct: 0 } }
  if shape.arguments + shape.locals + shape.stack > 4096 { return Outcome { code: Option<Code>.none(), why: b"too many cells", uncovered: move uncovered, stepped: move stepped, map: List<u32>.make(), construct: 0 } }
  // Depths: every instruction a template can reach, with the operands on its stack there.
  let mut depths = List<i32>.make()
  // The instructions a branch reaches.
  let mut targets = List<bool>.make()
  let mut fill: usize = 0
  // The opcodes, for the tails (which exit left, --jit-stats).
  let mut codes = List<u8>.make()
  while fill < bytes.length { run depths.append(-1) run targets.append(false) run codes.append(bytes[fill]) fill = fill + 1 }
  let mut work = List<usize>.make()
  let mut lazy = false
  depths.set(0, 0)
  run work.append(0)
  while work.length() != 0 {
    let pc = work.get(work.length() - 1)
    let last = work.length() - 1
    drop work.remove(last)
    let depth = depths.get(pc)
    let step = stepOf(bytes, pc)
    if bytes[pc] == op.OP_special_object && pc + 1 < bytes.length && bytes[pc + 1] == engine.LAZY_ARGUMENTS { lazy = true }
    if step.size == 0 { return Outcome { code: Option<Code>.none(), why: b"bytes that are no instruction", uncovered: move uncovered, stepped: move stepped, map: List<u32>.make(), construct: 0 } }
    if step.kind == DEPART { continue }
    if depth < step.needs { return Outcome { code: Option<Code>.none(), why: b"an operand stack underflow", uncovered: move uncovered, stepped: move stepped, map: List<u32>.make(), construct: 0 } }
    let mut successors: [usize; 2] = [usize.MAX; 2]
    let mut entering: [i32; 2] = [0; 2]
    if step.kind == LEAP { continue }
    if step.kind == FALL || step.kind == BRANCH || step.kind == STEP { successors[0] = pc + step.size entering[0] = depth + step.fall }
    // A stepped instruction with a target is a catch: the engine brings the code to its handler.
    if step.kind == BRANCH || step.kind == JUMP || (step.kind == STEP && step.target != usize.MAX) {
      if step.target == usize.MAX { return Outcome { code: Option<Code>.none(), why: b"a branch out of the code", uncovered: move uncovered, stepped: move stepped, map: List<u32>.make(), construct: 0 } }
      successors[1] = step.target entering[1] = depth + step.taken
      if step.target < bytes.length { targets.set(step.target, true) }
    }
    let mut k: usize = 0
    while k < 2 {
      let successor = successors[k]
      k = k + 1
      if successor == usize.MAX { continue }
      if successor >= bytes.length { return Outcome { code: Option<Code>.none(), why: b"code that runs off its end", uncovered: move uncovered, stepped: move stepped, map: List<u32>.make(), construct: 0 } }
      let entered = entering[k - 1]
      if entered < 0 || entered > u32.wrappingToI32(shape.stack) { return Outcome { code: Option<Code>.none(), why: b"an operand stack out of bounds", uncovered: move uncovered, stepped: move stepped, map: List<u32>.make(), construct: 0 } }
      let known = depths.get(successor)
      if known == -1 { depths.set(successor, entered) run work.append(successor) }
      else if known != entered { return Outcome { code: Option<Code>.none(), why: b"two depths at one instruction", uncovered: move uncovered, stepped: move stepped, map: List<u32>.make(), construct: 0 } }
    }
  }
  if !shape.plain {
    // Refused, with what its code would have stepped or left at (for --jit-dump).
    let mut seen: usize = 0
    while seen < bytes.length {
      if depths.get(seen) >= 0 {
        let step = stepOf(bytes, seen)
        if step.kind == DEPART { run uncovered.append(bytes[seen]) }
        else if step.kind == STEP || step.kind == LEAP { run stepped.append(bytes[seen]) }
      }
      seen = seen + 1
    }
    let mut why = b"not a plain function: several reasons"
    if shape.odd == 1 { why = b"not a plain function: its kind" }
    else if shape.odd == 2 { why = b"not a plain function: captured variables" }
    else if shape.odd == 4 { why = b"not a plain function: own scope" }
    else if shape.odd == 6 { why = b"not a plain function: own scope and captured variables" }
    else if shape.odd == 8 { why = b"not a plain function: known local" }
    else if shape.odd == 10 { why = b"not a plain function: known local with captured variables" }
    else if shape.odd == 12 { why = b"not a plain function: known local with own scope" }
    else if shape.odd == 14 { why = b"not a plain function: known local with own scope and captured variables" }
    else if (shape.odd & 1) != 0 { why = b"not a plain function: its kind and more" }
    return Outcome { code: Option<Code>.none(), why: why, uncovered: move uncovered, stepped: move stepped, map: List<u32>.make(), construct: 0 }
  }
  let mut a = Assembler.make()
  let finish = run a.label()
  let stepEnded = run a.label()
  let leave = run a.label()
  let unused = run a.label()
  let overflow = run a.label()
  let entered = run a.label()
  let moved = run a.label()
  let table = run a.label()
  let mut labels = List<Label>.make()
  let mut at: usize = 0
  while at < bytes.length {
    if depths.get(at) >= 0 { let label = run a.label() run labels.append(label) } else { run labels.append(unused) }
    at = at + 1
  }
  // A resume entry (js_baseline.resumeOf) for a function with a return instruction to end
  // an entered activation at, and none that reads how it was called: the entered frame is
  // given the activation's argument cells, not the call's.
  let mut returnPc: u32 = u32.MAX
  let mut returnsValue = false
  let mut resumable = true
  let mut scan: usize = 0
  while scan < bytes.length {
    if depths.get(scan) >= 0 {
      let opcode = bytes[scan]
      if opcode == op.OP_special_object || opcode == op.OP_rest { resumable = false }
      if opcode == op.OP_return && !returnsValue { returnPc = usize.toU32(scan) returnsValue = true }
      if opcode == op.OP_return_undef && returnPc == u32.MAX { returnPc = usize.toU32(scan) }
    }
    scan = scan + 1
  }
  if !resumable { returnPc = u32.MAX }
  let mut plan = Plan.of(settings, shape)
  plan.lazy = lazy
  let mut emitter = Emitter { a: move a, p: plan, exits: List<Exit>.make(), slows: List<Slow>.make(), labels: move labels, codes: move codes, finish: finish, stepEnded: stepEnded, leave: leave, overflow: overflow, entered: entered, moved: moved, table: table, returnPc: returnPc, returnsValue: returnsValue, map: List<u32>.make() }
  run emitter.mark(0, MARK_PROLOGUE)
  run emitter.prologue(shape)
  let mut pc: usize = 0
  let mut falls = true
  while pc < bytes.length {
    let depth = depths.get(pc)
    if depth < 0 {
      // Not reached by any template: skip to the next reached instruction.
      pc = pc + 1
      continue
    }
    let step = stepOf(bytes, pc)
    run emitter.mark(usize.toU32(pc), u8.toU32(bytes[pc]))
    emitter.a.bind(emitter.labels.get(pc))
    let mut covered = false
    let mut extra: usize = 0
    if step.kind == FALL {
      let second = pc + step.size
      if second < bytes.length && !targets.get(second) { extra = run emitter.fused(bytes, pc, depth, &step, targets.get(0)) }
    }
    if extra != 0 { covered = true }
    else if step.kind == STEP || step.kind == LEAP { run emitter.stepped(bytes[pc], pc, depth, &step) run stepped.append(bytes[pc]) covered = true }
    else if step.kind != DEPART { covered = run emitter.template(bytes, pc, depth, &step) }
    if !covered && (step.kind == FALL || step.kind == BRANCH || step.kind == JUMP) {
      // No template for this form of it: the engine runs it alone.
      run emitter.stepped(bytes[pc], pc, depth, &step)
      run stepped.append(bytes[pc])
      covered = true
    }
    if !covered {
      let other = run emitter.exit(pc, depth, false)
      run emitter.a.jmp(other)
      run uncovered.append(bytes[pc])
    }
    falls = covered && (step.kind == FALL || step.kind == BRANCH || step.kind == STEP)
    pc = pc + step.size + extra
  }
  // Verified bytecode never runs off its end; a template that fell through here would.
  if falls { run emitter.a.ud2() }
  emitter.a.bind(unused)
  run emitter.a.ud2()
  run emitter.tails(shape)
  match move emitter {
    Emitter { a: assembler, map: places, .. } => {
      let mut map = move places
      let mut code = run assembler.finishPlaced(&mut map, 3)
      let mut construct: u32 = 0
      let mut table: u32 = 0
      let mut resume: u32 = 0
      let mut place: usize = 0
      while place + 2 < map.length() {
        if map.get(place + 2) == MARK_CONSTRUCT { construct = map.get(place) }
        if map.get(place + 2) == MARK_TABLE { table = map.get(place) }
        if map.get(place + 2) == MARK_RESUME { resume = map.get(place) }
        place = place + 3
      }
      // The distance to the resume entry, in the word before the construct entry.
      if resume > construct && construct >= 4 {
        let distance = resume - construct
        let word = u32.toUsize(construct) - 4
        code.bytes.set(word, u32.wrappingToU8(distance & 0xff))
        code.bytes.set(word + 1, u32.wrappingToU8(u32.shiftRight(distance, 8) & 0xff))
        code.bytes.set(word + 2, u32.wrappingToU8(u32.shiftRight(distance, 16) & 0xff))
        code.bytes.set(word + 3, u32.wrappingToU8(u32.shiftRight(distance, 24)))
      }
      // The resume table: every instruction that has code of its own.
      place = 0
      while place + 2 < map.length() {
        let at = map.get(place)
        let pc = u32.toUsize(map.get(place + 1))
        if map.get(place + 2) < 0x100 && at < table && table - at <= 0xffffff && depths.get(pc) >= 0 && depths.get(pc) < 0x100 {
          let word = (table - at) | u32.shiftLeft(i32.wrappingToU32(depths.get(pc)), 24)
          let slot = u32.toUsize(table) + pc * 4
          code.bytes.set(slot, u32.wrappingToU8(word & 0xff))
          code.bytes.set(slot + 1, u32.wrappingToU8(u32.shiftRight(word, 8) & 0xff))
          code.bytes.set(slot + 2, u32.wrappingToU8(u32.shiftRight(word, 16) & 0xff))
          code.bytes.set(slot + 3, u32.wrappingToU8(u32.shiftRight(word, 24)))
        }
        place = place + 3
      }
      return Outcome { code: Option<Code>.some(move code), why: b"", uncovered: move uncovered, stepped: move stepped, map: move map, construct: construct }
    }
  }
}

/// The entry from the engine (js_baseline.Enter): the C ABI on one side, the baseline
/// calling convention on the other.
pub effect fn entryStub(settings: &Settings) -> Code ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut a = Assembler.make()
  let threw = run a.label()
  let done = run a.label()
  // env rdi, function (or a known local function's scope) rsi, argv rdx, argc rcx,
  // receiver r8, out r9; the code and the bytecode object on the stack.
  run a.push(Reg.Rbp)
  run a.mov(Width.W64, Reg.Rbp, Reg.Rsp)
  // FRAME_STOP where a baseline frame keeps its state: the frames above are not the code's.
  run a.movImm32(Reg.Rax, 0)
  run a.push(Reg.Rax)
  run a.push(Reg.Rax)
  run a.push(Reg.R12)
  run a.push(Reg.R13)
  run a.push(Reg.Rbx)
  run a.aluImm(Alu.Sub, Width.W64, Reg.Rsp, 8)
  run a.mov(Width.W64, Reg.R12, Reg.Rdi)
  run a.load(Width.W64, Reg.R13, Mem.at(Reg.R12, 0))
  run a.mov(Width.W64, Reg.Rbx, Reg.R9)
  run a.load(Width.W64, Reg.R11, Mem.at(Reg.Rbp, 24))
  run a.mov(Width.W64, Reg.Rdi, Reg.Rsi)
  run a.mov(Width.W64, Reg.Rsi, Reg.Rdx)
  run a.mov(Width.W64, Reg.Rdx, Reg.Rcx)
  run a.load(Width.W64, Reg.Rcx, Mem.at(Reg.R8, 0))
  run a.load(Width.W64, Reg.R8, Mem.at(Reg.R8, 8))
  run a.callMem(Mem.at(Reg.Rbp, 16))
  run a.zeroExtend8(Reg.Rcx, Reg.Rax)
  run a.aluImm(Alu.Cmp, Width.W32, Reg.Rcx, signed(settings.layout.tagOf(6)))
  run a.jcc(Cond.Equal, threw)
  run a.store(Width.W64, Mem.at(Reg.Rbx, 0), Reg.Rax)
  run a.store(Width.W64, Mem.at(Reg.Rbx, 8), Reg.Rdx)
  run a.movImm32(Reg.Rax, 0)
  a.bind(done)
  run a.aluImm(Alu.Add, Width.W64, Reg.Rsp, 8)
  run a.pop(Reg.Rbx)
  run a.pop(Reg.R13)
  run a.pop(Reg.R12)
  run a.aluImm(Alu.Add, Width.W64, Reg.Rsp, 16)
  run a.pop(Reg.Rbp)
  run a.ret()
  a.bind(threw)
  run a.movImm32(Reg.Rax, 1)
  run a.jmp(done)
  return run a.finish()
}

/// RELEASE_STUB: the value whose tag word is in r10 and payload in r11 loses a count through
/// the engine; every register is as it was on return.
pub effect fn releaseStub() -> Code ! OutOfMemoryError | UnboundLabelError ? &mut Allocator {
  let mut a = Assembler.make()
  run a.push(Reg.Rax)
  run a.push(Reg.Rcx)
  run a.push(Reg.Rdx)
  run a.push(Reg.Rsi)
  run a.push(Reg.Rdi)
  run a.push(Reg.R8)
  run a.push(Reg.R9)
  // The value, as a ValueBits on the stack: tag word first.
  run a.push(Reg.R11)
  run a.push(Reg.R10)
  run a.mov(Width.W64, Reg.Rdi, Reg.R12)
  run a.mov(Width.W64, Reg.Rsi, Reg.Rsp)
  run a.callMem(Mem.at(Reg.R12, env.helperOffset(env.RELEASE)))
  run a.pop(Reg.R10)
  run a.pop(Reg.R11)
  run a.pop(Reg.R9)
  run a.pop(Reg.R8)
  run a.pop(Reg.Rdi)
  run a.pop(Reg.Rsi)
  run a.pop(Reg.Rdx)
  run a.pop(Reg.Rcx)
  run a.pop(Reg.Rax)
  run a.ret()
  return run a.finish()
}
