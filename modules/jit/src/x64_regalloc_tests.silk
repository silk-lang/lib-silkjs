// The register allocator's intervals and assignment (x64_regalloc), checked on the hand-built
// sum loop of x64_backend_tests; the backend tests run the code it leads to.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.num.u32
import silk.testing.testing { AssertionError, Testing }
import ssa { Function, Type }
import x64_regalloc { Allocation, SPILL }
import x64_regalloc as regalloc
import x64_backend_tests { sumFunction }

/// Whether no two values with overlapping intervals share a register of the same pool.
fn disjoint(f: &Function, places: &Allocation) -> bool {
  let mut v: u32 = 0
  while v < f.valueCount() {
    let mut w: u32 = v + 1
    while w < f.valueCount() {
      let kind = places.kind(v)
      if kind != SPILL && kind == places.kind(w) && places.register(v) == places.register(w) {
        let overlap = places.starts.get(u32.toUsize(v)) <= places.ends.get(u32.toUsize(w)) && places.starts.get(u32.toUsize(w)) <= places.ends.get(u32.toUsize(v))
        if overlap { return false }
      }
      w = w + 1
    }
    v = v + 1
  }
  return true
}

test effect fn sumLoopLivesInRegisters() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let f = run sumFunction() |> Effect.provideMut<Allocator>(&mut allocator)
  let places = run regalloc.allocate(&f) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(disjoint(&f, &places), "values live at once never share a register")
  let mut spilled: u32 = 0
  let mut v: u32 = 0
  while v < f.valueCount() {
    let ty = f.value(v).ty
    if (ty == Type.I32 || ty == Type.Bool) && places.kind(v) == SPILL { spilled = spilled + 1 }
    v = v + 1
  }
  run Testing.expect(spilled == 0, "the loop's integers all get registers")
  run Testing.expect(places.savedMask != 0, "and the prologue saves the callee-saved ones it uses")
}
