//! Calls in the SSA form (workstream H, docs/jit/compiled-entry.md section 7.3): the shape
//! rules the verifier checks for `call.arg` and `call`, and what the backend needs to know
//! about a function's calls.
import silk.num.i32
import silk.num.u32
import silk.num.usize
import ssa { Function, Inst, Op, Type, Own, NONE }
import silkjs.js_compiled as compiled

/// Arguments a call may pass: the call area holds the function, the receiver and these.
pub const MAX_ARGUMENTS: u32 = 8
// js_compiled.CALL_AREA_SLOTS holds them.

/// A call's `k`: its argument count, plus its site kind (js_compiled.SITE_*) shifted left by 8,
/// which the backend writes to the block's CALL_SITE word as it is.
pub fn countOf(inst: Inst) -> u32 { return i32.wrappingToU32(inst.k) & 0xff }
pub fn kindOf(inst: Inst) -> u32 { return u32.shiftRight(i32.wrappingToU32(inst.k), 8) & 0xff }
/// A generic equality's bit 16: 1 for !=, which the backend's helper try needs (the engine
/// reads the opcode).
pub fn notEqualOf(inst: Inst) -> bool { return u32.shiftRight(i32.wrappingToU32(inst.k), 16) == 1 }
pub fn kAt(count: u32, kind: u32) -> i32 { return u32.wrappingToI32(count | u32.shiftLeft(kind, 8)) }

fn isValue(f: &Function, v: u32) -> bool { return f.value(v).ty == Type.Value }

/// Whether `inst`, a `call.arg` or `call` at instruction `index` of block `b`, is well formed:
/// a call's function and receiver are values (an argument may be an i32 or bool, boxed into
/// the call area), its `k` arguments are the `k` instructions right before it in
/// its block (`call.arg 0` to `k - 1`, in order), and every `call.arg` is part of one.
pub fn wellFormed(f: &Function, b: u32, index: u32, inst: Inst) -> bool {
  let block = f.blocks.get(u32.toUsize(b))
  let end = block.firstInst + block.instCount
  if inst.op == Op.CallArg {
    if inst.a == NONE || inst.result != NONE || inst.k < 0 || i32.wrappingToU32(inst.k) >= MAX_ARGUMENTS { return false }
    if index + 1 >= end { return false }
    let next = f.inst(index + 1)
    if next.op == Op.CallArg { return next.k == inst.k + 1 }
    return next.op == Op.Call && countOf(next) == i32.wrappingToU32(inst.k) + 1
  }
  if !isValue(f, inst.a) || !isValue(f, inst.b) || inst.result == NONE { return false }
  let result = f.value(inst.result)
  if result.ty != Type.Value || result.own != Own.Owned { return false }
  let count = countOf(inst)
  let kind = kindOf(inst)
  if inst.k < 0 || count > MAX_ARGUMENTS || kind > compiled.SITE_EQUAL { return false }
  let extra = u32.shiftRight(i32.wrappingToU32(inst.k), 16)
  if extra > 1 || (extra == 1 && kind != compiled.SITE_EQUAL) { return false }
  // A generic put_field or equality passes no arguments.
  if kind >= compiled.SITE_PUT_FIELD && count != 0 { return false }
  if index - block.firstInst < count { return false }
  let mut i: u32 = 0
  while i < count {
    let arg = f.inst(index - count + i)
    if arg.op != Op.CallArg || arg.k != u32.wrappingToI32(i) { return false }
    i = i + 1
  }
  return true
}

/// The call block `f` needs (js_compiled's layout: its header and area, then two words per
/// value the code saves), or 0 when it makes no call.
pub fn callWords(f: &Function) -> u32 {
  if !makesCalls(f) { return 0 }
  return usize.toU32(compiled.CALL_SAVED) + 2 * f.valueCount()
}

/// Whether `f` makes any call.
pub fn makesCalls(f: &Function) -> bool {
  let mut i: usize = 0
  while i < f.insts.length() { if f.insts.get(i).op == Op.Call { return true } i = i + 1 }
  return false
}

