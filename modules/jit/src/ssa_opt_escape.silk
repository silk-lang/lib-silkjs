//! Own-slot field-load forwarding for fresh planned constructions (RayTrace SROA Phase 1).
//!
//! For each planned construction (`Op.NewObject` fast path + `calls.PLANNED` slow path merging
//! at `joinBlock(joined)`), tracks the unboxed (`F64`, `I32`, `Bool`) values held in each own
//! slot `0 .. stores - 1` across blocks dominated by `joinBlock`, stopping on any escaping use,
//! unrecognized field access/mutation, or conflicting control-flow merge.
//!
//! Any own-slot `Op.GetField` on `joined` (or a `Retain` alias of it) whose site key matches
//! `f.constructShapes[siteIdx]` and whose current slot value is a dominating unboxed value is
//! rewritten in-place to `Op.BoxF64` / `Op.BoxI32` / `Op.BoxBool` (`Own.Imm`). A subsequent
//! `ssa_ownership.simplify` collapses `unbox(box(x)) -> x` and removes dead boxes.
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u32
import silk.num.u64
import silk.num.usize
import ssa { Function, Inst, Type, Own, RootKind, Op, NONE, edgeCount, readsK }
import ssa_calls as calls
import ssa_ownership { Forward, fixSlots }
import ssa_shapes { Shapes, analyze, versionOf }
import ssa_translate { FunctionInput }
import ssa_verify { readsA, readsB, dominators }

struct ConstructCand { joinBlock: u32, initPred: u32, obj: u32, joined: u32, ver: u64, stores: u32 }
impl Copy for ConstructCand {}

struct SlotState { alive: bool, anyVisited: bool, slots: [u32; 8] }
impl Copy for SlotState {}

fn dominates(idom: &List<u32>, a: u32, b: u32) -> bool {
  let mut x = b
  while x > a && x != NONE { x = idom.get(u32.toUsize(x)) }
  return x == a
}

fn definedAt(f: &Function, idom: &List<u32>, v: u32, b: u32, idx: u32) -> bool {
  if v == NONE || v >= f.valueCount() { return false }
  let info = f.value(v)
  if info.block == b { return info.def == NONE || info.def < idx }
  return dominates(idom, info.block, b)
}

/// Returns `v` when it is unboxed (`F64`, `I32`, `Bool`), or the unboxed operand of
/// `BoxF64` / `BoxI32` / `BoxBool`, or `NONE`.
fn unboxedOf(f: &Function, v: u32) -> u32 {
  if v == NONE || v >= f.valueCount() { return NONE }
  let info = f.value(v)
  if info.ty == Type.F64 || info.ty == Type.I32 || info.ty == Type.Bool { return v }
  if info.ty == Type.Value && info.def != NONE {
    let def = f.inst(info.def)
    if def.op == Op.BoxF64 || def.op == Op.BoxI32 || def.op == Op.BoxBool { return def.a }
  }
  return NONE
}

/// Own data slot index for field instruction `idx` when receiver has shape `ver`, or `NONE`.
/// Rejects prototype-chain keys (`protoKeys[m] != 0` or bit 63 set) and add-property writes.
fn slotOfSite(shapes: &Shapes, idx: u32, ver: u64) -> u32 {
  if shapes.add(idx) != 0 { return NONE }
  let key = shapes.key(idx)
  if key != 0 {
    if u64.shiftRight(key, 63) == 0 && u64.shiftRight(key, 16) == ver {
      return u64.wrappingToU32(u64.bitAnd(key, 65535))
    }
    return NONE
  }
  let r = shapes.read(idx)
  if r != 0 {
    let site = shapes.sites.get(u32.toUsize(r - 1))
    let mut m: u32 = 0
    while m < site.count {
      let k = site.keys[u32.toUsize(m)]
      if site.protoKeys[u32.toUsize(m)] == 0 && u64.shiftRight(k, 63) == 0 && versionOf(k) == ver {
        return u64.wrappingToU32(u64.bitAnd(k, 65535))
      }
      m = m + 1
    }
  }
  return NONE
}

/// Non-field operations that can read an alias of a fresh constructed object without
/// escaping its reference or mutating its slots.
fn safeReadOp(op: Op) -> bool {
  return op == Op.Retain || op == Op.Release || op == Op.CheckTag || op == Op.CheckShape
    || op == Op.CheckWatched || op == Op.CheckArray || op == Op.CheckCallee || op == Op.IsCallee
    || op == Op.TagIn || op == Op.TagIs || op == Op.Truthy || op == Op.TypeofAtom || op == Op.Equals
}

fn boxOpFor(ty: Type) -> Op {
  if ty == Type.F64 { return Op.BoxF64 }
  if ty == Type.I32 { return Op.BoxI32 }
  return Op.BoxBool
}

fn isMarked(flags: &List<bool>, v: u32) -> bool {
  return v != NONE && u32.toUsize(v) < flags.length() && flags.get(u32.toUsize(v))
}

fn readsAnyAlias(inst: Inst, isAlias: &List<bool>) -> bool {
  if readsA(inst.op) && isMarked(isAlias, inst.a) { return true }
  if readsB(inst.op) && isMarked(isAlias, inst.b) { return true }
  if readsK(inst.op) && isMarked(isAlias, i32.wrappingToU32(inst.k)) { return true }
  return false
}

/// Checks whether `GetField` result `r` can safely become `Own.Imm` (`Box*`).
/// For `Own.Borrowed`, always true. For `Own.Owned`, true unless some non-`Retain` value
/// borrows directly from `r` (`rootKind == RootKind.Value && root == r`).
fn canChangeToImm(f: &Function, r: u32) -> bool {
  let info = f.value(r)
  if info.own == Own.Borrowed || info.own == Own.Imm { return true }
  if info.own != Own.Owned { return false }
  let mut v: usize = 0
  while v < f.values.length() {
    let u = f.values.get(v)
    if u.own == Own.Borrowed && u.rootKind == RootKind.Value && u.root == r {
      if u.def == NONE { return false }
      let d = f.inst(u.def)
      if d.op != Op.Retain || d.a != r { return false }
    }
    v = v + 1
  }
  return true
}

/// Entry slot state for block `b` from all visited predecessors (meet of `outAlive` and `outSlot`).
fn entryState(cand: ConstructCand, startSlots: [u32; 8], b: u32, inFirst: &List<u32>, inEdges: &List<u32>, source: &List<u32>, visited: &List<bool>, outAlive: &List<bool>, outSlot: &List<u32>) -> SlotState {
  if b == cand.joinBlock {
    return SlotState { alive: true, anyVisited: true, slots: startSlots }
  }
  let mut curSlots: [u32; 8] = [NONE; 8]
  let mut curAlive = true
  let mut anyVisited = false
  let mut firstPred = true
  let mut k = inFirst.get(u32.toUsize(b))
  let last = inFirst.get(u32.toUsize(b) + 1)
  while k < last {
    let pred = source.get(u32.toUsize(inEdges.get(u32.toUsize(k))))
    if pred != NONE && visited.get(u32.toUsize(pred)) {
      anyVisited = true
      if !outAlive.get(u32.toUsize(pred)) {
        curAlive = false
      } else {
        let base = u32.toUsize(pred) * 8
        if firstPred {
          let mut s: usize = 0
          while s < 8 { curSlots[s] = outSlot.get(base + s) s = s + 1 }
          firstPred = false
        } else {
          let mut s: usize = 0
          while s < 8 {
            if curSlots[s] != outSlot.get(base + s) { curSlots[s] = NONE }
            s = s + 1
          }
        }
      }
    }
    k = k + 1
  }
  if !curAlive {
    let mut s: usize = 0
    while s < 8 { curSlots[s] = NONE s = s + 1 }
  }
  return SlotState { alive: curAlive, anyVisited: anyVisited, slots: curSlots }
}

/// Forwards own-slot `Op.GetField` reads of freshly constructed planned objects to their
/// dominating unboxed slot values (from `Op.InitSlot` or subsequent own-slot `Op.PutField`s)
/// prior to any escaping use or unrecognized mutation. Compacts `f` when any load is rewritten.
pub effect fn forwardConstructFields(f: &mut Function, input: &FunctionInput, sites: &List<u32>) -> () ! OutOfMemoryError ? &mut Allocator {
  if f.constructTargets.length() == 0 { return () }
  let blocks = u32.toUsize(f.blockCount())
  let values = u32.toUsize(f.valueCount())
  if blocks < 2 || values == 0 { return () }

  let shapes = run analyze(&f.*, input, sites)
  let idom = run dominators(&f.*)

  // Source block of each edge, and incoming edges per block.
  let mut source = List<u32>.make()
  run source.appendRepeated(NONE, f.edges.length())
  let mut b: usize = 0
  while b < blocks {
    let blk = f.blocks.get(b)
    if blk.instCount > 0 {
      let term = f.inst(blk.firstInst + blk.instCount - 1)
      let mut e: u32 = 0
      while term.edge != NONE && e < edgeCount(term.op) {
        source.set(u32.toUsize(term.edge + e), usize.toU32(b))
        e = e + 1
      }
    }
    b = b + 1
  }
  let mut inFirst = List<u32>.make()
  run inFirst.appendRepeated(0, blocks + 1)
  let mut e: usize = 0
  while e < f.edges.length() {
    let t = u32.toUsize(f.edges.get(e).target)
    if t < blocks { let c = inFirst.get(t + 1) + 1 inFirst.set(t + 1, c) }
    e = e + 1
  }
  b = 0
  while b < blocks { let c = inFirst.get(b + 1) + inFirst.get(b) inFirst.set(b + 1, c) b = b + 1 }
  let mut inNext = List<u32>.make()
  run inNext.appendSlice(inFirst.asSlice())
  let mut inEdges = List<u32>.make()
  run inEdges.appendRepeated(0, f.edges.length())
  e = 0
  while e < f.edges.length() {
    let t = u32.toUsize(f.edges.get(e).target)
    if t < blocks {
      let at = inNext.get(t)
      inEdges.set(u32.toUsize(at), usize.toU32(e))
      inNext.set(t, at + 1)
    }
    e = e + 1
  }

  // Discover planned construct-join candidates in RPO order.
  let mut cands = List<ConstructCand>.make()
  let mut jb: u32 = 1
  while jb < f.blockCount() {
    let s0 = inFirst.get(u32.toUsize(jb))
    let s1 = inFirst.get(u32.toUsize(jb) + 1)
    if s1 - s0 == 2 {
      let blk = f.blocks.get(u32.toUsize(jb))
      if blk.paramCount == 1 {
        let e0Idx = inEdges.get(u32.toUsize(s0))
        let e1Idx = inEdges.get(u32.toUsize(s0 + 1))
        let e0 = f.edges.get(u32.toUsize(e0Idx))
        let e1 = f.edges.get(u32.toUsize(e1Idx))
        if e0.argCount == 1 && e1.argCount == 1 {
          let a0 = f.edgeArg(e0, 0)
          let a1 = f.edgeArg(e1, 0)
          if u32.toUsize(a0) < values && u32.toUsize(a1) < values {
            let d0 = f.value(a0).def
            let d1 = f.value(a1).def
            if d0 != NONE && d1 != NONE {
              let i0 = f.inst(d0)
              let i1 = f.inst(d1)
              let mut obj = NONE
              let mut objDef = NONE
              let mut initPred = NONE
              if i0.op == Op.NewObject && i1.op == Op.Call && (i1.k & calls.PLANNED) != 0 {
                obj = a0 objDef = d0 initPred = source.get(u32.toUsize(e0Idx))
              } else if i1.op == Op.NewObject && i0.op == Op.Call && (i0.k & calls.PLANNED) != 0 {
                obj = a1 objDef = d1 initPred = source.get(u32.toUsize(e1Idx))
              }
              if obj != NONE && initPred != NONE {
                let siteIdx = i32.toUsize(f.inst(objDef).k)
                if siteIdx < f.constructShapes.length() {
                  let ver = u32.toU64(f.constructShapes.get(siteIdx))
                  if ver != 0 && inFirst.get(u32.toUsize(initPred) + 1) - inFirst.get(u32.toUsize(initPred)) == 1 {
                    let initBlk = f.blocks.get(u32.toUsize(initPred))
                    let mut stores: u32 = 0
                    let mut seenMask: u32 = 0
                    let mut ok = true
                    let mut k = initBlk.firstInst
                    while k < initBlk.firstInst + initBlk.instCount {
                      let inst = f.inst(k)
                      if inst.op == Op.InitSlot && inst.a == obj && inst.k >= 0 && inst.k < 8 {
                        if inst.b == obj { ok = false }
                        let slot = i32.wrappingToU32(inst.k)
                        seenMask = u32.bitOr(seenMask, u32.shiftLeft(1, slot))
                        if slot + 1 > stores { stores = slot + 1 }
                      } else if inst.op == Op.PutField || inst.op == Op.Call || inst.op == Op.PutKey || inst.op == Op.PutElem {
                        ok = false
                      } else if (readsA(inst.op) && inst.a == obj) || (readsB(inst.op) && inst.b == obj) || (readsK(inst.op) && i32.wrappingToU32(inst.k) == obj) {
                        ok = false
                      }
                      k = k + 1
                    }
                    if ok && stores > 0 && seenMask == u32.shiftLeft(1, stores) - 1 {
                      run cands.append(ConstructCand { joinBlock: jb, initPred: initPred, obj: obj, joined: f.paramAt(blk, 0), ver: ver, stores: stores })
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    jb = jb + 1
  }
  if cands.length() == 0 { return () }

  let mut isAlias = List<bool>.make() run isAlias.appendRepeated(false, values)
  let mut visited = List<bool>.make() run visited.appendRepeated(false, blocks)
  let mut outAlive = List<bool>.make() run outAlive.appendRepeated(false, blocks)
  let mut outSlot = List<u32>.make() run outSlot.appendRepeated(NONE, blocks * 8)
  let mut becameImm = List<bool>.make() run becameImm.appendRepeated(false, values)
  let mut forward = run Forward.make(&f.*)
  let mut anyChanged = false

  let mut ci: usize = 0
  while ci < cands.length() {
    let cand = cands.get(ci)

    // Read initial unboxed slot values fresh from `initPred` (so earlier candidates' rewrites
    // are visible to chained constructions).
    let mut startSlots: [u32; 8] = [NONE; 8]
    let initBlk = f.blocks.get(u32.toUsize(cand.initPred))
    let mut k = initBlk.firstInst
    while k < initBlk.firstInst + initBlk.instCount {
      let inst = f.inst(k)
      if inst.op == Op.InitSlot && inst.a == cand.obj && inst.k >= 0 && inst.k < 8 {
        let u = unboxedOf(&f.*, inst.b)
        if u != NONE && f.value(u).block != cand.joinBlock && dominates(&idom, f.value(u).block, cand.joinBlock) {
          startSlots[i32.toUsize(inst.k)] = u
        } else {
          startSlots[i32.toUsize(inst.k)] = NONE
        }
      }
      k = k + 1
    }

    // Collect `joined` and all transitive `Op.Retain` copies in blocks dominated by `joinBlock`.
    let mut vi: usize = 0
    while vi < values { isAlias.set(vi, false) vi = vi + 1 }
    isAlias.set(u32.toUsize(cand.joined), true)
    let mut aliasProp = true
    while aliasProp {
      aliasProp = false
      let mut cb = cand.joinBlock
      while cb < f.blockCount() {
        if dominates(&idom, cand.joinBlock, cb) {
          let blk = f.blocks.get(u32.toUsize(cb))
          let mut j = blk.firstInst
          while j < blk.firstInst + blk.instCount {
            let inst = f.inst(j)
            if inst.op == Op.Retain && inst.result != NONE && isMarked(&isAlias, inst.a) && !isMarked(&isAlias, inst.result) {
              isAlias.set(u32.toUsize(inst.result), true)
              aliasProp = true
            }
            j = j + 1
          }
        }
        cb = cb + 1
      }
    }

    // Monotone forward dataflow fixpoint over blocks dominated by `joinBlock`.
    let mut bi: usize = u32.toUsize(cand.joinBlock)
    while bi < blocks {
      visited.set(bi, false)
      outAlive.set(bi, false)
      let base = bi * 8
      let mut s: usize = 0
      while s < 8 { outSlot.set(base + s, NONE) s = s + 1 }
      bi = bi + 1
    }
    let mut iter: u32 = 0
    let mut fpChanged = true
    while fpChanged && iter < 16 {
      fpChanged = false
      let mut cb = cand.joinBlock
      while cb < f.blockCount() {
        if dominates(&idom, cand.joinBlock, cb) {
          let st = entryState(cand, startSlots, cb, &inFirst, &inEdges, &source, &visited, &outAlive, &outSlot)
          if st.anyVisited {
            let mut curAlive = st.alive
            let mut curSlots = st.slots
            let blk = f.blocks.get(u32.toUsize(cb))
            let mut j = blk.firstInst
            while j < blk.firstInst + blk.instCount && curAlive {
              let inst = f.inst(j)
              if inst.op != Op.Removed {
                if inst.op == Op.GetField && isMarked(&isAlias, inst.a) {
                  let slot = slotOfSite(&shapes, j, cand.ver)
                  if slot == NONE || slot >= cand.stores { curAlive = false }
                } else if inst.op == Op.PutField && isMarked(&isAlias, inst.a) {
                  let slot = slotOfSite(&shapes, j, cand.ver)
                  if slot == NONE || slot >= cand.stores || isMarked(&isAlias, inst.b) {
                    curAlive = false
                  } else {
                    curSlots[u32.toUsize(slot)] = unboxedOf(&f.*, inst.b)
                  }
                } else if readsAnyAlias(inst, &isAlias) {
                  if !safeReadOp(inst.op) { curAlive = false }
                }
              }
              j = j + 1
            }
            if curAlive && blk.instCount > 0 {
              let term = f.inst(blk.firstInst + blk.instCount - 1)
              if term.edge != NONE {
                let mut te: u32 = 0
                while te < edgeCount(term.op) && curAlive {
                  let edge = f.edge(term.edge + te)
                  let mut g: u32 = 0
                  while g < edge.argCount {
                    if isMarked(&isAlias, f.edgeArg(edge, g)) { curAlive = false break }
                    g = g + 1
                  }
                  te = te + 1
                }
              }
            }
            if !curAlive {
              let mut s: usize = 0
              while s < 8 { curSlots[s] = NONE s = s + 1 }
            }
            let bIdx = u32.toUsize(cb)
            let base = bIdx * 8
            let mut diff = !visited.get(bIdx) || outAlive.get(bIdx) != curAlive
            let mut s: usize = 0
            while s < 8 {
              if outSlot.get(base + s) != curSlots[s] { diff = true }
              s = s + 1
            }
            if diff {
              visited.set(bIdx, true)
              outAlive.set(bIdx, curAlive)
              s = 0
              while s < 8 { outSlot.set(base + s, curSlots[s]) s = s + 1 }
              fpChanged = true
            }
          }
        }
        cb = cb + 1
      }
      iter = iter + 1
    }

    // Transform pass using the converged fixpoint state.
    if !fpChanged {
      let mut anyOwnedImm = false
      let mut cb = cand.joinBlock
      while cb < f.blockCount() {
        if dominates(&idom, cand.joinBlock, cb) && visited.get(u32.toUsize(cb)) {
          let st = entryState(cand, startSlots, cb, &inFirst, &inEdges, &source, &visited, &outAlive, &outSlot)
          let mut curAlive = st.alive
          let mut curSlots = st.slots
          let blk = f.blocks.get(u32.toUsize(cb))
          let mut j = blk.firstInst
          while j < blk.firstInst + blk.instCount && curAlive {
            let inst = f.inst(j)
            if inst.op != Op.Removed {
              if inst.op == Op.GetField && isMarked(&isAlias, inst.a) {
                let slot = slotOfSite(&shapes, j, cand.ver)
                if slot == NONE || slot >= cand.stores {
                  curAlive = false
                } else {
                  let val = curSlots[u32.toUsize(slot)]
                  if val != NONE && inst.result != NONE && definedAt(&f.*, &idom, val, cb, j) && canChangeToImm(&f.*, inst.result) {
                    let valTy = f.value(val).ty
                    if valTy == Type.F64 || valTy == Type.I32 || valTy == Type.Bool {
                      let wasOwned = f.value(inst.result).own == Own.Owned
                      let mut boxed = inst
                      boxed.op = boxOpFor(valTy)
                      boxed.a = val
                      boxed.b = NONE
                      boxed.k = 0
                      boxed.exit = NONE
                      f.setInst(j, boxed)
                      f.setOwnership(inst.result, Own.Imm, RootKind.None, NONE)
                      if wasOwned {
                        becameImm.set(u32.toUsize(inst.result), true)
                        anyOwnedImm = true
                      }
                      anyChanged = true
                    }
                  }
                }
              } else if inst.op == Op.PutField && isMarked(&isAlias, inst.a) {
                let slot = slotOfSite(&shapes, j, cand.ver)
                if slot == NONE || slot >= cand.stores || isMarked(&isAlias, inst.b) {
                  curAlive = false
                } else {
                  curSlots[u32.toUsize(slot)] = unboxedOf(&f.*, inst.b)
                }
              } else if readsAnyAlias(inst, &isAlias) {
                if !safeReadOp(inst.op) { curAlive = false }
              }
            }
            j = j + 1
          }
        }
        cb = cb + 1
      }
      if anyOwnedImm {
        let mut ii: usize = 0
        while ii < f.insts.length() {
          let mut inst = f.insts.get(ii)
          if inst.op == Op.Release && isMarked(&becameImm, inst.a) {
            inst.op = Op.Removed
            f.insts.set(ii, inst)
          } else if inst.op == Op.Retain && inst.result != NONE {
            let info = f.value(inst.result)
            if info.own == Own.Borrowed && info.rootKind == RootKind.Value && isMarked(&becameImm, info.root) {
              run forward.replace(inst.result, inst.a)
              inst.op = Op.Removed
              f.insts.set(ii, inst)
            }
          }
          ii = ii + 1
        }
        forward.apply(&mut f)
        let mut bi2: usize = 0
        while bi2 < values { becameImm.set(bi2, false) bi2 = bi2 + 1 }
      }
    }
    f.work = f.work + usize.toU64(blocks)
    ci = ci + 1
  }

  if anyChanged {
    run fixSlots(&mut f)
    run f.compact()
  }
}
