//! What baseline code (baseline.silk, docs/jit/baseline.md) finds through its pinned
//! environment register: the runtime, the helpers it calls and its counters.
//!
//! The code names a helper by its index, never by address, so its bytes hold no
//! process-local pointer (ahead-of-time compilation). One BaselineEnv serves a runtime.
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.num.u32
import silkjs.js_heap { HeapHeader }
import silkjs.js_value { ValueBits }
import silkjs.js_baseline as engine

pub const HELPER_COUNT: usize = 16
/// Machine code, not a C function: drops the count of the heap value whose tag word is in
/// r10 and payload in r11, and preserves every register (baseline.releaseStub).
pub const RELEASE_STUB: u32 = 0
/// release(env, value: *const ValueBits): drops the count the value owns.
pub const RELEASE: u32 = 1
/// get_field(env, ip, cell, out) -> u32: js_baseline.readField.
pub const GET_FIELD: u32 = 2
/// get_field_top(env, ip, cell) -> u32: js_baseline.readFieldTop.
pub const GET_FIELD_TOP: u32 = 3
/// get_field2(env, ip, cell, out) -> u32: js_baseline.readFieldCached.
pub const GET_FIELD2: u32 = 4
/// put_field(env, ip, target, source, pops) -> u32: js_baseline.writeField.
pub const PUT_FIELD: u32 = 5
/// get_var(env, function, index, out) -> u32: js_baseline.readVariable.
pub const GET_VAR: u32 = 6
/// equal(env, left, right, negate) -> u32: js_baseline.equal.
pub const EQUAL: u32 = 7
/// truthy(env, cell) -> u32: js_baseline.truthy.
pub const TRUTHY: u32 = 8
/// get_element(env, ip, cell) -> u32: js_baseline.readElement.
pub const GET_ELEMENT: u32 = 9
/// put_element(env, ip, cell) -> u32: js_baseline.storeElement.
pub const PUT_ELEMENT: u32 = 10
/// arithmetic(env, left, right, opcode) -> u32: js_baseline.arithmetic.
pub const ARITHMETIC: u32 = 11
/// not(env, cell) -> u32: js_baseline.logicalNot.
pub const NOT: u32 = 12
/// atom_value(env, atom, out) -> u32: js_baseline.atomValue.
pub const ATOM_VALUE: u32 = 13
/// truth(env, cell) -> u32: js_baseline.truth.
pub const TRUTH: u32 = 14

/// The layout baseline code reads: the offsets below are part of its ABI.
pub struct BaselineEnv {
  /// The runtime the code runs in (offset 0).
  pub runtime: ?*mut HeapHeader,
  /// Helper entry points, at offset 8 + 8 * index.
  pub helpers: [?*const u8; 16],
  /// Activations the interpreter finished (SERVICE_FINISH requests), at DEPARTURES_OFFSET.
  pub departures: u64,
  /// Calls made through the engine's service (SERVICE_CALL), at SERVICE_CALLS_OFFSET.
  pub serviceCalls: u64,
  /// Calls made from baseline code straight into baseline code, at DIRECT_CALLS_OFFSET.
  pub directCalls: u64
}
pub const DEPARTURES_OFFSET: i32 = 8 + 8 * 16
pub const SERVICE_CALLS_OFFSET: i32 = DEPARTURES_OFFSET + 8
pub const DIRECT_CALLS_OFFSET: i32 = SERVICE_CALLS_OFFSET + 8
impl Copy for BaselineEnv {}

/// The byte offset of helper `index` in a BaselineEnv.
pub fn helperOffset(index: u32) -> i32 { return u32.wrappingToI32(8 + index * 8) }

fn address4(function: extern "C" fn(*mut BaselineEnv, *const u8, *const ValueBits, *mut ValueBits) -> u32) -> ?*const u8 {
  return unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const u8, *const ValueBits, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&function)))
}

impl BaselineEnv {
  /// An environment with every C helper installed; the caller adds RELEASE_STUB.
  pub fn make() -> BaselineEnv {
    let mut env = BaselineEnv { runtime: Pointer.null<HeapHeader>(), helpers: [Pointer.null<u8>(); 16], departures: 0, serviceCalls: 0, directCalls: 0 }
    let release: extern "C" fn(*mut BaselineEnv, *const ValueBits) -> () = baselineRelease
    env.helpers[u32.toUsize(RELEASE)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const ValueBits) -> (), *const ?*const u8>(Pointer.fromRef(&release)))
    env.helpers[u32.toUsize(GET_FIELD)] = address4(baselineGetField)
    let getFieldTop: extern "C" fn(*mut BaselineEnv, *const u8, *mut ValueBits) -> u32 = baselineGetFieldTop
    env.helpers[u32.toUsize(GET_FIELD_TOP)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const u8, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&getFieldTop)))
    env.helpers[u32.toUsize(GET_FIELD2)] = address4(baselineGetField2)
    let putField: extern "C" fn(*mut BaselineEnv, *const u8, *const ValueBits, *mut ValueBits, u32) -> u32 = baselinePutField
    env.helpers[u32.toUsize(PUT_FIELD)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const u8, *const ValueBits, *mut ValueBits, u32) -> u32, *const ?*const u8>(Pointer.fromRef(&putField)))
    let getVar: extern "C" fn(*mut BaselineEnv, *mut HeapHeader, u32, *mut ValueBits) -> u32 = baselineGetVar
    env.helpers[u32.toUsize(GET_VAR)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut HeapHeader, u32, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&getVar)))
    let equal: extern "C" fn(*mut BaselineEnv, *mut ValueBits, *const ValueBits, u32) -> u32 = baselineEqual
    env.helpers[u32.toUsize(EQUAL)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut ValueBits, *const ValueBits, u32) -> u32, *const ?*const u8>(Pointer.fromRef(&equal)))
    let truthy: extern "C" fn(*mut BaselineEnv, *const ValueBits) -> u32 = baselineTruthy
    env.helpers[u32.toUsize(TRUTHY)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&truthy)))
    let getElement: extern "C" fn(*mut BaselineEnv, *const u8, *mut ValueBits) -> u32 = baselineGetElement
    env.helpers[u32.toUsize(GET_ELEMENT)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const u8, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&getElement)))
    let putElement: extern "C" fn(*mut BaselineEnv, *const u8, *mut ValueBits) -> u32 = baselinePutElement
    env.helpers[u32.toUsize(PUT_ELEMENT)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const u8, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&putElement)))
    let arithmetic: extern "C" fn(*mut BaselineEnv, *mut ValueBits, *const ValueBits, u32) -> u32 = baselineArithmetic
    env.helpers[u32.toUsize(ARITHMETIC)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut ValueBits, *const ValueBits, u32) -> u32, *const ?*const u8>(Pointer.fromRef(&arithmetic)))
    let not: extern "C" fn(*mut BaselineEnv, *mut ValueBits) -> u32 = baselineNot
    env.helpers[u32.toUsize(NOT)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&not)))
    let atomValue: extern "C" fn(*mut BaselineEnv, u32, *mut ValueBits) -> u32 = baselineAtomValue
    env.helpers[u32.toUsize(ATOM_VALUE)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, u32, *mut ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&atomValue)))
    let truth: extern "C" fn(*mut BaselineEnv, *const ValueBits) -> u32 = baselineTruth
    env.helpers[u32.toUsize(TRUTH)] = unsafe Pointer.read<?*const u8>(unsafe Intrinsic.pointerReinterpret<*const extern "C" fn(*mut BaselineEnv, *const ValueBits) -> u32, *const ?*const u8>(Pointer.fromRef(&truth)))
    return env
  }
}

unsafe fn runtimeOf(env: *mut BaselineEnv) -> *mut HeapHeader {
  let anchor = ()
  let state = unsafe Pointer.borrow<(), BaselineEnv>(&anchor, env)
  return unsafe Intrinsic.pointerRequalify<?*mut HeapHeader, *mut HeapHeader>(state.runtime)
}

export "C" fn baselineRelease(env: *mut BaselineEnv, value: *const ValueBits) -> () {
  unsafe engine.release(unsafe Pointer.read<ValueBits>(value))
}
export "C" fn baselineGetField(env: *mut BaselineEnv, ip: *const u8, cell: *const ValueBits, out: *mut ValueBits) -> u32 {
  if unsafe engine.readField(unsafe runtimeOf(env), ip, cell, out) { return 1 }
  return 0
}
export "C" fn baselineGetFieldTop(env: *mut BaselineEnv, ip: *const u8, cell: *mut ValueBits) -> u32 {
  if unsafe engine.readFieldTop(unsafe runtimeOf(env), ip, cell) { return 1 }
  return 0
}
export "C" fn baselineGetField2(env: *mut BaselineEnv, ip: *const u8, cell: *const ValueBits, out: *mut ValueBits) -> u32 {
  if unsafe engine.readFieldCached(unsafe runtimeOf(env), ip, cell, out) { return 1 }
  return 0
}
export "C" fn baselinePutField(env: *mut BaselineEnv, ip: *const u8, target: *const ValueBits, source: *mut ValueBits, pops: u32) -> u32 {
  if unsafe engine.writeField(unsafe runtimeOf(env), ip, target, source, pops != 0) { return 1 }
  return 0
}
export "C" fn baselineGetVar(env: *mut BaselineEnv, function: *mut HeapHeader, index: u32, out: *mut ValueBits) -> u32 {
  if unsafe engine.readVariable(function, index, out) { return 1 }
  return 0
}
export "C" fn baselineEqual(env: *mut BaselineEnv, left: *mut ValueBits, right: *const ValueBits, negate: u32) -> u32 {
  if unsafe engine.equal(left, right, negate != 0) { return 1 }
  return 0
}
export "C" fn baselineTruthy(env: *mut BaselineEnv, cell: *const ValueBits) -> u32 {
  if unsafe engine.truthy(cell) { return 1 }
  return 0
}
export "C" fn baselineGetElement(env: *mut BaselineEnv, ip: *const u8, cell: *mut ValueBits) -> u32 {
  if unsafe engine.readElement(cell) { return 1 }
  return 0
}
export "C" fn baselinePutElement(env: *mut BaselineEnv, ip: *const u8, cell: *mut ValueBits) -> u32 {
  if unsafe engine.storeElement(cell) { return 1 }
  return 0
}
export "C" fn baselineArithmetic(env: *mut BaselineEnv, left: *mut ValueBits, right: *const ValueBits, opcode: u32) -> u32 {
  if unsafe engine.arithmetic(left, right, u32.wrappingToU8(opcode)) { return 1 }
  return 0
}
export "C" fn baselineNot(env: *mut BaselineEnv, cell: *mut ValueBits) -> u32 {
  if unsafe engine.logicalNot(cell) { return 1 }
  return 0
}
export "C" fn baselineAtomValue(env: *mut BaselineEnv, atom: u32, out: *mut ValueBits) -> u32 {
  if unsafe engine.atomValue(unsafe runtimeOf(env), atom, out) { return 1 }
  return 0
}
export "C" fn baselineTruth(env: *mut BaselineEnv, cell: *const ValueBits) -> u32 {
  if unsafe engine.truth(cell) { return 1 }
  return 0
}
