//! Shape facts for frame mode (docs/jit/optimizer.md, "Shapes"). A field site whose inline
//! key held a shape version when the function was compiled is lowered against that version
//! and slot as constants, and leaves compiled code when the object's shape is another: no
//! helper answers a miss, so what the test proved stays true after it. This pass finds, for
//! each such site, what earlier sites and tag checks already proved about its object: that
//! it is an object (no tag test) and that it has the key's shape (no shape test).
//!
//! A fact holds from the instruction that proved it over what that instruction dominates,
//! until something may change a shape: a call, or any helper that can run a getter, a
//! setter or a conversion. Stores through a constant key write an existing slot in place and
//! change no shape. Where blocks meet, a fact holds when every block before the meeting
//! proved the same; a loop header starts with none (its back edge is not known yet).
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import ssa { Function, Op, NONE, edgeCount }
import ssa_translate { FunctionInput, SiteShape, FIELD_KEYED, FIELD_CACHED, CallTarget }

/// In Shapes.facts: the site's object is known to be an object; and to have the key's shape.
pub const FACT_OBJECT: u8 = 1
pub const FACT_SHAPE: u8 = 2
/// The tag `check.tag` names for an object (ValueBits.tag).
const TAG_OBJECT: i32 = -1
/// A key the compiler has not filled (js_vm_property_ops.fieldKeyAt).
const NO_KEY: u64 = 18446744073709551615

/// A cached site (Shapes.reads) that left before: a shape it has no test for goes to the
/// helper instead of leaving, so the site proves nothing.
pub const FACT_HEDGED: u8 = 4
/// A cached site whose object is known to have the shape of its pair n: (1 + n) << FACT_PAIR.
pub const FACT_PAIR: u8 = 4

/// By instruction: the constant key of a field site (shape version << 16 | slot), or 0 for
/// an instruction lowered as before; and the FACT_* of its object. For a cached field site
/// the embedder knows the shapes of (FunctionInput.siteShapes): reads is 1 + its index in
/// sites, and the read is lowered as tests against those shapes.
/// same, by instruction: for a field read whose value an earlier value still holds (an
/// earlier read of the same property of the same object, or what was stored there, with
/// nothing since that could change it), that value: the read is a copy of it. NONE otherwise.
pub struct Shapes { pub keys: List<u64>, pub facts: List<u8>, pub reads: List<u32>, pub sites: List<SiteShape>, pub same: List<u32> }
/// A property whose value a value holds: `atom` of the object `object` (the first value
/// that was this object, Retain copies seen through) is in the slot of `value`.
struct Known { object: u32, atom: u32, value: u32 }
impl Copy for Known {}
/// The most properties tracked at a time; more push the oldest out.
const KNOWN: usize = 8

impl Shapes {
  pub fn none() -> Shapes { return Shapes { keys: List<u64>.make(), facts: List<u8>.make(), reads: List<u32>.make(), sites: List<SiteShape>.make(), same: List<u32>.make() } }
  pub fn sameAs(self: &Self, inst: u32) -> u32 { if u32.toUsize(inst) < self.same.length() { return self.same.get(u32.toUsize(inst)) } return NONE }
  pub fn read(self: &Self, inst: u32) -> u32 { if u32.toUsize(inst) < self.reads.length() { return self.reads.get(u32.toUsize(inst)) } return 0 }
  pub fn key(self: &Self, inst: u32) -> u64 { if u32.toUsize(inst) < self.keys.length() { return self.keys.get(u32.toUsize(inst)) } return 0 }
  pub fn fact(self: &Self, inst: u32) -> u8 { if u32.toUsize(inst) < self.facts.length() { return self.facts.get(u32.toUsize(inst)) } return 0 }
}

/// The key the field site at pc of code holds: 8 bytes after its atom, low byte first.
fn keyAt(code: &[u8], pc: u32) -> u64 {
  let at = u32.toUsize(pc) + 5
  if at + 8 > code.length { return 0 }
  let mut key: u64 = 0
  let mut b: usize = 8
  while b != 0 { b = b - 1 key = u64.bitOr(u64.shiftLeft(key, 8), u8.toU64(code[at + b])) }
  // A version the code can compare as a sign-extended 32-bit immediate.
  if key == NO_KEY || u64.shiftRight(key, 16) == 0 || u64.shiftRight(key, 16) >= 2147483648 { return 0 }
  return key
}

/// The shape version of a site cache key (own or of the prototype).
pub fn versionOf(key: u64) -> u64 { return u64.shiftRight(u64.shiftLeft(key, 1), 17) }
/// The entry of sites for the cached field site at pc, or none.
fn siteAt(sites: &List<SiteShape>, pc: u32) -> SiteShape {
  let mut s: usize = 0
  while s < sites.length() { if sites.get(s).pc == pc { return sites.get(s) } s = s + 1 }
  return SiteShape { pc: pc, count: 0, keys: [0, 0, 0, 0], protoKeys: [0, 0, 0, 0] }
}

/// What the field site at `pc` of inline target `id` has: its recorded shapes, its atom and its
/// key. The target is one of `targets` or, an inlined body's own callee, one of theirs.
struct InlinedSite { known: bool, site: SiteShape, atom: u32, key: u64 }
impl Copy for InlinedSite {}
fn inlinedSite(targets: &List<CallTarget>, id: u32, pc: u32) -> InlinedSite {
  let mut t: usize = 0
  while t < targets.length() {
    let target = &targets.asSlice()[t]
    if target.id == id {
      return InlinedSite { known: true, site: siteAt(&target.input.siteShapes, pc), atom: atomAt(target.input.code.asSlice(), pc), key: keyAt(target.input.code.asSlice(), pc) }
    }
    let inner = inlinedSite(&target.input.targets, id, pc)
    if inner.known { return inner }
    t = t + 1
  }
  return InlinedSite { known: false, site: SiteShape { pc: pc, count: 0, keys: [0, 0, 0, 0], protoKeys: [0, 0, 0, 0] }, atom: 0, key: 0 }
}
/// The atom of the field site at pc of code: the 4 bytes after its opcode. 0: none.
fn atomAt(code: &[u8], pc: u32) -> u32 {
  let at = u32.toUsize(pc) + 1
  if at + 4 > code.length { return 0 }
  return u8.toU32(code[at]) | u32.shiftLeft(u8.toU32(code[at + 1]), 8) | u32.shiftLeft(u8.toU32(code[at + 2]), 16) | u32.shiftLeft(u8.toU32(code[at + 3]), 24)
}
/// The value among held[0..] that holds `atom` of `object`, or NONE.
fn knownValue(held: &List<Known>, object: u32, atom: u32) -> u32 {
  let mut i: usize = 0
  while i < held.length() {
    let k = held.get(i)
    if k.object == object && k.atom == atom { return k.value }
    i = i + 1
  }
  return NONE
}
/// held without what it knew of `atom` (0: of anything), of any object: a store may alias.
fn forget(held: &mut List<Known>, atom: u32) -> () {
  let mut kept: usize = 0
  let mut i: usize = 0
  while i < held.length() {
    let k = held.get(i)
    if atom != 0 && k.atom != atom { held.set(kept, k) kept = kept + 1 }
    i = i + 1
  }
  held.truncate(kept)
}

/// held with k, in place of what was held for the same property, the oldest dropped when full.
effect fn remember(held: &mut List<Known>, k: Known) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut kept: usize = 0
  let mut i: usize = 0
  while i < held.length() {
    let h = held.get(i)
    if h.object != k.object || h.atom != k.atom { held.set(kept, h) kept = kept + 1 }
    i = i + 1
  }
  held.truncate(kept)
  if held.length() >= KNOWN {
    i = 1
    while i < held.length() { let h = held.get(i) held.set(i - 1, h) i = i + 1 }
    let less = held.length() - 1
    held.truncate(less)
  }
  run held.append(k)
}

/// Whether op leaves every object's shape as it is. Anything not listed may change one.
fn quiet(op: Op) -> bool {
  return op == Op.Arg || op == Op.ConstI32 || op == Op.Imm || op == Op.Unbox || op == Op.UnboxBool || op == Op.BoxI32 || op == Op.BoxBool
    || op == Op.Add || op == Op.Sub || op == Op.Mul || op == Op.Cmp || op == Op.Retain || op == Op.Release
    || op == Op.Jump || op == Op.Branch || op == Op.Return || op == Op.This || op == Op.CheckTag || op == Op.TagIn || op == Op.TagIs
    || op == Op.AtomValue || op == Op.GetVar || op == Op.PutVar || op == Op.GetScope || op == Op.PutScope || op == Op.Truthy || op == Op.TypeofAtom
    || op == Op.CallArg || op == Op.CallResult || op == Op.CheckCallee || op == Op.IsCallee || op == Op.InlineFrame || op == Op.Removed
    || op == Op.ConstF64 || op == Op.UnboxF64 || op == Op.BoxF64 || op == Op.ToF64 || op == Op.AddF64 || op == Op.SubF64 || op == Op.MulF64
    || op == Op.DivF64 || op == Op.CmpF64 || op == Op.NegF64 || op == Op.SqrtF64 || op == Op.AbsF64 || op == Op.FloorF64 || op == Op.ToInt32
    || op == Op.ExactI32 || op == Op.BitAnd || op == Op.BitOr || op == Op.BitXor || op == Op.Shl || op == Op.Sar || op == Op.Shr || op == Op.Mod
    || op == Op.Neg || op == Op.BitNot || op == Op.NotBool || op == Op.Imul
}

/// The facts of f, compacted, whose own code is input's and whose inlined bodies' are its
/// targets'. sites are the offsets earlier code of the function left at: a field site among
/// them (of the function's own code) keeps its helper.
pub effect fn analyze(f: &Function, input: &FunctionInput, sites: &List<u32>) -> Shapes ! OutOfMemoryError ? &mut Allocator {
  let count = f.insts.length()
  let mut keys = List<u64>.make()
  run keys.appendRepeated(0, count)
  let mut facts = List<u8>.make()
  run facts.appendRepeated(0, count)
  let mut reads = List<u32>.make()
  run reads.appendRepeated(0, count)
  let mut read = List<SiteShape>.make()
  let mut same = List<u32>.make()
  run same.appendRepeated(NONE, count)
  // The property each field site names.
  let mut atoms = List<u32>.make()
  run atoms.appendRepeated(0, count)
  let mut any = false
  let mut i: usize = 0
  while i < count {
    let inst = f.insts.get(i)
    if inst.op == Op.GetField && (inst.k & 1) == FIELD_CACHED {
      let mut site = SiteShape { pc: inst.pc, count: 0, keys: [0, 0, 0, 0], protoKeys: [0, 0, 0, 0] }
      let mut hedged = false
      if inst.frame == 0 {
        site = siteAt(&input.siteShapes, inst.pc)
        atoms.set(i, atomAt(input.code.asSlice(), inst.pc))
        let mut s: usize = 0
        while s < sites.length() { if sites.get(s) == inst.pc { hedged = true } s = s + 1 }
      } else if u32.toUsize(inst.frame - 1) < f.inlineTargets.length() {
        let found = inlinedSite(&input.targets, f.inlineTargets.get(u32.toUsize(inst.frame - 1)), inst.pc)
        if found.known { site = found.site atoms.set(i, found.atom) }
      }
      if site.count != 0 {
        run read.append(site)
        reads.set(i, usize.toU32(read.length()))
        if hedged { facts.set(i, FACT_HEDGED) }
        any = true
      }
    }
    if (inst.op == Op.GetField && inst.k == FIELD_KEYED) || inst.op == Op.PutField {
      let mut key: u64 = 0
      if inst.frame == 0 {
        let mut left = false
        let mut s: usize = 0
        while s < sites.length() { if sites.get(s) == inst.pc { left = true } s = s + 1 }
        if !left { key = keyAt(input.code.asSlice(), inst.pc) }
        atoms.set(i, atomAt(input.code.asSlice(), inst.pc))
      } else if u32.toUsize(inst.frame - 1) < f.inlineTargets.length() {
        let found = inlinedSite(&input.targets, f.inlineTargets.get(u32.toUsize(inst.frame - 1)), inst.pc)
        if found.known { key = found.key atoms.set(i, found.atom) }
      }
      if key != 0 { keys.set(i, key) any = true }
    }
    i = i + 1
  }
  if !any { return Shapes { keys: move keys, facts: move facts, reads: move reads, sites: move read, same: move same } }
  // The block each edge leaves.
  let blocks = u32.toUsize(f.blockCount())
  let values = u32.toUsize(f.valueCount())
  let mut source = List<u32>.make()
  run source.appendRepeated(NONE, f.edges.length())
  let mut b: usize = 0
  while b < blocks {
    let block = f.blocks.get(b)
    if block.instCount > 0 {
      let last = f.inst(block.firstInst + block.instCount - 1)
      let mut e: u32 = 0
      while e < edgeCount(last.op) { source.set(u32.toUsize(last.edge + e), usize.toU32(b)) e = e + 1 }
    }
    b = b + 1
  }
  // What each block leaves known, by value: its shape version (0: none) and whether it is
  // an object; and the properties whose values are held (heldOut, KNOWN a block, heldCount
  // of them in use). `done` tells a block that was walked from one that was not.
  //
  // Two walks. In the first a block entered from one not walked yet (a loop header, by its
  // back edge) starts with nothing. The second takes what the first found at the end of
  // such a block: that was found with nothing assumed at the header, so it holds at the end
  // of every turn, and with it the header keeps what the code before the loop and every
  // turn agree on.
  let mut versions = List<u64>.make()
  run versions.appendRepeated(0, blocks * values)
  let mut objects = List<u8>.make()
  run objects.appendRepeated(0, blocks * values)
  let mut heldOut = List<Known>.make()
  run heldOut.appendRepeated(Known { object: NONE, atom: 0, value: NONE }, blocks * KNOWN)
  let mut heldCount = List<u32>.make()
  run heldCount.appendRepeated(0, blocks)
  let mut done = List<u8>.make()
  run done.appendRepeated(0, blocks)
  let mut version = List<u64>.make()
  run version.appendRepeated(0, values)
  let mut object = List<u8>.make()
  run object.appendRepeated(0, values)
  let mut held = List<Known>.make()
  // The first value that was the same object as each value (Retain and copies seen through).
  let mut alias = List<u32>.make()
  let mut pass: u32 = 0
  while pass < 2 {
  alias.truncate(0)
  let mut v0: usize = 0
  while v0 < values { run alias.append(usize.toU32(v0)) v0 = v0 + 1 }
  let mut clear: usize = 0
  while clear < count { let fixed = u8.bitAnd(facts.get(clear), FACT_HEDGED) facts.set(clear, fixed) same.set(clear, NONE) clear = clear + 1 }
  b = 0
  while b < blocks {
    // What every edge into the block agrees on; nothing when one comes from a block not
    // walked yet, or when there is none (the entry).
    let mut first = true
    let mut open = false
    held.truncate(0)
    let mut e: usize = 0
    while e < f.edges.length() {
      if u32.toUsize(f.edges.get(e).target) == b {
        let from = source.get(e)
        if from == NONE || done.get(u32.toUsize(from)) == 0 { open = true }
        else {
          let base = u32.toUsize(from) * values
          let mut v: usize = 0
          while v < values {
            if first { version.set(v, versions.get(base + v)) object.set(v, objects.get(base + v)) }
            else {
              if version.get(v) != versions.get(base + v) { version.set(v, 0) }
              if objects.get(base + v) == 0 { object.set(v, 0) }
            }
            v = v + 1
          }
          let theirs = u32.toUsize(from) * KNOWN
          let their = u32.toUsize(heldCount.get(u32.toUsize(from)))
          if first {
            let mut k: usize = 0
            while k < their { run held.append(heldOut.get(theirs + k)) k = k + 1 }
          } else {
            let mut kept: usize = 0
            let mut k: usize = 0
            while k < held.length() {
              let mine = held.get(k)
              let mut both = false
              let mut t: usize = 0
              while t < their {
                let other = heldOut.get(theirs + t)
                if other.object == mine.object && other.atom == mine.atom && other.value == mine.value { both = true }
                t = t + 1
              }
              if both { held.set(kept, mine) kept = kept + 1 }
              k = k + 1
            }
            held.truncate(kept)
          }
          first = false
        }
      }
      e = e + 1
    }
    if first || open {
      let mut v: usize = 0
      while v < values { version.set(v, 0) object.set(v, 0) v = v + 1 }
      held.truncate(0)
    }
    let block = f.blocks.get(b)
    let mut n: u32 = 0
    while n < block.instCount {
      let index = u32.toUsize(block.firstInst + n)
      let inst = f.insts.get(index)
      let key = keys.get(index)
      let atom = atoms.get(index)
      // A read of a data property with no helper behind it: a keyed site, or a cached one
      // that leaves on another shape.
      let plain = inst.op == Op.GetField && u32.toUsize(inst.a) < values && u32.toUsize(inst.result) < values
        && (key != 0 || (reads.get(index) != 0 && u8.bitAnd(facts.get(index), FACT_HEDGED) == 0))
      let mut copied = NONE
      if plain && atom != 0 { copied = knownValue(&held, alias.get(u32.toUsize(inst.a)), atom) }
      if copied != NONE && u32.toUsize(copied) < values {
        // The property's value is still in `copied`: the same value, and what is known of it.
        same.set(index, copied)
        let r = u32.toUsize(inst.result)
        let first = alias.get(u32.toUsize(copied))
        let isObject = object.get(u32.toUsize(copied))
        let has = version.get(u32.toUsize(copied))
        alias.set(r, first)
        object.set(r, isObject)
        version.set(r, has)
        if isObject != 0 { let fact = u8.bitOr(facts.get(index), FACT_OBJECT) facts.set(index, fact) }
      } else if inst.op == Op.CheckTag {
        if u32.toUsize(inst.a) < values {
          if object.get(u32.toUsize(inst.a)) != 0 && inst.k == TAG_OBJECT { facts.set(index, FACT_OBJECT) }
          if inst.k == TAG_OBJECT { object.set(u32.toUsize(inst.a), 1) }
        }
      } else if key != 0 {
        let a = u32.toUsize(inst.a)
        let mut fact: u8 = 0
        if object.get(a) != 0 { fact = FACT_OBJECT }
        if version.get(a) == u64.shiftRight(key, 16) { fact = u8.bitOr(fact, FACT_SHAPE) }
        facts.set(index, fact)
        object.set(a, 1)
        version.set(a, u64.shiftRight(key, 16))
        if inst.op == Op.PutField {
          // In place, in the slot of this property: whatever held it before is out of date,
          // on any object (another value may be the same one), and the stored value has it.
          forget(&mut held, atom)
          if atom != 0 && u32.toUsize(inst.b) < values { run remember(&mut held, Known { object: alias.get(a), atom: atom, value: inst.b }) }
        } else if atom != 0 { run remember(&mut held, Known { object: alias.get(a), atom: atom, value: inst.result }) }
      } else if reads.get(index) != 0 {
        let site = read.get(u32.toUsize(reads.get(index) - 1))
        let a = u32.toUsize(inst.a)
        let mut fact = facts.get(index)
        if object.get(a) != 0 { fact = u8.bitOr(fact, FACT_OBJECT) }
        let mut m: u32 = 0
        while m < site.count {
          if version.get(a) != 0 && version.get(a) == versionOf(site.keys[u32.toUsize(m)]) { fact = u8.bitOr(fact, u8.shiftLeft(u32.wrappingToU8(m + 1), FACT_PAIR)) }
          m = m + 1
        }
        facts.set(index, fact)
        if u8.bitAnd(fact, FACT_HEDGED) != 0 {
          // Its helper may run a getter.
          let mut v: usize = 0
          while v < values { version.set(v, 0) v = v + 1 }
          held.truncate(0)
        } else {
          object.set(a, 1)
          if site.count == 1 { version.set(a, versionOf(site.keys[0])) }
          if atom != 0 { run remember(&mut held, Known { object: alias.get(a), atom: atom, value: inst.result }) }
        }
      } else if inst.op == Op.Release {
        if u32.toUsize(inst.a) < values && object.get(u32.toUsize(inst.a)) != 0 { facts.set(index, FACT_OBJECT) }
      } else if inst.op == Op.Retain {
        // Another owner of the same object.
        if inst.result != NONE && u32.toUsize(inst.result) < values && u32.toUsize(inst.a) < values {
          let isObject = object.get(u32.toUsize(inst.a))
          if isObject != 0 { facts.set(index, FACT_OBJECT) }
          let has = version.get(u32.toUsize(inst.a))
          object.set(u32.toUsize(inst.result), isObject)
          version.set(u32.toUsize(inst.result), has)
          let first = alias.get(u32.toUsize(inst.a))
          alias.set(u32.toUsize(inst.result), first)
        }
      } else if !quiet(inst.op) {
        let mut v: usize = 0
        while v < values { version.set(v, 0) v = v + 1 }
        held.truncate(0)
      } else if inst.op == Op.PutVar {
        // A global binding may be a property of the global object.
        held.truncate(0)
      }
      n = n + 1
    }
    let base = b * values
    let mut v: usize = 0
    while v < values { versions.set(base + v, version.get(v)) objects.set(base + v, object.get(v)) v = v + 1 }
    let mut k: usize = 0
    while k < held.length() && k < KNOWN { heldOut.set(b * KNOWN + k, held.get(k)) k = k + 1 }
    heldCount.set(b, usize.toU32(k))
    done.set(b, 1)
    b = b + 1
  }
  pass = pass + 1
  }
  return Shapes { keys: move keys, facts: move facts, reads: move reads, sites: move read, same: move same }
}
