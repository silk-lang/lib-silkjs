//! Exits name the unboxed number (docs/jit/code-quality.md).
//!
//! After `u = unbox.i32 v` passed, `v` is an Int and `u` is its number, so an exit later in
//! the block that writes `v` to the interpreter's frame can write `int u` instead: the same
//! value. `v` then has no reader past its unbox, and when `v` is an element read the backend
//! loads the number straight from the array (x64_backend: get.elem followed by its unbox),
//! without copying the element to a frame slot first.
//!
//! Only a borrowed `v` (an owned one is moved by the exit, which the ownership rules count),
//! and only exits one instruction uses: an exit shared with an instruction in front of the
//! unbox (ssa_opt_hoist's front block) runs before `u` exists.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize
import ssa { Function, Own, Op, Slot, SlotMode, NONE }

/// Rewrites the exit slots described above; answers whether any changed. Linear in the
/// instructions and the exit slots.
pub effect fn unboxedSlots(f: &mut Function) -> bool ! OutOfMemoryError ? &mut Allocator {
  let values = f.values.length()
  // How many instructions use each exit.
  let mut users = List<u32>.make()
  run users.appendRepeated(0, f.exits.length())
  let mut any = false
  let mut i: usize = 0
  while i < f.insts.length() {
    let inst = f.insts.get(i)
    if inst.op != Op.Removed && inst.exit != NONE { let at = u32.toUsize(inst.exit) let before = users.get(at) users.set(at, before + 1) }
    if inst.op == Op.Unbox { any = true }
    i = i + 1
  }
  f.work = f.work + usize.toU64(f.insts.length())
  if !any { return false }
  // unboxed[v]: the number of v, valid while stamp[v] is the block being walked (plus one).
  let mut unboxed = List<u32>.make() let mut stamp = List<u32>.make()
  run unboxed.appendRepeated(NONE, values) run stamp.appendRepeated(0, values)
  let mut changed = false
  let mut b: u32 = 0
  while b < f.blockCount() {
    let block = f.blocks.get(u32.toUsize(b))
    let mut seen = false
    let mut at = block.firstInst
    while at < block.firstInst + block.instCount {
      let inst = f.inst(at)
      if inst.block == b && inst.op != Op.Removed {
        if seen && inst.exit != NONE && users.get(u32.toUsize(inst.exit)) == 1 {
          let exit = f.exit(inst.exit)
          let count = f.slotCount(exit)
          let mut s: u32 = 0
          while s < count {
            let v = f.slot(exit, s).value
            if u32.toUsize(v) < values && stamp.get(u32.toUsize(v)) == b + 1 {
              f.setSlot(exit.firstSlot + s, Slot { value: unboxed.get(u32.toUsize(v)), mode: SlotMode.Int, root: NONE })
              changed = true
            }
            s = s + 1
          }
          f.work = f.work + u32.toU64(count)
        }
        if inst.op == Op.Unbox && inst.result != NONE && u32.toUsize(inst.a) < values && f.value(inst.a).own == Own.Borrowed {
          unboxed.set(u32.toUsize(inst.a), inst.result)
          stamp.set(u32.toUsize(inst.a), b + 1)
          seen = true
        }
      }
      at = at + 1
    }
    b = b + 1
  }
  return changed
}
