//! The part of libuv that uvwasi calls, written in Silk, so that uvwasi builds and runs without
//! libuv.
//!
//! uvwasi (modules/native/uvwasi/uvwasi) is C written against libuv's `uv.h`. It is compiled
//! against modules/native/uvwasi/uvwasi/shim/uv.h instead, which declares only what uvwasi uses and
//! names every function `silk_uvwasi_*`. This module exports those functions. Nothing here is
//! named `uv_*`, so it cannot collide with another definition of libuv's interface.
//!
//! The behavior follows libuv 1.51 (src/unix): what a request stores in `result`, `ptr` and
//! `statbuf`, which calls are made again after `EINTR`, how a status record, a directory entry
//! and a time are converted, and the order of one loop turn.
//!
//! # Layouts
//! Each `extern "C" struct` below is the Silk view of a struct in shim/uv.h. The header asserts
//! the sizes and offsets it expects, and [`layoutsAgree`] checks this module's side when the first
//! request or loop is made. Change the two files together.
//!
//! # The loop
//! uvwasi makes a loop for each `poll_oneoff` call, and one more when it is created with sockets
//! to open. That loop is private to uvwasi and is not the runtime's event loop. It holds poll
//! handles, timers and TCP streams in a list and waits in `poll(2)`. A turn runs in libuv's order:
//! pending shutdown requests, the wait, the handles that close, then the timers.
//!
//! # Differences from libuv
//! - A handle or stream argument that is null is refused with an error. libuv dereferences it.
//!   uvwasi passes a null stream when a guest calls a `sock_*` function on a descriptor that is not
//!   one of its sockets.
//! - `uv_poll_init` asks a scratch epoll descriptor (Linux) or kqueue (Darwin) whether the
//!   descriptor can be watched, as libuv asks its backend, and so refuses the same descriptors.
//!   The wait itself is `poll(2)` on both systems.
//! - A TCP stream is linked into its loop when it gets a descriptor or closes, not when it is
//!   initialized, so a stream that uvwasi frees without closing leaves no dangling link.
//! - A full descriptor table while accepting is not relieved with a spare descriptor.
//! - Linux `uv_random` does not fall back to the `_sysctl` system call, which Linux removed.
//! - Linux tries `statx` on every status request and falls back each time the kernel refuses it;
//!   libuv remembers the refusal. The results are the same.
//! - The process keeps no descriptors of its own: libuv's two for its signal pipe are not opened.
//!
//! # Targets
//! Linux on x86_64 and aarch64 with GNU libc, and Darwin on aarch64. Darwin on x86_64 would need
//! the `$INODE64` variants of `stat`, `fstat`, `lstat`, `opendir` and `readdir`.
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.layout { Layout }
import silk.mem.pointer { Pointer }
import silk.num.f64
import silk.num.i16
import silk.num.i32
import silk.num.i64
import silk.num.isize
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize

// The layouts of shim/uv.h.

/// `uv_timespec_t`, and the C `struct timespec` of the supported targets.
pub extern "C" struct Timespec { pub seconds: i64, pub nanoseconds: i64 }
impl Copy for Timespec {}

/// `uv_stat_t`.
pub extern "C" struct Stat {
  pub dev: u64, pub mode: u64, pub nlink: u64, pub uid: u64, pub gid: u64, pub rdev: u64,
  pub ino: u64, pub size: u64, pub blksize: u64, pub blocks: u64, pub flags: u64, pub gen: u64,
  pub atime: Timespec, pub mtime: Timespec, pub ctime: Timespec, pub birthtime: Timespec,
}
impl Copy for Stat {}

/// `uv_fs_t`. `kind` says which request it was, and so who owns `ptr`.
pub extern "C" struct Fs { pub result: isize, pub ptr: ?*mut u8, pub kind: i32, pub reserved: i32, pub stat: Stat }

/// `uv_buf_t`, which is also the C `struct iovec`.
pub extern "C" struct Buf { pub base: ?[*]mut u8, pub length: usize }
impl Copy for Buf {}

/// `uv_dirent_t`.
pub extern "C" struct Dirent { pub name: ?*mut u8, pub kind: i32 }

/// `uv_dir_t`.
pub extern "C" struct Dir { pub dirents: ?[*]mut Dirent, pub count: usize, pub stream: ?*mut DirectoryStream }

/// `uv_timeval64_t`.
pub extern "C" struct Timeval64 { pub seconds: i64, pub microseconds: i32 }

pub type CloseCallback = ?extern "C" fn(*mut Handle) -> ()
pub type PollCallback = ?extern "C" fn(*mut Poll, i32, i32) -> ()
pub type TimerCallback = ?extern "C" fn(*mut Timer) -> ()
pub type AllocCallback = ?extern "C" fn(*mut Handle, usize, *mut Buf) -> ()
pub type ReadCallback = ?extern "C" fn(*mut Stream, isize, *const Buf) -> ()
pub type ConnectionCallback = ?extern "C" fn(*mut Stream, i32) -> ()
pub type ShutdownCallback = ?extern "C" fn(*mut Shutdown, i32) -> ()

/// `uv_loop_t`.
pub extern "C" struct Loop {
  pub data: ?*mut u8,
  /// Every handle that is active, holds a descriptor, or closes.
  pub handles: ?*mut Handle,
  pub closing: ?*mut Handle,
  /// Milliseconds of the monotonic clock, as of the last update.
  pub time: u64,
  /// Handles that are both active and referenced.
  pub activeHandles: u32,
  /// Shutdown requests that wait for the next turn.
  pub activeRequests: u32,
  pub stop: i32,
  pub reserved: i32,
}

/// `uv_handle_t`: the fields that every handle starts with.
pub extern "C" struct Handle {
  pub data: ?*mut u8, pub loop: ?*mut Loop, pub kind: i32, pub flags: u32, pub close: CloseCallback,
  pub next: ?*mut Handle, pub previous: ?*mut Handle, pub nextClosing: ?*mut Handle,
}

/// `uv_poll_t`. `events` holds the wanted `poll(2)` events, and 0 while the handle is stopped.
pub extern "C" struct Poll {
  pub data: ?*mut u8, pub loop: ?*mut Loop, pub kind: i32, pub flags: u32, pub close: CloseCallback,
  pub next: ?*mut Handle, pub previous: ?*mut Handle, pub nextClosing: ?*mut Handle,
  pub callback: PollCallback, pub fd: i32, pub events: i32,
}

/// `uv_timer_t`. `timeout` is the loop time at which the timer is due.
pub extern "C" struct Timer {
  pub data: ?*mut u8, pub loop: ?*mut Loop, pub kind: i32, pub flags: u32, pub close: CloseCallback,
  pub next: ?*mut Handle, pub previous: ?*mut Handle, pub nextClosing: ?*mut Handle,
  pub callback: TimerCallback, pub timeout: u64, pub repeat: u64,
}

/// `uv_stream_t` and `uv_tcp_t`.
pub extern "C" struct Stream {
  pub data: ?*mut u8, pub loop: ?*mut Loop, pub kind: i32, pub flags: u32, pub close: CloseCallback,
  pub next: ?*mut Handle, pub previous: ?*mut Handle, pub nextClosing: ?*mut Handle,
  pub alloc: AllocCallback, pub read: ReadCallback, pub connection: ConnectionCallback,
  pub shutdown: ?*mut Shutdown, pub fd: i32, pub acceptedFd: i32, pub delayedError: i32, pub reserved: i32,
}

/// `uv_shutdown_t`.
pub extern "C" struct Shutdown { pub data: ?*mut u8, pub handle: ?*mut Stream, pub callback: ShutdownCallback }

/// The C `DIR`.
pub extern "C" struct DirectoryStream {}

/// The C `struct pollfd`.
extern "C" struct PollFd { fd: i32, events: i16, revents: i16 }
impl Copy for PollFd {}

// libuv's numbers.

const UV_EOF: i32 = -4095
const UV_UNKNOWN_HANDLE: i32 = 0
const UV_NAMED_PIPE: i32 = 7
const UV_POLL: i32 = 8
