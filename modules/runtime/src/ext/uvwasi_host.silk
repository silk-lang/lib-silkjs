const UV_TIMER: i32 = 13
const UV_TTY: i32 = 14
const UV_UDP: i32 = 15
const UV_FILE: i32 = 17
const UV_RUN_DEFAULT: i32 = 0
const UV_RUN_ONCE: i32 = 1
const UV_READABLE: i32 = 1
const UV_WRITABLE: i32 = 2
const UV_DISCONNECT: i32 = 4
const UV_PRIORITIZED: i32 = 8

// Handle flags. The first group has libuv's values and meanings.
const CLOSING: u32 = 1
const CLOSED: u32 = 2
const ACTIVE: u32 = 4
const REFERENCED: u32 = 8
const SHUT: u32 = 512
const READ_PARTIAL: u32 = 1024
const READ_EOF: u32 = 2048
const READING: u32 = 4096
const BOUND: u32 = 8192
const READABLE: u32 = 16384
const WRITABLE: u32 = 32768
// The handle is in its loop's list.
const LINKED: u32 = 16
// The stream listens for connections.
const LISTENING: u32 = 65536
// The timer is due and its callback has not run yet.
const TIMER_READY: u32 = 131072

// What a request was.
const FS_PLAIN: i32 = 0
// `ptr` is the request's own `statbuf`.
const FS_STAT: i32 = 1
// `ptr` is a `uv_dir_t` that `uv_fs_closedir` frees.
const FS_OPENDIR: i32 = 2
// `ptr` is the `uv_dir_t`, whose first `result` entry names the request owns.
const FS_READDIR: i32 = 3
// `ptr` is memory that the request owns.
const FS_OWNED: i32 = 4

// `poll(2)` events. The first six have the same values on Linux and Darwin. POLLRDHUP is Linux's
// value; on Darwin it is only this module's mark for "tell me about a hangup".
const POLLIN: i32 = 1
const POLLPRI: i32 = 2
const POLLOUT: i32 = 4
const POLLERR: i32 = 8
const POLLHUP: i32 = 16
const POLLNVAL: i32 = 32
const POLLRDHUP: i32 = 8192

// Values that are the same on Linux and Darwin.
const EPERM: i32 = 1
const EINTR: i32 = 4
const EIO: i32 = 5
const E2BIG: i32 = 7
const EBADF: i32 = 9
const ENOMEM: i32 = 12
const EBUSY: i32 = 16
const EEXIST: i32 = 17
const EINVAL: i32 = 22
const ENOTTY: i32 = 25
const EPIPE: i32 = 32
const AF_UNIX: u16 = 1
const AF_INET: u16 = 2
const SOCK_STREAM: i32 = 1
const SOCK_DGRAM: i32 = 2
const SHUT_WR: i32 = 1
const F_GETFD: i32 = 1
const F_SETFD: i32 = 2
const F_GETFL: i32 = 3
const F_SETFL: i32 = 4
const FD_CLOEXEC: i32 = 1
const IOV_MAX: u32 = 1024
const TYPE_MASK: u64 = 61440
const TYPE_FIFO: u64 = 4096
const TYPE_CHARACTER: u64 = 8192
const TYPE_DIRECTORY: u64 = 16384
const TYPE_REGULAR: u64 = 32768
const TYPE_SOCKET: u64 = 49152

