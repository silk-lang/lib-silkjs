//! Brotli for `ext.compression_native`: the calls it made on the C library, with the C library's
//! names, arguments and results, on the Silk port in `modules/brotli`. A codec is a box on the C
//! heap that the handle which created it owns; a worker thread is the only one using it between
//! submit and poll, as before. The stream calls report progress in `availableIn` and `availableOut`
//! only, which is all their one caller reads; `nextIn` and `nextOut` are left where they were.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.pointer { Pointer }
import silk.mem.layout { Layout }
import silk.collections.slice { Slice }
import silk.num.i32
import silk.num.u32
import brotli.decode { BrotliDecoder }
import brotli.encode { BrotliEncoder, PreparedDictionary }
import ext.compression_abi as c

unsafe fn box<T>(value: T) -> ?*mut u8 {
  let storage = unsafe c.calloc(1, Layout.of<T>().bytes)
  return match Pointer.nonNullMut<u8>(storage) {
    Option.Some { value: raw } => {
      unsafe Pointer.put<T>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(raw), move value)
      storage
    }
    Option.None => {
      drop value
      Pointer.null<u8>()
    }
  }
}

unsafe fn unbox<T>(storage: ?*mut u8) -> () {
  match Pointer.nonNullMut<u8>(storage) {
    Option.Some { value: raw } => {
      let owned = unsafe Pointer.take<T>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut T>(raw))
      drop owned
      unsafe c.free(storage)
    }
    Option.None => {}
  }
}

// The `length` bytes at `data`, or nothing when there are none (C callers pass null then).
unsafe fn input<'a>(anchor: &'a (), data: ?*mut u8, length: usize) -> &'a [u8] {
  if length == 0 { return b"" }
  return match Pointer.nonNullMut<u8>(data) {
    Option.Some { value: raw } => unsafe Pointer.borrowMany<(), u8>(anchor, unsafe Pointer.assumeMany<u8>(raw), length)
    Option.None => b""
  }
}

pub unsafe fn BrotliEncoderCreateInstance(_alloc: ?*mut u8, _free: ?*mut u8, _opaque: ?*mut u8) -> ?*mut u8 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let made = run Effect.result(BrotliEncoder.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  return match move made {
    Result<BrotliEncoder, OutOfMemoryError>.Success { value } => unsafe box<BrotliEncoder>(move value)
    Result<BrotliEncoder, OutOfMemoryError>.Failure { .. } => Pointer.null<u8>()
  }
}

pub unsafe fn BrotliEncoderDestroyInstance(state: ?*mut u8) -> () {
  unsafe unbox<BrotliEncoder>(state)
}

pub unsafe fn BrotliEncoderSetParameter(state: ?*mut u8, parameter: i32, value: u32) -> i32 {
  let mut anchor = ()
  let encoder = unsafe Pointer.borrowMut<(), BrotliEncoder>(&mut anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut BrotliEncoder>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(state)))
  if BrotliEncoder.setParameter(&mut encoder, i32.wrappingToU32(parameter), value) { return 1 }
  return 0
}

pub unsafe fn BrotliEncoderCompressStream(state: ?*mut u8, operation: i32, availableIn: *mut usize, nextIn: *mut ?*mut u8, availableOut: *mut usize, nextOut: *mut ?*mut u8, _totalOut: ?*mut usize) -> i32 {
  let mut anchor = ()
  let encoder = unsafe Pointer.borrowMut<(), BrotliEncoder>(&mut anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut BrotliEncoder>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(state)))
  let source = ()
  let given = unsafe Pointer.read<usize>(availableIn)
  let capacity = unsafe Pointer.read<usize>(availableOut)
  let from = unsafe Pointer.read<?*mut u8>(nextIn)
  let to = unsafe Pointer.read<?*mut u8>(nextOut)
  let mut target = ()
  let mut none: [u8; 1] = [0]
  let mut allocator = Allocator.systemAllocatorProvider()
  let step = match Pointer.nonNullMut<u8>(to) {
    Option.Some { value: raw } => run BrotliEncoder.compressStream(&mut encoder, i32.wrappingToU32(operation), unsafe input(&source, from, given), unsafe Pointer.borrowManyMut<(), u8>(&mut target, unsafe Pointer.assumeManyMut<u8>(raw), capacity)) |> Effect.provideMut<Allocator>(&mut allocator)
    Option.None => run BrotliEncoder.compressStream(&mut encoder, i32.wrappingToU32(operation), unsafe input(&source, from, given), Slice.viewMut<u8>(&mut none, 0, 0)) |> Effect.provideMut<Allocator>(&mut allocator)
  }
  unsafe Pointer.put<usize>(availableIn, given - step.consumed)
  unsafe Pointer.put<usize>(availableOut, capacity - step.written)
  if step.ok { return 1 }
  return 0
}

pub unsafe fn BrotliEncoderIsFinished(state: ?*mut u8) -> i32 {
  let anchor = ()
  let encoder = unsafe Pointer.borrow<(), BrotliEncoder>(&anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut BrotliEncoder>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(state)))
  if BrotliEncoder.isFinished(encoder) { return 1 }
  return 0
}

pub unsafe fn BrotliEncoderHasMoreOutput(state: ?*mut u8) -> i32 {
  let anchor = ()
  let encoder = unsafe Pointer.borrow<(), BrotliEncoder>(&anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut BrotliEncoder>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(state)))
  if BrotliEncoder.hasMoreOutput(encoder) { return 1 }
  return 0
}

pub unsafe fn BrotliEncoderPrepareDictionary(kind: i32, size: usize, data: ?*mut u8, quality: i32, _alloc: ?*mut u8, _free: ?*mut u8, _opaque: ?*mut u8) -> ?*mut u8 {
  let source = ()
  let mut allocator = Allocator.systemAllocatorProvider()
  let made = run Effect.result(PreparedDictionary.prepare(i32.wrappingToU32(kind), unsafe input(&source, data, size), i32.wrappingToU32(quality))) |> Effect.provideMut<Allocator>(&mut allocator)
  return match move made {
    Result<PreparedDictionary, OutOfMemoryError>.Success { value } => unsafe box<Option<PreparedDictionary>>(Option<PreparedDictionary>.some(move value))
    Result<PreparedDictionary, OutOfMemoryError>.Failure { .. } => Pointer.null<u8>()
  }
}

// The encoder takes a prepared dictionary when it is attached, so there is nothing left to destroy
// afterwards: BrotliEncoderAttachPreparedDictionary empties the box and this frees it.
pub unsafe fn BrotliEncoderDestroyPreparedDictionary(dictionary: ?*mut u8) -> () {
  unsafe unbox<Option<PreparedDictionary>>(dictionary)
}

pub unsafe fn BrotliEncoderAttachPreparedDictionary(state: ?*mut u8, dictionary: ?*mut u8) -> i32 {
  let mut anchor = ()
  let encoder = unsafe Pointer.borrowMut<(), BrotliEncoder>(&mut anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut BrotliEncoder>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(state)))
  let slot = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Option<PreparedDictionary>>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(dictionary))
  let held = unsafe Pointer.take<Option<PreparedDictionary>>(slot)
  unsafe Pointer.put<Option<PreparedDictionary>>(slot, Option<PreparedDictionary>.none())
  return match move held {
    Option.Some { value } => {
      let mut allocator = Allocator.systemAllocatorProvider()
      let attached = run BrotliEncoder.attachPreparedDictionary(&mut encoder, move value) |> Effect.provideMut<Allocator>(&mut allocator)
      if attached { 1 } else { 0 }
    }
    Option.None => 0
  }
}

pub unsafe fn BrotliDecoderCreateInstance(_alloc: ?*mut u8, _free: ?*mut u8, _opaque: ?*mut u8) -> ?*mut u8 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let made = run Effect.result(BrotliDecoder.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  return match move made {
    Result<BrotliDecoder, OutOfMemoryError>.Success { value } => unsafe box<BrotliDecoder>(move value)
    Result<BrotliDecoder, OutOfMemoryError>.Failure { .. } => Pointer.null<u8>()
  }
}

pub unsafe fn BrotliDecoderDestroyInstance(state: ?*mut u8) -> () {
  unsafe unbox<BrotliDecoder>(state)
}

pub unsafe fn BrotliDecoderSetParameter(state: ?*mut u8, parameter: i32, value: u32) -> i32 {
  let mut anchor = ()
  let decoder = unsafe Pointer.borrowMut<(), BrotliDecoder>(&mut anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut BrotliDecoder>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(state)))
  if BrotliDecoder.setParameter(&mut decoder, i32.wrappingToU32(parameter), value) { return 1 }
  return 0
}

pub unsafe fn BrotliDecoderAttachDictionary(state: ?*mut u8, kind: i32, size: usize, data: ?*mut u8) -> i32 {
  let mut anchor = ()
  let decoder = unsafe Pointer.borrowMut<(), BrotliDecoder>(&mut anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut BrotliDecoder>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(state)))
  let source = ()
  let mut allocator = Allocator.systemAllocatorProvider()
  let attached = run BrotliDecoder.attachDictionary(&mut decoder, i32.wrappingToU32(kind), unsafe input(&source, data, size)) |> Effect.provideMut<Allocator>(&mut allocator)
  if attached { return 1 }
  return 0
}

pub unsafe fn BrotliDecoderDecompressStream(state: ?*mut u8, availableIn: *mut usize, nextIn: *mut ?*mut u8, availableOut: *mut usize, nextOut: *mut ?*mut u8, _totalOut: ?*mut usize) -> i32 {
  let mut anchor = ()
  let decoder = unsafe Pointer.borrowMut<(), BrotliDecoder>(&mut anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut BrotliDecoder>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(state)))
  let source = ()
  let given = unsafe Pointer.read<usize>(availableIn)
  let capacity = unsafe Pointer.read<usize>(availableOut)
  let from = unsafe Pointer.read<?*mut u8>(nextIn)
  let to = unsafe Pointer.read<?*mut u8>(nextOut)
  let mut target = ()
  let mut none: [u8; 1] = [0]
  let mut allocator = Allocator.systemAllocatorProvider()
  let step = match Pointer.nonNullMut<u8>(to) {
    Option.Some { value: raw } => run BrotliDecoder.decompressStream(&mut decoder, unsafe input(&source, from, given), unsafe Pointer.borrowManyMut<(), u8>(&mut target, unsafe Pointer.assumeManyMut<u8>(raw), capacity)) |> Effect.provideMut<Allocator>(&mut allocator)
    Option.None => run BrotliDecoder.decompressStream(&mut decoder, unsafe input(&source, from, given), Slice.viewMut<u8>(&mut none, 0, 0)) |> Effect.provideMut<Allocator>(&mut allocator)
  }
  unsafe Pointer.put<usize>(availableIn, given - step.consumed)
  unsafe Pointer.put<usize>(availableOut, capacity - step.written)
  return u32.wrappingToI32(step.result)
}

pub unsafe fn BrotliDecoderGetErrorCode(state: ?*mut u8) -> i32 {
  let anchor = ()
  let decoder = unsafe Pointer.borrow<(), BrotliDecoder>(&anchor, unsafe Intrinsic.pointerReinterpret<*mut u8, *mut BrotliDecoder>(unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(state)))
  return BrotliDecoder.errorCode(decoder)
}

/// `process.versions.brotli`, as `major << 24 | minor << 12 | patch`.
pub fn BrotliDecoderVersion() -> u32 {
  return BrotliDecoder.version()
}
