//! The table of block compressors: `ZSTD_selectBlockCompressor` of `lib/compress/zstd_compress.c`.
//!
//! [`compressBlock`] calls the block compressor of a strategy, of the row match finder mode and
//! of a dictionary mode (`cstate.NO_DICT`, `EXT_DICT`, `DICT_MATCH_STATE`,
//! `DEDICATED_DICT_SEARCH`). A block compressor has the signature that `zfast` documents.
//!
//! Not ported yet, and routed to a compressor that makes a valid block:
//! - `greedy` and above (`zlazy`, `zopt`): routed to `dfast`, or to `fast` when the strategy
//!   has no chain table (the row match finder is on).
//! - `DICT_MATCH_STATE` and `DEDICATED_DICT_SEARCH`: no caller attaches a dictionary yet.
import cstate
import cstate { MatchState, SeqStore }
import cparams
import zfast
import zdfast
import zopt

/// Whether [`compressBlock`] runs the block compressor of the reference for `strategy`, and not
/// a stand-in.
pub fn isExact(strategy: u32) -> bool { return strategy <= cparams.DFAST || strategy >= cparams.BTOPT }

/// Runs the block compressor that `ZSTD_selectBlockCompressor(strategy, useRowMatchFinder,
/// dictMode)` selects on `src[0..srcSize]`, and returns the size of the last literals.
pub unsafe fn compressBlock(strategy: u32, useRowMatchFinder: u32, dictMode: u32, ms: &mut MatchState, seqStore: &mut SeqStore, rep: [*]mut u8, src: [*]const u8, srcSize: usize) -> usize {
  let hasChain = cparams.allocateChainTable(strategy, useRowMatchFinder, false)
  if dictMode == cstate.EXT_DICT {
    if strategy <= cparams.FAST { return unsafe zfast.compressBlockFastExtDict(&mut ms, &mut seqStore, rep, src, srcSize) }
    if strategy == cparams.DFAST { return unsafe zdfast.compressBlockDoubleFastExtDict(&mut ms, &mut seqStore, rep, src, srcSize) }
    // greedy .. btultra2, extDict: plug `zlazy` and `zopt` in here.
    if strategy == cparams.BTOPT { return unsafe zopt.compressBlockBtoptExtDict(&mut ms, &mut seqStore, rep, src, srcSize) }
    if strategy >= cparams.BTULTRA { return unsafe zopt.compressBlockBtultraExtDict(&mut ms, &mut seqStore, rep, src, srcSize) }
    if !hasChain { return unsafe zfast.compressBlockFastExtDict(&mut ms, &mut seqStore, rep, src, srcSize) }
    return unsafe zdfast.compressBlockDoubleFastExtDict(&mut ms, &mut seqStore, rep, src, srcSize)
  }
  // NO_DICT. (DICT_MATCH_STATE and DEDICATED_DICT_SEARCH: plug the dictionary variants in here.)
  if strategy <= cparams.FAST { return unsafe zfast.compressBlockFast(&mut ms, &mut seqStore, rep, src, srcSize) }
  if strategy == cparams.DFAST { return unsafe zdfast.compressBlockDoubleFast(&mut ms, &mut seqStore, rep, src, srcSize) }
  // greedy .. btultra2, noDict: plug `zlazy` and `zopt` in here.
  if strategy == cparams.BTOPT { return unsafe zopt.compressBlockBtopt(&mut ms, &mut seqStore, rep, src, srcSize) }
  if strategy == cparams.BTULTRA { return unsafe zopt.compressBlockBtultra(&mut ms, &mut seqStore, rep, src, srcSize) }
  if strategy >= cparams.BTULTRA2 { return unsafe zopt.compressBlockBtultra2(&mut ms, &mut seqStore, rep, src, srcSize) }
  if !hasChain { return unsafe zfast.compressBlockFast(&mut ms, &mut seqStore, rep, src, srcSize) }
  return unsafe zdfast.compressBlockDoubleFast(&mut ms, &mut seqStore, rep, src, srcSize)
}
