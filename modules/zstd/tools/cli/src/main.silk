import zstd.api
import zstd.mem
import silk.mem.pointer { Pointer }
import silk.num.usize
unsafe extern "C" fn printf(format: ?[*]const u8, a: i64) -> i32
pub fn main() -> i32 {
  let p = unsafe Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(unsafe mem.calloc(1, 64))
  let n = unsafe api.probe(unsafe mem.ro(p), unsafe mem.ro(p), 50)
  let _p = unsafe printf(Pointer.fromSlice<u8>(b"%ld\n\0"), usize.toI64(n))
  return 0
}
