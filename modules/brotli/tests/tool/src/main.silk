//! The Silk side of the Brotli differential tests: the same driver as ../reference/ref_tool.c, on
//! this package. Input on stdin, output on stdout, one trace line for each library call on stderr.
//! Environment: BR_MODE (0 compress, 1 decompress), BR_PARAMS ("id=value,id=value"), BR_IN (input
//! bytes given to one call), BR_OUT (output capacity of one call), BR_FLUSH (compress: every n-th
//! input chunk ends with OPERATION_FLUSH; 0 never), BR_META (compress: every n-th input chunk is
//! sent as EMIT_METADATA, at most 16 bytes; 0 never), BR_DICT (path of a raw dictionary to
//! attach), BR_TRACE (0 turns the trace off).
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.mem.pointer { Pointer }
import silk.num.usize
import silk.num.i64
import silk.num.i32
import silk.num.u8
import silk.num.u32
import silk.core.option { Option }
import brotli.decode { BrotliDecoder }
import brotli.encode { BrotliEncoder, PreparedDictionary }

unsafe extern "C" fn read(fd: i32, buffer: ?[*]mut u8, count: usize) -> i64
unsafe extern "C" fn write(fd: i32, buffer: ?[*]const u8, count: usize) -> i64
unsafe extern "C" fn open(path: ?[*]const u8, flags: i32) -> i32
unsafe extern "C" fn getenv(name: ?[*]const u8) -> ?[*]const u8
unsafe extern "C" fn atol(text: ?[*]const u8) -> i64
unsafe extern "C" fn strlen(text: ?[*]const u8) -> usize

fn env(name: &[u8], fallback: i64) -> i64 {
  let value = unsafe getenv(Pointer.fromSlice<u8>(name))
  if Pointer.isNullMany<u8>(value) { return fallback }
  if unsafe strlen(value) == 0 { return fallback }
  return unsafe atol(value)
}

fn writeAll(fd: i32, bytes: &[u8]) -> () {
  let mut done: usize = 0
  while done < bytes.length {
    let rest = Slice.view<u8>(bytes, done, bytes.length - done)
    let n = unsafe write(fd, Pointer.fromSlice<u8>(rest), rest.length)
    if n <= 0 { return () }
    done = done + i64.toUsize(n)
  }
}

// Reads the whole file like the C driver's `slurp`: a buffer of 1 MiB that doubles whenever less
// than 64 KiB are free, so that the memory the driver itself touches is the same on both sides.
effect fn readAll(fd: i32) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut data = run List<u8>.makeWithCapacity(1048576)
  let mut used: usize = 0
  while true {
    let capacity = List<u8>.capacity(&data)
    if capacity - used < 65536 { run List<u8>.reserveExact(&mut data, 2 * capacity - used) }
    let space = List<u8>.capacity(&data) - used
    // The capacity is not 0, so the storage is not null; `used` is below the capacity.
    let base = unsafe Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(unsafe List<u8>.storage(&mut data))
    let n = unsafe read(fd, unsafe Pointer.assumeManyMut<u8>(unsafe Pointer.atMut<u8>(base, used)), space)
    if n <= 0 { break }
    used = used + i64.toUsize(n)
    unsafe List<u8>.setLength(&mut data, used)
  }
  return move data
}

// Appends the decimal digits of `value` and then `end` to `line`.
fn number(line: &mut [u8; 160], at: usize, value: i64, end: u8) -> usize {
  let mut digits: [u8; 24] = [0; 24]
  let mut count: usize = 0
  let mut rest = value
  let mut position = at
  if rest < 0 { line[position] = 45 position = position + 1 rest = 0 - rest }
  while true {
    digits[count] = i64.wrappingToU8(48 + i64.remainder(rest, 10))
    count = count + 1
    rest = i64.divide(rest, 10)
    if rest == 0 { break }
  }
  while count > 0 { count = count - 1 line[position] = digits[count] position = position + 1 }
  line[position] = end
  return position + 1
}

// One trace line: `tag` and up to six numbers.
fn trace(on: bool, tag: u8, count: usize, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> () {
  if !on { return () }
  let mut line: [u8; 160] = [0; 160]
  line[0] = tag
  let mut at: usize = 1
  let values: [i64; 6] = [a, b, c, d, e, f]
  let mut index: usize = 0
  while index < count {
    line[at] = 32
    at = number(&mut line, at + 1, values[index], 0) - 1
    index = index + 1
  }
  line[at] = 10
  writeAll(2, Slice.view<u8>(&line, 0, at + 1))
}

fn flag(value: bool) -> i64 { if value { return 1 } return 0 }

// The next `id=value` pair of BR_PARAMS at `at`, as (id, value, next position), or id -1 at the end.
fn pair(text: &[u8], at: usize) -> [i64; 3] {
  let mut position = at
  let mut values: [i64; 2] = [0, 0]
  let mut which: usize = 0
  if position >= text.length { return [-1, 0, 0] }
  while position < text.length && text[position] != 44 {
    if text[position] == 61 { which = 1 } else { values[which] = values[which] * 10 + u8.toI64(text[position]) - 48 }
    position = position + 1
  }
  if position < text.length { position = position + 1 }
  return [values[0], values[1], usize.toI64(position)]
}

effect fn params() -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut text = List<u8>.make()
  let value = unsafe getenv(Pointer.fromSlice<u8>(b"BR_PARAMS\x00"))
  match Pointer.nonNullMany<u8>(value) {
    Option.Some { value: start } => {
      let length = unsafe strlen(value)
      let mut index: usize = 0
      while index < length {
        run List<u8>.append(&mut text, unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(start, index)))
        index = index + 1
      }
    }
    Option.None => {}
  }
  return move text
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run body() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn body() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let data = run readAll(0)
  let input = List<u8>.asSlice(&data)
  let mode = env(b"BR_MODE\x00", 0)
  let inChunk = i64.toUsize(env(b"BR_IN\x00", 1073741824))
  let outCapacity = i64.toUsize(env(b"BR_OUT\x00", 65536))
  let flushEvery = env(b"BR_FLUSH\x00", 0)
  let metaEvery = env(b"BR_META\x00", 0)
  let tracing = env(b"BR_TRACE\x00", 1) != 0
  let mut out = List<u8>.make()
  run List<u8>.appendRepeated(&mut out, 0, outCapacity + 1)
  let mut dictionary = List<u8>.make()
  let mut hasDictionary = false
  let path = unsafe getenv(Pointer.fromSlice<u8>(b"BR_DICT\x00"))
  if !Pointer.isNullMany<u8>(path) {
    if unsafe strlen(path) != 0 {
      let fd = unsafe open(path, 0)
      if fd < 0 { return 91 }
      dictionary = run readAll(fd)
      hasDictionary = true
    }
  }
  let paramText = run params()
  let text = List<u8>.asSlice(&paramText)
  let mut position: usize = 0
  if mode == 0 {
    let mut encoder = run BrotliEncoder.make()
    let mut at: usize = 0
    while true {
      let next = pair(text, at)
      if next[0] < 0 { break }
      let ok = BrotliEncoder.setParameter(&mut encoder, i64.wrappingToU32(next[0]), i64.wrappingToU32(next[1]))
      trace(tracing, 80, 3, next[0], next[1], flag(ok), 0, 0, 0)
      at = i64.toUsize(next[2])
    }
    if hasDictionary {
      let prepared = run PreparedDictionary.prepare(0, List<u8>.asSlice(&dictionary), 11)
      let ok = run BrotliEncoder.attachPreparedDictionary(&mut encoder, move prepared)
      trace(tracing, 68, 1, flag(ok), 0, 0, 0, 0, 0)
    }
    let mut index: i64 = 0
    while true {
      let mut take = input.length - position
      let mut operation: u32 = 2
      if take > inChunk {
        take = inChunk
        operation = 0
        if flushEvery != 0 && i64.remainder(index, flushEvery) == flushEvery - 1 { operation = 1 }
        if metaEvery != 0 && i64.remainder(index, metaEvery) == metaEvery - 1 { operation = 3 if take > 16 { take = 16 } }
      }
      let mut given: usize = 0
      while true {
        let step = run BrotliEncoder.compressStream(&mut encoder, operation, Slice.view<u8>(input, position + given, take - given), Slice.viewMut<u8>(List<u8>.asMutSlice(&mut out), 0, outCapacity))
        let more = BrotliEncoder.hasMoreOutput(&encoder)
        let finished = BrotliEncoder.isFinished(&encoder)
        trace(tracing, 69, 6, u32.toI64(operation), flag(step.ok), usize.toI64(step.consumed), usize.toI64(step.written), flag(more), flag(finished))
        writeAll(1, Slice.view<u8>(List<u8>.asSlice(&out), 0, step.written))
        if !step.ok { return 3 }
        given = given + step.consumed
        if given == take && !more && (operation != 2 || finished) { break }
        if step.written == 0 && step.consumed == 0 && outCapacity == 0 { return 92 }
      }
      position = position + take
      index = index + 1
      if operation == 2 { break }
    }
    return 0
  }
  let mut decoder = run BrotliDecoder.make()
  let mut at: usize = 0
  while true {
    let next = pair(text, at)
    if next[0] < 0 { break }
    let ok = BrotliDecoder.setParameter(&mut decoder, i64.wrappingToU32(next[0]), i64.wrappingToU32(next[1]))
    trace(tracing, 80, 3, next[0], next[1], flag(ok), 0, 0, 0)
    at = i64.toUsize(next[2])
  }
  if hasDictionary {
    let ok = run BrotliDecoder.attachDictionary(&mut decoder, 0, List<u8>.asSlice(&dictionary))
    trace(tracing, 68, 1, flag(ok), 0, 0, 0, 0, 0)
  }
  while true {
    let mut take = input.length - position
    if take > inChunk { take = inChunk }
    let mut given: usize = 0
    while true {
      let step = run BrotliDecoder.decompressStream(&mut decoder, Slice.view<u8>(input, position + given, take - given), Slice.viewMut<u8>(List<u8>.asMutSlice(&mut out), 0, outCapacity))
      let mut code: i64 = 0
      if step.result == 0 { code = i32.toI64(BrotliDecoder.errorCode(&decoder)) }
      trace(tracing, 88, 5, u32.toI64(step.result), usize.toI64(step.consumed), usize.toI64(step.written), flag(BrotliDecoder.hasMoreOutput(&decoder)), code, 0)
      writeAll(1, Slice.view<u8>(List<u8>.asSlice(&out), 0, step.written))
      given = given + step.consumed
      if step.result == 0 { return 1 }
      if step.result == 1 {
        trace(tracing, 84, 1, usize.toI64(input.length - position - given), 0, 0, 0, 0, 0)
        return 0
      }
      if step.result == 2 { break }
    }
    position = position + take
    if position == input.length {
      trace(tracing, 85, 0, 0, 0, 0, 0, 0, 0)
      return 2
    }
  }
  return 0
}
