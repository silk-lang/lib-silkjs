//! Builders of the Huffman decoding tables: a port of google/brotli v1.2.0 `c/dec/huffman.h` and
//! `c/dec/huffman.c` (the variant without `BROTLI_RBIT`, which x86-64 takes).
//!
//! A table entry, C's `HuffmanCode { uint8_t bits; uint16_t value; }`, is one `u32` here:
//! `bits | value << 16`. A table is a range of a `[u32]` that starts at a `base` position.
import silk.num.i32
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.usize

/// `BROTLI_HUFFMAN_MAX_CODE_LENGTH`.
pub const MAX_CODE_LENGTH: i32 = 15

/// `BROTLI_HUFFMAN_MAX_SIZE_26`: the size of a block length table.
pub const MAX_SIZE_26: usize = 396

/// `BROTLI_HUFFMAN_MAX_SIZE_258`: the size of a block type table.
pub const MAX_SIZE_258: usize = 632

/// `BROTLI_HUFFMAN_MAX_SIZE_272`: the size of a context map table.
pub const MAX_SIZE_272: usize = 646

/// `BROTLI_HUFFMAN_MAX_CODE_LENGTH_CODE_LENGTH`.
pub const MAX_CODE_LENGTH_CODE_LENGTH: i32 = 5

/// `BROTLI_CODE_LENGTH_CODES`.
pub const CODE_LENGTH_CODES: usize = 18

// `BROTLI_REVERSE_BITS_LOWEST` with `BROTLI_REVERSE_BITS_MAX` 8 and base 0.
const REVERSE_BITS_LOWEST: u32 = 128

const REVERSE_BITS: [u8; 256] = [
  0x00, 0x80, 0x40, 0xC0, 0x20, 0xA0, 0x60, 0xE0, 0x10, 0x90, 0x50, 0xD0, 0x30, 0xB0, 0x70, 0xF0,
  0x08, 0x88, 0x48, 0xC8, 0x28, 0xA8, 0x68, 0xE8, 0x18, 0x98, 0x58, 0xD8, 0x38, 0xB8, 0x78, 0xF8,
  0x04, 0x84, 0x44, 0xC4, 0x24, 0xA4, 0x64, 0xE4, 0x14, 0x94, 0x54, 0xD4, 0x34, 0xB4, 0x74, 0xF4,
  0x0C, 0x8C, 0x4C, 0xCC, 0x2C, 0xAC, 0x6C, 0xEC, 0x1C, 0x9C, 0x5C, 0xDC, 0x3C, 0xBC, 0x7C, 0xFC,
  0x02, 0x82, 0x42, 0xC2, 0x22, 0xA2, 0x62, 0xE2, 0x12, 0x92, 0x52, 0xD2, 0x32, 0xB2, 0x72, 0xF2,
  0x0A, 0x8A, 0x4A, 0xCA, 0x2A, 0xAA, 0x6A, 0xEA, 0x1A, 0x9A, 0x5A, 0xDA, 0x3A, 0xBA, 0x7A, 0xFA,
  0x06, 0x86, 0x46, 0xC6, 0x26, 0xA6, 0x66, 0xE6, 0x16, 0x96, 0x56, 0xD6, 0x36, 0xB6, 0x76, 0xF6,
  0x0E, 0x8E, 0x4E, 0xCE, 0x2E, 0xAE, 0x6E, 0xEE, 0x1E, 0x9E, 0x5E, 0xDE, 0x3E, 0xBE, 0x7E, 0xFE,
  0x01, 0x81, 0x41, 0xC1, 0x21, 0xA1, 0x61, 0xE1, 0x11, 0x91, 0x51, 0xD1, 0x31, 0xB1, 0x71, 0xF1,
  0x09, 0x89, 0x49, 0xC9, 0x29, 0xA9, 0x69, 0xE9, 0x19, 0x99, 0x59, 0xD9, 0x39, 0xB9, 0x79, 0xF9,
  0x05, 0x85, 0x45, 0xC5, 0x25, 0xA5, 0x65, 0xE5, 0x15, 0x95, 0x55, 0xD5, 0x35, 0xB5, 0x75, 0xF5,
  0x0D, 0x8D, 0x4D, 0xCD, 0x2D, 0xAD, 0x6D, 0xED, 0x1D, 0x9D, 0x5D, 0xDD, 0x3D, 0xBD, 0x7D, 0xFD,
  0x03, 0x83, 0x43, 0xC3, 0x23, 0xA3, 0x63, 0xE3, 0x13, 0x93, 0x53, 0xD3, 0x33, 0xB3, 0x73, 0xF3,
  0x0B, 0x8B, 0x4B, 0xCB, 0x2B, 0xAB, 0x6B, 0xEB, 0x1B, 0x9B, 0x5B, 0xDB, 0x3B, 0xBB, 0x7B, 0xFB,
  0x07, 0x87, 0x47, 0xC7, 0x27, 0xA7, 0x67, 0xE7, 0x17, 0x97, 0x57, 0xD7, 0x37, 0xB7, 0x77, 0xF7,
  0x0F, 0x8F, 0x4F, 0xCF, 0x2F, 0xAF, 0x6F, 0xEF, 0x1F, 0x9F, 0x5F, 0xDF, 0x3F, 0xBF, 0x7F, 0xFF,
]

/// `ConstructHuffmanCode`.
@inlineAlways
pub fn code(bits: u32, value: u32) -> u32 {
  return (bits & 255) | u32.shiftLeft(value & 65535, 16)
}

/// `BROTLI_HC_FAST_LOAD_BITS`.
@inlineAlways
pub fn codeBits(entry: u32) -> u64 {
  return u32.toU64(entry & 255)
}

/// `BROTLI_HC_FAST_LOAD_VALUE`.
@inlineAlways
pub fn codeValue(entry: u32) -> u64 {
  return u32.toU64(u32.shiftRight(entry, 16))
}

// `BrotliReverseBits`: the reversal of the low 8 bits.
@inlineAlways
fn reverseBits(key: u32) -> usize {
  return u8.toUsize(REVERSE_BITS[u32.toUsize(key & 255)])
}

// `ReplicateValue`: stores `entry` at `base + end - step`, `base + end - 2 * step`, ..., `base`.
// `end` is a multiple of `step`. The position arithmetic wraps: were `end` not a multiple, a
// position would wrap around and the bounds check of the store would catch it, so the loop
// needs no checks of its own.
@inlineAlways
fn replicateValue(table: &mut [u32], base: usize, step: usize, end: usize, entry: u32) -> () {
  let mut at = end
  while true {
    at = usize.wrappingSubtract(at, step)
    table[usize.wrappingAdd(base, at)] = entry
    if at == 0 { break }
  }
}

// `NextTableBitSize`: the width of the next second level table. `count` is the histogram of the
// lengths of the remaining symbols, `length` the code length of the next symbol.
@inlineAlways
fn nextTableBitSize(count: &[u16], length: i32, rootBits: i32) -> i32 {
  let mut len = length
  let mut left = i32.shiftLeft(1, len - rootBits)
  while len < MAX_CODE_LENGTH {
    left = left - u16.toI32(count[i32.toUsize(len)])
    if left <= 0 { break }
    len = len + 1
    left = i32.shiftLeft(left, 1)
  }
  return len - rootBits
}

// Doubles the `size` entries at `base` until there are `goal` of them.
@inlineAlways
fn replicateTable(table: &mut [u32], base: usize, size: usize, goal: usize) -> () {
  let mut filled = size
  while filled != goal {
    let mut index: usize = 0
    // The positions are below `base + 2 * filled`, which does not overflow; the stores check
    // them.
    let from = base
    let to = base + filled
    while index < filled {
      table[usize.wrappingAdd(to, index)] = table[usize.wrappingAdd(from, index)]
      index = index + 1
    }
    filled = filled * 2
  }
}

/// `BrotliBuildCodeLengthsHuffmanTable`: the 32-entry table of the code length code, from the
/// lengths in symbol order and their histogram `count`.
pub fn buildCodeLengthsHuffmanTable(table: &mut [u32; 32], codeLengths: &[u8; 18], count: &[u16; 16]) -> () {
  // The symbols sorted by code length.
  let mut sorted: [i32; 18] = [0; 18]
  // The offsets in the sorted table for each length.
  let mut offset: [i32; 6] = [0; 6]
  let mut symbol: i32 = -1
  let mut bits: usize = 1
  while bits <= 5 {
    symbol = symbol + u16.toI32(count[bits])
    offset[bits] = symbol
    bits = bits + 1
  }
  // Symbols with code length 0 are placed after all other symbols.
  offset[0] = 17
  // Sort symbols by length, by symbol order within each length.
  let mut index: usize = CODE_LENGTH_CODES
  while index != 0 {
    index = index - 1
    let length = u8.toUsize(codeLengths[index])
    sorted[i32.toUsize(offset[length])] = usize.toI32(index)
    offset[length] = offset[length] - 1
  }
  let tableSize: usize = 32
  // Special case: all symbols but one have 0 code length.
  if offset[0] == 0 {
    let entry = code(0, i32.wrappingToU32(sorted[0]))
    let mut key: usize = 0
    while key < tableSize {
      table[key] = entry
      key = key + 1
    }
    return ()
  }
  // Fill in table.
  let mut key: u32 = 0
  let mut keyStep: u32 = REVERSE_BITS_LOWEST
  let mut next: usize = 0
  let mut step: usize = 2
  bits = 1
  while true {
    let mut bitsCount = count[bits]
    while bitsCount != 0 {
      let entry = code(usize.toU32(bits), i32.wrappingToU32(sorted[next]))
      next = next + 1
      replicateValue(&mut table, reverseBits(key), step, tableSize, entry)
      key = key + keyStep
      bitsCount = bitsCount - 1
    }
    step = step * 2
    keyStep = u32.shiftRight(keyStep, 1)
    bits = bits + 1
    if bits > 5 { break }
  }
}

/// `BrotliBuildHuffmanTable`: builds a two-level table with `rootBits` root bits at `base` and
/// returns its size.
///
/// `symbolLists` holds, shifted by 16 positions, the chains of symbols of each code length: the
/// chain of length `n` starts at C index `n - 16`. `count` is the histogram of code lengths; the
/// counts of the lengths above `rootBits` are zero afterwards.
pub fn buildHuffmanTable(root: &mut [u32], base: usize, rootBits: i32, symbolLists: &[u16], count: &mut [u16; 16]) -> u32 {
  let mut maxLength: i32 = -1
  while symbolLists[i32.toUsize(maxLength + 16)] == 65535 { maxLength = maxLength - 1 }
  maxLength = maxLength + MAX_CODE_LENGTH + 1
  // The next available space in the table.
  let mut table = base
  let mut tableBits = rootBits
  let mut tableSize = usize.shiftLeft(1, i32.toUsize(tableBits))
  let mut totalSize = tableSize
  // Fill in the root table. Reduce the table size if possible, and create the repetitions by
  // copying.
  if tableBits > maxLength {
    tableBits = maxLength
    tableSize = usize.shiftLeft(1, i32.toUsize(tableBits))
  }
  let mut key: u32 = 0
  let mut keyStep: u32 = REVERSE_BITS_LOWEST
  let mut bits: i32 = 1
  let mut step: usize = 2
  while true {
    let mut symbol = bits - (MAX_CODE_LENGTH + 1)
    let mut bitsCount = count[i32.toUsize(bits)]
    while bitsCount != 0 {
      symbol = u16.toI32(symbolLists[i32.toUsize(symbol + 16)])
      let entry = code(i32.wrappingToU32(bits), i32.wrappingToU32(symbol))
      // The stores of `replicateValue` check the positions, so the sums may wrap as C's do.
      replicateValue(&mut root, usize.wrappingAdd(table, reverseBits(key)), step, tableSize, entry)
      key = u32.wrappingAdd(key, keyStep)
      bitsCount = bitsCount - 1
    }
    step = step * 2
    keyStep = u32.shiftRight(keyStep, 1)
    bits = bits + 1
    if bits > tableBits { break }
  }
  // If the root table is narrower than `rootBits`, replicate to fill the remaining slots.
  replicateTable(&mut root, table, tableSize, totalSize)
  tableSize = totalSize
  // Fill in second level tables and add pointers to the root table.
  keyStep = u32.shiftRight(REVERSE_BITS_LOWEST, i32.wrappingToU32(rootBits - 1))
  let mut subKey: u32 = REVERSE_BITS_LOWEST * 2
  let mut subKeyStep: u32 = REVERSE_BITS_LOWEST
  let mut len = rootBits + 1
  step = 2
  while len <= maxLength {
    let mut symbol = len - (MAX_CODE_LENGTH + 1)
    let lenIndex = i32.toUsize(len)
    while count[lenIndex] != 0 {
      if subKey == REVERSE_BITS_LOWEST * 2 {
        table = table + tableSize
        tableBits = nextTableBitSize(&count, len, rootBits)
        tableSize = usize.shiftLeft(1, i32.toUsize(tableBits))
        totalSize = totalSize + tableSize
        let rootKey = reverseBits(key)
        key = key + keyStep
        root[base + rootKey] = code(i32.wrappingToU32(tableBits + rootBits), usize.wrappingToU32(table - base - rootKey))
        subKey = 0
      }
      symbol = u16.toI32(symbolLists[i32.toUsize(symbol + 16)])
      let entry = code(i32.wrappingToU32(len - rootBits), i32.wrappingToU32(symbol))
      replicateValue(&mut root, usize.wrappingAdd(table, reverseBits(subKey)), step, tableSize, entry)
      subKey = u32.wrappingAdd(subKey, subKeyStep)
      // The count is not zero (the loop condition).
      count[lenIndex] = u16.wrappingSubtract(count[lenIndex], 1)
    }
    step = step * 2
    subKeyStep = u32.shiftRight(subKeyStep, 1)
    len = len + 1
  }
  return usize.toU32(totalSize)
}

/// `BrotliBuildSimpleHuffmanTable`: the table of a simple code at `base`. `numSymbols` is 0 for
/// one symbol, 1 for two, 2 for three, 3 for four symbols with lengths 2, 2, 2, 2 and 4 for four
/// with lengths 1, 2, 3, 3. The symbols are the first entries of `values`, which may be reordered.
/// Returns the size of the table, `1 << rootBits`.
pub fn buildSimpleHuffmanTable(table: &mut [u32], base: usize, rootBits: i32, values: &mut [u16], numSymbols: u32) -> u32 {
  let mut tableSize: usize = 1
  let goalSize = usize.shiftLeft(1, i32.toUsize(rootBits))
  if numSymbols == 0 {
    table[base] = code(0, u16.toU32(values[0]))
  } else if numSymbols == 1 {
    if values[1] > values[0] {
      table[base] = code(1, u16.toU32(values[0]))
      table[base + 1] = code(1, u16.toU32(values[1]))
    } else {
      table[base] = code(1, u16.toU32(values[1]))
      table[base + 1] = code(1, u16.toU32(values[0]))
    }
    tableSize = 2
  } else if numSymbols == 2 {
    table[base] = code(1, u16.toU32(values[0]))
    table[base + 2] = code(1, u16.toU32(values[0]))
    if values[2] > values[1] {
      table[base + 1] = code(2, u16.toU32(values[1]))
      table[base + 3] = code(2, u16.toU32(values[2]))
    } else {
      table[base + 1] = code(2, u16.toU32(values[2]))
      table[base + 3] = code(2, u16.toU32(values[1]))
    }
    tableSize = 4
  } else if numSymbols == 3 {
    let mut i: usize = 0
    while i < 3 {
      let mut k = i + 1
      while k < 4 {
        if values[k] < values[i] {
          let t = values[k]
          values[k] = values[i]
          values[i] = t
        }
        k = k + 1
      }
      i = i + 1
    }
    table[base] = code(2, u16.toU32(values[0]))
    table[base + 2] = code(2, u16.toU32(values[1]))
    table[base + 1] = code(2, u16.toU32(values[2]))
    table[base + 3] = code(2, u16.toU32(values[3]))
    tableSize = 4
  } else if numSymbols == 4 {
    if values[3] < values[2] {
      let t = values[3]
      values[3] = values[2]
      values[2] = t
    }
    table[base] = code(1, u16.toU32(values[0]))
    table[base + 1] = code(2, u16.toU32(values[1]))
    table[base + 2] = code(1, u16.toU32(values[0]))
    table[base + 3] = code(3, u16.toU32(values[2]))
    table[base + 4] = code(1, u16.toU32(values[0]))
    table[base + 5] = code(2, u16.toU32(values[1]))
    table[base + 6] = code(1, u16.toU32(values[0]))
    table[base + 7] = code(3, u16.toU32(values[3]))
    tableSize = 8
  }
  replicateTable(&mut table, base, tableSize, goalSize)
  return usize.toU32(goalSize)
}
