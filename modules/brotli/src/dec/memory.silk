//! Word-sized reads, writes and copies on byte slices, for the decoder's hot paths. They are what
//! C's `BROTLI_UNALIGNED_LOAD64LE`, `memmove16` and `memcpy` are in `c/dec/decode.c` and
//! `c/dec/bit_reader.h` of google/brotli v1.2.0.
//!
//! The checked functions test their ranges once and then work through pointers, so that a
//! 64-bit read is one load; the unchecked ones leave the proof to the caller, which states it. The words are in the byte order of the target, which is little-endian on all
//! targets of this toolchain.
import silk.mem.raw_buffer { RawBuffer }
import silk.num.usize

/// The 8 bytes of `bytes` at `at` as a little-endian word, without a range check. The caller
/// must prove that `at + 8` is at most `bytes.length`.
@inlineAlways
pub unsafe fn load64Unchecked(bytes: &[u8], at: usize) -> u64 {
  unsafe {
    let base = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Intrinsic.pointerFromSlice<u8>(bytes))
    let wide = Intrinsic.pointerReinterpret<*const u8, *const align(1) u64>(Intrinsic.pointerAt<u8>(base, at))
    return Intrinsic.pointerReadUnaligned<u64>(wide)
  }
}

/// The 4 bytes of `bytes` at `at` as a little-endian word, without a range check. The caller
/// must prove that `at + 4` is at most `bytes.length`.
@inlineAlways
pub unsafe fn load32Unchecked(bytes: &[u8], at: usize) -> u32 {
  unsafe {
    let base = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Intrinsic.pointerFromSlice<u8>(bytes))
    let wide = Intrinsic.pointerReinterpret<*const u8, *const align(1) u32>(Intrinsic.pointerAt<u8>(base, at))
    return Intrinsic.pointerReadUnaligned<u32>(wide)
  }
}

/// C's `memmove16`: copies 16 bytes of `bytes` from `from` to `to`, reading all of them before
/// writing any. Traps if a range is not inside.
@inlineAlways
pub fn move16(bytes: &mut [u8], to: usize, from: usize) -> () {
  let length = bytes.length
  if length < 16 || from > length - 16 || to > length - 16 {
    return Intrinsic.trap("brotli: a 16-byte copy is outside the ring buffer")
  }
  unsafe {
    // Both ranges are inside the slice, which is not empty.
    let input = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Intrinsic.pointerFromSlice<u8>(&bytes))
    let low = Intrinsic.pointerReadUnaligned<u64>(Intrinsic.pointerReinterpret<*const u8, *const align(1) u64>(Intrinsic.pointerAt<u8>(input, from)))
    let high = Intrinsic.pointerReadUnaligned<u64>(Intrinsic.pointerReinterpret<*const u8, *const align(1) u64>(Intrinsic.pointerAt<u8>(input, usize.wrappingAdd(from, 8))))
    let output = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(Intrinsic.pointerFromMutSlice<u8>(&mut bytes))
    Intrinsic.pointerWriteUnaligned<u64>(Intrinsic.pointerReinterpret<*mut u8, *mut align(1) u64>(Intrinsic.pointerAtMut<u8>(output, to)), low)
    Intrinsic.pointerWriteUnaligned<u64>(Intrinsic.pointerReinterpret<*mut u8, *mut align(1) u64>(Intrinsic.pointerAtMut<u8>(output, usize.wrappingAdd(to, 8))), high)
  }
}

/// `values` as a slice that borrows `anchor` instead of its owner, so that the owner can be used
/// while the slice is held in a local (where its pointer and length stay in registers). The
/// caller must prove that the values are neither freed nor moved while `anchor` is borrowed, and
/// that they are not written through the owner then.
@inlineAlways
pub unsafe fn detach<'a, T>(anchor: &'a usize, values: &[T]) -> &'a [T] {
  unsafe {
    let base = Intrinsic.pointerRequalify<?[*]const T, [*]const T>(Intrinsic.pointerFromSlice<T>(values))
    return Intrinsic.pointerBorrowMany<usize, T>(anchor, base, values.length)
  }
}

/// `detach` for exclusive access. The caller must prove that the values are neither freed nor
/// moved while `anchor` is borrowed; other accesses through the owner must not overlap a use of
/// the slice in time (each one is a call that finishes before the slice is used again).
@inlineAlways
pub unsafe fn detachMut<'a, T>(anchor: &'a mut usize, values: &mut [T]) -> &'a mut [T] {
  unsafe {
    let count = values.length
    let base = Intrinsic.pointerRequalify<?[*]mut T, [*]mut T>(Intrinsic.pointerFromMutSlice<T>(&mut values))
    return Intrinsic.pointerBorrowManyMut<usize, T>(anchor, base, count)
  }
}

/// `move16` without the range checks. The caller must prove that `from + 16` and `to + 16` are
/// at most `bytes.length`.
@inlineAlways
pub unsafe fn move16Unchecked(bytes: &mut [u8], to: usize, from: usize) -> () {
  unsafe {
    let input = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Intrinsic.pointerFromSlice<u8>(&bytes))
    let low = Intrinsic.pointerReadUnaligned<u64>(Intrinsic.pointerReinterpret<*const u8, *const align(1) u64>(Intrinsic.pointerAt<u8>(input, from)))
    let high = Intrinsic.pointerReadUnaligned<u64>(Intrinsic.pointerReinterpret<*const u8, *const align(1) u64>(Intrinsic.pointerAt<u8>(input, usize.wrappingAdd(from, 8))))
    let output = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(Intrinsic.pointerFromMutSlice<u8>(&mut bytes))
    Intrinsic.pointerWriteUnaligned<u64>(Intrinsic.pointerReinterpret<*mut u8, *mut align(1) u64>(Intrinsic.pointerAtMut<u8>(output, to)), low)
    Intrinsic.pointerWriteUnaligned<u64>(Intrinsic.pointerReinterpret<*mut u8, *mut align(1) u64>(Intrinsic.pointerAtMut<u8>(output, usize.wrappingAdd(to, 8))), high)
  }
}

/// C's `memcpy` inside one buffer: copies `count` bytes of `buffer` from `from` to `to`. Traps if
/// a range is not inside. The result is that of a copy through a temporary buffer.
pub fn copyWithin(buffer: &mut Intrinsic.RawBuffer<u8>, to: usize, from: usize, count: usize) -> () {
  let length = RawBuffer.count<u8>(&buffer)
  if from > length || length - from < count || to > length || length - to < count {
    return Intrinsic.trap("brotli: a copy is outside the ring buffer")
  }
  if count == 0 { return () }
  unsafe {
    // Both ranges are inside the buffer. The source slice is a second view of the buffer that
    // borrows `anchor` instead, so that the buffer can be the destination; the copy allows the
    // ranges to overlap and the slice is not used after it.
    let anchor: usize = 0
    let start = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Intrinsic.pointerFromSlice<u8>(RawBuffer.view<u8>(&buffer, from, count)))
    let source = Intrinsic.pointerBorrowMany<usize, u8>(&anchor, start, count)
    RawBuffer.copy<u8>(&mut buffer, to, source, count)
  }
}

/// C's byte-by-byte copy of a back-reference that overlaps its target or wraps around the ring:
/// for each of `count` positions `p` from `to`, `bytes[p] = bytes[(p - distance) & mask]`, in
/// order. Traps if a write is outside `bytes` or `mask` is not below its length.
@inlineAlways
pub fn copyBackward(bytes: &mut [u8], to: usize, distance: usize, mask: usize, count: usize) -> () {
  let length = bytes.length
  if mask >= length || to > length || length - to < count {
    return Intrinsic.trap("brotli: a copy is outside the ring buffer")
  }
  unsafe {
    // Every write is at a position from `to` to `to + count - 1` and every read at a position of
    // at most `mask`; both are inside the slice.
    let base = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(Intrinsic.pointerFromMutSlice<u8>(&mut bytes))
    let mut position = to
    let end = usize.wrappingAdd(to, count)
    while position < end {
      let value = Intrinsic.pointerRead<u8>(Intrinsic.pointerRequalify<*mut u8, *const u8>(Intrinsic.pointerAtMut<u8>(base, usize.wrappingSubtract(position, distance) & mask)))
      Intrinsic.pointerWrite<u8>(Intrinsic.pointerAtMut<u8>(base, position), value)
      position = usize.wrappingAdd(position, 1)
    }
  }
}

/// `bytes[index]` without a bounds check. The caller must prove that `index` is below
/// `bytes.length`.
@inlineAlways
pub unsafe fn byteAt(bytes: &[u8], index: usize) -> u8 {
  unsafe {
    let base = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Intrinsic.pointerFromSlice<u8>(bytes))
    return Intrinsic.pointerRead<u8>(Intrinsic.pointerAt<u8>(base, index))
  }
}

/// `bytes[index] = value` without a bounds check. The caller must prove that `index` is below
/// `bytes.length`.
@inlineAlways
pub unsafe fn setByte(bytes: &mut [u8], index: usize, value: u8) -> () {
  unsafe {
    let base = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(Intrinsic.pointerFromMutSlice<u8>(&mut bytes))
    Intrinsic.pointerWrite<u8>(Intrinsic.pointerAtMut<u8>(base, index), value)
  }
}
