/// The position in `CMD_LUT` of the entry of command symbol `code` (below 704). The mask does
/// not change a symbol of the command alphabet; it keeps every field of the entry inside the
/// table, so that the loads need no range checks.
@inlineAlways
pub fn cmdLut(code: usize) -> usize {
  return (code & 1023) * 8
}

/// `CmdLutElement.insert_len_extra_bits` of the entry at `entry`.
@inlineAlways
pub fn cmdInsertExtraBits(entry: usize) -> u64 {
  return u8.toU64(CMD_LUT[entry])
}

/// `CmdLutElement.copy_len_extra_bits` of the entry at `entry`.
@inlineAlways
pub fn cmdCopyExtraBits(entry: usize) -> u64 {
  return u8.toU64(CMD_LUT[entry + 1])
}

/// `CmdLutElement.distance_code` of the entry at `entry`: 0, or -1 when the command has an
/// explicit distance.
@inlineAlways
pub fn cmdDistanceCode(entry: usize) -> i32 {
  return i8.toI32(u8.wrappingToI8(CMD_LUT[entry + 2]))
}

/// `CmdLutElement.context` of the entry at `entry`: the distance context, 0 to 3.
@inlineAlways
pub fn cmdContext(entry: usize) -> u64 {
  return u8.toU64(CMD_LUT[entry + 3])
}

/// `CmdLutElement.insert_len_offset` of the entry at `entry`.
@inlineAlways
pub fn cmdInsertOffset(entry: usize) -> u64 {
  return u8.toU64(CMD_LUT[entry + 4]) | u64.shiftLeft(u8.toU64(CMD_LUT[entry + 5]), 8)
}

/// `CmdLutElement.copy_len_offset` of the entry at `entry`.
@inlineAlways
pub fn cmdCopyOffset(entry: usize) -> u64 {
  return u8.toU64(CMD_LUT[entry + 6]) | u64.shiftLeft(u8.toU64(CMD_LUT[entry + 7]), 8)
}
