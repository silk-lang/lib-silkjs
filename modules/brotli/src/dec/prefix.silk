/// The packed `kCmdLut` entry of command symbol `code` (below 704).
@inlineAlways
pub fn cmdLut(code: usize) -> u64 {
  return CMD_LUT[code]
}

/// `CmdLutElement.insert_len_extra_bits` of a packed entry.
@inlineAlways
pub fn cmdInsertExtraBits(entry: u64) -> u64 {
  return entry & 255
}

/// `CmdLutElement.copy_len_extra_bits` of a packed entry.
@inlineAlways
pub fn cmdCopyExtraBits(entry: u64) -> u64 {
  return u64.shiftRight(entry, 8) & 255
}

/// `CmdLutElement.distance_code` of a packed entry: 0, or -1 when the command has an explicit
/// distance.
@inlineAlways
pub fn cmdDistanceCode(entry: u64) -> i32 {
  if (u64.shiftRight(entry, 16) & 1) != 0 { return -1 }
  return 0
}

/// `CmdLutElement.context` of a packed entry: the distance context, 0 to 3.
@inlineAlways
pub fn cmdContext(entry: u64) -> u64 {
  return u64.shiftRight(entry, 24) & 255
}

/// `CmdLutElement.insert_len_offset` of a packed entry.
@inlineAlways
pub fn cmdInsertOffset(entry: u64) -> u64 {
  return u64.shiftRight(entry, 32) & 65535
}

/// `CmdLutElement.copy_len_offset` of a packed entry.
@inlineAlways
pub fn cmdCopyOffset(entry: u64) -> u64 {
  return u64.shiftRight(entry, 48)
}
