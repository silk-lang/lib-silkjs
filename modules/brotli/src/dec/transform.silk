//! Word transforms of the static dictionary: a port of `BrotliTransformDictionaryWord` of
//! google/brotli v1.2.0 `c/common/transform.c`, on the transform tables of
//! `silk.compress.brotli_tables` (the same data as C's `kPrefixSuffix`, `kPrefixSuffixMap` and
//! `kTransformsData`).
//!
//! The shift transforms (`BROTLI_TRANSFORM_SHIFT_FIRST` and `_ALL`) are not ported: the built-in
//! transform list has none, and other lists come only from serialized shared dictionaries, which
//! C supports only in `BROTLI_EXPERIMENTAL` builds.
import silk.compress.brotli_tables
import silk.num.u8
import silk.num.u32

// `BROTLI_TRANSFORM_*`.
const OMIT_LAST_9: u32 = 9
const UPPERCASE_FIRST: u32 = 10
const UPPERCASE_ALL: u32 = 11
const OMIT_FIRST_1: u32 = 12
const OMIT_FIRST_9: u32 = 20

// `ToUpperCase`: changes the character at `at` and returns its length in bytes.
fn toUpperCase(dst: &mut [u8], at: usize) -> usize {
  if dst[at] < 192 {
    if dst[at] >= 97 && dst[at] <= 122 {
      dst[at] = u8.bitXor(dst[at], 32)
    }
    return 1
  }
  // An overly simplified uppercasing model for UTF-8.
  if dst[at] < 224 {
    dst[at + 1] = u8.bitXor(dst[at + 1], 32)
    return 2
  }
  // An arbitrary transform for three byte characters.
  dst[at + 2] = u8.bitXor(dst[at + 2], 5)
  return 3
}

/// `BrotliTransformDictionaryWord`: writes transform `transformIndex` of the `length` bytes of
/// `words` at `wordAt` to `dst` at `at`, and returns the number of bytes written.
pub fn transformDictionaryWord(dst: &mut [u8], at: usize, words: &[u8], wordAt: usize, length: usize, transformIndex: usize) -> usize {
  let affixes = brotli_tables.affixes()
  let mut idx = at
  let mut prefix = brotli_tables.affixOffset(brotli_tables.transformPrefix(transformIndex))
  let kind = brotli_tables.transformKind(transformIndex)
  let mut suffix = brotli_tables.affixOffset(brotli_tables.transformSuffix(transformIndex))
  let mut prefixLength = u8.toUsize(affixes[prefix])
  prefix = prefix + 1
  while prefixLength != 0 {
    dst[idx] = affixes[prefix]
    idx = idx + 1
    prefix = prefix + 1
    prefixLength = prefixLength - 1
  }
  // C keeps the length as an `int` that an omit transform can make negative; no byte is copied
  // then.
  let mut len = length
  let mut word = wordAt
  if kind <= OMIT_LAST_9 {
    let omit = u32.toUsize(kind)
    if omit > len { len = 0 } else { len = len - omit }
  } else if kind >= OMIT_FIRST_1 && kind <= OMIT_FIRST_9 {
    let skip = u32.toUsize(kind - (OMIT_FIRST_1 - 1))
    word = word + skip
    if skip > len { len = 0 } else { len = len - skip }
  }
  let mut i: usize = 0
  while i < len {
    dst[idx] = words[word + i]
    idx = idx + 1
    i = i + 1
  }
  if kind == UPPERCASE_FIRST {
    let _step = toUpperCase(&mut dst, idx - len)
  } else if kind == UPPERCASE_ALL {
    let mut uppercase = idx - len
    let mut rest = len
    while rest > 0 {
      let step = toUpperCase(&mut dst, uppercase)
      uppercase = uppercase + step
      if step > rest { rest = 0 } else { rest = rest - step }
    }
  }
  let mut suffixLength = u8.toUsize(affixes[suffix])
  suffix = suffix + 1
  while suffixLength != 0 {
    dst[idx] = affixes[suffix]
    idx = idx + 1
    suffix = suffix + 1
    suffixLength = suffixLength - 1
  }
  return idx - at
}
