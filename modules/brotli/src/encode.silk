//! The Brotli encoder: a port of google/brotli v1.2.0 `c/enc`. For the same parameters and the
//! same calls it writes the same bytes as the C library.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize

/// `BROTLI_OPERATION_*`.
pub const OPERATION_PROCESS: u32 = 0
pub const OPERATION_FLUSH: u32 = 1
pub const OPERATION_FINISH: u32 = 2
pub const OPERATION_EMIT_METADATA: u32 = 3

/// What one call to [`BrotliEncoder.compressStream`] did.
pub struct EncodeStep {
  /// False where the C API returns `BROTLI_FALSE`.
  pub ok: bool,
  /// The input bytes the call consumed, from the start of its input.
  pub consumed: usize,
  /// The output bytes the call wrote, from the start of its output.
  pub written: usize,
}

/// A dictionary prepared for the encoder, `BrotliEncoderPreparedDictionary` of the C API.
pub struct PreparedDictionary {
  kind: u32,
}

impl PreparedDictionary {
  /// `BrotliEncoderPrepareDictionary`. It keeps its own copy of `data`.
  pub effect fn prepare(kind: u32, data: &[u8], quality: u32) -> PreparedDictionary ! OutOfMemoryError ? &mut Allocator {
    return PreparedDictionary { kind: kind }
  }
}

/// A streaming encoder, `BrotliEncoderState` of the C API.
pub struct BrotliEncoder {
  finished: bool,
}

impl BrotliEncoder {
  /// `BrotliEncoderCreateInstance`.
  pub effect fn make() -> BrotliEncoder ! OutOfMemoryError ? &mut Allocator {
    return BrotliEncoder { finished: false }
  }

  /// `BrotliEncoderSetParameter`: false when the encoder has started or the parameter is unknown.
  pub fn setParameter(self: &mut Self, parameter: u32, value: u32) -> bool {
    return false
  }

  /// `BrotliEncoderAttachPreparedDictionary`. The encoder takes the dictionary.
  pub effect fn attachPreparedDictionary(self: &mut Self, dictionary: PreparedDictionary) -> bool ? &mut Allocator {
    drop dictionary
    return false
  }

  /// `BrotliEncoderCompressStream` with `next_out` set.
  pub effect fn compressStream(self: &mut Self, operation: u32, input: &[u8], output: &mut [u8]) -> EncodeStep ? &mut Allocator {
    return EncodeStep { ok: false, consumed: 0, written: 0 }
  }

  /// `BrotliEncoderIsFinished`.
  pub fn isFinished(self: &Self) -> bool {
    return self.finished
  }

  /// `BrotliEncoderHasMoreOutput`.
  pub fn hasMoreOutput(self: &Self) -> bool {
    return false
  }
}
