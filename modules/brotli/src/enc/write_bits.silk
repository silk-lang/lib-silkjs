//! Writing bits to a byte array, least significant bit first: a port of google/brotli v1.2.0
//! `c/enc/write_bits.h` (the little-endian variant), with the unaligned loads of
//! `c/common/platform.h` that the encoder uses.
import silk.encoding.endian
import silk.mem.pointer { Pointer }
import silk.num.u8
import silk.num.u64
import silk.num.usize

/// `BROTLI_UNALIGNED_LOAD64LE`: the 8 bytes at `at`. Traps if they are not inside `buffer`.
@inlineAlways
pub fn load64(buffer: &[u8], at: usize) -> u64 {
  return endian.readU64LittleEndian(buffer, at)
}

/// `BROTLI_UNALIGNED_LOAD32LE`: the 4 bytes at `at`. Traps if they are not inside `buffer`.
@inlineAlways
pub fn load32(buffer: &[u8], at: usize) -> u32 {
  return endian.readU32LittleEndian(buffer, at)
}

/// `BROTLI_UNALIGNED_LOAD64LE` without a bounds check, for the match search loops, where the
/// checks of `load64` cost a measurable part of the encoder's speed.
///
/// # Gotchas
/// The caller must prove that `at + 8` is at most `buffer.length`.
@inlineAlways
pub unsafe fn load64Unchecked(buffer: &[u8], at: usize) -> u64 {
  unsafe {
    // The caller's proof implies that the slice is not empty, so its pointer is not null.
    let base = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(buffer))
    return Pointer.readUnaligned<u64>(Intrinsic.pointerReinterpret<*const u8, *const align(1) u64>(Pointer.at<u8>(base, at)))
  }
}

/// `BROTLI_UNALIGNED_LOAD32LE` without a bounds check, for the match search loops.
///
/// # Gotchas
/// The caller must prove that `at + 4` is at most `buffer.length`.
@inlineAlways
pub unsafe fn load32Unchecked(buffer: &[u8], at: usize) -> u32 {
  unsafe {
    // The caller's proof implies that the slice is not empty, so its pointer is not null.
    let base = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(buffer))
    return Pointer.readUnaligned<u32>(Intrinsic.pointerReinterpret<*const u8, *const align(1) u32>(Pointer.at<u8>(base, at)))
  }
}

/// The byte at `at` without a bounds check, for the match search loops.
///
/// # Gotchas
/// The caller must prove that `at` is less than `buffer.length`.
@inlineAlways
pub unsafe fn byteUnchecked(buffer: &[u8], at: usize) -> u8 {
  unsafe {
    // The caller's proof implies that the slice is not empty, so its pointer is not null.
    let base = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(buffer))
    return Pointer.read<u8>(Pointer.at<u8>(base, at))
  }
}

/// `BrotliWriteBits`: writes the low `nBits` (at most 56) of `bits` at bit position `pos` and
/// advances it. Traps if the 8 bytes from the byte of `pos` are not inside `array`.
///
/// As in C the write is one unaligned 64-bit store at the byte of `pos`: it keeps the bits already
/// in that byte and sets the 7 bytes after it to zero or to the new bits. Callers rely on that
/// (the array must be 8 bytes longer than the last byte written, and what follows is cleared).
@inlineAlways
pub fn writeBits(nBits: usize, bits: u64, pos: &mut usize, array: &mut [u8]) -> () {
  let at = pos.*
  let byte = usize.shiftRight(at, 3)
  let length = array.length
  // Two tests, so that the first does not depend on the position and leaves a loop of writes.
  if length < 8 {
    Intrinsic.trap("brotli: a write past the end of the output storage")
  }
  if byte > length - 8 {
    Intrinsic.trap("brotli: a write past the end of the output storage")
  }
  unsafe {
    // The check above proves that the 8 bytes at `byte` are inside the slice.
    let base = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(Pointer.fromMutSlice<u8>(&mut array))
    let p = Pointer.atMut<u8>(base, byte)
    let v = u8.toU64(Pointer.read<u8>(Intrinsic.pointerRequalify<*mut u8, *const u8>(p))) | u64.shiftLeft(bits, usize.toU64(at & 7))
    Pointer.writeUnaligned<u64>(Intrinsic.pointerReinterpret<*mut u8, *mut align(1) u64>(p), v)
  }
  // The position cannot overflow: it is a bit position inside `array`.
  pos.* = usize.wrappingAdd(at, nBits)
}

/// `BrotliWriteBitsPrepareStorage`: clears the byte at the byte-aligned bit position `pos`.
@inlineAlways
pub fn writeBitsPrepareStorage(pos: usize, array: &mut [u8]) -> () {
  array[usize.shiftRight(pos, 3)] = 0
}
