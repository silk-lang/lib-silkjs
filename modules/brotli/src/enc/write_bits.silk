//! Writing bits to a byte array, least significant bit first: a port of google/brotli v1.2.0
//! `c/enc/write_bits.h` (the little-endian variant), with the unaligned loads of
//! `c/common/platform.h` that the encoder uses.
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// `BROTLI_UNALIGNED_LOAD64LE`: the 8 bytes at `at`, with one bounds check.
@inlineAlways
pub fn load64(buffer: &[u8], at: usize) -> u64 {
  let bytes = Slice.view<u8>(buffer, at, 8)
  return u8.toU64(bytes[0]) | u64.shiftLeft(u8.toU64(bytes[1]), 8)
    | u64.shiftLeft(u8.toU64(bytes[2]), 16)
    | u64.shiftLeft(u8.toU64(bytes[3]), 24)
    | u64.shiftLeft(u8.toU64(bytes[4]), 32)
    | u64.shiftLeft(u8.toU64(bytes[5]), 40)
    | u64.shiftLeft(u8.toU64(bytes[6]), 48)
    | u64.shiftLeft(u8.toU64(bytes[7]), 56)
}

/// `BROTLI_UNALIGNED_LOAD32LE`: the 4 bytes at `at`, with one bounds check.
@inlineAlways
pub fn load32(buffer: &[u8], at: usize) -> u32 {
  let bytes = Slice.view<u8>(buffer, at, 4)
  return u8.toU32(bytes[0]) | u32.shiftLeft(u8.toU32(bytes[1]), 8)
    | u32.shiftLeft(u8.toU32(bytes[2]), 16)
    | u32.shiftLeft(u8.toU32(bytes[3]), 24)
}

/// `BrotliWriteBits`: writes the low `nBits` (at most 56) of `bits` at bit position `pos` and
/// advances it.
///
/// As in C the write is one unaligned 64-bit store at the byte of `pos`: it keeps the bits already
/// in that byte and sets the 7 bytes after it to zero or to the new bits. Callers rely on that
/// (the array must be 8 bytes longer than the last byte written, and what follows is cleared).
@inlineAlways
pub fn writeBits(nBits: usize, bits: u64, pos: &mut usize, array: &mut [u8]) -> () {
  let at = pos.*
  let view = Slice.viewMut<u8>(&mut array, usize.shiftRight(at, 3), 8)
  let v = u8.toU64(view[0]) | u64.shiftLeft(bits, usize.toU64(at & 7))
  view[0] = u64.wrappingToU8(v)
  view[1] = u64.wrappingToU8(u64.shiftRight(v, 8))
  view[2] = u64.wrappingToU8(u64.shiftRight(v, 16))
  view[3] = u64.wrappingToU8(u64.shiftRight(v, 24))
  view[4] = u64.wrappingToU8(u64.shiftRight(v, 32))
  view[5] = u64.wrappingToU8(u64.shiftRight(v, 40))
  view[6] = u64.wrappingToU8(u64.shiftRight(v, 48))
  view[7] = u64.wrappingToU8(u64.shiftRight(v, 56))
  pos.* = at + nBits
}

/// `BrotliWriteBitsPrepareStorage`: clears the byte at the byte-aligned bit position `pos`.
@inlineAlways
pub fn writeBitsPrepareStorage(pos: usize, array: &mut [u8]) -> () {
  array[usize.shiftRight(pos, 3)] = 0
}
