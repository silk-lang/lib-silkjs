//! The length of a match: a port of google/brotli v1.2.0 `c/enc/find_match_length.h` (the 64-bit
//! little-endian variant).
import silk.num.u32
import silk.num.u64
import silk.num.usize
import enc.write_bits { byteUnchecked, load64, load64Unchecked }

/// `FindMatchLengthWithLimit`: how many bytes at `s1` and `s2` of `data` are equal, at most
/// `limit`.
@inlineAlways
pub fn findMatchLengthWithLimit(data: &[u8], s1: usize, s2: usize, limit: usize) -> usize {
  let mut matched: usize = 0
  let mut left = limit
  while left >= 8 {
    let x = load64(data, s2 + matched) ^ load64(data, s1 + matched)
    if x != 0 {
      return matched + u32.toUsize(u64.trailingZeros(x) / 8)
    }
    matched = matched + 8
    left = left - 8
  }
  while left != 0 && data[s1 + matched] == data[s2 + matched] {
    left = left - 1
    matched = matched + 1
  }
  return matched
}

/// `findMatchLengthWithLimit` without bounds checks, for the match search loops.
///
/// # Gotchas
/// The caller must prove that `s1 + limit` and `s2 + limit` are at most `data.length`.
@inlineAlways
pub unsafe fn findMatchLengthWithLimitUnchecked(data: &[u8], s1: usize, s2: usize, limit: usize) -> usize {
  let mut matched: usize = 0
  let mut left = limit
  // `matched + left` stays `limit`, so every read below is inside what the caller proved, and the
  // sums cannot overflow.
  while left >= 8 {
    let x = unsafe load64Unchecked(data, usize.wrappingAdd(s2, matched)) ^ unsafe load64Unchecked(data, usize.wrappingAdd(s1, matched))
    if x != 0 {
      return usize.wrappingAdd(matched, u32.toUsize(u64.trailingZeros(x) / 8))
    }
    matched = usize.wrappingAdd(matched, 8)
    left = left - 8
  }
  while left != 0 && unsafe byteUnchecked(data, usize.wrappingAdd(s1, matched)) == unsafe byteUnchecked(data, usize.wrappingAdd(s2, matched)) {
    left = left - 1
    matched = usize.wrappingAdd(matched, 1)
  }
  return matched
}
