//! Estimates of the cost of storing a histogram: a port of google/brotli v1.2.0 `c/enc/bit_cost.h`,
//! `bit_cost.c` and `bit_cost_inc.h`.
//!
//! The floating-point operations are in the order of the C code, so the results are the same bits.
import silk.num.f64
import silk.num.i64
import silk.num.u32
import silk.num.usize
import enc.fast_log { fastLog2, fastLog2u32 }
import enc.histogram { HistogramCommand, HistogramDistance, HistogramLiteral }

/// `BrotliBitsEntropy`: the Shannon entropy of the counts in bits, at least one bit per count.
pub fn bitsEntropy(population: &[u32], size: usize) -> f64 {
  let mut sum: usize = 0
  let mut retval: f64 = 0.0
  let mut i: usize = 0
  while i < size {
    let p = population[i]
    sum = sum + u32.toUsize(p)
    retval = retval - u32.toF64(p) * fastLog2u32(p)
    i = i + 1
  }
  if sum != 0 { retval = retval + usize.toF64(sum) * fastLog2(sum) }
  if retval < usize.toF64(sum) {
    // At least one bit per literal is needed.
    retval = usize.toF64(sum)
  }
  return retval
}

// `BrotliPopulationCost*` of bit_cost_inc.h over the counts of one histogram.
@inlineAlways
fn populationCost(data: &[u32], dataSize: usize, totalCount: usize) -> f64 {
  let mut count: usize = 0
  let mut s: [usize; 5] = [0; 5]
  let mut bits: f64 = 0.0
  if totalCount == 0 { return 12.0 }
  // One test for all the reads below.
  if data.length < dataSize {
    Intrinsic.trap("brotli: a histogram shorter than its alphabet")
  }
  let mut i: usize = 0
  while i < dataSize {
    if data[i] > 0 {
      s[count] = i
      count = count + 1
      if count > 4 { break }
    }
    i = i + 1
  }
  if count == 1 { return 12.0 }
  if count == 2 { return 20.0 + usize.toF64(totalCount) }
  if count == 3 {
    let histo0 = data[s[0]]
    let histo1 = data[s[1]]
    let histo2 = data[s[2]]
    let mut histomax = if histo1 > histo2 { histo1 } else { histo2 }
    if histo0 > histomax { histomax = histo0 }
    // The sum is 32-bit unsigned arithmetic in C; the rest is in doubles.
    let twice = u32.wrappingMultiply(2, u32.wrappingAdd(u32.wrappingAdd(histo0, histo1), histo2))
    return 28.0 + u32.toF64(twice) - u32.toF64(histomax)
  }
  if count == 4 {
    let mut histo: [u32; 4] = [0; 4]
    i = 0
    while i < 4 {
      histo[i] = data[s[i]]
      i = i + 1
    }
    // Sort.
    i = 0
    while i < 4 {
      let mut j = i + 1
      while j < 4 {
        if histo[j] > histo[i] {
          let tmp = histo[j]
          histo[j] = histo[i]
          histo[i] = tmp
        }
        j = j + 1
      }
      i = i + 1
    }
    let h23 = u32.wrappingAdd(histo[2], histo[3])
    let histomax = if h23 > histo[0] { h23 } else { histo[0] }
    return 37.0 + u32.toF64(u32.wrappingMultiply(3, h23))
      + u32.toF64(u32.wrappingMultiply(2, u32.wrappingAdd(histo[0], histo[1])))
      - u32.toF64(histomax)
  }
  // In this loop we compute the entropy of the histogram and simultaneously build a simplified
  // histogram of the code length codes where we use the zero repeat code 17, but we don't use the
  // non-zero repeat code 16.
  let mut maxDepth: usize = 1
  let mut depthHisto: [u32; 18] = [0; 18]
  let log2total = fastLog2(totalCount)
  i = 0
  while i < dataSize {
    if data[i] > 0 {
      // Compute -log2(P(symbol)) = -log2(count(symbol)/total_count) =
      //                          = log2(total_count) - log2(count(symbol))
      let log2p = log2total - fastLog2u32(data[i])
      // Approximate the bit depth by round(-log2(P(symbol)))
      // `(size_t)(log2p + 0.5)`: the value is not negative and far below 2^63, so the signed
      // conversion gives the same result.
      let mut depth = i64.wrappingToUsize(Intrinsic.f64ToI64(log2p + 0.5))
      bits = bits + u32.toF64(data[i]) * log2p
      if depth > 15 { depth = 15 }
      if depth > maxDepth { maxDepth = depth }
      depthHisto[depth] = u32.wrappingAdd(depthHisto[depth], 1)
      i = i + 1
    } else {
      // Compute the run length of zeros and add the appropriate number of 0 and 17 code length
      // codes to the code length code histogram.
      let mut reps: u32 = 1
      let mut k = i + 1
      while k < dataSize && data[k] == 0 {
        reps = u32.wrappingAdd(reps, 1)
        k = usize.wrappingAdd(k, 1)
      }
      i = i + u32.toUsize(reps)
      if i == dataSize {
        // Don't add any cost for the last zero run, since these are encoded only implicitly.
        break
      }
      if reps < 3 {
        depthHisto[0] = depthHisto[0] + reps
      } else {
        reps = reps - 2
        while reps > 0 {
          depthHisto[17] = depthHisto[17] + 1
          // Add the 3 extra bits for the 17 code length code.
          bits = bits + 3.0
          reps = u32.shiftRight(reps, 3)
        }
      }
    }
  }
  // Add the estimated encoding cost of the code length code histogram.
  bits = bits + usize.toF64(18 + 2 * maxDepth)
  // Add the entropy of the code length code histogram.
  bits = bits + bitsEntropy(&depthHisto, 18)
  return bits
}

/// `BrotliPopulationCostLiteral`.
pub fn populationCostLiteral(histogram: &HistogramLiteral) -> f64 {
  return populationCost(&histogram.data, 256, histogram.totalCount)
}

/// `BrotliPopulationCostCommand`.
pub fn populationCostCommand(histogram: &HistogramCommand) -> f64 {
  return populationCost(&histogram.data, 704, histogram.totalCount)
}

/// `BrotliPopulationCostDistance`.
pub fn populationCostDistance(histogram: &HistogramDistance) -> f64 {
  return populationCost(&histogram.data, 544, histogram.totalCount)
}
