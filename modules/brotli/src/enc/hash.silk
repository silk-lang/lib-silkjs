//! The match finders ("hashers") of the encoder: the interface of google/brotli v1.2.0
//! `c/enc/hash.h`.
//!
//! NOT PORTED YET: the hashers themselves (`hash_*_inc.h`). This is the seam for them. The
//! functions below have the names and the arguments of the C interface and do what it does up to
//! the point where a hasher would be set up, so the encoder state machine calls them where the C
//! code does.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import enc.params { EncoderParams, HasherParams, chooseHasher }

/// `Hasher`: `HasherCommon` without the hasher-specific state.
pub struct Hasher {
  /// `common.is_setup_`.
  pub isSetup: bool,
  /// `common.is_prepared_`.
  pub isPrepared: bool,
  /// `common.params`.
  pub params: HasherParams,
}

impl Hasher {
  /// `HasherInit`. Must be invoked before any other method.
  pub fn make() -> Hasher {
    return Hasher { isSetup: false, isPrepared: false, params: HasherParams { kind: 0, bucketBits: 0, blockBits: 0, numLastDistancesToCheck: 0 } }
  }

  /// `HasherReset`.
  pub fn reset(self: &mut Self) -> () {
    self.isPrepared = false
  }

  // `HasherSetup`, up to the allocation and initialization of the hasher's tables.
  effect fn setup(self: &mut Self, params: &mut EncoderParams, data: &[u8], position: usize, inputSize: usize, isLast: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    if !self.isSetup {
      let mut chosen = HasherParams { kind: params.hasher.kind, bucketBits: params.hasher.bucketBits, blockBits: params.hasher.blockBits, numLastDistancesToCheck: params.hasher.numLastDistancesToCheck }
      chooseHasher(&params, &mut chosen)
      self.params = HasherParams { kind: chosen.kind, bucketBits: chosen.bucketBits, blockBits: chosen.blockBits, numLastDistancesToCheck: chosen.numLastDistancesToCheck }
      params.hasher = move chosen
      // SEAM: `HasherSize`, the allocation of `common.extra` and `InitializeH*` go here.
      Hasher.reset(&mut self)
      self.isSetup = true
    }
    if !self.isPrepared {
      // SEAM: `PrepareH*(one_shot = position == 0 && is_last, input_size, data)` goes here.
      self.isPrepared = true
    }
  }

  /// `InitOrStitchToPreviousBlock`.
  pub effect fn initOrStitchToPreviousBlock(self: &mut Self, data: &[u8], mask: usize, params: &mut EncoderParams, position: usize, inputSize: usize, isLast: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    run Hasher.setup(&mut self, &mut params, data, position, inputSize, isLast)
    // SEAM: `StitchToPreviousBlockH*(input_size, position, data, mask)` goes here.
  }
}
