//! The match finders ("hashers") of the encoder: a port of the hasher dispatch of google/brotli
//! v1.2.0 `c/enc/hash.h` (`Hasher`, `HasherSetup`, `HasherSize`, `HasherReset`,
//! `InitOrStitchToPreviousBlock`) over the hashers of qualities 2 to 9: H2, H3, H4 and H54
//! (`enc.hash_quickly`), H5, H6, H58 and H68 (`enc.hash_longest_match`), H40, H41 and H42
//! (`enc.hash_forgetful_chain`), and H35, H55 and H65 (`enc.hash_rolling`).
//!
//! H10 (`enc.hash_to_binary_tree`, qualities 10 and 11) is kept apart from the others, in
//! `Hasher.h10`, because the Zopfli search uses it directly. Attached prepared dictionaries do
//! not change the hashers in v1.2.0 (there is no `HasherPrependCustomDictionary` any more); they
//! are searched separately (`enc.compound_dictionary`).
//!
//! The memory of a hasher is allocated by `HasherSetup` in the sizes `HasherSize` gives, the
//! first time the encoder needs it, as in C.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import enc.hash_forgetful_chain { H40Config, H41Config, H42Config, HashForgetfulChain }
import enc.hash_longest_match { HashLongestMatch, HashLongestMatchSimd, Narrow, Wide }
import enc.hash_quickly { H2Config, H3Config, H4Config, H54Config, HashQuickly }
import enc.hash_rolling { HashComposite, HashRolling }
import enc.hash_base { MatchFinder }
import silk.collections.list { List }
import enc.hash_to_binary_tree { HashToBinaryTree }
import enc.params { EncoderParams, HasherParams, chooseHasher }

/// The state of the hasher that `common.params.type` selects (the `privat` union of the C
/// `Hasher`).
pub union HasherKernel {
  /// Not set up yet, or H10, which is `Hasher.h10`.
  None,
  H2 { pub h: HashQuickly<H2Config> },
  H3 { pub h: HashQuickly<H3Config> },
  H4 { pub h: HashQuickly<H4Config> },
  H54 { pub h: HashQuickly<H54Config> },
  H5 { pub h: HashLongestMatch<Narrow> },
  H6 { pub h: HashLongestMatch<Wide> },
  H58 { pub h: HashLongestMatchSimd<Narrow> },
  H68 { pub h: HashLongestMatchSimd<Wide> },
  H40 { pub h: HashForgetfulChain<H40Config> },
  H41 { pub h: HashForgetfulChain<H41Config> },
  H42 { pub h: HashForgetfulChain<H42Config> },
  H35 { pub h: HashComposite<HashQuickly<H3Config>, HashRolling> },
  H55 { pub h: HashComposite<HashQuickly<H54Config>, HashRolling> },
  H65 { pub h: HashComposite<HashLongestMatch<Wide>, HashRolling> },
  // H10 (qualities 10 and 11) is `Hasher.h10`.
}

/// `Hasher`.
pub struct Hasher {
  /// `common.is_setup_`.
  pub isSetup: bool,
  /// `common.is_prepared_`.
  pub isPrepared: bool,
  /// `common.params`.
  pub params: HasherParams,
  /// `privat`. Each hasher keeps its own `dict_num_lookups` and `dict_num_matches`.
  pub kernel: HasherKernel,
  /// `privat._H10`: one hasher once it is set up as H10 (qualities 10 and 11), else none.
  pub h10: List<HashToBinaryTree>,
}

// `HasherSize`, the allocation of `HasherSetup` and `InitializeH*`.
effect fn makeKernel(params: &EncoderParams) -> HasherKernel ! OutOfMemoryError ? &mut Allocator {
  let kind = params.hasher.kind
  if kind == 2 {
    return HasherKernel.H2 { h: run HashQuickly<H2Config>.make(H2Config {}) }
  } else if kind == 3 {
    return HasherKernel.H3 { h: run HashQuickly<H3Config>.make(H3Config {}) }
  } else if kind == 4 {
    return HasherKernel.H4 { h: run HashQuickly<H4Config>.make(H4Config {}) }
  } else if kind == 54 {
    return HasherKernel.H54 { h: run HashQuickly<H54Config>.make(H54Config {}) }
  } else if kind == 5 {
    return HasherKernel.H5 { h: run HashLongestMatch<Narrow>.make(Narrow {}, &params.hasher) }
  } else if kind == 6 {
    return HasherKernel.H6 { h: run HashLongestMatch<Wide>.make(Wide {}, &params.hasher) }
  } else if kind == 58 {
    return HasherKernel.H58 { h: run HashLongestMatchSimd<Narrow>.make(Narrow {}, &params.hasher) }
  } else if kind == 68 {
    return HasherKernel.H68 { h: run HashLongestMatchSimd<Wide>.make(Wide {}, &params.hasher) }
  } else if kind == 40 {
    return HasherKernel.H40 { h: run HashForgetfulChain<H40Config>.make(H40Config {}, params.quality) }
  } else if kind == 41 {
    return HasherKernel.H41 { h: run HashForgetfulChain<H41Config>.make(H41Config {}, params.quality) }
  } else if kind == 42 {
    return HasherKernel.H42 { h: run HashForgetfulChain<H42Config>.make(H42Config {}, params.quality) }
  } else if kind == 35 {
    // The memory of both hashers is allocated here (`extra[0..1]` for A, `extra[2..3]` for B);
    // they are initialized by the first `prepare`.
    let a = run HashQuickly<H3Config>.make(H3Config {})
    let b = run HashRolling.make(4)
    return HasherKernel.H35 { h: HashComposite<HashQuickly<H3Config>, HashRolling>.make(move a, move b) }
  } else if kind == 55 {
    let a = run HashQuickly<H54Config>.make(H54Config {})
    let b = run HashRolling.make(4)
    return HasherKernel.H55 { h: HashComposite<HashQuickly<H54Config>, HashRolling>.make(move a, move b) }
  } else if kind == 65 {
    let a = run HashLongestMatch<Wide>.make(Wide {}, &params.hasher)
    let b = run HashRolling.make(1)
    return HasherKernel.H65 { h: HashComposite<HashLongestMatch<Wide>, HashRolling>.make(move a, move b) }
  }
  // H10 (qualities 10 and 11) is set up apart, in `Hasher.h10`.
  return HasherKernel.None
}

// `PrepareH*(one_shot, input_size, data)`.
fn prepareKernel(kernel: &mut HasherKernel, oneShot: bool, inputSize: usize, data: &[u8]) -> () {
  match &mut kernel.* {
    HasherKernel.None => {}
    HasherKernel.H2 { h } => { MatchFinder.prepare(&mut h, oneShot, inputSize, data) }
    HasherKernel.H3 { h } => { MatchFinder.prepare(&mut h, oneShot, inputSize, data) }
    HasherKernel.H4 { h } => { MatchFinder.prepare(&mut h, oneShot, inputSize, data) }
    HasherKernel.H54 { h } => { MatchFinder.prepare(&mut h, oneShot, inputSize, data) }
    HasherKernel.H5 { h } => { MatchFinder.prepare(&mut h, oneShot, inputSize, data) }
    HasherKernel.H6 { h } => { MatchFinder.prepare(&mut h, oneShot, inputSize, data) }
    HasherKernel.H58 { h } => { MatchFinder.prepare(&mut h, oneShot, inputSize, data) }
    HasherKernel.H68 { h } => { MatchFinder.prepare(&mut h, oneShot, inputSize, data) }
    HasherKernel.H40 { h } => { MatchFinder.prepare(&mut h, oneShot, inputSize, data) }
    HasherKernel.H41 { h } => { MatchFinder.prepare(&mut h, oneShot, inputSize, data) }
    HasherKernel.H42 { h } => { MatchFinder.prepare(&mut h, oneShot, inputSize, data) }
    HasherKernel.H35 { h } => { MatchFinder.prepare(&mut h, oneShot, inputSize, data) }
    HasherKernel.H55 { h } => { MatchFinder.prepare(&mut h, oneShot, inputSize, data) }
    HasherKernel.H65 { h } => { MatchFinder.prepare(&mut h, oneShot, inputSize, data) }
  }
}

// `StitchToPreviousBlockH*(input_size, position, data, mask)`.
fn stitchKernel(kernel: &mut HasherKernel, inputSize: usize, position: usize, data: &[u8], mask: usize) -> () {
  match &mut kernel.* {
    HasherKernel.None => {}
    HasherKernel.H2 { h } => { MatchFinder.stitchToPreviousBlock(&mut h, inputSize, position, data, mask) }
    HasherKernel.H3 { h } => { MatchFinder.stitchToPreviousBlock(&mut h, inputSize, position, data, mask) }
    HasherKernel.H4 { h } => { MatchFinder.stitchToPreviousBlock(&mut h, inputSize, position, data, mask) }
    HasherKernel.H54 { h } => { MatchFinder.stitchToPreviousBlock(&mut h, inputSize, position, data, mask) }
    HasherKernel.H5 { h } => { MatchFinder.stitchToPreviousBlock(&mut h, inputSize, position, data, mask) }
    HasherKernel.H6 { h } => { MatchFinder.stitchToPreviousBlock(&mut h, inputSize, position, data, mask) }
    HasherKernel.H58 { h } => { MatchFinder.stitchToPreviousBlock(&mut h, inputSize, position, data, mask) }
    HasherKernel.H68 { h } => { MatchFinder.stitchToPreviousBlock(&mut h, inputSize, position, data, mask) }
    HasherKernel.H40 { h } => { MatchFinder.stitchToPreviousBlock(&mut h, inputSize, position, data, mask) }
    HasherKernel.H41 { h } => { MatchFinder.stitchToPreviousBlock(&mut h, inputSize, position, data, mask) }
    HasherKernel.H42 { h } => { MatchFinder.stitchToPreviousBlock(&mut h, inputSize, position, data, mask) }
    HasherKernel.H35 { h } => { MatchFinder.stitchToPreviousBlock(&mut h, inputSize, position, data, mask) }
    HasherKernel.H55 { h } => { MatchFinder.stitchToPreviousBlock(&mut h, inputSize, position, data, mask) }
    HasherKernel.H65 { h } => { MatchFinder.stitchToPreviousBlock(&mut h, inputSize, position, data, mask) }
  }
}

impl Hasher {
  /// `HasherInit`. Must be invoked before any other method.
  pub fn make() -> Hasher {
    return Hasher {
      isSetup: false,
      isPrepared: false,
      params: HasherParams { kind: 0, bucketBits: 0, blockBits: 0, numLastDistancesToCheck: 0 },
      kernel: HasherKernel.None,
      h10: List<HashToBinaryTree>.make(),
    }
  }

  /// `HasherReset`.
  pub fn reset(self: &mut Self) -> () {
    self.isPrepared = false
  }

  // `HasherSetup`.
  effect fn setup(self: &mut Self, params: &mut EncoderParams, data: &[u8], position: usize, inputSize: usize, isLast: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    let oneShot = position == 0 && isLast
    if !self.isSetup {
      let mut chosen = HasherParams { kind: params.hasher.kind, bucketBits: params.hasher.bucketBits, blockBits: params.hasher.blockBits, numLastDistancesToCheck: params.hasher.numLastDistancesToCheck }
      chooseHasher(&params, &mut chosen)
      self.params = HasherParams { kind: chosen.kind, bucketBits: chosen.bucketBits, blockBits: chosen.blockBits, numLastDistancesToCheck: chosen.numLastDistancesToCheck }
      params.hasher = move chosen
      self.kernel = run makeKernel(&params)
      if self.params.kind == 10 {
        run List<HashToBinaryTree>.append(&mut self.h10, run HashToBinaryTree.make(&params, position == 0 && isLast, inputSize))
      }
      Hasher.reset(&mut self)
      self.isSetup = true
    }
    if !self.isPrepared {
      prepareKernel(&mut self.kernel, oneShot, inputSize, data)
      if self.params.kind == 10 {
        HashToBinaryTree.prepare(&mut List<HashToBinaryTree>.asMutSlice(&mut self.h10)[0])
      }
      self.isPrepared = true
    }
  }

  /// `InitOrStitchToPreviousBlock`.
  pub effect fn initOrStitchToPreviousBlock(self: &mut Self, data: &[u8], mask: usize, params: &mut EncoderParams, position: usize, inputSize: usize, isLast: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    run Hasher.setup(&mut self, &mut params, data, position, inputSize, isLast)
    stitchKernel(&mut self.kernel, inputSize, position, data, mask)
    if self.params.kind == 10 {
      HashToBinaryTree.stitchToPreviousBlock(&mut List<HashToBinaryTree>.asMutSlice(&mut self.h10)[0], inputSize, position, data, mask)
    }
  }
}
