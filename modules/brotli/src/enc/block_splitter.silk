//! The split of a meta-block into blocks of different types: the data structure of google/brotli
//! v1.2.0 `c/enc/block_splitter.h`.
//!
//! NOT PORTED YET: the block splitter itself (`block_splitter.c`, `block_splitter_inc.h`). The
//! structure is here because the bit stream writer reads it.
import silk.collections.list { List }

/// `BlockSplit`. `types` and `lengths` hold `numBlocks` entries.
pub struct BlockSplit {
  /// The number of block types.
  pub numTypes: usize,
  /// The number of blocks.
  pub numBlocks: usize,
  pub types: List<u8>,
  pub lengths: List<u32>,
}

impl BlockSplit {
  /// `BrotliInitBlockSplit`.
  pub fn make() -> BlockSplit {
    return BlockSplit { numTypes: 0, numBlocks: 0, types: List<u8>.make(), lengths: List<u32>.make() }
  }
}
