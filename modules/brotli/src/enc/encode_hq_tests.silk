//! Tests of qualities 10 and 11 of the encoder against fixed vectors of the C reference
//! (google/brotli v1.2.0 built with `tests/reference/build.sh`, driven with `BR_TRACE=0` and the
//! parameters named in each test), and of the static tables the Zopfli match finder reads.
import enc.static_dict_lut { NUM_BUCKETS, NUM_ITEMS, bucketBytes, wordBytes }
import encode { BrotliEncoder, OPERATION_FINISH }
import silk.collections.list { List }
import silk.compress.brotli_tables
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u64
import silk.testing.testing { AssertionError, Testing }

// FNV-1a 64 of `data`.
fn fnv1a64(data: &[u8]) -> u64 {
  let mut h: u64 = 0xcbf29ce484222325
  let mut i: usize = 0
  while i < data.length {
    h = u64.wrappingMultiply(u64.bitXor(h, u8.toU64(data[i])), 0x100000001b3)
    i = i + 1
  }
  return h
}

// Whether two byte strings are equal.
fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] { return false }
    i = i + 1
  }
  return true
}

test effect fn theStaticDictionaryLookupTableIsTheOneOfTheCSources() -> () ! AssertionError<'static> {
  // The hashes that tools/gen_static_dict_lut.py prints for static_dict_lut_inc.h of v1.2.0.
  run Testing.expect(bucketBytes().length == 2 * NUM_BUCKETS, "the buckets are 16-bit values")
  run Testing.expect(wordBytes().length == 4 * NUM_ITEMS, "the words are 4 bytes each")
  run Testing.expect(fnv1a64(bucketBytes()) == 0x91ba745357aa25b9, "kStaticDictionaryBuckets")
  run Testing.expect(fnv1a64(wordBytes()) == 0x50361663d08a3eb3, "kStaticDictionaryWords")
}

test effect fn theStandardLibraryDictionaryIsTheOneOfTheCSources() -> () ! AssertionError<'static> {
  // FNV-1a 64 of c/common/dictionary.bin of v1.2.0.
  run Testing.expect(brotli_tables.words().length == 122784, "the size of the dictionary")
  run Testing.expect(fnv1a64(brotli_tables.words()) == 0xd8a843a9cc932619, "the bytes of the dictionary")
}

// Compresses `input` in one call with the parameters given as (id, value) pairs.
effect fn compressed(parameters: &[u32], input: &[u8]) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut encoder = run BrotliEncoder.make()
  let mut i: usize = 0
  while i + 1 < parameters.length {
    drop BrotliEncoder.setParameter(&mut encoder, parameters[i], parameters[i + 1])
    i = i + 2
  }
  let mut out = List<u8>.make()
  run List<u8>.appendRepeated(&mut out, 0, 65536)
  let step = run BrotliEncoder.compressStream(&mut encoder, OPERATION_FINISH, input, List<u8>.asMutSlice(&mut out))
  List<u8>.truncate(&mut out, step.written)
  return move out
}

effect fn check(parameters: &[u32], input: &[u8], expected: &[u8], what: string<'static>) -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let out = run compressed(parameters, input)
  run Testing.expect(same(List<u8>.asSlice(&out), expected), what)
}

