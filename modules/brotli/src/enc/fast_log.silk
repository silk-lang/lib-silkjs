//! Base-2 logarithms for entropy estimates: a port of google/brotli v1.2.0 `c/enc/fast_log.h` and
//! `fast_log.c`.
import silk.num.f64
import silk.num.u32
import silk.num.usize

// libm, so that large arguments give the same bits as the C library does.
unsafe extern "C" fn log2(value: f64) -> f64

/// `Log2FloorNonZero` for a `size_t`; C truncates the argument to 32 bits.
@inlineAlways
pub fn log2FloorNonZero(n: usize) -> u32 {
  // 31 - clz for a value that is not zero, without a subtraction that could trap.
  return u32.bitXor(u32.leadingZeros(usize.wrappingToU32(n)), 31)
}

/// `Log2FloorNonZero` of a 32-bit value.
@inlineAlways
pub fn log2FloorNonZero32(n: u32) -> u32 {
  return u32.bitXor(u32.leadingZeros(n), 31)
}

/// `FastLog2`: log2 of `v`, with log2(0) = 0.
@inlineAlways
pub fn fastLog2(v: usize) -> f64 {
  if v < 256 {
    return f64.fromBits(LOG2_TABLE_BITS[v])
  }
  return unsafe log2(usize.toF64(v))
}

/// `FastLog2` of a 32-bit count.
@inlineAlways
pub fn fastLog2u32(v: u32) -> f64 {
  if v < 256 {
    return f64.fromBits(LOG2_TABLE_BITS[u32.toUsize(v)])
  }
  return unsafe log2(u32.toF64(v))
}

// `kBrotliLog2Table` as IEEE-754 bit patterns. The C table is written with `float` literals
// (`1.5849625007211563f`), so each entry is the single-precision value widened to double, not the
// nearest double; the bits here are those values.
