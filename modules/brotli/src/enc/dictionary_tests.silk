effect fn encodeVectors() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let p0: [[u32; 2]; 1] = [[1, 0]]
  run expectEncoded(&p0, 519, &[0x98, 0x60, 0x89, 0xea, 0x7c, 0xdb, 0x39, 0x9b, 0xb9, 0x52, 0xb6, 0xf9, 0x88, 0xeb, 0x36, 0xf1, 0x86, 0xe7, 0x9b, 0x98, 0xdd, 0xb5, 0xbc, 0x1e, 0x3f, 0x46, 0x4c, 0x2d, 0x38, 0x23, 0x65, 0x54], "1=0")
