/// `StoreStaticCodeLengthCode`.
@inlineAlways
pub fn storeStaticCodeLengthCode(storageIx: &mut usize, storage: &mut [u8]) -> () {
  writeBits(40, 0x000000ff55555554, &mut storageIx, &mut storage)
}

/// `StoreStaticCommandHuffmanTree`.
@inlineAlways
pub fn storeStaticCommandHuffmanTree(storageIx: &mut usize, storage: &mut [u8]) -> () {
  writeBits(56, 0x0092624416307003, &mut storageIx, &mut storage)
  writeBits(3, 0, &mut storageIx, &mut storage)
}

/// `StoreStaticDistanceHuffmanTree`.
@inlineAlways
pub fn storeStaticDistanceHuffmanTree(storageIx: &mut usize, storage: &mut [u8]) -> () {
  writeBits(28, 0x0369dc03, &mut storageIx, &mut storage)
}
