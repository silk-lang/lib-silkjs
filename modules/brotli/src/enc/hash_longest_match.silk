//! The match finders H5, H6, H58 and H68: a port of google/brotli v1.2.0
//! `c/enc/hash_longest_match_inc.h` (H5), `hash_longest_match64_inc.h` (H6),
//! `hash_longest_match_simd_inc.h` (H58), `hash_longest_match64_simd_inc.h` (H68) and
//! `matching_tag_mask.h`.
//!
//! A (forgetful) hash table to the data seen by the compressor, to help create backward
//! references to previous data. This is a hash map of fixed size (`bucketSize`) to a ring buffer
//! of fixed size (`blockSize`). The ring buffer contains the last `blockSize` index positions of
//! the given hash key in the compressed data. H5 and H58 hash 4 bytes, H6 and H68 hash 5 bytes
//! (of the 8 they load); H58 and H68 also keep an 8-bit tag of each entry's hash and look only at
//! the entries whose tag matches, which the reference build (x86-64, `BROTLI_TZCNT64`) uses at
//! qualities up to `enc.params.MAX_SIMD_QUALITY`. The tag comparison here is the portable
//! semantics of the SSE2 code: bit `i` of the mask is set when tag `i` of the bucket matches.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize
import enc.find_match_length { findMatchLengthWithLimit }
import enc.hash_base { DictionaryStats, HASH_MUL_32, HASH_MUL_64, HasherSearchResult, MatchFinder, backwardReferencePenaltyUsingLastDistance, backwardReferenceScore, backwardReferenceScoreUsingLastDistance, prepareDistanceCache, searchInStaticDictionary }
import enc.memory { bytesMut, halfwordsMut, wordsMut, zeroedBytes, zeroedHalfwords, zeroedWords }
import enc.params { HasherParams }
import enc.write_bits { load32, load64 }

// `TAG_HASH_BITS` of the SIMD variants.
const TAG_HASH_BITS: usize = 8

// The first loop of `FindLongestMatch` of all four hashers: tries the last distances (and the
// candidates of `PrepareDistanceCache` around them) first.
@inlineAlways
fn searchLastDistances(
  data: &[u8],
  ringBufferMask: usize,
  distanceCache: &[i32; 16],
  numLastDistancesToCheck: usize,
  curIx: usize,
  curIxMasked: usize,
  maxLength: usize,
  maxBackward: usize,
  bestScoreRef: &mut usize,
  bestLenRef: &mut usize,
  out: &mut HasherSearchResult,
) -> () {
  let mut bestScore = bestScoreRef.*
  let mut bestLen = bestLenRef.*
  let mut i: usize = 0
  while i < numLastDistancesToCheck {
    let backward = i32.wrappingToUsize(distanceCache[i])
    let mut prevIx = usize.wrappingSubtract(curIx, backward)
    i = i + 1
    if prevIx >= curIx {
      continue
    }
    if backward > maxBackward {
      continue
    }
    prevIx = prevIx & ringBufferMask
    if curIxMasked + bestLen > ringBufferMask {
      break
    }
    if prevIx + bestLen > ringBufferMask || data[curIxMasked + bestLen] != data[prevIx + bestLen] {
      continue
    }
    let len = findMatchLengthWithLimit(data, prevIx, curIxMasked, maxLength)
    if len >= 3 || (len == 2 && i - 1 < 2) {
      // Comparing for >= 2 does not change the semantics, but just saves for a few unnecessary
      // binary logarithms in backward reference score, since we are not interested in such short
      // matches.
      let mut score = backwardReferenceScoreUsingLastDistance(len)
      if bestScore < score {
        if i - 1 != 0 {
          score = score - backwardReferencePenaltyUsingLastDistance(i - 1)
        }
        if bestScore < score {
          bestScore = score
          bestLen = len
          out.len = bestLen
          out.distance = backward
          out.score = bestScore
        }
      }
    }
  }
  bestScoreRef.* = bestScore
  bestLenRef.* = bestLen
}

// `HashBytes` of H5 and H58: the high bits of the hash of the 4 bytes at `at`.
@inlineAlways
fn hashBytes32(data: &[u8], at: usize, shift: u32) -> usize {
  let h = u32.wrappingMultiply(load32(data, at), HASH_MUL_32)
  // The higher bits contain more mixture from the multiplication, so we take our results from
  // there.
  return u32.toUsize(u32.shiftRight(h, shift))
}

// `HashBytes` of H6 and H68: the high `bits` bits of the hash of the 8 bytes at `at`.
@inlineAlways
fn hashBytes64(data: &[u8], at: usize, hashMul: u64, bits: u64) -> usize {
  let h = u64.wrappingMultiply(load64(data, at), hashMul)
  return u64.toUsize(u64.shiftRight(h, 64 - bits))
}

// `kHashMul64 << (64 - 5 * 8)`: the multiplier of H6 and H68, tuned to a match length of 5.
const HASH_MUL_64_LONG: u64 = 0x7bd3579bd3000000

/// `HashLongestMatch` of `hash_longest_match_inc.h` (H5) and `hash_longest_match64_inc.h` (H6).
pub struct HashLongestMatch {
  /// Whether this is H6 (8-byte hash) rather than H5.
  wide: bool,
  stats: DictionaryStats,
  /// Number of hash buckets.
  bucketSize: usize,
  /// Only `blockSize` newest backward references are kept, and the older are forgotten.
  blockSize: usize,
  /// Right-shift for computing hash bucket index from hash value (H5).
  hashShift: u32,
  /// Mask for accessing entries in a block (in a ring-buffer manner).
  blockMask: u32,
  blockBits: usize,
  numLastDistancesToCheck: usize,
  /// Number of entries in a particular bucket: `uint16_t[bucket_size]`.
  num: Intrinsic.RawBuffer<u16>,
  /// Buckets containing `blockSize` of backward references: `uint32_t[bucket_size * block_size]`.
  buckets: Intrinsic.RawBuffer<u32>,
}

impl HashLongestMatch {
  /// `HashMemAllocInBytes`, the allocation of `HasherSetup` and `Initialize` of H5 (or of H6 if
  /// `wide`).
  pub effect fn make(params: &HasherParams, wide: bool) -> HashLongestMatch ! OutOfMemoryError ? &mut Allocator {
    let bucketSize = usize.shiftLeft(1, i32.toUsize(params.bucketBits))
    let blockSize = usize.shiftLeft(1, i32.toUsize(params.blockBits))
    return HashLongestMatch {
      wide: wide,
      stats: DictionaryStats.make(),
      bucketSize: bucketSize,
      blockSize: blockSize,
      hashShift: 32 - i32.toU32(params.bucketBits),
      blockMask: usize.wrappingToU32(blockSize - 1),
      blockBits: i32.toUsize(params.blockBits),
      numLastDistancesToCheck: i32.toUsize(params.numLastDistancesToCheck),
      num: run zeroedHalfwords(bucketSize),
      buckets: run zeroedWords(bucketSize * blockSize),
    }
  }

  @inlineAlways
  fn hashBytes(self: &Self, data: &[u8], at: usize) -> usize {
    if self.wide {
      return hashBytes64(data, at, HASH_MUL_64_LONG, 15)
    }
    return hashBytes32(data, at, self.hashShift)
  }
}

impl MatchFinder for HashLongestMatch {
  @inlineAlways
  fn hashTypeLength(self: &Self) -> usize { return if self.wide { 8 } else { 4 } }
  @inlineAlways
  fn storeLookahead(self: &Self) -> usize { return if self.wide { 8 } else { 4 } }

  fn initialize(self: &mut Self) -> () {}

  fn prepare(self: &mut Self, oneShot: bool, inputSize: usize, data: &[u8]) -> () {
    // Partial preparation is 100 times slower (per socket).
    let partialPrepareThreshold = usize.shiftRight(self.bucketSize, 6)
    if oneShot && inputSize <= partialPrepareThreshold {
      let mut i: usize = 0
      while i < inputSize {
        let key = HashLongestMatch.hashBytes(&self, data, i)
        halfwordsMut(&mut self.num)[key] = 0
        i = i + 1
      }
    } else {
      let num = halfwordsMut(&mut self.num)
      let mut i: usize = 0
      while i < num.length {
        num[i] = 0
        i = i + 1
      }
    }
  }

  fn stitchToPreviousBlock(self: &mut Self, numBytes: usize, position: usize, ringbuffer: &[u8], ringbufferMask: usize) -> () {
    if numBytes >= MatchFinder.hashTypeLength(&self) - 1 && position >= 3 {
      // Prepare the hashes for three last bytes of the last write. These could not be calculated
      // before, since they require knowledge of both the previous and the current block.
      MatchFinder.store(&mut self, ringbuffer, ringbufferMask, position - 3)
      MatchFinder.store(&mut self, ringbuffer, ringbufferMask, position - 2)
      MatchFinder.store(&mut self, ringbuffer, ringbufferMask, position - 1)
    }
  }

  @inlineAlways
  fn prepareDistanceCache(self: &Self, distanceCache: &mut [i32; 16]) -> () {
    prepareDistanceCache(&mut distanceCache, usize.toI32(self.numLastDistancesToCheck))
  }

  // REQUIRES: `prepareDistanceCache` must be invoked for current distance cache values; if this
  // method is invoked repeatedly with the same distance cache values, it is enough to invoke
  // `prepareDistanceCache` once.
  @inlineAlways
  fn findLongestMatch(self: &mut Self, data: &[u8], ringBufferMask: usize, distanceCache: &[i32; 16], curIx: usize, maxLength: usize, maxBackward: usize, dictionaryDistance: usize, maxDistance: usize, out: &mut HasherSearchResult) -> () {
    let curIxMasked = curIx & ringBufferMask
    // Don't accept a short copy from far away.
    let minScore = out.score
    let mut bestScore = out.score
    let mut bestLen = out.len
    // Precalculate the hash key.
    let key = HashLongestMatch.hashBytes(&self, data, curIxMasked)
    let bucketStart = usize.shiftLeft(key, self.blockBits)
    out.len = 0
    out.lenCodeDelta = 0

    // Try last distance first.
    searchLastDistances(data, ringBufferMask, distanceCache, self.numLastDistancesToCheck, curIx, curIxMasked, maxLength, maxBackward, &mut bestScore, &mut bestLen, &mut out)
    // We require matches of len > 4, so increase bestLen to 3, so we can compare 4 bytes all the
    // time.
    if bestLen < 3 {
      bestLen = 3
    }
    let blockMask = u32.toUsize(self.blockMask)
    let count = u16.toUsize(halfwordsMut(&mut self.num)[key])
    let down = if count > self.blockSize { count - self.blockSize } else { 0 }
    let bucket = wordsMut(&mut self.buckets)
    let mut i = count
    if self.wide {
      let first4 = load32(data, curIxMasked)
      let maxLengthM4 = usize.wrappingSubtract(maxLength, 4)
      while i > down {
        i = i - 1
        let mut prevIx = u32.toUsize(bucket[bucketStart + (i & blockMask)])
        let backward = usize.wrappingSubtract(curIx, prevIx)
        if backward > maxBackward {
          break
        }
        prevIx = prevIx & ringBufferMask
        if curIxMasked + bestLen > ringBufferMask {
          break
        }
        // Compare 4 bytes ending at bestLen + 1.
        if prevIx + bestLen > ringBufferMask || load32(data, curIxMasked + bestLen - 3) != load32(data, prevIx + bestLen - 3) {
          continue
        }
        if first4 != load32(data, prevIx) {
          continue
        }
        let len = findMatchLengthWithLimit(data, prevIx + 4, curIxMasked + 4, maxLengthM4) + 4
        let score = backwardReferenceScore(len, backward)
        if bestScore < score {
          bestScore = score
          bestLen = len
          out.len = bestLen
          out.distance = backward
          out.score = bestScore
        }
      }
    } else {
      while i > down {
        i = i - 1
        let mut prevIx = u32.toUsize(bucket[bucketStart + (i & blockMask)])
        let backward = usize.wrappingSubtract(curIx, prevIx)
        if backward > maxBackward {
          break
        }
        prevIx = prevIx & ringBufferMask
        if curIxMasked + bestLen > ringBufferMask {
          break
        }
        // Compare 4 bytes ending at bestLen + 1.
        if prevIx + bestLen > ringBufferMask || load32(data, curIxMasked + bestLen - 3) != load32(data, prevIx + bestLen - 3) {
          continue
        }
        let len = findMatchLengthWithLimit(data, prevIx, curIxMasked, maxLength)
        if len >= 4 {
          // Comparing for >= 3 does not change the semantics, but just saves for a few
          // unnecessary binary logarithms in backward reference score, since we are not
          // interested in such short matches.
          let score = backwardReferenceScore(len, backward)
          if bestScore < score {
            bestScore = score
            bestLen = len
            out.len = bestLen
            out.distance = backward
            out.score = bestScore
          }
        }
      }
    }
    bucket[bucketStart + (count & blockMask)] = usize.wrappingToU32(curIx)
    halfwordsMut(&mut self.num)[key] = u16.wrappingAdd(usize.wrappingToU16(count), 1)
    if minScore == out.score {
      searchInStaticDictionary(&mut self.stats, data, curIxMasked, maxLength, dictionaryDistance, maxDistance, &mut out, false)
    }
  }

  @inlineAlways
  fn store(self: &mut Self, data: &[u8], mask: usize, ix: usize) -> () {
    let key = HashLongestMatch.hashBytes(&self, data, ix & mask)
    let num = halfwordsMut(&mut self.num)
    let count = num[key]
    let minorIx = u16.toUsize(count) & u32.toUsize(self.blockMask)
    let offset = minorIx + usize.shiftLeft(key, self.blockBits)
    num[key] = u16.wrappingAdd(count, 1)
    wordsMut(&mut self.buckets)[offset] = usize.wrappingToU32(ix)
  }

  fn storeRange(self: &mut Self, data: &[u8], mask: usize, ixStart: usize, ixEnd: usize) -> () {
    let mut i = ixStart
    while i < ixEnd {
      MatchFinder.store(&mut self, data, mask, i)
      i = i + 1
    }
  }
}

// `GetMatchingTagMask` (`matching_tag_mask.h`): bit `i` is set when `tagBucket[start + i]` is
// `tag`, for the `16 * chunkCount` (at most 64) tags of the bucket, rotated right by `head`.
@inlineAlways
fn matchingTagMask(chunkCount: usize, tag: u8, tagBucket: &[u8], start: usize, head: usize) -> u64 {
  let count = if chunkCount < 4 { 16 * chunkCount } else { 64 }
  let splat = u64.wrappingMultiply(u8.toU64(tag), 0x0101010101010101)
  let mut matches: u64 = 0
  let mut i: usize = 0
  while i < count {
    // A zero byte of `chunk` is a matching tag.
    let chunk = load64(tagBucket, start + i) ^ splat
    let mut j: usize = 0
    while j < 8 {
      if (u64.shiftRight(chunk, usize.toU64(8 * j)) & 0xff) == 0 {
        matches = matches | u64.shiftLeft(1, usize.toU64(i + j))
      }
      j = j + 1
    }
    i = i + 8
  }
  if chunkCount == 1 {
    let value = u64.wrappingToU16(matches)
    let c = usize.toU32(head & 0x0f)
    return u16.toU64(u16.shiftRight(value, c) | u16.shiftLeft(value, (16 - c) & 0x0f))
  }
  if chunkCount == 2 {
    let value = u64.wrappingToU32(matches)
    let c = usize.toU32(head & 0x1f)
    return u32.toU64(u32.shiftRight(value, c) | u32.shiftLeft(value, (32 - c) & 0x1f))
  }
  let c = usize.toU64(head & 0x3f)
  return u64.shiftRight(matches, c) | u64.shiftLeft(matches, (64 - c) & 0x3f)
}

/// `HashLongestMatch` of `hash_longest_match_simd_inc.h` (H58) and
/// `hash_longest_match64_simd_inc.h` (H68).
pub struct HashLongestMatchSimd {
  /// Whether this is H68 (8-byte hash) rather than H58.
  wide: bool,
  stats: DictionaryStats,
  bucketSize: usize,
  blockSize: usize,
  /// Right-shift for computing hash bucket index and tag from hash value (H58).
  hashShift: u32,
  blockMask: u32,
  blockBits: usize,
  numLastDistancesToCheck: usize,
  /// `uint16_t[bucket_size]`: 65535 minus the number of entries in a particular bucket.
  num: Intrinsic.RawBuffer<u16>,
  /// `uint8_t[bucket_size * block_size]`: the tags of the entries.
  tags: Intrinsic.RawBuffer<u8>,
  /// `uint32_t[bucket_size * block_size]`.
  buckets: Intrinsic.RawBuffer<u32>,
}

impl HashLongestMatchSimd {
  /// `HashMemAllocInBytes`, the allocation of `HasherSetup` and `Initialize` of H58 (or of H68 if
  /// `wide`).
  pub effect fn make(params: &HasherParams, wide: bool) -> HashLongestMatchSimd ! OutOfMemoryError ? &mut Allocator {
    let bucketSize = usize.shiftLeft(1, i32.toUsize(params.bucketBits))
    let blockSize = usize.shiftLeft(1, i32.toUsize(params.blockBits))
    return HashLongestMatchSimd {
      wide: wide,
      stats: DictionaryStats.make(),
      bucketSize: bucketSize,
      blockSize: blockSize,
      hashShift: 32 - i32.toU32(params.bucketBits) - usize.toU32(TAG_HASH_BITS),
      blockMask: usize.wrappingToU32(blockSize - 1),
      blockBits: i32.toUsize(params.blockBits),
      numLastDistancesToCheck: i32.toUsize(params.numLastDistancesToCheck),
      num: run zeroedHalfwords(bucketSize),
      tags: run zeroedBytes(bucketSize * blockSize),
      buckets: run zeroedWords(bucketSize * blockSize),
    }
  }

  @inlineAlways
  fn hashBytes(self: &Self, data: &[u8], at: usize) -> usize {
    if self.wide {
      return hashBytes64(data, at, HASH_MUL_64_LONG, 15 + usize.toU64(TAG_HASH_BITS))
    }
    return hashBytes32(data, at, self.hashShift)
  }
}

impl MatchFinder for HashLongestMatchSimd {
  @inlineAlways
  fn hashTypeLength(self: &Self) -> usize { return if self.wide { 8 } else { 4 } }
  @inlineAlways
  fn storeLookahead(self: &Self) -> usize { return if self.wide { 8 } else { 4 } }

  fn initialize(self: &mut Self) -> () {}

  fn prepare(self: &mut Self, oneShot: bool, inputSize: usize, data: &[u8]) -> () {
    // Partial preparation is 100 times slower (per socket).
    let partialPrepareThreshold = usize.shiftRight(self.bucketSize, 6)
    if oneShot && inputSize <= partialPrepareThreshold {
      let mut i: usize = 0
      while i < inputSize {
        let key = usize.shiftRight(HashLongestMatchSimd.hashBytes(&self, data, i), TAG_HASH_BITS)
        halfwordsMut(&mut self.num)[key] = 65535
        i = i + 1
      }
    } else {
      // Set all the bytes of num to 255, which makes each 16-bit value 65535.
      let num = halfwordsMut(&mut self.num)
      let mut i: usize = 0
      while i < num.length {
        num[i] = 65535
        i = i + 1
      }
    }
  }

  fn stitchToPreviousBlock(self: &mut Self, numBytes: usize, position: usize, ringbuffer: &[u8], ringbufferMask: usize) -> () {
    if numBytes >= MatchFinder.hashTypeLength(&self) - 1 && position >= 3 {
      // Prepare the hashes for three last bytes of the last write. These could not be calculated
      // before, since they require knowledge of both the previous and the current block.
      MatchFinder.store(&mut self, ringbuffer, ringbufferMask, position - 3)
      MatchFinder.store(&mut self, ringbuffer, ringbufferMask, position - 2)
      MatchFinder.store(&mut self, ringbuffer, ringbufferMask, position - 1)
    }
  }

  @inlineAlways
  fn prepareDistanceCache(self: &Self, distanceCache: &mut [i32; 16]) -> () {
    prepareDistanceCache(&mut distanceCache, usize.toI32(self.numLastDistancesToCheck))
  }

  @inlineAlways
  fn findLongestMatch(self: &mut Self, data: &[u8], ringBufferMask: usize, distanceCache: &[i32; 16], curIx: usize, maxLength: usize, maxBackward: usize, dictionaryDistance: usize, maxDistance: usize, out: &mut HasherSearchResult) -> () {
    let curIxMasked = curIx & ringBufferMask
    // Don't accept a short copy from far away.
    let minScore = out.score
    let mut bestScore = out.score
    let mut bestLen = out.len
    // Precalculate the hash key.
    let hash = HashLongestMatchSimd.hashBytes(&self, data, curIxMasked)
    let key = usize.shiftRight(hash, TAG_HASH_BITS)
    let bucketStart = usize.shiftLeft(key, self.blockBits)
    out.len = 0
    out.lenCodeDelta = 0

    // Try last distance first.
    searchLastDistances(data, ringBufferMask, distanceCache, self.numLastDistancesToCheck, curIx, curIxMasked, maxLength, maxBackward, &mut bestScore, &mut bestLen, &mut out)
    // We require matches of len > 4, so increase bestLen to 3, so we can compare 4 bytes all the
    // time.
    if bestLen < 3 {
      bestLen = 3
    }
    let blockMask = u32.toUsize(self.blockMask)
    let tag = usize.wrappingToU8(hash & 0xff)
    let numKey = halfwordsMut(&mut self.num)[key]
    let head = (u16.toUsize(numKey) + 1) & blockMask
    let mut matches = matchingTagMask(self.blockSize / 16, tag, bytesMut(&mut self.tags), bucketStart, head)
    // Mask off any matches from uninitialized tags.
    let n = 65535 - numKey
    let blockHasUnusedSlots: u64 = if self.blockSize > u16.toUsize(n) { 1 } else { 0 }
    let mask = u64.wrappingSubtract(u64.shiftLeft(blockHasUnusedSlots, u16.toU64(n & 63)), 1)
    matches = matches & mask
    let bucket = wordsMut(&mut self.buckets)
    let first4 = if self.wide { load32(data, curIxMasked) } else { 0 }
    let maxLengthM4 = usize.wrappingSubtract(maxLength, 4)
    while matches > 0 {
      let rbIndex = (head + u32.toUsize(u64.trailingZeros(matches))) & blockMask
      matches = matches & (matches - 1)
      let mut prevIx = u32.toUsize(bucket[bucketStart + rbIndex])
      let backward = usize.wrappingSubtract(curIx, prevIx)
      if backward > maxBackward {
        break
      }
      prevIx = prevIx & ringBufferMask
      if curIxMasked + bestLen > ringBufferMask {
        break
      }
      // Compare 4 bytes ending at bestLen + 1.
      if prevIx + bestLen > ringBufferMask || load32(data, curIxMasked + bestLen - 3) != load32(data, prevIx + bestLen - 3) {
        continue
      }
      if self.wide {
        if first4 != load32(data, prevIx) {
          continue
        }
        let len = findMatchLengthWithLimit(data, prevIx + 4, curIxMasked + 4, maxLengthM4) + 4
        let score = backwardReferenceScore(len, backward)
        if bestScore < score {
          bestScore = score
          bestLen = len
          out.len = bestLen
          out.distance = backward
          out.score = bestScore
        }
      } else {
        let len = findMatchLengthWithLimit(data, prevIx, curIxMasked, maxLength)
        if len >= 4 {
          // Comparing for >= 3 does not change the semantics, but just saves for a few
          // unnecessary binary logarithms in backward reference score, since we are not
          // interested in such short matches.
          let score = backwardReferenceScore(len, backward)
          if bestScore < score {
            bestScore = score
            bestLen = len
            out.len = bestLen
            out.distance = backward
            out.score = bestScore
          }
        }
      }
    }
    let slot = bucketStart + (u16.toUsize(numKey) & blockMask)
    bucket[slot] = usize.wrappingToU32(curIx)
    bytesMut(&mut self.tags)[slot] = tag
    halfwordsMut(&mut self.num)[key] = u16.wrappingSubtract(numKey, 1)
    if minScore == out.score {
      searchInStaticDictionary(&mut self.stats, data, curIxMasked, maxLength, dictionaryDistance, maxDistance, &mut out, false)
    }
  }

  @inlineAlways
  fn store(self: &mut Self, data: &[u8], mask: usize, ix: usize) -> () {
    let hash = HashLongestMatchSimd.hashBytes(&self, data, ix & mask)
    let key = usize.shiftRight(hash, TAG_HASH_BITS)
    let tag = usize.wrappingToU8(hash & 0xff)
    let num = halfwordsMut(&mut self.num)
    let count = num[key]
    let minorIx = u16.toUsize(count) & u32.toUsize(self.blockMask)
    let offset = minorIx + usize.shiftLeft(key, self.blockBits)
    num[key] = u16.wrappingSubtract(count, 1)
    wordsMut(&mut self.buckets)[offset] = usize.wrappingToU32(ix)
    bytesMut(&mut self.tags)[offset] = tag
  }

  fn storeRange(self: &mut Self, data: &[u8], mask: usize, ixStart: usize, ixEnd: usize) -> () {
    let mut i = ixStart
    while i < ixEnd {
      MatchFinder.store(&mut self, data, mask, i)
      i = i + 1
    }
  }
}
