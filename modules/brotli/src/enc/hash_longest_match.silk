//! The match finders H5, H6, H58 and H68: a port of google/brotli v1.2.0
//! `c/enc/hash_longest_match_inc.h` (H5), `hash_longest_match64_inc.h` (H6),
//! `hash_longest_match_simd_inc.h` (H58), `hash_longest_match64_simd_inc.h` (H68) and
//! `matching_tag_mask.h`.
//!
//! A (forgetful) hash table to the data seen by the compressor, to help create backward
//! references to previous data. This is a hash map of fixed size (`bucketSize`) to a ring buffer
//! of fixed size (`blockSize`). The ring buffer contains the last `blockSize` index positions of
//! the given hash key in the compressed data. H5 and H58 hash 4 bytes, H6 and H68 hash 5 bytes
//! (of the 8 they load); H58 and H68 also keep an 8-bit tag of each entry's hash and look only at
//! the entries whose tag matches, which the reference build (x86-64, `BROTLI_TZCNT64`) uses at
//! qualities up to `enc.params.MAX_SIMD_QUALITY`. The tag comparison here is the portable
//! semantics of the SSE2 code: bit `i` of the mask is set when tag `i` of the bucket matches.
//! (SSE2 is an optimization there; any comparison gives the same mask.)
//!
//! The search loops read the ring buffer without bounds checks: `findLongestMatch` first checks
//! that every byte it can read (up to `maxLength + 8` bytes after any masked position) is inside
//! it, and the table indexes are masked to the table sizes.
import silk.collections.slice { Slice }
import silk.mem.pointer { Pointer }
import silk.simd.mask16
import silk.simd.u8x16
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize
import enc.find_match_length { findMatchLengthWithLimitUnchecked }
import enc.hash_base { DictionaryStats, checkHashable, signExtend, HASH_MUL_32, HasherSearchResult, MatchFinder, backwardReferencePenaltyUsingLastDistance, backwardReferenceScore, backwardReferenceScoreUsingLastDistance, prepareDistanceCache, searchInStaticDictionary }
import enc.memory { bytes, bytesMut, getUnchecked, getUncheckedMut, halfwordsMut, setUnchecked, wordsMut, zeroedBytes, zeroedHalfwords, zeroedWords }
import enc.params { HasherParams }
import enc.write_bits { byteUnchecked, load32Unchecked, load64Unchecked }

// `TAG_HASH_BITS` of the SIMD variants.
const TAG_HASH_BITS: usize = 8

// `kHashMul64 << (64 - 5 * 8)`: the multiplier of H6 and H68, tuned to a match length of 5.
const HASH_MUL_64_LONG: u64 = 0x7bd3579bd3000000

/// Whether a hasher of this file hashes 8 bytes (H6, H68) or 4 (H5, H58).
pub interface HashWidth {
  fn wide(self: &Self) -> bool
}

/// The width of H5 and H58.
pub struct Narrow {}
impl HashWidth for Narrow {
  @inlineAlways
  fn wide(self: &Self) -> bool { return false }
}

/// The width of H6 and H68.
pub struct Wide {}
impl HashWidth for Wide {
  @inlineAlways
  fn wide(self: &Self) -> bool { return true }
}

// The first loop of `FindLongestMatch` of all four hashers: tries the last distances (and the
// candidates of `PrepareDistanceCache` around them) first.
//
// # Gotchas
// `checkReadable(data, ringBufferMask, curIxMasked, maxLength)` must hold.
@inlineAlways
unsafe fn searchLastDistances(
  data: &[u8],
  ringBufferMask: usize,
  distanceCache: &[i32; 16],
  numLastDistancesToCheck: usize,
  curIx: usize,
  curIxMasked: usize,
  maxLength: usize,
  maxBackward: usize,
  bestScoreRef: &mut usize,
  bestLenRef: &mut usize,
  out: &mut HasherSearchResult,
) -> () {
  let mut bestScore = bestScoreRef.*
  let mut bestLen = bestLenRef.*
  // At most the 16 entries of the cache.
  let count = if numLastDistancesToCheck < 16 { numLastDistancesToCheck } else { 16 }
  // C skips a distance when `prevIx >= curIx` or `backward > maxBackward`. With `prevIx` equal to
  // `curIx - backward`, the first holds when `backward` is 0 or above `curIx`; so both together
  // are `backward - 1 >= min(maxBackward, curIx)` (as unsigned numbers), one test in the loop.
  let limit = if maxBackward < curIx { maxBackward } else { curIx }
  let mut i: usize = 0
  while i < count {
    let backward = signExtend(unsafe getUnchecked<i32>(distanceCache, i))
    i = i + 1
    if usize.wrappingSubtract(backward, 1) >= limit {
      continue
    }
    let prevIx = usize.wrappingSubtract(curIx, backward) & ringBufferMask
    if usize.wrappingAdd(curIxMasked, bestLen) > ringBufferMask {
      break
    }
    if usize.wrappingAdd(prevIx, bestLen) > ringBufferMask || unsafe byteUnchecked(data, usize.wrappingAdd(curIxMasked, bestLen)) != unsafe byteUnchecked(data, usize.wrappingAdd(prevIx, bestLen)) {
      continue
    }
    let len = unsafe findMatchLengthWithLimitUnchecked(data, prevIx, curIxMasked, maxLength)
    if len >= 3 || (len == 2 && i - 1 < 2) {
      // Comparing for >= 2 does not change the semantics, but just saves for a few unnecessary
      // binary logarithms in backward reference score, since we are not interested in such short
      // matches.
      let mut score = backwardReferenceScoreUsingLastDistance(len)
      if bestScore < score {
        if i - 1 != 0 {
          score = score - backwardReferencePenaltyUsingLastDistance(i - 1)
        }
        if bestScore < score {
          bestScore = score
          bestLen = len
          out.len = bestLen
          out.distance = backward
          out.score = bestScore
        }
      }
    }
  }
  bestScoreRef.* = bestScore
  bestLenRef.* = bestLen
}

// `HashBytes` of all four: the bucket (and tag) of the bytes at `at`. Reads 8 bytes; the caller
// proves they are inside `data`.
@inlineAlways
unsafe fn hashBytes(wide: bool, data: &[u8], at: usize, shift32: u32, bits64: u64) -> usize {
  if wide {
    let h = u64.wrappingMultiply(unsafe load64Unchecked(data, at), HASH_MUL_64_LONG)
    return u64.toUsize(u64.shiftRight(h, 64 - bits64))
  }
  let h = u32.wrappingMultiply(unsafe load32Unchecked(data, at), HASH_MUL_32)
  // The higher bits contain more mixture from the multiplication, so we take our results from
  // there.
  return u32.toUsize(u32.shiftRight(h, shift32))
}

// One candidate of the bucket loops at `prevIxIn`: its match length shifted left by 16, plus 1,
// or 0 when the C code skips it (the conditions of H5/H58 and of H6/H68). `curTail` is the
// 4 bytes at `curIxMasked + bestLen - 3`, which C loads for each candidate.
//
// # Gotchas
// `checkReadable(data, ringBufferMask, curIxMasked, maxLength)` must hold and `bestLen` must be at least 3.
@inlineAlways
unsafe fn tryCandidate(wide: bool, data: &[u8], ringBufferMask: usize, curIxMasked: usize, curTail: u32, prevIxIn: usize, maxLength: usize, bestLen: usize) -> usize {
  let prevIx = prevIxIn & ringBufferMask
  // Compare 4 bytes ending at bestLen + 1.
  let lastPrev = usize.wrappingAdd(prevIx, bestLen)
  if lastPrev > ringBufferMask || curTail != unsafe load32Unchecked(data, usize.wrappingSubtract(lastPrev, 3)) {
    return 0
  }
  if wide {
    if unsafe load32Unchecked(data, curIxMasked) != unsafe load32Unchecked(data, prevIx) {
      return 0
    }
    // `maxLength` is more than 8 (the hash type length).
    let len = usize.wrappingAdd(unsafe findMatchLengthWithLimitUnchecked(data, usize.wrappingAdd(prevIx, 4), usize.wrappingAdd(curIxMasked, 4), maxLength - 4), 4)
    return usize.shiftLeft(len, 16) | 1
  }
  let len = unsafe findMatchLengthWithLimitUnchecked(data, prevIx, curIxMasked, maxLength)
  // Comparing for >= 3 does not change the semantics, but just saves for a few unnecessary binary
  // logarithms in backward reference score, since we are not interested in such short matches.
  if len >= 4 {
    return usize.shiftLeft(len, 16) | 1
  }
  return 0
}

// `hashBytes` with a bounds check.
@inlineAlways
fn hashBytesChecked(wide: bool, data: &[u8], at: usize, shift32: u32, bits64: u64) -> usize {
  let _last = data[at + 7]
  return unsafe hashBytes(wide, data, at, shift32, bits64)
}

/// `HashLongestMatch` of `hash_longest_match_inc.h` (H5, `W` = [`Narrow`]) and
/// `hash_longest_match64_inc.h` (H6, `W` = [`Wide`]).
pub struct HashLongestMatch<W> {
  width: W,
  stats: DictionaryStats,
  /// Number of hash buckets.
  bucketSize: usize,
  /// Only `blockSize` newest backward references are kept, and the older are forgotten.
  blockSize: usize,
  /// Right-shift for computing hash bucket index from hash value (H5).
  hashShift: u32,
  /// Mask for accessing entries in a block (in a ring-buffer manner).
  blockMask: usize,
  blockBits: usize,
  numLastDistancesToCheck: usize,
  /// Number of entries in a particular bucket: `uint16_t[bucket_size]`.
  num: Intrinsic.RawBuffer<u16>,
  /// Buckets containing `blockSize` of backward references: `uint32_t[bucket_size * block_size]`.
  buckets: Intrinsic.RawBuffer<u32>,
}

impl<W: HashWidth> HashLongestMatch<W> {
  /// `HashMemAllocInBytes`, the allocation of `HasherSetup` and `Initialize`.
  pub effect fn make(width: W, params: &HasherParams) -> HashLongestMatch<W> ! OutOfMemoryError ? &mut Allocator {
    let bucketBits = i32.toUsize(params.bucketBits)
    let bucketSize = usize.shiftLeft(1, bucketBits)
    let blockSize = usize.shiftLeft(1, i32.toUsize(params.blockBits))
    return HashLongestMatch<W> {
      width: move width,
      stats: DictionaryStats.make(),
      bucketSize: bucketSize,
      blockSize: blockSize,
      hashShift: usize.toU32(32 - bucketBits),
      blockMask: blockSize - 1,
      blockBits: i32.toUsize(params.blockBits),
      numLastDistancesToCheck: i32.toUsize(params.numLastDistancesToCheck),
      num: run zeroedHalfwords(bucketSize),
      buckets: run zeroedWords(bucketSize * blockSize),
    }
  }
}

impl<W: HashWidth> MatchFinder for HashLongestMatch<W> {
  @inlineAlways
  fn hashTypeLength(self: &Self) -> usize { return if HashWidth.wide(&self.width) { 8 } else { 4 } }
  @inlineAlways
  fn storeLookahead(self: &Self) -> usize { return if HashWidth.wide(&self.width) { 8 } else { 4 } }

  fn initialize(self: &mut Self) -> () {}

  fn prepare(self: &mut Self, oneShot: bool, inputSize: usize, data: &[u8]) -> () {
    let wide = HashWidth.wide(&self.width)
    let shift = self.hashShift
    let num = halfwordsMut(&mut self.num)
    // Partial preparation is 100 times slower (per socket).
    let partialPrepareThreshold = usize.shiftRight(self.bucketSize, 6)
    if oneShot && inputSize <= partialPrepareThreshold {
      let mut i: usize = 0
      while i < inputSize {
        num[hashBytesChecked(wide, data, i, shift, 15)] = 0
        i = i + 1
      }
    } else {
      let mut i: usize = 0
      while i < num.length {
        num[i] = 0
        i = i + 1
      }
    }
  }

  fn stitchToPreviousBlock(self: &mut Self, numBytes: usize, position: usize, ringbuffer: &[u8], ringbufferMask: usize) -> () {
    let hashTypeLength: usize = if HashWidth.wide(&self.width) { 8 } else { 4 }
    if numBytes + 1 >= hashTypeLength && position >= 3 {
      // Prepare the hashes for three last bytes of the last write. These could not be calculated
      // before, since they require knowledge of both the previous and the current block.
      MatchFinder.store(&mut self, ringbuffer, ringbufferMask, position - 3)
      MatchFinder.store(&mut self, ringbuffer, ringbufferMask, position - 2)
      MatchFinder.store(&mut self, ringbuffer, ringbufferMask, position - 1)
    }
  }

  @inlineAlways
  fn prepareDistanceCache(self: &Self, distanceCache: &mut [i32; 16]) -> () {
    prepareDistanceCache(&mut distanceCache, usize.toI32(self.numLastDistancesToCheck))
  }

  // REQUIRES: `prepareDistanceCache` must be invoked for current distance cache values; if this
  // method is invoked repeatedly with the same distance cache values, it is enough to invoke
  // `prepareDistanceCache` once.
  // Out of line: inlined into the reference search, it makes that loop's register allocation
  // worse (measured: about 6% more instructions at qualities 7 to 9).
  @inlineNever
  unsafe fn findLongestMatch(self: &mut Self, data: &[u8], ringBufferMask: usize, distanceCache: &[i32; 16], curIx: usize, maxLength: usize, maxBackward: usize, dictionaryDistance: usize, maxDistance: usize, out: &mut HasherSearchResult) -> () {
    // The caller proved `checkReadable(data, ringBufferMask, curIx & ringBufferMask, maxLength)`.
    let wide = HashWidth.wide(&self.width)
    let curIxMasked = curIx & ringBufferMask
    // Don't accept a short copy from far away.
    let minScore = out.score
    let mut bestScore = out.score
    let mut bestLen = out.len
    // Precalculate the hash key.
    let key = unsafe hashBytes(wide, data, curIxMasked, self.hashShift & 31, 15)
    let bucketStart = usize.shiftLeft(key, self.blockBits & 63)
    out.len = 0
    out.lenCodeDelta = 0

    // Try last distance first.
    unsafe searchLastDistances(data, ringBufferMask, distanceCache, self.numLastDistancesToCheck, curIx, curIxMasked, maxLength, maxBackward, &mut bestScore, &mut bestLen, &mut out)
    // We require matches of len > 4, so increase bestLen to 3, so we can compare 4 bytes all the
    // time.
    if bestLen < 3 {
      bestLen = 3
    }
    let blockMask = self.blockMask
    let blockSize = self.blockSize
    let num = halfwordsMut(&mut self.num)
    // `key` is below the bucket size, and so are the indexes into `bucket` below its size.
    let count = u16.toUsize(unsafe getUncheckedMut<u16>(&mut num, key))
    let down = if count > blockSize { count - blockSize } else { 0 }
    // The entries of this bucket: `bucketStart` is `key << blockBits`, so the bucket is inside the
    // table, and the view lets the loop index it from one base.
    let bucket = Slice.viewMut<u32>(wordsMut(&mut self.buckets), bucketStart, blockSize)
    let mut i = count
    // C checks `curIxMasked + bestLen > ringBufferMask` before each candidate and stops the loop
    // when it holds; that changes only with `bestLen`.
    let mut lastCur = usize.wrappingAdd(curIxMasked, bestLen)
    if lastCur <= ringBufferMask {
      while i > down {
        i = usize.wrappingSubtract(i, 1)
        // Masked to the block size.
        let prevIx = u32.toUsize(unsafe getUncheckedMut<u32>(&mut bucket, i & blockMask))
        let backward = usize.wrappingSubtract(curIx, prevIx)
        if backward > maxBackward {
          break
        }
        // The 4 bytes that end at `lastCur + 1`, loaded for each candidate as in C: kept in a
        // local across this loop, they make its register allocation much worse. `lastCur` is at
        // most `ringBufferMask` and `bestLen` is at least 3, so they are inside what
        // `checkReadable` proved.
        let curTail = unsafe load32Unchecked(data, usize.wrappingSubtract(lastCur, 3))
        let found = unsafe tryCandidate(wide, data, ringBufferMask, curIxMasked, curTail, prevIx, maxLength, bestLen)
        if found != 0 {
          let len = usize.shiftRight(found, 16)
          let score = backwardReferenceScore(len, backward)
          if bestScore < score {
            bestScore = score
            bestLen = len
            out.len = bestLen
            out.distance = backward
            out.score = bestScore
            lastCur = usize.wrappingAdd(curIxMasked, bestLen)
            if lastCur > ringBufferMask {
              break
            }
          }
        }
      }
    }
    // Masked to the block size.
    unsafe setUnchecked<u32>(&mut bucket, count & blockMask, usize.wrappingToU32(curIx))
    unsafe setUnchecked<u16>(&mut num, key, u16.wrappingAdd(usize.wrappingToU16(count), 1))
    if minScore == out.score {
      unsafe searchInStaticDictionary(&mut self.stats, data, curIxMasked, maxLength, dictionaryDistance, maxDistance, &mut out, false)
    }
  }

  @inlineAlways
  fn store(self: &mut Self, data: &[u8], mask: usize, ix: usize) -> () {
    MatchFinder.storeEvery(&mut self, data, mask, ix, ix + 1, 1)
  }

  @inlineAlways
  fn storeRange(self: &mut Self, data: &[u8], mask: usize, ixStart: usize, ixEnd: usize) -> () {
    MatchFinder.storeEvery(&mut self, data, mask, ixStart, ixEnd, 1)
  }

  @inlineAlways
  fn storeEvery(self: &mut Self, data: &[u8], mask: usize, ixStart: usize, ixEnd: usize, step: usize) -> () {
    // The 8 bytes that each position hashes are inside what this checks.
    checkHashable(data, mask, ixStart, ixEnd, 8)
    let wide = HashWidth.wide(&self.width)
    let shift = self.hashShift & 31
    let blockMask = self.blockMask
    let blockBits = self.blockBits & 63
    let num = halfwordsMut(&mut self.num)
    let buckets = wordsMut(&mut self.buckets)
    let mut ix = ixStart
    while ix < ixEnd {
      let key = unsafe hashBytes(wide, data, ix & mask, shift, 15)
      // `key` is below the bucket size.
      let count = unsafe getUncheckedMut<u16>(&mut num, key)
      let offset = usize.wrappingAdd(u16.toUsize(count) & blockMask, usize.shiftLeft(key, blockBits))
      unsafe setUnchecked<u16>(&mut num, key, u16.wrappingAdd(count, 1))
      unsafe setUnchecked<u32>(&mut buckets, offset, usize.wrappingToU32(ix))
      // ix < ixEnd and the step is at most 4: the sum does not wrap.
      ix = usize.wrappingAdd(ix, step)
    }
  }
}

// `GetMatchingTagMask` (`matching_tag_mask.h`): bit `i` is set when `tagBucket[start + i]` is
// `tag`, for the `16 * chunkCount` (at most 64) tags of the bucket, rotated right by `head`. As
// the SSE2 code of the reference build, 16 tags at a time.
//
// # Gotchas
// The caller proves that the tags are inside `tagBucket`.
@inlineAlways
unsafe fn matchingTagMask(chunkCount: usize, tag: u8, tagBucket: &[u8], start: usize, head: usize) -> u64 {
  let comparison = u8x16.splat(tag)
  // The caller's proof implies that the slice is not empty, so its pointer is not null.
  let base = unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(tagBucket))
  let mut matches: u64 = 0
  let mut i: usize = 0
  while i < chunkCount && i < 4 {
    // Inside the tags, as the caller proved; the sum cannot wrap.
    let chunk = unsafe u8x16.loadUnchecked(unsafe Pointer.assumeMany<u8>(unsafe Pointer.at<u8>(base, usize.wrappingAdd(start, 16 * i))))
    let equal = u8x16.lanesEqual(chunk, comparison)
    matches = matches | u64.shiftLeft(mask16.toBits(equal), usize.toU64(16 * i))
    i = i + 1
  }
  if chunkCount == 1 {
    let value = u64.wrappingToU16(matches)
    let c = usize.wrappingToU16(head & 0x0f)
    return u16.toU64(u16.shiftRight(value, c) | u16.shiftLeft(value, (16 - c) & 0x0f))
  }
  if chunkCount == 2 {
    let value = u64.wrappingToU32(matches)
    let c = usize.toU32(head & 0x1f)
    return u32.toU64(u32.shiftRight(value, c) | u32.shiftLeft(value, (32 - c) & 0x1f))
  }
  let c = usize.toU64(head & 0x3f)
  return u64.shiftRight(matches, c) | u64.shiftLeft(matches, (64 - c) & 0x3f)
}

/// `HashLongestMatch` of `hash_longest_match_simd_inc.h` (H58, `W` = [`Narrow`]) and
/// `hash_longest_match64_simd_inc.h` (H68, `W` = [`Wide`]).
pub struct HashLongestMatchSimd<W> {
  width: W,
  stats: DictionaryStats,
  bucketSize: usize,
  blockSize: usize,
  /// Right-shift for computing hash bucket index and tag from hash value (H58).
  hashShift: u32,
  blockMask: usize,
  blockBits: usize,
  numLastDistancesToCheck: usize,
  /// `uint16_t[bucket_size]`: 65535 minus the number of entries in a particular bucket.
  num: Intrinsic.RawBuffer<u16>,
  /// `uint8_t[bucket_size * block_size]`: the tags of the entries.
  tags: Intrinsic.RawBuffer<u8>,
  /// `uint32_t[bucket_size * block_size]`.
  buckets: Intrinsic.RawBuffer<u32>,
}

impl<W: HashWidth> HashLongestMatchSimd<W> {
  /// `HashMemAllocInBytes`, the allocation of `HasherSetup` and `Initialize`.
  pub effect fn make(width: W, params: &HasherParams) -> HashLongestMatchSimd<W> ! OutOfMemoryError ? &mut Allocator {
    let bucketBits = i32.toUsize(params.bucketBits)
    let bucketSize = usize.shiftLeft(1, bucketBits)
    let blockSize = usize.shiftLeft(1, i32.toUsize(params.blockBits))
    return HashLongestMatchSimd<W> {
      width: move width,
      stats: DictionaryStats.make(),
      bucketSize: bucketSize,
      blockSize: blockSize,
      hashShift: usize.toU32(32 - bucketBits - TAG_HASH_BITS),
      blockMask: blockSize - 1,
      blockBits: i32.toUsize(params.blockBits),
      numLastDistancesToCheck: i32.toUsize(params.numLastDistancesToCheck),
      num: run zeroedHalfwords(bucketSize),
      tags: run zeroedBytes(bucketSize * blockSize),
      buckets: run zeroedWords(bucketSize * blockSize),
    }
  }
}

impl<W: HashWidth> MatchFinder for HashLongestMatchSimd<W> {
  @inlineAlways
  fn hashTypeLength(self: &Self) -> usize { return if HashWidth.wide(&self.width) { 8 } else { 4 } }
  @inlineAlways
  fn storeLookahead(self: &Self) -> usize { return if HashWidth.wide(&self.width) { 8 } else { 4 } }

  fn initialize(self: &mut Self) -> () {}

  fn prepare(self: &mut Self, oneShot: bool, inputSize: usize, data: &[u8]) -> () {
    let wide = HashWidth.wide(&self.width)
    let shift = self.hashShift
    let num = halfwordsMut(&mut self.num)
    // Partial preparation is 100 times slower (per socket).
    let partialPrepareThreshold = usize.shiftRight(self.bucketSize, 6)
    if oneShot && inputSize <= partialPrepareThreshold {
      let mut i: usize = 0
      while i < inputSize {
        num[usize.shiftRight(hashBytesChecked(wide, data, i, shift, 23), TAG_HASH_BITS)] = 65535
        i = i + 1
      }
    } else {
      // Set all the bytes of num to 255, which makes each 16-bit value 65535.
      let mut i: usize = 0
      while i < num.length {
        num[i] = 65535
        i = i + 1
      }
    }
  }

  fn stitchToPreviousBlock(self: &mut Self, numBytes: usize, position: usize, ringbuffer: &[u8], ringbufferMask: usize) -> () {
    let hashTypeLength: usize = if HashWidth.wide(&self.width) { 8 } else { 4 }
    if numBytes + 1 >= hashTypeLength && position >= 3 {
      // Prepare the hashes for three last bytes of the last write. These could not be calculated
      // before, since they require knowledge of both the previous and the current block.
      MatchFinder.store(&mut self, ringbuffer, ringbufferMask, position - 3)
      MatchFinder.store(&mut self, ringbuffer, ringbufferMask, position - 2)
      MatchFinder.store(&mut self, ringbuffer, ringbufferMask, position - 1)
    }
  }

  @inlineAlways
  fn prepareDistanceCache(self: &Self, distanceCache: &mut [i32; 16]) -> () {
    prepareDistanceCache(&mut distanceCache, usize.toI32(self.numLastDistancesToCheck))
  }

  // Inlined, as C inlines it: the call (with its arguments on the stack) costs more than the
  // search of a small bucket (measured: 3 to 10% of the instructions at qualities 5 and 6).
  @inlineAlways
  unsafe fn findLongestMatch(self: &mut Self, data: &[u8], ringBufferMask: usize, distanceCache: &[i32; 16], curIx: usize, maxLength: usize, maxBackward: usize, dictionaryDistance: usize, maxDistance: usize, out: &mut HasherSearchResult) -> () {
    // The caller proved `checkReadable(data, ringBufferMask, curIx & ringBufferMask, maxLength)`.
    let wide = HashWidth.wide(&self.width)
    let curIxMasked = curIx & ringBufferMask
    // Don't accept a short copy from far away.
    let minScore = out.score
    let mut bestScore = out.score
    let mut bestLen = out.len
    // Precalculate the hash key.
    let hash = unsafe hashBytes(wide, data, curIxMasked, self.hashShift & 31, 23)
    let key = usize.shiftRight(hash, TAG_HASH_BITS)
    let bucketStart = usize.shiftLeft(key, self.blockBits & 63)
    out.len = 0
    out.lenCodeDelta = 0

    // Try last distance first.
    unsafe searchLastDistances(data, ringBufferMask, distanceCache, self.numLastDistancesToCheck, curIx, curIxMasked, maxLength, maxBackward, &mut bestScore, &mut bestLen, &mut out)
    // We require matches of len > 4, so increase bestLen to 3, so we can compare 4 bytes all the
    // time.
    if bestLen < 3 {
      bestLen = 3
    }
    let blockMask = self.blockMask
    let blockSize = self.blockSize
    let tag = usize.wrappingToU8(hash & 0xff)
    let num = halfwordsMut(&mut self.num)
    // `key` is below the bucket size, and so are the indexes into the bucket below its size.
    let numKey = unsafe getUncheckedMut<u16>(&mut num, key)
    let head = (u16.toUsize(numKey) + 1) & blockMask
    // The block size is 16 or more, and a multiple of 16: the tags of the bucket are inside.
    let mut matches = unsafe matchingTagMask(blockSize / 16, tag, bytes(&self.tags), bucketStart, head)
    // Mask off any matches from uninitialized tags.
    let n = 65535 - numKey
    let blockHasUnusedSlots: u64 = if blockSize > u16.toUsize(n) { 1 } else { 0 }
    let mask = u64.wrappingSubtract(u64.shiftLeft(blockHasUnusedSlots, u16.toU64(n & 63)), 1)
    matches = matches & mask
    // The entries of this bucket: `bucketStart` is `key << blockBits`, so the bucket is inside the
    // table, and the view lets the loop index it from one base.
    let bucket = Slice.viewMut<u32>(wordsMut(&mut self.buckets), bucketStart, blockSize)
    // C checks `curIxMasked + bestLen > ringBufferMask` before each candidate and stops the loop
    // when it holds; that changes only with `bestLen`.
    let mut lastCur = usize.wrappingAdd(curIxMasked, bestLen)
    if lastCur <= ringBufferMask {
      // The 4 bytes that end at `lastCur + 1`, which each candidate compares first: they change
      // only with `bestLen`. `lastCur` is at most `ringBufferMask` and `bestLen` is at least 3,
      // so they are inside what `checkReadable` proved.
      let mut curTail = unsafe load32Unchecked(data, usize.wrappingSubtract(lastCur, 3))
      while matches > 0 {
        // `rbIndex` is masked to the block size.
        let rbIndex = usize.wrappingAdd(head, u32.toUsize(u64.trailingZeros(matches))) & blockMask
        matches = matches & (matches - 1)
        let prevIx = u32.toUsize(unsafe getUncheckedMut<u32>(&mut bucket, rbIndex))
        let backward = usize.wrappingSubtract(curIx, prevIx)
        if backward > maxBackward {
          break
        }
        let found = unsafe tryCandidate(wide, data, ringBufferMask, curIxMasked, curTail, prevIx, maxLength, bestLen)
        if found != 0 {
          let len = usize.shiftRight(found, 16)
          let score = backwardReferenceScore(len, backward)
          if bestScore < score {
            bestScore = score
            bestLen = len
            out.len = bestLen
            out.distance = backward
            out.score = bestScore
            lastCur = usize.wrappingAdd(curIxMasked, bestLen)
            if lastCur > ringBufferMask {
              break
            }
            // As above.
            curTail = unsafe load32Unchecked(data, usize.wrappingSubtract(lastCur, 3))
          }
        }
      }
    }
    // Below the block size, as `rbIndex` above.
    let slotInBucket = u16.toUsize(numKey) & blockMask
    unsafe setUnchecked<u32>(&mut bucket, slotInBucket, usize.wrappingToU32(curIx))
    unsafe setUnchecked<u8>(bytesMut(&mut self.tags), usize.wrappingAdd(bucketStart, slotInBucket), tag)
    unsafe setUnchecked<u16>(&mut num, key, u16.wrappingSubtract(numKey, 1))
    if minScore == out.score {
      unsafe searchInStaticDictionary(&mut self.stats, data, curIxMasked, maxLength, dictionaryDistance, maxDistance, &mut out, false)
    }
  }

  @inlineAlways
  fn store(self: &mut Self, data: &[u8], mask: usize, ix: usize) -> () {
    MatchFinder.storeEvery(&mut self, data, mask, ix, ix + 1, 1)
  }

  @inlineAlways
  fn storeRange(self: &mut Self, data: &[u8], mask: usize, ixStart: usize, ixEnd: usize) -> () {
    MatchFinder.storeEvery(&mut self, data, mask, ixStart, ixEnd, 1)
  }

  @inlineAlways
  fn storeEvery(self: &mut Self, data: &[u8], mask: usize, ixStart: usize, ixEnd: usize, step: usize) -> () {
    // The 8 bytes that each position hashes are inside what this checks.
    checkHashable(data, mask, ixStart, ixEnd, 8)
    let wide = HashWidth.wide(&self.width)
    let shift = self.hashShift & 31
    let blockMask = self.blockMask
    let blockBits = self.blockBits & 63
    let num = halfwordsMut(&mut self.num)
    let buckets = wordsMut(&mut self.buckets)
    let tags = bytesMut(&mut self.tags)
    let mut ix = ixStart
    while ix < ixEnd {
      let hash = unsafe hashBytes(wide, data, ix & mask, shift, 23)
      let key = usize.shiftRight(hash, TAG_HASH_BITS)
      // `key` is below the bucket size.
      let count = unsafe getUncheckedMut<u16>(&mut num, key)
      let offset = usize.wrappingAdd(u16.toUsize(count) & blockMask, usize.shiftLeft(key, blockBits))
      unsafe setUnchecked<u16>(&mut num, key, u16.wrappingSubtract(count, 1))
      unsafe setUnchecked<u32>(&mut buckets, offset, usize.wrappingToU32(ix))
      unsafe setUnchecked<u8>(&mut tags, offset, usize.wrappingToU8(hash & 0xff))
      // ix < ixEnd and the step is at most 4: the sum does not wrap.
      ix = usize.wrappingAdd(ix, step)
    }
  }
}
