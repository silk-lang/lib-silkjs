//! Finding the backward references of the input: the interface of google/brotli v1.2.0
//! `c/enc/backward_references.h` and `backward_references_hq.h`.
//!
//! NOT PORTED YET: the reference search (`backward_references.c`, `backward_references_inc.h`,
//! `backward_references_hq.c`). This is the seam for it: `createBackwardReferences` has the
//! arguments of the C function and reports that it found no match, which is always a valid
//! answer. The output is then a valid stream, but not the bytes that the C encoder writes at
//! these qualities.
import enc.command { Command }
import enc.hash { Hasher }
import enc.params { EncoderParams }

/// `BrotliCreateBackwardReferences` (and, until they are ported,
/// `BrotliCreateZopfliBackwardReferences` and `BrotliCreateHqZopfliBackwardReferences`).
///
/// `commands` is the storage from the next command to write, `numCommands` is initially the
/// total amount of commands output by previous calls and must be incremented by the amount
/// written by this call.
///
/// PLACEHOLDER: finds nothing. All `numBytes` are added to the pending insert length, as the C
/// function does with the bytes after its last match.
pub fn createBackwardReferences(
  numBytes: usize,
  position: usize,
  ringbuffer: &[u8],
  ringbufferMask: usize,
  literalContextLut: usize,
  params: &EncoderParams,
  hasher: &mut Hasher,
  distCache: &mut [i32; 16],
  lastInsertLen: &mut usize,
  commands: &mut [Command],
  numCommands: &mut usize,
  numLiterals: &mut usize,
) -> () {
  lastInsertLen.* = lastInsertLen.* + numBytes
}
