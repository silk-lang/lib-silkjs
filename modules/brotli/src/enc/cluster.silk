//! Clustering of histograms: a port of google/brotli v1.2.0 `c/enc/cluster.h`, `cluster.c` and
//! `cluster_inc.h`, with the histogram operations of `histogram_inc.h` as an interface, so that one
//! generic function stands for the three instantiations (`Literal`, `Command`, `Distance`) of each
//! C template.
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.num.f64
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.usize
import enc.bit_cost { populationCostCommand, populationCostDistance, populationCostLiteral }
import enc.fast_log { fastLog2 }
import enc.histogram { HistogramCommand, HistogramDistance, HistogramLiteral }

/// The operations of `histogram_inc.h` and `bit_cost_inc.h` on one histogram type.
pub interface HistogramOps {
  /// A cleared histogram (`HistogramClear`).
  fn cleared() -> Self
  /// `HistogramDataSize`.
  fn dataSize(self: &Self) -> usize
  /// `data_`.
  fn counts(self: &Self) -> &[u32]
  /// `total_count_`.
  fn total(self: &Self) -> usize
  /// `bit_cost_`.
  fn cost(self: &Self) -> f64
  /// Sets `bit_cost_`.
  fn setCost(self: &mut Self, value: f64) -> ()
  /// `HistogramClear`.
  fn clearAll(self: &mut Self) -> ()
  /// `HistogramAdd`.
  fn addOne(self: &mut Self, value: usize) -> ()
  /// `HistogramAddHistogram`.
  fn addAll(self: &mut Self, other: &Self) -> ()
  /// `BrotliPopulationCost`.
  fn population(self: &Self) -> f64
}

/// A symbol of the data that a histogram counts: `uint8_t` for literals, `uint16_t` for
/// commands and distances.
pub interface SymbolValue {
  fn symbol(value: Self) -> usize
}

impl SymbolValue for u8 {
  @inlineAlways
  fn symbol(value: u8) -> usize {
    return u8.toUsize(value)
  }
}

impl SymbolValue for u16 {
  @inlineAlways
  fn symbol(value: u16) -> usize {
    return u16.toUsize(value)
  }
}

impl HistogramOps for HistogramLiteral {
  fn cleared() -> HistogramLiteral { return HistogramLiteral.make() }
  @inlineAlways
  fn dataSize(self: &HistogramLiteral) -> usize { return 256 }
  @inlineAlways
  fn counts(self: &HistogramLiteral) -> &[u32] { return &self.data }
  @inlineAlways
  fn total(self: &HistogramLiteral) -> usize { return self.totalCount }
  @inlineAlways
  fn cost(self: &HistogramLiteral) -> f64 { return self.bitCost }
  @inlineAlways
  fn setCost(self: &mut HistogramLiteral, value: f64) -> () { self.bitCost = value }
  fn clearAll(self: &mut HistogramLiteral) -> () { HistogramLiteral.clear(&mut self) }
  @inlineAlways
  fn addOne(self: &mut HistogramLiteral, value: usize) -> () { HistogramLiteral.add(&mut self, value) }
  fn addAll(self: &mut HistogramLiteral, other: &HistogramLiteral) -> () { HistogramLiteral.addHistogram(&mut self, other) }
  fn population(self: &HistogramLiteral) -> f64 { return populationCostLiteral(self) }
}

impl HistogramOps for HistogramCommand {
  fn cleared() -> HistogramCommand { return HistogramCommand.make() }
  @inlineAlways
  fn dataSize(self: &HistogramCommand) -> usize { return 704 }
  @inlineAlways
  fn counts(self: &HistogramCommand) -> &[u32] { return &self.data }
  @inlineAlways
  fn total(self: &HistogramCommand) -> usize { return self.totalCount }
  @inlineAlways
  fn cost(self: &HistogramCommand) -> f64 { return self.bitCost }
  @inlineAlways
  fn setCost(self: &mut HistogramCommand, value: f64) -> () { self.bitCost = value }
  fn clearAll(self: &mut HistogramCommand) -> () { HistogramCommand.clear(&mut self) }
  @inlineAlways
  fn addOne(self: &mut HistogramCommand, value: usize) -> () { HistogramCommand.add(&mut self, value) }
  fn addAll(self: &mut HistogramCommand, other: &HistogramCommand) -> () { HistogramCommand.addHistogram(&mut self, other) }
  fn population(self: &HistogramCommand) -> f64 { return populationCostCommand(self) }
}

impl HistogramOps for HistogramDistance {
  fn cleared() -> HistogramDistance { return HistogramDistance.make() }
  @inlineAlways
  fn dataSize(self: &HistogramDistance) -> usize { return 544 }
  @inlineAlways
  fn counts(self: &HistogramDistance) -> &[u32] { return &self.data }
  @inlineAlways
  fn total(self: &HistogramDistance) -> usize { return self.totalCount }
  @inlineAlways
  fn cost(self: &HistogramDistance) -> f64 { return self.bitCost }
  @inlineAlways
  fn setCost(self: &mut HistogramDistance, value: f64) -> () { self.bitCost = value }
  fn clearAll(self: &mut HistogramDistance) -> () { HistogramDistance.clear(&mut self) }
  @inlineAlways
  fn addOne(self: &mut HistogramDistance, value: usize) -> () { HistogramDistance.add(&mut self, value) }
  fn addAll(self: &mut HistogramDistance, other: &HistogramDistance) -> () { HistogramDistance.addHistogram(&mut self, other) }
  fn population(self: &HistogramDistance) -> f64 { return populationCostDistance(self) }
}

/// `count` cleared histograms (`BROTLI_ALLOC` followed by `ClearHistograms`).
pub effect fn clearedHistograms<H: HistogramOps + Copy>(count: usize) -> List<H> ! OutOfMemoryError ? &mut Allocator {
  let mut list = List<H>.make()
  run List<H>.reserveExact(&mut list, count)
  let empty: H = HistogramOps.cleared()
  run List<H>.appendRepeated(&mut list, empty, count)
  return move list
}

/// `count` 32-bit words set to `value`.
pub effect fn filledWords(value: u32, count: usize) -> List<u32> ! OutOfMemoryError ? &mut Allocator {
  let mut list = List<u32>.make()
  run List<u32>.reserveExact(&mut list, count)
  run List<u32>.appendRepeated(&mut list, value, count)
  return move list
}

/// `HistogramPair`.
pub struct HistogramPair {
  pub idx1: u32,
  pub idx2: u32,
  pub costCombo: f64,
  pub costDiff: f64,
}

impl Copy for HistogramPair {}

/// `count` empty pairs.
pub effect fn makePairs(count: usize) -> List<HistogramPair> ! OutOfMemoryError ? &mut Allocator {
  let mut list = List<HistogramPair>.make()
  run List<HistogramPair>.reserveExact(&mut list, count)
  run List<HistogramPair>.appendRepeated(&mut list, HistogramPair { idx1: 0, idx2: 0, costCombo: 0.0, costDiff: 0.0 }, count)
  return move list
}

// `HistogramPairIsLess`.
@inlineAlways
fn histogramPairIsLess(p1: &HistogramPair, p2: &HistogramPair) -> bool {
  if p1.costDiff != p2.costDiff {
    return p1.costDiff > p2.costDiff
  }
  return u32.wrappingSubtract(p1.idx2, p1.idx1) > u32.wrappingSubtract(p2.idx2, p2.idx1)
}

// `ClusterCostDiff`.
@inlineAlways
fn clusterCostDiff(sizeA: usize, sizeB: usize) -> f64 {
  let sizeC = sizeA + sizeB
  return usize.toF64(sizeA) * fastLog2(sizeA) + usize.toF64(sizeB) * fastLog2(sizeB) - usize.toF64(sizeC) * fastLog2(sizeC)
}

/// `BrotliCompareAndPushToQueue`: computes the bit cost reduction by combining out[idx1] and
/// out[idx2] and if it is below a threshold, stores the pair (idx1, idx2) in the *pairs queue.
pub fn compareAndPushToQueue<H: HistogramOps + Copy>(
  out: &[H],
  tmp: &mut H,
  clusterSize: &[u32],
  idx1In: u32,
  idx2In: u32,
  maxNumPairs: usize,
  pairs: &mut [HistogramPair],
  numPairs: &mut usize,
) -> () {
  let mut isGoodPair = false
  if idx1In == idx2In {
    return ()
  }
  let mut idx1 = idx1In
  let mut idx2 = idx2In
  if idx2 < idx1 {
    let t = idx2
    idx2 = idx1
    idx1 = t
  }
  let i1 = u32.toUsize(idx1)
  let i2 = u32.toUsize(idx2)
  let mut p = HistogramPair { idx1: idx1, idx2: idx2, costCombo: 0.0, costDiff: 0.0 }
  p.costDiff = 0.5 * clusterCostDiff(u32.toUsize(clusterSize[i1]), u32.toUsize(clusterSize[i2]))
  p.costDiff = p.costDiff - HistogramOps.cost(&out[i1])
  p.costDiff = p.costDiff - HistogramOps.cost(&out[i2])

  if HistogramOps.total(&out[i1]) == 0 {
    p.costCombo = HistogramOps.cost(&out[i2])
    isGoodPair = true
  } else if HistogramOps.total(&out[i2]) == 0 {
    p.costCombo = HistogramOps.cost(&out[i1])
    isGoodPair = true
  } else {
    let threshold: f64 = if numPairs.* == 0 { 1e99 } else { if pairs[0].costDiff > 0.0 { pairs[0].costDiff } else { 0.0 } }
    tmp.* = out[i1]
    HistogramOps.addAll(&mut tmp, &out[i2])
    let costCombo = HistogramOps.population(&tmp)
    if costCombo < threshold - p.costDiff {
      p.costCombo = costCombo
      isGoodPair = true
    }
  }
  if isGoodPair {
    p.costDiff = p.costDiff + p.costCombo
    if numPairs.* > 0 && histogramPairIsLess(&pairs[0], &p) {
      // Replace the top of the queue if needed.
      if numPairs.* < maxNumPairs {
        pairs[numPairs.*] = pairs[0]
        numPairs.* = numPairs.* + 1
      }
      pairs[0] = p
    } else if numPairs.* < maxNumPairs {
      pairs[numPairs.*] = p
      numPairs.* = numPairs.* + 1
    }
  }
}

/// `BrotliHistogramCombine`.
pub fn histogramCombine<H: HistogramOps + Copy>(
  out: &mut [H],
  tmp: &mut H,
  clusterSize: &mut [u32],
  symbols: &mut [u32],
  clusters: &mut [u32],
  pairs: &mut [HistogramPair],
  numClustersIn: usize,
  symbolsSize: usize,
  maxClusters: usize,
  maxNumPairs: usize,
) -> usize {
  let mut numClusters = numClustersIn
  let mut costDiffThreshold: f64 = 0.0
  let mut minClusterSize: usize = 1
  let mut numPairs: usize = 0

  // We maintain a vector of histogram pairs, with the property that the pair with the maximum
  // bit cost reduction is the first.
  let mut idx1: usize = 0
  while idx1 < numClusters {
    let mut idx2 = idx1 + 1
    while idx2 < numClusters {
      compareAndPushToQueue<H>(&out, &mut tmp, &clusterSize, clusters[idx1], clusters[idx2], maxNumPairs, &mut pairs, &mut numPairs)
      idx2 = idx2 + 1
    }
    idx1 = idx1 + 1
  }

  while numClusters > minClusterSize {
    if pairs[0].costDiff >= costDiffThreshold {
      costDiffThreshold = 1e99
      minClusterSize = maxClusters
      continue
    }
    // Take the best pair from the top of heap.
    let bestIdx1 = pairs[0].idx1
    let bestIdx2 = pairs[0].idx2
    let b1 = u32.toUsize(bestIdx1)
    let b2 = u32.toUsize(bestIdx2)
    let other = out[b2]
    HistogramOps.addAll(&mut out[b1], &other)
    HistogramOps.setCost(&mut out[b1], pairs[0].costCombo)
    clusterSize[b1] = clusterSize[b1] + clusterSize[b2]
    let mut i: usize = 0
    while i < symbolsSize {
      if symbols[i] == bestIdx2 {
        symbols[i] = bestIdx1
      }
      i = i + 1
    }
    i = 0
    while i < numClusters {
      if clusters[i] == bestIdx2 {
        let mut k = i
        while k + 1 < numClusters {
          clusters[k] = clusters[k + 1]
          k = k + 1
        }
        break
      }
      i = i + 1
    }
    numClusters = numClusters - 1
    // Remove pairs intersecting the just combined best pair.
    let mut copyToIdx: usize = 0
    i = 0
    while i < numPairs {
      let p = pairs[i]
      if p.idx1 == bestIdx1 || p.idx2 == bestIdx1 || p.idx1 == bestIdx2 || p.idx2 == bestIdx2 {
        // Remove invalid pair from the queue.
        i = i + 1
        continue
      }
      if histogramPairIsLess(&pairs[0], &p) {
        // Replace the top of the queue if needed.
        let front = pairs[0]
        pairs[0] = p
        pairs[copyToIdx] = front
      } else {
        pairs[copyToIdx] = p
      }
      copyToIdx = copyToIdx + 1
      i = i + 1
    }
    numPairs = copyToIdx

    // Push new pairs formed with the combined histogram to the heap.
    i = 0
    while i < numClusters {
      compareAndPushToQueue<H>(&out, &mut tmp, &clusterSize, bestIdx1, clusters[i], maxNumPairs, &mut pairs, &mut numPairs)
      i = i + 1
    }
  }
  return numClusters
}

/// `BrotliHistogramBitCostDistance`: what is the bit cost of moving histogram from cur_symbol to
/// candidate.
pub fn histogramBitCostDistance<H: HistogramOps + Copy>(histogram: &H, candidate: &H, tmp: &mut H) -> f64 {
  if HistogramOps.total(histogram) == 0 {
    return 0.0
  }
  tmp.* = histogram.*
  HistogramOps.addAll(&mut tmp, candidate)
  return HistogramOps.population(&tmp) - HistogramOps.cost(candidate)
}

/// `BrotliHistogramRemap`: find the best 'out' histogram for each of the 'in' histograms. When
/// called, clusters[0..num_clusters) contains the unique values from symbols[0..in_size), but
/// this property is not preserved in this function. Note: we assume that out[]->bit_cost_ is
/// already up-to-date.
pub fn histogramRemap<H: HistogramOps + Copy>(input: &[H], inSize: usize, clusters: &[u32], numClusters: usize, out: &mut [H], tmp: &mut H, symbols: &mut [u32]) -> () {
  let mut i: usize = 0
  while i < inSize {
    let mut bestOut = if i == 0 { symbols[0] } else { symbols[i - 1] }
    let mut bestBits = histogramBitCostDistance<H>(&input[i], &out[u32.toUsize(bestOut)], &mut tmp)
    let mut j: usize = 0
    while j < numClusters {
      let curBits = histogramBitCostDistance<H>(&input[i], &out[u32.toUsize(clusters[j])], &mut tmp)
      if curBits < bestBits {
        bestBits = curBits
        bestOut = clusters[j]
      }
      j = j + 1
    }
    symbols[i] = bestOut
    i = i + 1
  }

  // Recompute each out based on raw and symbols.
  i = 0
  while i < numClusters {
    HistogramOps.clearAll(&mut out[u32.toUsize(clusters[i])])
    i = i + 1
  }
  i = 0
  while i < inSize {
    HistogramOps.addAll(&mut out[u32.toUsize(symbols[i])], &input[i])
    i = i + 1
  }
}

/// `BrotliHistogramReindex`: reorders elements of the out[0..length) array and changes values in
/// symbols[0..length) array in the following way:
///   * when called, symbols[] contains indexes into out[], and has N unique values (possibly
///     N < length)
///   * on return, symbols'[i] = f(symbols[i]) and out'[symbols'[i]] = out[symbols[i]], for each
///     0 <= i < length, where f is a bijection between the range of symbols[] and [0..N), and the
///     first occurrences of values in symbols'[i] come in consecutive increasing order.
/// Returns N, the number of unique values in symbols[].
pub effect fn histogramReindex<H: HistogramOps + Copy>(out: &mut [H], symbols: &mut [u32], length: usize) -> usize ! OutOfMemoryError ? &mut Allocator {
  let invalidIndex: u32 = 0xffffffff
  let mut newIndexList = run filledWords(invalidIndex, length)
  let newIndex = List<u32>.asMutSlice(&mut newIndexList)
  let mut nextIndex: u32 = 0
  let mut i: usize = 0
  while i < length {
    let s = u32.toUsize(symbols[i])
    if newIndex[s] == invalidIndex {
      newIndex[s] = nextIndex
      nextIndex = nextIndex + 1
    }
    i = i + 1
  }
  // TODO(eustas): by using idea of "cycle-sort" we can avoid allocation of tmp and reduce the
  // number of copying by the factor of 2.
  let mut tmpList = List<H>.make()
  run List<H>.reserveExact(&mut tmpList, u32.toUsize(nextIndex))
  nextIndex = 0
  i = 0
  while i < length {
    let s = u32.toUsize(symbols[i])
    if newIndex[s] == nextIndex {
      run List<H>.append(&mut tmpList, out[s])
      nextIndex = nextIndex + 1
    }
    symbols[i] = newIndex[s]
    i = i + 1
  }
  drop newIndexList
  let tmp = List<H>.asSlice(&tmpList)
  i = 0
  while i < u32.toUsize(nextIndex) {
    out[i] = tmp[i]
    i = i + 1
  }
  return u32.toUsize(nextIndex)
}

/// `BrotliClusterHistograms`: clusters the `inSize` histograms of `input` into at most
/// `maxHistograms`, written to `out` (which holds at least `inSize`), and returns their number
/// (`*out_size`). `histogramSymbols[i]` is set to the cluster of histogram `i`.
pub effect fn clusterHistograms<H: HistogramOps + Copy>(input: &[H], inSize: usize, maxHistograms: usize, out: &mut [H], histogramSymbols: &mut [u32]) -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut clusterSizeList = run filledWords(1, inSize)
  let clusterSize = List<u32>.asMutSlice(&mut clusterSizeList)
  let mut clustersList = run filledWords(0, inSize)
  let clusters = List<u32>.asMutSlice(&mut clustersList)
  let mut numClusters: usize = 0
  let maxInputHistograms: usize = 64
  let mut pairsCapacity = maxInputHistograms * maxInputHistograms / 2
  // For the first pass of clustering, we allow all pairs.
  let mut pairsList = run makePairs(pairsCapacity + 1)
  // TODO(eustas): move to "persistent" arena?
  let mut tmp: H = HistogramOps.cleared()

  let mut i: usize = 0
  while i < inSize {
    out[i] = input[i]
    HistogramOps.setCost(&mut out[i], HistogramOps.population(&input[i]))
    histogramSymbols[i] = usize.wrappingToU32(i)
    i = i + 1
  }

  i = 0
  while i < inSize {
    let numToCombine = if inSize - i < maxInputHistograms { inSize - i } else { maxInputHistograms }
    let mut j: usize = 0
    while j < numToCombine {
      clusters[numClusters + j] = usize.wrappingToU32(i + j)
      j = j + 1
    }
    let numNewClusters = histogramCombine<H>(
      &mut out,
      &mut tmp,
      &mut clusterSize,
      Slice.viewMut<u32>(&mut histogramSymbols, i, inSize - i),
      Slice.viewMut<u32>(&mut clusters, numClusters, inSize - numClusters),
      List<HistogramPair>.asMutSlice(&mut pairsList),
      numToCombine,
      numToCombine,
      maxHistograms,
      pairsCapacity,
    )
    numClusters = numClusters + numNewClusters
    i = i + maxInputHistograms
  }

  // For the second pass, we limit the total number of histogram pairs. After this limit is
  // reached, we only keep searching for the best pair.
  let a = 64 * numClusters
  let b = (numClusters / 2) * numClusters
  let maxNumPairs = if a < b { a } else { b }
  // `BROTLI_ENSURE_CAPACITY(m, HistogramPair, pairs, pairs_capacity, max_num_pairs + 1)`.
  if pairsCapacity < maxNumPairs + 1 {
    let mut newSize = pairsCapacity
    while newSize < maxNumPairs + 1 { newSize = newSize * 2 }
    let mut grown = run makePairs(newSize)
    Slice.copyInto<HistogramPair>(List<HistogramPair>.asMutSlice(&mut grown), 0, Slice.view<HistogramPair>(List<HistogramPair>.asSlice(&pairsList), 0, pairsCapacity))
    pairsList = move grown
    pairsCapacity = newSize
  }

  // Collapse similar histograms.
  numClusters = histogramCombine<H>(&mut out, &mut tmp, &mut clusterSize, &mut histogramSymbols, &mut clusters, List<HistogramPair>.asMutSlice(&mut pairsList), numClusters, inSize, maxHistograms, maxNumPairs)
  drop pairsList
  drop clusterSizeList
  // Find the optimal map from original histograms to the final ones.
  histogramRemap<H>(input, inSize, &clusters, numClusters, &mut out, &mut tmp, &mut histogramSymbols)
  drop clustersList
  // Convert the context map to a canonical form.
  return run histogramReindex<H>(&mut out, &mut histogramSymbols, inSize)
}
