//! Histograms of literals, commands and distances: a port of google/brotli v1.2.0
//! `c/enc/histogram.h` and `histogram_inc.h`.
//!
//! `BrotliBuildHistogramsWithContext` (`histogram.c`) needs the block splits of the meta-block
//! builder and belongs with it.
import silk.core.ownership { Copy }
import silk.num.f64
import silk.num.u8
import silk.num.u16

/// `HistogramLiteral`.
pub struct HistogramLiteral {
  pub data: [u32; 256],
  pub totalCount: usize,
  pub bitCost: f64,
}

/// `HistogramCommand`.
pub struct HistogramCommand {
  pub data: [u32; 704],
  pub totalCount: usize,
  pub bitCost: f64,
}

/// `HistogramDistance`.
pub struct HistogramDistance {
  pub data: [u32; 544],
  pub totalCount: usize,
  pub bitCost: f64,
}

impl Copy for HistogramLiteral {}
impl Copy for HistogramCommand {}
impl Copy for HistogramDistance {}

// `HUGE_VAL`.
@inlineAlways
fn hugeValue() -> f64 {
  return f64.fromBits(0x7ff0000000000000)
}

impl HistogramLiteral {
  /// A cleared histogram.
  pub fn make() -> HistogramLiteral {
    return HistogramLiteral { data: [0; 256], totalCount: 0, bitCost: hugeValue() }
  }

  /// `HistogramClearLiteral`.
  pub fn clear(self: &mut Self) -> () {
    let mut i: usize = 0
    while i < 256 {
      self.data[i] = 0
      i = i + 1
    }
    self.totalCount = 0
    self.bitCost = hugeValue()
  }

  /// `HistogramAddLiteral`.
  @inlineAlways
  pub fn add(self: &mut Self, value: usize) -> () {
    self.data[value] = self.data[value] + 1
    self.totalCount = self.totalCount + 1
  }

  /// `HistogramAddVectorLiteral`.
  pub fn addVector(self: &mut Self, values: &[u8]) -> () {
    self.totalCount = self.totalCount + values.length
    let mut i: usize = 0
    while i < values.length {
      let value = u8.toUsize(values[i])
      self.data[value] = self.data[value] + 1
      i = i + 1
    }
  }

  /// `HistogramAddHistogramLiteral`.
  pub fn addHistogram(self: &mut Self, other: &Self) -> () {
    self.totalCount = self.totalCount + other.totalCount
    let mut i: usize = 0
    while i < 256 {
      self.data[i] = self.data[i] + other.data[i]
      i = i + 1
    }
  }
}

