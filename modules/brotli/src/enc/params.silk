//! The parameters of an encoder and the formulas that define the quality levels: a port of
//! google/brotli v1.2.0 `c/enc/params.h` and `quality.h`, with `BrotliInitDistanceParams` of
//! `metablock.c`.
import silk.num.i32
import silk.num.u32
import silk.num.usize
import enc.constants { LARGE_MAX_DISTANCE_BITS, LARGE_MAX_WINDOW_BITS, MAX_ALLOWED_DISTANCE, MAX_DISTANCE, MAX_DISTANCE_BITS, MAX_INPUT_BLOCK_BITS, MAX_QUALITY, MAX_WINDOW_BITS, MIN_INPUT_BLOCK_BITS, MIN_QUALITY, MIN_WINDOW_BITS, DEFAULT_QUALITY, DEFAULT_WINDOW, MODE_GENERIC, calculateDistanceCodeLimit, distanceAlphabetSize }
import enc.encoder_dict { SharedEncoderDictionary }

pub const FAST_ONE_PASS_COMPRESSION_QUALITY: i32 = 0
pub const FAST_TWO_PASS_COMPRESSION_QUALITY: i32 = 1
pub const ZOPFLIFICATION_QUALITY: i32 = 10
pub const HQ_ZOPFLIFICATION_QUALITY: i32 = 11

pub const MAX_QUALITY_FOR_STATIC_ENTROPY_CODES: i32 = 2
pub const MIN_QUALITY_FOR_BLOCK_SPLIT: i32 = 4
pub const MIN_QUALITY_FOR_NONZERO_DISTANCE_PARAMS: i32 = 4
pub const MIN_QUALITY_FOR_OPTIMIZE_HISTOGRAMS: i32 = 4
pub const MIN_QUALITY_FOR_EXTENSIVE_REFERENCE_SEARCH: i32 = 5
pub const MIN_QUALITY_FOR_CONTEXT_MODELING: i32 = 5
pub const MIN_QUALITY_FOR_HQ_CONTEXT_MODELING: i32 = 7
pub const MIN_QUALITY_FOR_HQ_BLOCK_SPLITTING: i32 = 10

/// For quality below `MIN_QUALITY_FOR_BLOCK_SPLIT` there is no block splitting, so we buffer at
/// most this much literals and commands.
pub const MAX_NUM_DELAYED_SYMBOLS: usize = 0x2fff

/// The maximum length for which the zopflification uses distinct distances.
pub const MAX_ZOPFLI_LEN_QUALITY_10: usize = 150
pub const MAX_ZOPFLI_LEN_QUALITY_11: usize = 325

/// Do not thoroughly search when a long copy is found.
pub const LONG_COPY_QUICK_STEP: usize = 16384

/// `BrotliHasherParams`.
pub struct HasherParams {
  /// `type`: the number of the hasher.
  pub kind: i32,
  pub bucketBits: i32,
  pub blockBits: i32,
  pub numLastDistancesToCheck: i32,
}

/// `BrotliDistanceParams`.
pub struct DistanceParams {
  pub distancePostfixBits: u32,
  pub numDirectDistanceCodes: u32,
  pub alphabetSizeMax: u32,
  pub alphabetSizeLimit: u32,
  pub maxDistance: usize,
}

/// `BrotliEncoderParams`.
pub struct EncoderParams {
  pub mode: u32,
  pub quality: i32,
  pub lgwin: i32,
  pub lgblock: i32,
  pub streamOffset: usize,
  pub sizeHint: usize,
  pub disableLiteralContextModeling: bool,
  pub largeWindow: bool,
  pub hasher: HasherParams,
  pub dist: DistanceParams,
  pub dictionary: SharedEncoderDictionary,
}

impl EncoderParams {
  /// `BrotliEncoderInitParams`.
  pub fn make() -> EncoderParams {
    let alphabetSizeMax = distanceAlphabetSize(0, 0, MAX_DISTANCE_BITS)
    return EncoderParams {
      mode: MODE_GENERIC,
      quality: DEFAULT_QUALITY,
      lgwin: DEFAULT_WINDOW,
      lgblock: 0,
      streamOffset: 0,
      sizeHint: 0,
      disableLiteralContextModeling: false,
      largeWindow: false,
      // C leaves the hasher parameters unset until `ChooseHasher`.
      hasher: HasherParams { kind: 0, bucketBits: 0, blockBits: 0, numLastDistancesToCheck: 0 },
      dist: DistanceParams {
        distancePostfixBits: 0,
        numDirectDistanceCodes: 0,
        alphabetSizeMax: alphabetSizeMax,
        alphabetSizeLimit: alphabetSizeMax,
        maxDistance: MAX_DISTANCE,
      },
      dictionary: SharedEncoderDictionary.make(),
    }
  }
}

/// `BrotliInitDistanceParams`.
pub fn initDistanceParams(dist: &mut DistanceParams, npostfix: u32, ndirect: u32, largeWindow: bool) -> () {
  dist.distancePostfixBits = npostfix
  dist.numDirectDistanceCodes = ndirect
  let mut alphabetSizeMax = distanceAlphabetSize(npostfix, ndirect, MAX_DISTANCE_BITS)
  let mut alphabetSizeLimit = alphabetSizeMax
  let mut maxDistance = ndirect + u32.shiftLeft(1, MAX_DISTANCE_BITS + npostfix + 2) - u32.shiftLeft(1, npostfix + 2)
  if largeWindow {
    let limit = calculateDistanceCodeLimit(MAX_ALLOWED_DISTANCE, npostfix, ndirect)
    alphabetSizeMax = distanceAlphabetSize(npostfix, ndirect, LARGE_MAX_DISTANCE_BITS)
    alphabetSizeLimit = limit.maxAlphabetSize
    maxDistance = limit.maxDistance
  }
  dist.alphabetSizeMax = alphabetSizeMax
  dist.alphabetSizeLimit = alphabetSizeLimit
  dist.maxDistance = u32.toUsize(maxDistance)
}

/// `MaxHashTableSize`: the hash table size for quality levels 0 and 1.
@inlineAlways
pub fn maxHashTableSize(quality: i32) -> usize {
  if quality == FAST_ONE_PASS_COMPRESSION_QUALITY { return 32768 }
  return 131072
}

/// `MaxZopfliLen`.
pub fn maxZopfliLen(params: &EncoderParams) -> usize {
  if params.quality <= 10 { return MAX_ZOPFLI_LEN_QUALITY_10 }
  return MAX_ZOPFLI_LEN_QUALITY_11
}

/// `MaxZopfliCandidates`: the number of best candidates to evaluate to expand a Zopfli chain.
pub fn maxZopfliCandidates(params: &EncoderParams) -> usize {
  if params.quality <= 10 { return 1 }
  return 5
}

/// `SanitizeParams`.
pub fn sanitizeParams(params: &mut EncoderParams) -> () {
  if params.quality < MIN_QUALITY { params.quality = MIN_QUALITY }
  if params.quality > MAX_QUALITY { params.quality = MAX_QUALITY }
  if params.quality <= MAX_QUALITY_FOR_STATIC_ENTROPY_CODES {
    params.largeWindow = false
  }
  if params.lgwin < MIN_WINDOW_BITS {
    params.lgwin = MIN_WINDOW_BITS
  } else {
    let maxLgwin = if params.largeWindow { LARGE_MAX_WINDOW_BITS } else { MAX_WINDOW_BITS }
    if params.lgwin > maxLgwin { params.lgwin = maxLgwin }
  }
}

/// `ComputeLgBlock`: the optimized lgblock value.
pub fn computeLgBlock(params: &EncoderParams) -> i32 {
  let mut lgblock = params.lgblock
  if params.quality == FAST_ONE_PASS_COMPRESSION_QUALITY || params.quality == FAST_TWO_PASS_COMPRESSION_QUALITY {
    lgblock = params.lgwin
  } else if params.quality < MIN_QUALITY_FOR_BLOCK_SPLIT {
    lgblock = 14
  } else if lgblock == 0 {
    lgblock = 16
    if params.quality >= 9 && params.lgwin > lgblock {
      lgblock = if params.lgwin < 18 { params.lgwin } else { 18 }
    }
  } else {
    if lgblock < MIN_INPUT_BLOCK_BITS { lgblock = MIN_INPUT_BLOCK_BITS }
    if lgblock > MAX_INPUT_BLOCK_BITS { lgblock = MAX_INPUT_BLOCK_BITS }
  }
  return lgblock
}

/// `ComputeRbBits`: log2 of the size of the main ring buffer area.
///
/// Allocate at least lgwin + 1 bits for the ring buffer so that the newly added block fits there
/// completely and we still get lgwin bits and at least read_block_size_bits + 1 bits because the
/// copy tail length needs to be smaller than ring-buffer size.
pub fn computeRbBits(params: &EncoderParams) -> i32 {
  return 1 + (if params.lgwin > params.lgblock { params.lgwin } else { params.lgblock })
}

/// `MaxMetablockSize`.
pub fn maxMetablockSize(params: &EncoderParams) -> usize {
  let rbBits = computeRbBits(params)
  let bits = if rbBits < MAX_INPUT_BLOCK_BITS { rbBits } else { MAX_INPUT_BLOCK_BITS }
  return usize.shiftLeft(1, i32.toUsize(bits))
}

/// `LiteralSpreeLengthForSparseSearch`.
///
/// When searching for backward references and have not seen matches for a long time, we can skip
/// some match lookups. Applied only to qualities 2 to 9.
pub fn literalSpreeLengthForSparseSearch(params: &EncoderParams) -> usize {
  if params.quality < 9 { return 64 }
  return 512
}

/// `BROTLI_MAX_SIMD_QUALITY` (`c/common/platform.h`) as the reference build on x86-64 Linux
/// defines it (`BROTLI_TZCNT64` without `_M_X64`): the highest quality that uses the hashers 58
/// and 68 in place of 5 and 6.
pub const MAX_SIMD_QUALITY: i32 = 6

/// `ChooseHasher`: the quality to hasher mapping.
pub fn chooseHasher(params: &EncoderParams, hparams: &mut HasherParams) -> () {
  if params.quality > 9 {
    hparams.kind = 10
  } else if params.quality == 4 && params.sizeHint >= 1048576 {
    hparams.kind = 54
  } else if params.quality < 5 {
    hparams.kind = params.quality
  } else if params.lgwin <= 16 {
    hparams.kind = if params.quality < 7 { 40 } else if params.quality < 9 { 41 } else { 42 }
  } else if params.sizeHint >= 1048576 && params.lgwin >= 19 {
    hparams.kind = if params.quality <= MAX_SIMD_QUALITY { 68 } else { 6 }
    hparams.blockBits = params.quality - 1
    hparams.bucketBits = 15
    hparams.numLastDistancesToCheck = if params.quality < 7 { 4 } else if params.quality < 9 { 10 } else { 16 }
  } else {
    hparams.kind = if params.quality <= MAX_SIMD_QUALITY { 58 } else { 5 }
    hparams.blockBits = params.quality - 1
    hparams.bucketBits = if params.quality < 7 { 14 } else { 15 }
    hparams.numLastDistancesToCheck = if params.quality < 7 { 4 } else if params.quality < 9 { 10 } else { 16 }
  }
  if params.lgwin > 24 {
    // Different hashers for large window brotli: not for qualities <= 2, these are too fast for
    // large window. Not for qualities >= 10: their hasher already works well with large window.
    // So the changes are:
    //   H3 --> H35: for quality 3.
    //   H54 --> H55: for quality 4 with size hint > 1MB
    //   H6/H68 --> H65: for qualities 5, 6, 7, 8, 9.
    if hparams.kind == 3 { hparams.kind = 35 }
    if hparams.kind == 54 { hparams.kind = 55 }
    if hparams.kind == 6 || hparams.kind == 68 { hparams.kind = 65 }
  }
}
