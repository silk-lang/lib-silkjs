//! The dictionaries of an encoder: the part of google/brotli v1.2.0 `c/enc/encoder_dict.h` and
//! `compound_dictionary.h` that the encoder state reads.
//!
//! NOT PORTED YET: prepared (LZ77 prefix) dictionaries and the static dictionary index. This is
//! the seam for them: `SharedEncoderDictionary` holds only the fields that `encode.c` itself
//! consults, with the values of an encoder that has no dictionary attached.
import enc.constants { MAX_QUALITY }

/// `SharedEncoderDictionary`, as far as the encoder state reads it.
pub struct SharedEncoderDictionary {
  /// `compound.total_size`: the bytes of all attached LZ77 prefix dictionaries.
  pub compoundTotalSize: usize,
  /// `max_quality`: the maximum quality the dictionary was computed for.
  pub maxQuality: i32,
}

impl SharedEncoderDictionary {
  /// `BrotliInitSharedEncoderDictionary`: the built-in dictionary alone.
  pub fn make() -> SharedEncoderDictionary {
    return SharedEncoderDictionary { compoundTotalSize: 0, maxQuality: MAX_QUALITY }
  }
}
