//! The dictionaries of an encoder: the part of google/brotli v1.2.0 `c/enc/encoder_dict.h` and
//! `encoder_dict.c` (`BrotliInitSharedEncoderDictionary`) that the encoder parameters hold.
//!
//! `SharedEncoderDictionary` keeps the plain values that the parameters carry: the size of the
//! attached prepared (LZ77 prefix) dictionaries and the maximum quality. The prepared
//! dictionaries themselves (`compound`) are the `enc.compound_dictionary.CompoundDictionary` of
//! the encoder state, so that the parameters stay a plain value. A custom (serialized) shared
//! dictionary, and with it a contextual static dictionary, exists only in the
//! `BROTLI_EXPERIMENTAL` build, so the static dictionary here is always the built-in one.
import enc.constants { MAX_QUALITY }

/// `SharedEncoderDictionary`, as far as the encoder state reads it.
pub struct SharedEncoderDictionary {
  /// `compound.total_size`: the bytes of all attached LZ77 prefix dictionaries.
  pub compoundTotalSize: usize,
  /// `max_quality`: the maximum quality the dictionary was computed for.
  pub maxQuality: i32,
}

impl SharedEncoderDictionary {
  /// `BrotliInitSharedEncoderDictionary`: the built-in dictionary alone.
  pub fn make() -> SharedEncoderDictionary {
    return SharedEncoderDictionary { compoundTotalSize: 0, maxQuality: MAX_QUALITY }
  }
}
