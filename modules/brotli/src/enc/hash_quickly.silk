//! The fast match finders H2, H3, H4 and H54: a port of google/brotli v1.2.0
//! `c/enc/hash_longest_match_quickly_inc.h` with the parameters that `c/enc/hash.h` instantiates
//! it with.
//!
//! A (forgetful) hash table to the data seen by the compressor, to help create backward
//! references to previous data. This is a hash map of fixed size (`1 << bucketBits`); each key
//! has `1 << bucketSweepBits` slots, 8 buckets apart.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u32
import silk.num.u64
import silk.num.usize
import enc.find_match_length { findMatchLengthWithLimitUnchecked }
import enc.hash_base { DictionaryStats, checkHashable, signExtend, HASH_MUL_64, HasherSearchResult, MatchFinder, backwardReferenceScore, backwardReferenceScoreUsingLastDistance, searchInStaticDictionary }
import enc.memory { getUncheckedMut, setUnchecked, wordsMut, zeroedWords }
import enc.write_bits { byteUnchecked, load64Unchecked }

/// The template parameters of `hash_longest_match_quickly_inc.h`.
pub interface QuicklyConfig {
  /// `BUCKET_BITS`.
  fn bucketBits(self: &Self) -> usize
  /// `BUCKET_SWEEP_BITS`.
  fn bucketSweepBits(self: &Self) -> usize
  /// `HASH_LEN`: the number of bytes hashed.
  fn hashLen(self: &Self) -> usize
  /// `USE_DICTIONARY`.
  fn useDictionary(self: &Self) -> bool
}

/// The parameters of H2. For a bucket sweep of 1, enabling the dictionary lookup makes
/// compression a little faster (0.5% - 1%) and it compresses 0.15% better on small text and HTML
/// inputs.
pub struct H2Config {}
impl QuicklyConfig for H2Config {
  @inlineAlways
  fn bucketBits(self: &Self) -> usize { return 16 }
  @inlineAlways
  fn bucketSweepBits(self: &Self) -> usize { return 0 }
  @inlineAlways
  fn hashLen(self: &Self) -> usize { return 5 }
  @inlineAlways
  fn useDictionary(self: &Self) -> bool { return true }
}

/// The parameters of H3.
pub struct H3Config {}
impl QuicklyConfig for H3Config {
  @inlineAlways
  fn bucketBits(self: &Self) -> usize { return 16 }
  @inlineAlways
  fn bucketSweepBits(self: &Self) -> usize { return 1 }
  @inlineAlways
  fn hashLen(self: &Self) -> usize { return 5 }
  @inlineAlways
  fn useDictionary(self: &Self) -> bool { return false }
}

/// The parameters of H4.
pub struct H4Config {}
impl QuicklyConfig for H4Config {
  @inlineAlways
  fn bucketBits(self: &Self) -> usize { return 17 }
  @inlineAlways
  fn bucketSweepBits(self: &Self) -> usize { return 2 }
  @inlineAlways
  fn hashLen(self: &Self) -> usize { return 5 }
  @inlineAlways
  fn useDictionary(self: &Self) -> bool { return true }
}

/// The parameters of H54.
pub struct H54Config {}
impl QuicklyConfig for H54Config {
  @inlineAlways
  fn bucketBits(self: &Self) -> usize { return 20 }
  @inlineAlways
  fn bucketSweepBits(self: &Self) -> usize { return 2 }
  @inlineAlways
  fn hashLen(self: &Self) -> usize { return 7 }
  @inlineAlways
  fn useDictionary(self: &Self) -> bool { return false }
}

/// `HashLongestMatchQuickly`.
pub struct HashQuickly<C> {
  config: C,
  /// `common->dict_num_lookups` and `dict_num_matches`.
  stats: DictionaryStats,
  /// `buckets_`: `uint32_t[BUCKET_SIZE]`.
  buckets: Intrinsic.RawBuffer<u32>,
}

impl<C: QuicklyConfig> HashQuickly<C> {
  /// `HashMemAllocInBytes`, the allocation of `HasherSetup` and `Initialize`.
  pub effect fn make(config: C) -> HashQuickly<C> ! OutOfMemoryError ? &mut Allocator {
    let size = usize.shiftLeft(1, QuicklyConfig.bucketBits(&config))
    return HashQuickly<C> { config: move config, stats: DictionaryStats.make(), buckets: run zeroedWords(size) }
  }

  // `HashBytes`: the bucket of the `HASH_LEN` bytes at `at`.
  @inlineAlways
  fn hashBytes(self: &Self, data: &[u8], at: usize) -> usize {
    let _last = data[at + 7]
    return unsafe HashQuickly<C>.hashBytesUnchecked(&self, data, at)
  }

  // `hashBytes` without a bounds check: the caller proves that `data` has 8 bytes at `at`.
  @inlineAlways
  unsafe fn hashBytesUnchecked(self: &Self, data: &[u8], at: usize) -> usize {
    return unsafe hashKey(data, at, QuicklyConfig.hashLen(&self.config), QuicklyConfig.bucketBits(&self.config))
  }
}

// The hash of [`HashQuickly.hashBytesUnchecked`], from the configuration's constants, so that the
// store loops can call it while they hold the table. The caller proves that `data` has 8 bytes
// at `at`.
@inlineAlways
unsafe fn hashKey(data: &[u8], at: usize, hashLen: usize, bucketBits: usize) -> usize {
  let shift = usize.toU64(64 - 8 * hashLen)
  let h = u64.wrappingMultiply(u64.shiftLeft(unsafe load64Unchecked(data, at), shift), HASH_MUL_64)
  // The higher bits contain more mixture from the multiplication, so we take our results from
  // there.
  return u64.toUsize(u64.shiftRight(h, usize.toU64(64 - bucketBits)))
}

impl<C: QuicklyConfig> MatchFinder for HashQuickly<C> {
  @inlineAlways
  fn hashTypeLength(self: &Self) -> usize { return 8 }
  @inlineAlways
  fn storeLookahead(self: &Self) -> usize { return 8 }

  fn initialize(self: &mut Self) -> () {}

  fn prepare(self: &mut Self, oneShot: bool, inputSize: usize, data: &[u8]) -> () {
    let bucketSize = usize.shiftLeft(1, QuicklyConfig.bucketBits(&self.config))
    let bucketMask = bucketSize - 1
    let sweep = usize.shiftLeft(1, QuicklyConfig.bucketSweepBits(&self.config))
    // Partial preparation is 100 times slower (per socket).
    let partialPrepareThreshold = usize.shiftRight(bucketSize, 5)
    if oneShot && inputSize <= partialPrepareThreshold {
      let mut i: usize = 0
      while i < inputSize {
        let key = HashQuickly<C>.hashBytes(&self, data, i)
        let buckets = wordsMut(&mut self.buckets)
        if sweep == 1 {
          buckets[key] = 0
        } else {
          let mut j: usize = 0
          while j < sweep {
            buckets[(key + usize.shiftLeft(j, 3)) & bucketMask] = 0
            j = j + 1
          }
        }
        i = i + 1
      }
    } else {
      // It is not strictly necessary to fill this buffer here, but not filling will make the
      // results of the compression stochastic (but correct). This is because random data would
      // cause the system to find accidentally good backward references here and there.
      let buckets = wordsMut(&mut self.buckets)
      let mut i: usize = 0
      while i < bucketSize {
        buckets[i] = 0
        i = i + 1
      }
    }
  }

  fn stitchToPreviousBlock(self: &mut Self, numBytes: usize, position: usize, ringbuffer: &[u8], ringbufferMask: usize) -> () {
    if numBytes >= 8 - 1 && position >= 3 {
      // Prepare the hashes for three last bytes of the last write. These could not be calculated
      // before, since they require knowledge of both the previous and the current block.
      MatchFinder.store(&mut self, ringbuffer, ringbufferMask, position - 3)
      MatchFinder.store(&mut self, ringbuffer, ringbufferMask, position - 2)
      MatchFinder.store(&mut self, ringbuffer, ringbufferMask, position - 1)
    }
  }

  @inlineAlways
  fn prepareDistanceCache(self: &Self, distanceCache: &mut [i32; 16]) -> () {}

  @inlineAlways
  unsafe fn findLongestMatch(self: &mut Self, data: &[u8], ringBufferMask: usize, distanceCache: &[i32; 16], curIx: usize, maxLength: usize, maxBackward: usize, dictionaryDistance: usize, maxDistance: usize, out: &mut HasherSearchResult) -> () {
    // The reads of `data` below are inside what the caller proved (`checkReadable`), and
    // `out.len` is at most `maxLength`.
    let bucketMask = usize.shiftLeft(1, QuicklyConfig.bucketBits(&self.config)) - 1
    let sweep = usize.shiftLeft(1, QuicklyConfig.bucketSweepBits(&self.config))
    let sweepMask = usize.shiftLeft(sweep - 1, 3)
    let bestLenIn = out.len
    let curIxMasked = curIx & ringBufferMask
    let mut compareChar = unsafe byteUnchecked(data, usize.wrappingAdd(curIxMasked, bestLenIn))
    let key = unsafe HashQuickly<C>.hashBytesUnchecked(&self, data, curIxMasked)
    let minScore = out.score
    let mut bestScore = out.score
    let mut bestLen = bestLenIn
    let cachedBackward = signExtend(distanceCache[0])
    let mut prevIx = usize.wrappingSubtract(curIx, cachedBackward)
    // The keys are masked to the bucket size.
    let buckets = wordsMut(&mut self.buckets)
    out.lenCodeDelta = 0
    if prevIx < curIx {
      prevIx = prevIx & (ringBufferMask & 0xffffffff)
      if compareChar == unsafe byteUnchecked(data, usize.wrappingAdd(prevIx, bestLen)) {
        let len = unsafe findMatchLengthWithLimitUnchecked(data, prevIx, curIxMasked, maxLength)
        if len >= 4 {
          let score = backwardReferenceScoreUsingLastDistance(len)
          if bestScore < score {
            out.len = len
            out.distance = cachedBackward
            out.score = score
            if sweep == 1 {
              unsafe setUnchecked<u32>(&mut buckets, key, usize.wrappingToU32(curIx))
              return ()
            } else {
              bestLen = len
              bestScore = score
              compareChar = unsafe byteUnchecked(data, usize.wrappingAdd(curIxMasked, len))
            }
          }
        }
      }
    }
    let mut keyOut: usize = 0
    if sweep == 1 {
      // Only one to look for, don't bother to prepare for a loop.
      prevIx = u32.toUsize(unsafe getUncheckedMut<u32>(&mut buckets, key))
      unsafe setUnchecked<u32>(&mut buckets, key, usize.wrappingToU32(curIx))
      let backward = usize.wrappingSubtract(curIx, prevIx)
      prevIx = prevIx & (ringBufferMask & 0xffffffff)
      if compareChar != unsafe byteUnchecked(data, usize.wrappingAdd(prevIx, bestLenIn)) {
        return ()
      }
      if backward == 0 || backward > maxBackward {
        return ()
      }
      let len = unsafe findMatchLengthWithLimitUnchecked(data, prevIx, curIxMasked, maxLength)
      if len >= 4 {
        let score = backwardReferenceScore(len, backward)
        if bestScore < score {
          out.len = len
          out.distance = backward
          out.score = score
          return ()
        }
      }
    } else {
      keyOut = usize.wrappingAdd(key, curIx & sweepMask) & bucketMask
      let mut i: usize = 0
      while i < sweep {
        let slot = usize.wrappingAdd(key, usize.shiftLeft(i, 3)) & bucketMask
        i = i + 1
        prevIx = u32.toUsize(unsafe getUncheckedMut<u32>(&mut buckets, slot))
        let backward = usize.wrappingSubtract(curIx, prevIx)
        prevIx = prevIx & (ringBufferMask & 0xffffffff)
        if compareChar != unsafe byteUnchecked(data, usize.wrappingAdd(prevIx, bestLen)) {
          continue
        }
        if backward == 0 || backward > maxBackward {
          continue
        }
        let len = unsafe findMatchLengthWithLimitUnchecked(data, prevIx, curIxMasked, maxLength)
        if len >= 4 {
          let score = backwardReferenceScore(len, backward)
          if bestScore < score {
            bestLen = len
            out.len = len
            compareChar = unsafe byteUnchecked(data, usize.wrappingAdd(curIxMasked, len))
            bestScore = score
            out.score = score
            out.distance = backward
          }
        }
      }
    }
    if QuicklyConfig.useDictionary(&self.config) && minScore == out.score {
      unsafe searchInStaticDictionary(&mut self.stats, data, curIxMasked, maxLength, dictionaryDistance, maxDistance, &mut out, true)
    }
    if sweep != 1 {
      let buckets = wordsMut(&mut self.buckets)
      unsafe setUnchecked<u32>(&mut buckets, keyOut, usize.wrappingToU32(curIx))
    }
  }

  @inlineAlways
  fn store(self: &mut Self, data: &[u8], mask: usize, ix: usize) -> () {
    MatchFinder.storeEvery(&mut self, data, mask, ix, ix + 1, 1)
  }

  @inlineAlways
  fn storeRange(self: &mut Self, data: &[u8], mask: usize, ixStart: usize, ixEnd: usize) -> () {
    MatchFinder.storeEvery(&mut self, data, mask, ixStart, ixEnd, 1)
  }

  @inlineAlways
  fn storeEvery(self: &mut Self, data: &[u8], mask: usize, ixStart: usize, ixEnd: usize, step: usize) -> () {
    // The 8 bytes that each position hashes are inside what this checks.
    checkHashable(data, mask, ixStart, ixEnd, 8)
    let sweep = usize.shiftLeft(1, QuicklyConfig.bucketSweepBits(&self.config))
    let sweepMask = usize.shiftLeft(sweep - 1, 3)
    let bucketMask = usize.shiftLeft(1, QuicklyConfig.bucketBits(&self.config)) - 1
    let hashLen = QuicklyConfig.hashLen(&self.config)
    let bucketBits = QuicklyConfig.bucketBits(&self.config)
    // The table is taken once: through `self`, each store into it could change where it is.
    let buckets = wordsMut(&mut self.buckets)
    let mut ix = ixStart
    while ix < ixEnd {
      let key = unsafe hashKey(data, ix & mask, hashLen, bucketBits)
      // The keys are masked to the bucket size.
      if sweep == 1 {
        unsafe setUnchecked<u32>(&mut buckets, key, usize.wrappingToU32(ix))
      } else {
        // Wiggle the value with the bucket sweep range.
        unsafe setUnchecked<u32>(&mut buckets, usize.wrappingAdd(key, ix & sweepMask) & bucketMask, usize.wrappingToU32(ix))
      }
      // ix < ixEnd and the step is at most 4: the sum does not wrap.
      ix = usize.wrappingAdd(ix, step)
    }
  }
}
