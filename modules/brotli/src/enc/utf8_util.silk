//! Heuristics for UTF-8 text: a port of google/brotli v1.2.0 `c/enc/utf8_util.h` and
//! `utf8_util.c`.
import silk.num.i32
import silk.num.u8
import silk.num.u64
import silk.num.usize

/// `kMinUTF8Ratio`.
pub const MIN_UTF8_RATIO: f64 = 0.75

// `BrotliParseAsUTF8` at `data[(pos) & mask]` with `size` bytes left. The bytes after the first
// are read at consecutive addresses, not through the mask, as C reads `input[1]`. Returns the
// symbol in the low 32 bits and the bytes read above them.
@inlineAlways
fn parseAsUtf8(data: &[u8], at: usize, size: usize) -> u64 {
  let b0 = u8.toI32(data[at])
  // ASCII
  if (b0 & 0x80) == 0 {
    if b0 > 0 { return pack(b0, 1) }
  }
  // 2-byte UTF8
  if size > 1 && (b0 & 0xe0) == 0xc0 {
    let b1 = u8.toI32(data[at + 1])
    if (b1 & 0xc0) == 0x80 {
      let symbol = i32.shiftLeft(b0 & 0x1f, 6) | (b1 & 0x3f)
      if symbol > 0x7f { return pack(symbol, 2) }
    }
  }
  // 3-byte UTF8
  if size > 2 && (b0 & 0xf0) == 0xe0 {
    let b1 = u8.toI32(data[at + 1])
    if (b1 & 0xc0) == 0x80 {
      let b2 = u8.toI32(data[at + 2])
      if (b2 & 0xc0) == 0x80 {
        let symbol = i32.shiftLeft(b0 & 0x0f, 12) | i32.shiftLeft(b1 & 0x3f, 6) | (b2 & 0x3f)
        if symbol > 0x7ff { return pack(symbol, 3) }
      }
    }
  }
  // 4-byte UTF8
  if size > 3 && (b0 & 0xf8) == 0xf0 {
    let b1 = u8.toI32(data[at + 1])
    if (b1 & 0xc0) == 0x80 {
      let b2 = u8.toI32(data[at + 2])
      if (b2 & 0xc0) == 0x80 {
        let b3 = u8.toI32(data[at + 3])
        if (b3 & 0xc0) == 0x80 {
          let symbol = i32.shiftLeft(b0 & 0x07, 18) | i32.shiftLeft(b1 & 0x3f, 12) | i32.shiftLeft(b2 & 0x3f, 6) | (b3 & 0x3f)
          if symbol > 0xffff && symbol <= 0x10ffff { return pack(symbol, 4) }
        }
      }
    }
  }
  // Not UTF8, emit a special symbol above the UTF8-code space.
  return pack(0x110000 | b0, 1)
}

@inlineAlways
fn pack(symbol: i32, bytes: u64) -> u64 {
  return i32.toU64(symbol) | u64.shiftLeft(bytes, 32)
}

/// `BrotliIsMostlyUTF8`: whether more than `minFraction` of the `length` bytes at `pos` of the
/// ring buffer `data` are UTF-8.
pub fn isMostlyUtf8(data: &[u8], pos: usize, mask: usize, length: usize, minFraction: f64) -> bool {
  let mut sizeUtf8: usize = 0
  let mut i: usize = 0
  // The positions are ring buffer positions, far from overflowing, and `i < length` in the loop:
  // the arithmetic below cannot wrap.
  while i < length {
    let at = usize.wrappingAdd(pos, i) & mask
    let b0 = data[at]
    // The common cases first, with the results of `parseAsUtf8`: a nonzero ASCII byte is one
    // UTF-8 byte; a zero byte, a continuation byte (0x80 to 0xbf) and a byte from 0xf8 up start
    // no sequence, so they are one byte that is not UTF-8.
    if b0 < 0xc0 || b0 >= 0xf8 {
      if u8.wrappingSubtract(b0, 1) < 0x7f {
        sizeUtf8 = usize.wrappingAdd(sizeUtf8, 1)
      }
      i = usize.wrappingAdd(i, 1)
      continue
    }
    let parsed = parseAsUtf8(data, at, usize.wrappingSubtract(length, i))
    let bytesRead = u64.toUsize(u64.shiftRight(parsed, 32))
    i = usize.wrappingAdd(i, bytesRead)
    if (parsed & 0xffffffff) < 0x110000 { sizeUtf8 = usize.wrappingAdd(sizeUtf8, bytesRead) }
  }
  return usize.toF64(sizeUtf8) > minFraction * usize.toF64(length)
}
