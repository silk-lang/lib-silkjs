//! Buffers for the encoder, in place of the `BROTLI_ALLOC` of google/brotli v1.2.0
//! `c/enc/memory.h`.
//!
//! The C encoder takes its buffers from `malloc` and so pays only for the pages it writes. The
//! buffers here come from the allocator in the same sizes and at the same moments: zeroed where
//! the C code clears them or where zero pages cost nothing, and not initialized where the code
//! writes each element before it reads it (the output storage and the command and literal
//! buffers), so that a small buffer is not cleared for nothing on each call.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.layout { Layout }
import silk.mem.raw_buffer { RawBuffer }

/// `count` zero bytes.
pub effect fn zeroedBytes(count: usize) -> Intrinsic.RawBuffer<u8> ! OutOfMemoryError ? &mut Allocator {
  let allocation = run Allocator.allocateZeroed(Layout { bytes: count, alignment: 1 })
  // The allocation holds `count` bytes.
  return unsafe RawBuffer.from<u8>(move allocation, count)
}

/// `count` zero 32-bit words. `count * 4` must not overflow.
pub effect fn zeroedWords(count: usize) -> Intrinsic.RawBuffer<u32> ! OutOfMemoryError ? &mut Allocator {
  let allocation = run Allocator.allocateZeroed(Layout { bytes: count * 4, alignment: 4 })
  // The allocation holds `count` words with word alignment.
  return unsafe RawBuffer.from<u32>(move allocation, count)
}

/// All bytes of a buffer.
@inlineAlways
pub fn bytes(buffer: &Intrinsic.RawBuffer<u8>) -> &[u8] {
  // The callers read only what was zeroed or written.
  return unsafe RawBuffer.view<u8>(&buffer, 0, RawBuffer.count<u8>(&buffer))
}

/// All bytes of a buffer, to write.
@inlineAlways
pub fn bytesMut(buffer: &mut Intrinsic.RawBuffer<u8>) -> &mut [u8] {
  let count = RawBuffer.count<u8>(&buffer)
  return unsafe RawBuffer.viewMut<u8>(&mut buffer, 0, count)
}

/// All words of a buffer, to write.
@inlineAlways
pub fn wordsMut(buffer: &mut Intrinsic.RawBuffer<u32>) -> &mut [u32] {
  let count = RawBuffer.count<u32>(&buffer)
  return unsafe RawBuffer.viewMut<u32>(&mut buffer, 0, count)
}

/// `count` bytes whose content is not defined, like `malloc`: the caller writes each byte before
/// it reads it.
pub effect fn uninitializedBytes(count: usize) -> Intrinsic.RawBuffer<u8> ! OutOfMemoryError ? &mut Allocator {
  let allocation = run Allocator.allocate(Layout { bytes: count, alignment: 1 })
  // The allocation holds `count` bytes.
  return unsafe RawBuffer.from<u8>(move allocation, count)
}

/// `count` 32-bit words whose content is not defined, like `malloc`: the caller writes each word
/// before it reads it. `count * 4` must not overflow.
pub effect fn uninitializedWords(count: usize) -> Intrinsic.RawBuffer<u32> ! OutOfMemoryError ? &mut Allocator {
  let allocation = run Allocator.allocate(Layout { bytes: count * 4, alignment: 4 })
  // The allocation holds `count` words with word alignment.
  return unsafe RawBuffer.from<u32>(move allocation, count)
}

/// All words of a buffer.
@inlineAlways
pub fn words(buffer: &Intrinsic.RawBuffer<u32>) -> &[u32] {
  // The callers read only what was zeroed or written.
  return unsafe RawBuffer.view<u32>(&buffer, 0, RawBuffer.count<u32>(&buffer))
}

/// `count` zero 16-bit values. `count * 2` must not overflow.
pub effect fn zeroedHalfwords(count: usize) -> Intrinsic.RawBuffer<u16> ! OutOfMemoryError ? &mut Allocator {
  let allocation = run Allocator.allocateZeroed(Layout { bytes: count * 2, alignment: 2 })
  // The allocation holds `count` values with their alignment.
  return unsafe RawBuffer.from<u16>(move allocation, count)
}

/// All 16-bit values of a buffer.
@inlineAlways
pub fn halfwords(buffer: &Intrinsic.RawBuffer<u16>) -> &[u16] {
  return unsafe RawBuffer.view<u16>(&buffer, 0, RawBuffer.count<u16>(&buffer))
}

/// All 16-bit values of a buffer, to write.
@inlineAlways
pub fn halfwordsMut(buffer: &mut Intrinsic.RawBuffer<u16>) -> &mut [u16] {
  let count = RawBuffer.count<u16>(&buffer)
  return unsafe RawBuffer.viewMut<u16>(&mut buffer, 0, count)
}
