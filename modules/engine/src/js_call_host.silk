//! Synchronous call/construct dispatch shared by bound functions and invocation
//! helpers. Inputs and FrameSlots are borrowed roots for the complete callback;
//! dispatch must not retain their native stack storage. Results own one reference.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import js_value { ValueBits }
import js_owned_value { ValueRef }
import js_realm { Realm, Arguments }
import js_exceptions { JsException }

pub interface CallHooks {
  effect fn callArguments<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>,
    function: ValueRef<'v>, receiver: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator
  effect fn construct<'r, 'v, 'w, 'x>(self: &mut Self, realm: Realm<'r>,
    function: ValueRef<'v>, newTarget: ValueRef<'w>, arguments: Arguments<'x>) -> ValueBits
    ! OutOfMemoryError | JsException ? &mut Allocator
  /// The host's C entry that makes a call compiled code asked for with these hooks while that
  /// code stays on the machine stack (js_vm.engineCall): an extern "C" fn(hooks: *mut u8,
  /// allocator: *mut u8, activation: *mut u8) -> u64 answering a compiled.CALL_* code. Null leaves such calls to
  /// the runner (EXIT_CALL).
  fn compiledReentry(self: &Self) -> ?*const u8 { return Pointer.null<u8>() }
}
