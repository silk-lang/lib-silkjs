//! What compiled code (js_compiled) asks the engine about objects: the interpreter's own fast
//! paths, wrapped so they need no Machine. None runs JavaScript, allocates or fails; each
//! answers false where the interpreter would take a slower path, and the code then
//! deoptimizes to let the interpreter run that instruction.
import silk.mem.pointer { Pointer }
import silk.num.u32
import js_heap { HeapCell }
import js_value { ValueBits }
import js_core_types { FunctionBytecode, RuntimeState }
import js_atoms { AtomTable }
import js_atom_data as atoms
import js_compiled { CompiledFrame }
import js_vm_property_ops as properties

/// The named property read of the get_field, get_loc_field8 or get_arg_field8 (cached
/// false: its inline key) or get_field2 (cached true: its site cache) at bytecode offset pc
/// of frame.bytecode, from object. True with the value retained into out.
pub unsafe fn readField(frame: &CompiledFrame, pc: u32, cached: bool, object: ValueBits, out: *mut ValueBits) -> bool {
  let target = match object { ValueBits.Object { reference } => reference _ => { return false } }
  let ip = unsafe operandAt(frame, pc)
  if cached { return unsafe properties.readFieldCachedAt(frame.runtime, ip, target, out, true) }
  return unsafe properties.readFieldKeyedAt(frame.runtime, ip, target, out, true)
}

/// The store of the put_field, put_loc_field_loc8 or put_loc_field_arg8 at bytecode offset pc
/// of frame.bytecode of the value at source into object: an existing own writable data
/// property of the shape its inline key names (writeOwnField). True with the object holding
/// its own count of the value; false with nothing changed.
pub unsafe fn writeField(frame: &CompiledFrame, pc: u32, object: ValueBits, source: *const ValueBits) -> bool {
  let target = match object { ValueBits.Object { reference } => reference _ => { return false } }
  let ip = unsafe operandAt(frame, pc)
  // writeOwnField takes the count it stores; the caller keeps its own, so add one on success.
  let mut copy = unsafe Pointer.read<ValueBits>(source)
  if !unsafe properties.writeOwnField(ip, target, Pointer.fromMutRef(&mut copy)) { return false }
  drop unsafe (unsafe Pointer.read<ValueBits>(source)).retained()
  return true
}

/// The operand after the opcode at pc of frame.bytecode: the sites' caches key on its address.
unsafe fn operandAt(frame: &CompiledFrame, pc: u32) -> *const u8 {
  let anchor = ()
  let bytecode = unsafe HeapCell.payload<FunctionBytecode, ()>(&anchor, frame.bytecode)
  let code = unsafe bytecode.code.asSlice()
  let base = unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(code))
  return unsafe Pointer.at<u8>(base, u32.toUsize(pc) + 1)
}

/// The string push_atom_value (empty false: its atom operand) or push_empty_string (empty
/// true) at bytecode offset pc of frame.bytecode pushes, retained into out. False for an
/// integer atom, whose text the interpreter makes.
pub unsafe fn atomValue(frame: &CompiledFrame, pc: u32, empty: bool, out: *mut ValueBits) -> bool {
  let anchor = ()
  let rt = unsafe HeapCell.payload<RuntimeState, ()>(&anchor, frame.runtime)
  if empty { unsafe Pointer.write<ValueBits>(out, rt.atoms.storedValue(atoms.JS_ATOM_empty_string, true)) return true }
  let atom = unsafe properties.fieldAtomAt(unsafe operandAt(frame, pc))
  if AtomTable.isInteger(atom) { return false }
  unsafe Pointer.write<ValueBits>(out, rt.atoms.storedAtomValue(atom))
  return true
}
