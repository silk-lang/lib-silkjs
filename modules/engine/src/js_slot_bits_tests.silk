//! SlotBits: a stored value reads back as the same value, NaNs included.
import silk.testing.testing { AssertionError, Testing }
import silk.num.f64
import silk.mem.layout { Layout }
import js_core_types { SlotBits }
import js_value { ValueBits }

effect fn same(stored: ValueBits) -> () ! AssertionError<'static> {
  let back = SlotBits.value(stored).valueBits()
  run Testing.expect(back.tag() == stored.tag(), "a stored value keeps its variant")
  match stored {
    ValueBits.Int { value: expected } => { run Testing.expect(match back { ValueBits.Int { value } => value == expected _ => false }, "an int reads back") }
    ValueBits.Bool { value: expected } => { run Testing.expect(match back { ValueBits.Bool { value } => value == expected _ => false }, "a bool reads back") }
    ValueBits.CatchOffset { offset: expected } => { run Testing.expect(match back { ValueBits.CatchOffset { offset } => offset == expected _ => false }, "a catch offset reads back") }
    ValueBits.ShortBigInt { value: expected } => { run Testing.expect(match back { ValueBits.ShortBigInt { value } => value == expected _ => false }, "a short BigInt reads back") }
    ValueBits.Float64 { value: expected } => {
      let bits = match back { ValueBits.Float64 { value } => f64.toBits(value) _ => 0 }
      if expected != expected { run Testing.expect(bits == 0x7ff8000000000000, "a NaN reads back as the canonical NaN") }
      else { run Testing.expect(bits == f64.toBits(expected), "a number keeps its bits") }
    }
    _ => ()
  }
}

test effect fn storedValuesReadBackUnchanged() -> () ! AssertionError<'static> {
  run Testing.expect(Layout.of<SlotBits>().bytes == 8, "a stored slot is one word")
  run same(ValueBits.Int { value: 0 }) run same(ValueBits.Int { value: -1 }) run same(ValueBits.Int { value: 2147483647 }) run same(ValueBits.Int { value: -2147483648 })
  run same(ValueBits.Bool { value: true }) run same(ValueBits.Bool { value: false })
  run same(ValueBits.Null) run same(ValueBits.Undefined) run same(ValueBits.Uninitialized) run same(ValueBits.Exception)
  run same(ValueBits.CatchOffset { offset: 12345 })
  run same(ValueBits.ShortBigInt { value: 0 }) run same(ValueBits.ShortBigInt { value: -1 })
  run same(ValueBits.ShortBigInt { value: 140737488355327 }) run same(ValueBits.ShortBigInt { value: -140737488355328 })
  run same(ValueBits.Float64 { value: 1.5 }) run same(ValueBits.Float64 { value: -0.0 })
  run same(ValueBits.Float64 { value: f64.fromBits(0x7ff0000000000000) }) run same(ValueBits.Float64 { value: f64.fromBits(0xfff0000000000000) })
  run same(ValueBits.Float64 { value: f64.fromBits(0x7ff8000000000000) }) run same(ValueBits.Float64 { value: f64.fromBits(0xfff8000000000001) })
  run same(ValueBits.Float64 { value: f64.fromBits(0x7ff0000000000001) }) run same(ValueBits.Float64 { value: f64.fromBits(0xffffffffffffffff) })
  run same(ValueBits.Float64 { value: f64.fromBits(0x0000000000000001) }) run same(ValueBits.Float64 { value: f64.fromBits(0xffefffffffffffff) })
  run Testing.expect(!SlotBits.anyHeap(&[SlotBits.value(ValueBits.Int { value: 1 }), SlotBits.value(ValueBits.Float64 { value: f64.fromBits(0xfff0000000000000) }), SlotBits.value(ValueBits.ShortBigInt { value: -1 })]), "immediates hold no heap reference")
}
